@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loroc: <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#> .
@prefix lorsh: <https://w3id.org/legal-ontology-rag/shapes#> .
@prefix lorsp: <https://w3id.org/legal-ontology-rag/ontology/source-provenance#> .
@prefix lortc: <https://w3id.org/legal-ontology-rag/ontology/temporal-change#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/legal-ontology-rag/shapes> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/legal-ontology-rag/shapes/0.3.0> ;
    owl:versionInfo "0.3.0" ;
    dcterms:title "Vietnamese Road Traffic Legal Ontology SHACL Shapes"@en ;
    dcterms:description "Closed-world data-quality constraints maintained separately from the OWL ontology."@en ;
    dcterms:issued "2026-08-18"^^xsd:date ;
    dcterms:source "docs/ontology_construction_plan.md" .

lorsh:LegalResourceShape a sh:NodeShape ;
    sh:targetClass lorsp:LegalResource ;
    sh:property [
        sh:path lorsp:hasExpression ;
        sh:minCount 1 ;
        sh:class lorsp:LegalExpression ;
        sh:message "A legal resource must have at least one legal expression."@en
    ] ;
    lorsp:requirementReference "SCOPE-001", "SCOPE-006" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-DOC-001" .

lorsh:LegalExpressionShape a sh:NodeShape ;
    sh:targetClass lorsp:LegalExpression ;
    sh:property [
        sh:path lorsp:representedBy ;
        sh:minCount 1 ;
        sh:class lorsp:SourceFile ;
        sh:message "A legal expression must be represented by at least one source file."@en
    ], [
        sh:path lorsp:containsProvision ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "A legal expression must contain at least one structural provision."@en
    ] ;
    lorsp:requirementReference "SCOPE-001", "SCOPE-007" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001" ;
    lorsp:modelingDecisionReference "MD-DOC-001", "MD-PROV-002" .

lorsh:LegalProvisionShape a sh:NodeShape ;
    sh:targetClass lorsp:LegalProvision ;
    sh:property [
        sh:path lorsp:structuralPath ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A legal provision must have one reviewed structural path."@en
    ], [
        sh:path [ sh:inversePath lorsp:containsProvision ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lorsp:LegalExpression ;
        sh:message "A legal provision must belong to exactly one legal expression in an approved data graph."@en
    ] ;
    lorsp:requirementReference "SCOPE-001", "SCOPE-007", "GRAN-006" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001", "CQ-ASSEMBLY-001" ;
    lorsp:modelingDecisionReference "MD-DOC-001", "MD-PROV-002" .

lorsh:ProvisionCitationShape a sh:NodeShape ;
    sh:targetClass lorsp:ProvisionCitation ;
    sh:property [
        sh:path lorsp:citationText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "A provision citation must preserve one language-tagged source wording."@en
    ], [
        sh:path lorsp:refersToProvision ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "An approved provision citation must resolve to at least one legal provision."@en
    ] ;
    lorsp:requirementReference "SCOPE-001", "GRAN-006" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001", "CQ-EXCEPTION-001" ;
    lorsp:modelingDecisionReference "MD-REF-001" .

lorsh:SourceChunkShape a sh:NodeShape ;
    sh:targetClass lorsp:SourceChunk ;
    sh:property [
        sh:path lorsp:derivedFromFile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lorsp:SourceFile ;
        sh:message "A source chunk must identify exactly one source file."@en
    ] ;
    lorsp:requirementReference "SCOPE-001", "SCOPE-007" ;
    lorsp:competencyQuestionReference "CQ-EVIDENCE-001" ;
    lorsp:modelingDecisionReference "MD-PROV-001" .

lorsh:EvidenceSpanShape a sh:NodeShape ;
    sh:targetClass lorsp:EvidenceSpan ;
    sh:property [
        sh:path lorsp:exactText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "An evidence span must preserve one exact language-tagged quotation."@en
    ], [
        sh:path [ sh:inversePath lorsp:containsSpan ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lorsp:SourceChunk ;
        sh:message "An evidence span must be located in exactly one source chunk."@en
    ] ;
    lorsp:requirementReference "PURP-003", "SCOPE-007", "GRAN-006" ;
    lorsp:competencyQuestionReference "CQ-EVIDENCE-001" ;
    lorsp:modelingDecisionReference "MD-PROV-001" .

lorsh:SupportedAssertionShape a sh:NodeShape ;
    sh:targetClass lorsp:SupportedAssertion ;
    sh:property [
        sh:path lorsp:groundedIn ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "A supported assertion must be grounded in at least one legal provision."@en
    ], [
        sh:path lorsp:supportedBy ;
        sh:minCount 1 ;
        sh:class lorsp:EvidenceSpan ;
        sh:message "A supported assertion must have at least one exact evidence span."@en
    ] ;
    lorsp:requirementReference "PURP-003", "SCOPE-007" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001", "CQ-EVIDENCE-001" ;
    lorsp:modelingDecisionReference "MD-PROV-001" .

lorsh:RegulatedConductShape a sh:NodeShape ;
    sh:targetClass loroc:RegulatedConduct ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue loroc:conductScheme ;
        sh:message "A regulated-conduct concept must belong to the regulated conduct scheme."@en
    ] ;
    lorsp:requirementReference "SCOPE-002", "GRAN-008" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-COMPARISON-001" ;
    lorsp:modelingDecisionReference "MD-CONDUCT-001" .

lorsh:SubjectKindShape a sh:NodeShape ;
    sh:targetClass loroc:SubjectKind ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue loroc:subjectKindScheme ;
        sh:message "A subject-kind concept must belong to the subject kind scheme."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-002" ;
    lorsp:competencyQuestionReference "CQ-APPLICABILITY-001", "CQ-COMPARISON-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001" .

lorsh:LegalSubjectRoleShape a sh:NodeShape ;
    sh:targetClass loroc:LegalSubjectRole ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue loroc:subjectRoleScheme ;
        sh:message "A legal-subject-role concept must belong to the subject role scheme."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-002" ;
    lorsp:competencyQuestionReference "CQ-APPLICABILITY-001", "CQ-POINTS-001", "CQ-REMEDY-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001" .

lorsh:VehicleCategoryShape a sh:NodeShape ;
    sh:targetClass loroc:VehicleCategory ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue loroc:vehicleCategoryScheme ;
        sh:message "A vehicle-category concept must belong to the vehicle category scheme."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-003" ;
    lorsp:competencyQuestionReference "CQ-APPLICABILITY-001", "CQ-COMPARISON-001" ;
    lorsp:modelingDecisionReference "MD-VEHICLE-001" .

lorsh:LegalSubjectShape a sh:NodeShape ;
    sh:targetClass loroc:LegalSubject ;
    sh:property [
        sh:path loroc:hasSubjectKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:SubjectKind ;
        sh:message "A legal subject must have exactly one controlled subject kind in approved pilot data."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-002" ;
    lorsp:competencyQuestionReference "CQ-APPLICABILITY-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001" .

lorsh:RoleAssignmentShape a sh:NodeShape ;
    sh:targetClass loroc:RoleAssignment ;
    sh:property [
        sh:path loroc:rolePlayer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:LegalSubject ;
        sh:message "A role assignment must identify exactly one legal subject."@en
    ], [
        sh:path loroc:playsRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:LegalSubjectRole ;
        sh:message "A role assignment must identify exactly one contextual role."@en
    ], [
        sh:path loroc:inOccurrence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:ConductOccurrence ;
        sh:message "A role assignment must be scoped to exactly one conduct occurrence."@en
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-003", "GRAN-002" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-APPLICABILITY-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001" .

lorsh:VehicleShape a sh:NodeShape ;
    sh:targetClass loroc:Vehicle ;
    sh:property [
        sh:path loroc:hasVehicleCategory ;
        sh:minCount 1 ;
        sh:class loroc:VehicleCategory ;
        sh:message "A concrete vehicle must have at least one legally relevant vehicle category."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-003" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-APPLICABILITY-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-VEHICLE-001" .

lorsh:ConductOccurrenceShape a sh:NodeShape ;
    sh:targetClass loroc:ConductOccurrence ;
    sh:property [
        sh:path loroc:hasConductConcept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:RegulatedConduct ;
        sh:message "A conduct occurrence must have exactly one normalized conduct concept in approved pilot data."@en
    ], [
        sh:path [ sh:inversePath loroc:inOccurrence ] ;
        sh:minCount 1 ;
        sh:class loroc:RoleAssignment ;
        sh:message "A conduct occurrence must have at least one contextual role assignment."@en
    ], [
        sh:path loroc:involvesVehicle ;
        sh:maxCount 1 ;
        sh:class loroc:Vehicle ;
        sh:message "A pilot conduct occurrence may identify at most one concrete vehicle."@en
    ], [
        sh:path loroc:occursAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "A conduct occurrence must have exactly one occurrence-time instant."@en
    ] ;
    lorsp:requirementReference "PURP-001", "PURP-002", "SCOPE-002", "SCOPE-003", "SCOPE-006" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-TEMPORAL-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-CONDUCT-001", "MD-SUBJECT-001", "MD-VEHICLE-001", "MD-TIME-001" .

lorsh:TimeInstantShape a sh:NodeShape ;
    sh:targetClass time:Instant ;
    sh:xone (
        [
            sh:property [
                sh:path time:inXSDDateTime ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:dateTime
            ], [
                sh:path time:inXSDDateTimeStamp ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path time:inXSDDateTimeStamp ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:dateTimeStamp
            ], [
                sh:path time:inXSDDateTime ;
                sh:maxCount 0
            ]
        ]
    ) ;
    sh:message "A pilot time instant must have exactly one supported XSD date-time representation."@en ;
    lorsp:requirementReference "PURP-001", "USE-004", "SCOPE-006", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-TIME-001", "MD-CHANGE-001" .

lorsh:ValidityAssignmentShape a sh:NodeShape ;
    sh:targetSubjectsOf lortc:validDuring ;
    sh:property [
        sh:path lortc:validDuring ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lortc:ValidityInterval ;
        sh:message "An approved rule or expression must have exactly one verified validity interval."@en
    ] ;
    lorsp:requirementReference "PURP-001", "USE-004", "SCOPE-006", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-TIME-001", "MD-RULE-001" .

lorsh:ValidityIntervalShape a sh:NodeShape ;
    sh:targetClass lortc:ValidityInterval ;
    sh:property [
        sh:path time:hasBeginning ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "A validity interval must have exactly one verified beginning instant."@en
    ], [
        sh:path time:hasEnd ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "A validity interval may have at most one verified end instant; omission means unknown."@en
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A known validity end must not precede the validity beginning."@en ;
        sh:select """
            PREFIX time: <http://www.w3.org/2006/time#>
            SELECT $this ?beginning ?end
            WHERE {
                $this time:hasBeginning/time:inXSDDateTime ?beginning ;
                    time:hasEnd/time:inXSDDateTime ?end .
                FILTER (?end < ?beginning)
            }
        """
    ] ;
    lorsp:requirementReference "PURP-001", "USE-004", "SCOPE-006", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-TIME-001" .

lorsh:LegalChangeTypeShape a sh:NodeShape ;
    sh:targetClass lortc:LegalChangeType ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue lortc:legalChangeTypeScheme ;
        sh:message "A legal-change type must belong to the controlled legal change type scheme."@en
    ] ;
    lorsp:requirementReference "USE-004", "SCOPE-006" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-CHANGE-001" .

lorsh:LegalChangeShape a sh:NodeShape ;
    sh:targetClass lortc:LegalChange ;
    sh:property [
        sh:path lortc:changeType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lortc:LegalChangeType ;
        sh:message "A legal change must have exactly one controlled change type."@en
    ], [
        sh:path lortc:effectiveAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "A legal change must have exactly one verified effective instant."@en
    ], [
        sh:path lortc:changesEarlierRule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A legal change must identify exactly one earlier rule version."@en
    ], [
        sh:path lortc:producesLaterRule ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A legal change may identify at most one later rule version; repeal may identify none."@en
    ], [
        sh:path lorsp:groundedIn ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "A legal change must be grounded in at least one authoritative provision."@en
    ], [
        sh:path lorsp:supportedBy ;
        sh:minCount 1 ;
        sh:class lorsp:EvidenceSpan ;
        sh:message "A legal change must have at least one exact evidence span."@en
    ] ;
    lorsp:requirementReference "PURP-001", "PURP-003", "USE-004", "SCOPE-006", "SCOPE-007", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-TIME-001", "MD-CHANGE-001", "MD-RULE-001" .
