@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loroc: <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#> .
@prefix lorlc: <https://w3id.org/legal-ontology-rag/ontology/legal-consequence#> .
@prefix lornr: <https://w3id.org/legal-ontology-rag/ontology/normative-rule#> .
@prefix lorsh: <https://w3id.org/legal-ontology-rag/shapes#> .
@prefix lorsp: <https://w3id.org/legal-ontology-rag/ontology/source-provenance#> .
@prefix lortc: <https://w3id.org/legal-ontology-rag/ontology/temporal-change#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/legal-ontology-rag/shapes> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/legal-ontology-rag/shapes/0.6.0> ;
    owl:versionInfo "0.6.0" ;
    dcterms:title "Vietnamese Road Traffic Legal Ontology SHACL Shapes"@en ;
    dcterms:description "Closed-world data-quality constraints maintained separately from the OWL ontology."@en ;
    dcterms:issued "2026-08-18"^^xsd:date ;
    dcterms:source "docs/ontology_construction_plan.md" .

lorsh:LegalResourceShape a sh:NodeShape ;
    sh:targetClass lorsp:LegalResource ;
    sh:property [
        sh:path lorsp:hasExpression ;
        sh:minCount 1 ;
        sh:class lorsp:LegalExpression ;
        sh:message "A legal resource must have at least one legal expression."@en
    ] ;
    lorsp:requirementReference "SCOPE-001", "SCOPE-006" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-DOC-001" .

lorsh:LegalExpressionShape a sh:NodeShape ;
    sh:targetClass lorsp:LegalExpression ;
    sh:property [
        sh:path lorsp:representedBy ;
        sh:minCount 1 ;
        sh:class lorsp:SourceFile ;
        sh:message "A legal expression must be represented by at least one source file."@en
    ], [
        sh:path lorsp:containsProvision ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "A legal expression must contain at least one structural provision."@en
    ] ;
    lorsp:requirementReference "SCOPE-001" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001" ;
    lorsp:modelingDecisionReference "MD-DOC-001", "MD-PROV-002" .

lorsh:LegalProvisionShape a sh:NodeShape ;
    sh:targetClass lorsp:LegalProvision ;
    sh:property [
        sh:path lorsp:structuralPath ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A legal provision must have one reviewed structural path."@en
    ], [
        sh:path [ sh:inversePath lorsp:containsProvision ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lorsp:LegalExpression ;
        sh:message "A legal provision must belong to exactly one legal expression in an approved data graph."@en
    ] ;
    lorsp:requirementReference "SCOPE-001", "GRAN-006" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001", "CQ-ASSEMBLY-001" ;
    lorsp:modelingDecisionReference "MD-DOC-001", "MD-PROV-002" .

lorsh:ProvisionCitationShape a sh:NodeShape ;
    sh:targetClass lorsp:ProvisionCitation ;
    sh:property [
        sh:path lorsp:citationText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "A provision citation must preserve one language-tagged source wording."@en
    ], [
        sh:path lorsp:refersToProvision ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "An approved provision citation must resolve to at least one legal provision."@en
    ] ;
    lorsp:requirementReference "SCOPE-001", "GRAN-006" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001", "CQ-EXCEPTION-001" ;
    lorsp:modelingDecisionReference "MD-REF-001" .

lorsh:SourceChunkShape a sh:NodeShape ;
    sh:targetClass lorsp:SourceChunk ;
    sh:property [
        sh:path lorsp:derivedFromFile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lorsp:SourceFile ;
        sh:message "A source chunk must identify exactly one source file."@en
    ] ;
    lorsp:requirementReference "PURP-003", "SCOPE-001" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001" ;
    lorsp:modelingDecisionReference "MD-PROV-001" .

lorsh:RegulatedConductShape a sh:NodeShape ;
    sh:targetClass loroc:RegulatedConduct ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue loroc:conductScheme ;
        sh:message "A regulated-conduct concept must belong to the regulated conduct scheme."@en
    ] ;
    lorsp:requirementReference "SCOPE-002", "GRAN-008" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-COMPARISON-001" ;
    lorsp:modelingDecisionReference "MD-CONDUCT-001" .

lorsh:SubjectKindShape a sh:NodeShape ;
    sh:targetClass loroc:SubjectKind ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue loroc:subjectKindScheme ;
        sh:message "A subject-kind concept must belong to the subject kind scheme."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-002" ;
    lorsp:competencyQuestionReference "CQ-APPLICABILITY-001", "CQ-COMPARISON-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001" .

lorsh:LegalSubjectRoleShape a sh:NodeShape ;
    sh:targetClass loroc:LegalSubjectRole ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue loroc:subjectRoleScheme ;
        sh:message "A legal-subject-role concept must belong to the subject role scheme."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-002" ;
    lorsp:competencyQuestionReference "CQ-APPLICABILITY-001", "CQ-POINTS-001", "CQ-REMEDY-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001" .

lorsh:VehicleCategoryShape a sh:NodeShape ;
    sh:targetClass loroc:VehicleCategory ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue loroc:vehicleCategoryScheme ;
        sh:message "A vehicle-category concept must belong to the vehicle category scheme."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-003" ;
    lorsp:competencyQuestionReference "CQ-APPLICABILITY-001", "CQ-COMPARISON-001" ;
    lorsp:modelingDecisionReference "MD-VEHICLE-001" .

lorsh:ConceptHierarchyShape a sh:NodeShape ;
    sh:targetSubjectsOf skos:broader ;
    sh:property [
        sh:path skos:broader ;
        sh:class skos:Concept ;
        sh:message "Every reviewed broader target must remain a controlled SKOS concept."@en
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A canonical concept hierarchy must not contain a broader cycle."@en ;
        sh:select """
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this
            WHERE {
                $this skos:broader+ $this .
            }
        """
    ] ;
    lorsp:requirementReference "GRAN-002", "GRAN-003", "GRAN-008" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-APPLICABILITY-001", "CQ-COMPARISON-001" ;
    lorsp:modelingDecisionReference "MD-CONDUCT-001", "MD-SUBJECT-001", "MD-VEHICLE-001" .

lorsh:LegalSubjectShape a sh:NodeShape ;
    sh:targetClass loroc:LegalSubject ;
    sh:property [
        sh:path loroc:hasSubjectKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:SubjectKind ;
        sh:message "A legal subject must have exactly one controlled subject kind in approved pilot data."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-002" ;
    lorsp:competencyQuestionReference "CQ-APPLICABILITY-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001" .

lorsh:RoleAssignmentShape a sh:NodeShape ;
    sh:targetClass loroc:RoleAssignment ;
    sh:property [
        sh:path loroc:rolePlayer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:LegalSubject ;
        sh:message "A role assignment must identify exactly one legal subject."@en
    ], [
        sh:path loroc:playsRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:LegalSubjectRole ;
        sh:message "A role assignment must identify exactly one contextual role."@en
    ], [
        sh:path loroc:inOccurrence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:ConductOccurrence ;
        sh:message "A role assignment must be scoped to exactly one conduct occurrence."@en
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-003", "GRAN-002" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-APPLICABILITY-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001" .

lorsh:VehicleShape a sh:NodeShape ;
    sh:targetClass loroc:Vehicle ;
    sh:property [
        sh:path loroc:hasVehicleCategory ;
        sh:minCount 1 ;
        sh:class loroc:VehicleCategory ;
        sh:message "A concrete vehicle must have at least one legally relevant vehicle category."@en
    ] ;
    lorsp:requirementReference "SCOPE-003", "GRAN-003" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-APPLICABILITY-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-VEHICLE-001" .

lorsh:ConductOccurrenceShape a sh:NodeShape ;
    sh:targetClass loroc:ConductOccurrence ;
    sh:property [
        sh:path loroc:hasConductConcept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:RegulatedConduct ;
        sh:message "A conduct occurrence must have exactly one normalized conduct concept in approved pilot data."@en
    ], [
        sh:path [ sh:inversePath loroc:inOccurrence ] ;
        sh:minCount 1 ;
        sh:class loroc:RoleAssignment ;
        sh:message "A conduct occurrence must have at least one contextual role assignment."@en
    ], [
        sh:path loroc:involvesVehicle ;
        sh:maxCount 1 ;
        sh:class loroc:Vehicle ;
        sh:message "A pilot conduct occurrence may identify at most one concrete vehicle."@en
    ], [
        sh:path loroc:occursAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "A conduct occurrence must have exactly one occurrence-time instant."@en
    ] ;
    lorsp:requirementReference "PURP-001", "PURP-002", "SCOPE-002", "SCOPE-003", "SCOPE-006" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-TEMPORAL-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-CONDUCT-001", "MD-SUBJECT-001", "MD-VEHICLE-001", "MD-TIME-001" .

lorsh:TimeInstantShape a sh:NodeShape ;
    sh:targetClass time:Instant ;
    sh:xone (
        [
            sh:property [
                sh:path time:inXSDDateTime ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:dateTime
            ], [
                sh:path time:inXSDDateTimeStamp ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path time:inXSDDateTimeStamp ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:dateTimeStamp
            ], [
                sh:path time:inXSDDateTime ;
                sh:maxCount 0
            ]
        ]
    ) ;
    sh:message "A pilot time instant must have exactly one supported XSD date-time representation."@en ;
    lorsp:requirementReference "PURP-001", "USE-004", "SCOPE-006", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-TIME-001", "MD-CHANGE-001" .

lorsh:ValidityAssignmentShape a sh:NodeShape ;
    sh:targetSubjectsOf lortc:validDuring ;
    sh:property [
        sh:path lortc:validDuring ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lortc:ValidityInterval ;
        sh:message "An approved rule or expression must have exactly one verified validity interval."@en
    ] ;
    lorsp:requirementReference "PURP-001", "USE-004", "SCOPE-006", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-TIME-001", "MD-RULE-001" .

lorsh:ValidityIntervalShape a sh:NodeShape ;
    sh:targetClass lortc:ValidityInterval ;
    sh:property [
        sh:path time:hasBeginning ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "A validity interval must have exactly one verified beginning instant."@en
    ], [
        sh:path time:hasEnd ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "A validity interval may have at most one verified end instant; omission means unknown."@en
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A known validity end must not precede the validity beginning."@en ;
        sh:select """
            PREFIX time: <http://www.w3.org/2006/time#>
            SELECT $this ?beginning ?end
            WHERE {
                $this time:hasBeginning/time:inXSDDateTime ?beginning ;
                    time:hasEnd/time:inXSDDateTime ?end .
                FILTER (?end < ?beginning)
            }
        """
    ] ;
    lorsp:requirementReference "PURP-001", "USE-004", "SCOPE-006", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-TIME-001" .

lorsh:LegalChangeTypeShape a sh:NodeShape ;
    sh:targetClass lortc:LegalChangeType ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue lortc:legalChangeTypeScheme ;
        sh:message "A legal-change type must belong to the controlled legal change type scheme."@en
    ] ;
    lorsp:requirementReference "USE-004", "SCOPE-006" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-CHANGE-001" .

lorsh:LegalChangeShape a sh:NodeShape ;
    sh:targetClass lortc:LegalChange ;
    sh:property [
        sh:path lortc:changeType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lortc:LegalChangeType ;
        sh:message "A legal change must have exactly one controlled change type."@en
    ], [
        sh:path lortc:effectiveAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class time:Instant ;
        sh:message "A legal change must have exactly one verified effective instant."@en
    ], [
        sh:path lortc:changesEarlierRule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A legal change must identify exactly one earlier rule version."@en
    ], [
        sh:path lortc:producesLaterRule ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A legal change may identify at most one later rule version; repeal may identify none."@en
    ], [
        sh:path lorsp:groundedIn ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "A legal change must be grounded in at least one authoritative provision."@en
    ], [
        sh:path lorsp:sourcedFromChunk ;
        sh:minCount 1 ;
        sh:class lorsp:SourceChunk ;
        sh:message "A legal change must identify at least one source chunk."@en
    ] ;
    lorsp:requirementReference "PURP-001", "PURP-003", "USE-004", "SCOPE-006", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-TEMPORAL-001", "CQ-TEMPORAL-002" ;
    lorsp:modelingDecisionReference "MD-TIME-001", "MD-CHANGE-001", "MD-RULE-001" .

lorsh:PenaltyRuleShape a sh:NodeShape ;
    sh:targetClass lornr:PenaltyRule ;
    sh:property [
        sh:path lornr:hasConductSpecification ;
        sh:minCount 1 ;
        sh:class lornr:ConductSpecification ;
        sh:message "A penalty rule must have at least one evidenced conduct specification."@en
    ], [
        sh:path lornr:hasApplicability ;
        sh:minCount 1 ;
        sh:class lornr:ApplicabilityProfile ;
        sh:message "A penalty rule must have at least one applicability profile."@en
    ], [
        sh:path lorlc:imposesConsequence ;
        sh:minCount 1 ;
        sh:class lorlc:LegalConsequence ;
        sh:message "A penalty rule must impose at least one independently evidenced legal consequence."@en
    ], [
        sh:path lortc:validDuring ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lortc:ValidityInterval ;
        sh:message "A penalty-rule version must have exactly one verified validity interval."@en
    ], [
        sh:path lorsp:groundedIn ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "A penalty rule must be grounded in at least one authoritative provision."@en
    ], [
        sh:path lorsp:sourcedFromChunk ;
        sh:minCount 1 ;
        sh:class lorsp:SourceChunk ;
        sh:message "A penalty rule must identify at least one source chunk."@en
    ] ;
    lorsp:requirementReference "PURP-001", "PURP-002", "PURP-003", "USE-001", "USE-002", "SCOPE-002", "SCOPE-003", "SCOPE-004", "SCOPE-006", "GRAN-001", "GRAN-007" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-SOURCE-001", "CQ-TEMPORAL-001", "CQ-ASSEMBLY-001" ;
    lorsp:modelingDecisionReference "MD-RULE-001", "MD-RULE-002", "MD-PROV-001", "MD-TIME-001" .

lorsh:RuleComponentShape a sh:NodeShape ;
    sh:targetClass lornr:RuleComponent ;
    sh:property [
        sh:path lorsp:groundedIn ;
        sh:minCount 1 ;
        sh:class lorsp:LegalProvision ;
        sh:message "A material rule component must be grounded in at least one authoritative provision."@en
    ], [
        sh:path lorsp:sourcedFromChunk ;
        sh:minCount 1 ;
        sh:class lorsp:SourceChunk ;
        sh:message "A material rule component must identify at least one source chunk."@en
    ] ;
    lorsp:requirementReference "PURP-003", "GRAN-004", "GRAN-006" ;
    lorsp:competencyQuestionReference "CQ-SOURCE-001", "CQ-ASSEMBLY-001" ;
    lorsp:modelingDecisionReference "MD-RULE-002", "MD-PROV-001", "MD-PROV-002" .

lorsh:ConductSpecificationShape a sh:NodeShape ;
    sh:targetClass lornr:ConductSpecification ;
    sh:property [
        sh:path lornr:usesConductConcept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class loroc:RegulatedConduct ;
        sh:message "A conduct specification must use exactly one reviewed regulated-conduct concept."@en
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-002", "GRAN-001", "GRAN-008" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-COMPARISON-001", "CQ-ASSEMBLY-001" ;
    lorsp:modelingDecisionReference "MD-RULE-002", "MD-CONDUCT-001" .

lorsh:ApplicabilityProfileShape a sh:NodeShape ;
    sh:targetClass lornr:ApplicabilityProfile ;
    sh:property [
        sh:path lornr:requiresSubjectKind ;
        sh:maxCount 1 ;
        sh:class loroc:SubjectKind ;
        sh:message "An applicability profile may require at most one controlled subject kind."@en
    ], [
        sh:path lornr:requiresRole ;
        sh:class loroc:LegalSubjectRole ;
        sh:message "Every required role must be a controlled legal-subject-role concept."@en
    ], [
        sh:path lornr:requiresVehicleCategory ;
        sh:class loroc:VehicleCategory ;
        sh:message "Every required vehicle category must be a controlled vehicle-category concept."@en
    ], [
        sh:path lornr:hasConditionExpression ;
        sh:maxCount 1 ;
        sh:class lornr:ConditionExpression ;
        sh:message "An applicability profile may have at most one root condition expression."@en
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-003", "SCOPE-004", "GRAN-002", "GRAN-003", "GRAN-004" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-APPLICABILITY-001", "CQ-CONDITION-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-SUBJECT-001", "MD-VEHICLE-001", "MD-COND-001" .

lorsh:ConditionExpressionShape a sh:NodeShape ;
    sh:targetClass lornr:ConditionExpression ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A condition-expression tree must not contain an operand cycle."@en ;
        sh:select """
            PREFIX lornr: <https://w3id.org/legal-ontology-rag/ontology/normative-rule#>
            SELECT $this
            WHERE {
                $this lornr:hasOperand+ $this .
            }
        """
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-004", "GRAN-004" ;
    lorsp:competencyQuestionReference "CQ-CONDITION-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-COND-001" .

lorsh:AtomicConditionShape a sh:NodeShape ;
    sh:targetClass lornr:AtomicCondition ;
    sh:property [
        sh:path lornr:hasOperand ;
        sh:maxCount 0 ;
        sh:message "An atomic condition must not have condition-expression operands."@en
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-004", "GRAN-004" ;
    lorsp:competencyQuestionReference "CQ-RULE-001", "CQ-CONDITION-001" ;
    lorsp:modelingDecisionReference "MD-COND-001" .

lorsh:AllOfShape a sh:NodeShape ;
    sh:targetClass lornr:AllOf ;
    sh:property [
        sh:path lornr:hasOperand ;
        sh:minCount 2 ;
        sh:class lornr:ConditionExpression ;
        sh:message "An AllOf expression must have at least two condition-expression operands."@en
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-004", "GRAN-004" ;
    lorsp:competencyQuestionReference "CQ-CONDITION-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-COND-001" .

lorsh:AnyOfShape a sh:NodeShape ;
    sh:targetClass lornr:AnyOf ;
    sh:property [
        sh:path lornr:hasOperand ;
        sh:minCount 2 ;
        sh:class lornr:ConditionExpression ;
        sh:message "An AnyOf expression must have at least two condition-expression operands."@en
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-004", "GRAN-004" ;
    lorsp:competencyQuestionReference "CQ-CONDITION-001", "CQ-NEGATIVE-001" ;
    lorsp:modelingDecisionReference "MD-COND-001" .

lorsh:NotShape a sh:NodeShape ;
    sh:targetClass lornr:Not ;
    sh:property [
        sh:path lornr:hasOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lornr:ConditionExpression ;
        sh:message "A Not expression must have exactly one condition-expression operand."@en
    ] ;
    lorsp:requirementReference "PURP-002", "SCOPE-004", "GRAN-004" ;
    lorsp:competencyQuestionReference "CQ-CONDITION-001", "CQ-NEGATIVE-001", "CQ-EXCEPTION-001" ;
    lorsp:modelingDecisionReference "MD-COND-001", "MD-EXCEPTION-001" .

lorsh:LegalExceptionShape a sh:NodeShape ;
    sh:targetClass lornr:LegalException ;
    sh:property [
        sh:path lornr:exceptionTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lornr:PenaltyRule ;
        sh:message "A legal exception must identify exactly one general penalty-rule version."@en
    ], [
        sh:path lornr:citesExcludedProvision ;
        sh:class lorsp:LegalProvision ;
        sh:message "Every excluded citation target must be a resolved legal provision."@en
    ], [
        sh:path lornr:hasProvisionCitation ;
        sh:class lorsp:ProvisionCitation ;
        sh:message "Every grouped exception citation must be a resolved provision-citation object."@en
    ], [
        sh:path lornr:redirectsTo ;
        sh:class lornr:PenaltyRule ;
        sh:message "Every exception redirect must target a verified penalty-rule version."@en
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The general penalty rule must link back to its legal exception."@en ;
        sh:select """
            PREFIX lornr: <https://w3id.org/legal-ontology-rag/ontology/normative-rule#>
            SELECT $this ?generalRule
            WHERE {
                $this lornr:exceptionTo ?generalRule .
                FILTER NOT EXISTS { ?generalRule lornr:hasException $this }
            }
        """
    ] ;
    lorsp:requirementReference "PURP-002", "PURP-003", "SCOPE-004", "SCOPE-006", "GRAN-004", "GRAN-006" ;
    lorsp:competencyQuestionReference "CQ-EXCEPTION-001", "CQ-SOURCE-001", "CQ-TEMPORAL-001", "CQ-ASSEMBLY-001" ;
    lorsp:modelingDecisionReference "MD-EXCEPTION-001", "MD-REF-001", "MD-PROV-001" .

lorsh:LegalConsequenceShape a sh:NodeShape ;
    sh:targetClass lorlc:LegalConsequence ;
    sh:or (
        [ sh:class lorlc:MonetaryPenalty ]
        [ sh:class lorlc:PointDeduction ]
        [ sh:class lorlc:AdditionalSanction ]
        [ sh:class lorlc:RemedialMeasure ]
    ) ;
    sh:property [
        sh:path [ sh:inversePath lorlc:imposesConsequence ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lornr:PenaltyRule ;
        sh:message "An approved legal consequence must belong to exactly one penalty rule."@en
    ], [
        sh:path lorlc:affectsTarget ;
        sh:class lorlc:ConsequenceTarget ;
        sh:message "Every affected object must be represented as a consequence target."@en
    ] ;
    sh:message "An approved legal consequence must have one source-supported V0.1 consequence subtype."@en ;
    lorsp:requirementReference "PURP-003", "USE-002", "SCOPE-005", "GRAN-001", "GRAN-005" ;
    lorsp:competencyQuestionReference "CQ-CONSEQUENCE-001", "CQ-SOURCE-001", "CQ-ASSEMBLY-001" ;
    lorsp:modelingDecisionReference "MD-CONSEQUENCE-001", "MD-CONSEQUENCE-002", "MD-PROV-001" .

lorsh:MonetaryPenaltyShape a sh:NodeShape ;
    sh:targetClass lorlc:MonetaryPenalty ;
    sh:property [
        sh:path lorlc:hasAmountRange ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lorlc:MonetaryAmountRange ;
        sh:message "A monetary penalty must have exactly one normalized monetary amount range."@en
    ] ;
    lorsp:requirementReference "USE-002", "SCOPE-005", "GRAN-005" ;
    lorsp:competencyQuestionReference "CQ-PENALTY-001", "CQ-CONSEQUENCE-001" ;
    lorsp:modelingDecisionReference "MD-CONSEQUENCE-001", "MD-CONSEQUENCE-002" .

lorsh:MonetaryAmountRangeShape a sh:NodeShape ;
    sh:targetClass lorlc:MonetaryAmountRange ;
    sh:property [
        sh:path lorlc:minimumAmount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "A monetary range must have exactly one normalized decimal lower bound."@en
    ], [
        sh:path lorlc:maximumAmount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "A monetary range must have exactly one normalized decimal upper bound."@en
    ], [
        sh:path lorlc:currency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lorlc:Currency ;
        sh:message "A monetary range must identify exactly one controlled currency."@en
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The maximum monetary amount must not be lower than the minimum amount."@en ;
        sh:select """
            PREFIX lorlc: <https://w3id.org/legal-ontology-rag/ontology/legal-consequence#>
            SELECT $this ?minimum ?maximum
            WHERE {
                $this lorlc:minimumAmount ?minimum ;
                    lorlc:maximumAmount ?maximum .
                FILTER (?maximum < ?minimum)
            }
        """
    ] ;
    lorsp:requirementReference "USE-002", "SCOPE-005", "GRAN-005" ;
    lorsp:competencyQuestionReference "CQ-PENALTY-001" ;
    lorsp:modelingDecisionReference "MD-CONSEQUENCE-001" .

lorsh:CurrencyShape a sh:NodeShape ;
    sh:targetClass lorlc:Currency ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue lorlc:currencyScheme ;
        sh:message "A currency concept must belong to the controlled currency scheme."@en
    ] ;
    lorsp:requirementReference "USE-002", "SCOPE-005", "GRAN-005" ;
    lorsp:competencyQuestionReference "CQ-PENALTY-001" ;
    lorsp:modelingDecisionReference "MD-CONSEQUENCE-001" .

lorsh:PointDeductionShape a sh:NodeShape ;
    sh:targetClass lorlc:PointDeduction ;
    sh:property [
        sh:path lorlc:pointValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minExclusive 0 ;
        sh:message "A point deduction must have exactly one positive integer point value."@en
    ], [
        sh:path lorlc:affectsTarget ;
        sh:minCount 1 ;
        sh:class lorlc:ConsequenceTarget ;
        sh:message "A point deduction must identify at least one affected driver-license target."@en
    ] ;
    lorsp:requirementReference "PURP-002", "USE-002", "SCOPE-003", "SCOPE-005", "GRAN-002", "GRAN-005" ;
    lorsp:competencyQuestionReference "CQ-POINTS-001", "CQ-CONSEQUENCE-001" ;
    lorsp:modelingDecisionReference "MD-CONSEQUENCE-001", "MD-CONSEQUENCE-002" .

lorsh:AdditionalSanctionShape a sh:NodeShape ;
    sh:targetClass lorlc:AdditionalSanction ;
    sh:property [
        sh:path lorlc:affectsTarget ;
        sh:minCount 1 ;
        sh:class lorlc:ConsequenceTarget ;
        sh:message "An additional sanction must identify at least one affected target in approved pilot data."@en
    ], [
        sh:path lorlc:minimumDurationMonths ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:lessThanOrEquals lorlc:maximumDurationMonths ;
        sh:message "An additional-sanction lower duration must be a positive month value not above its upper bound."@en
    ], [
        sh:path lorlc:maximumDurationMonths ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "An additional-sanction upper duration must be a positive month value."@en
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An additional-sanction duration must provide both month bounds or neither."@en ;
        sh:select """
            PREFIX lorlc: <https://w3id.org/legal-ontology-rag/ontology/legal-consequence#>
            SELECT $this
            WHERE {
                OPTIONAL { $this lorlc:minimumDurationMonths ?minimum . }
                OPTIONAL { $this lorlc:maximumDurationMonths ?maximum . }
                FILTER(BOUND(?minimum) != BOUND(?maximum))
            }
        """
    ] ;
    lorsp:requirementReference "USE-002", "SCOPE-005", "GRAN-005" ;
    lorsp:competencyQuestionReference "CQ-ADDITIONAL-001", "CQ-CONSEQUENCE-001" ;
    lorsp:modelingDecisionReference "MD-CONSEQUENCE-001", "MD-CONSEQUENCE-002" .

lorsh:RemedialMeasureShape a sh:NodeShape ;
    sh:targetClass lorlc:RemedialMeasure ;
    sh:property [
        sh:path lorlc:affectsTarget ;
        sh:minCount 1 ;
        sh:class lorlc:ConsequenceTarget ;
        sh:message "A remedial measure must identify at least one affected target in approved pilot data."@en
    ], [
        sh:path lorlc:mustBePerformedBy ;
        sh:minCount 1 ;
        sh:class loroc:LegalSubjectRole ;
        sh:message "A remedial measure must identify at least one responsible legal-subject role."@en
    ] ;
    lorsp:requirementReference "PURP-002", "USE-002", "SCOPE-003", "SCOPE-004", "SCOPE-005", "GRAN-002", "GRAN-005" ;
    lorsp:competencyQuestionReference "CQ-REMEDY-001", "CQ-CONSEQUENCE-001" ;
    lorsp:modelingDecisionReference "MD-CONSEQUENCE-001", "MD-CONSEQUENCE-002", "MD-SUBJECT-001" .
