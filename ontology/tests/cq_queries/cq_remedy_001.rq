PREFIX lorlc: <https://w3id.org/legal-ontology-rag/ontology/legal-consequence#>
PREFIX lornr: <https://w3id.org/legal-ontology-rag/ontology/normative-rule#>
PREFIX lorsp: <https://w3id.org/legal-ontology-rag/ontology/source-provenance#>

SELECT DISTINCT ?penaltyRule ?remedialMeasure ?responsibleRole ?affectedTarget ?conditionExpression ?sourceProvision
WHERE {
  ?penaltyRule lorlc:imposesConsequence ?remedialMeasure .
  ?remedialMeasure a lorlc:RemedialMeasure ;
    lorlc:mustBePerformedBy ?responsibleRole ;
    lorlc:affectsTarget ?affectedTarget ;
    lorsp:groundedIn ?sourceProvision .
  OPTIONAL { ?penaltyRule lornr:hasApplicability/lornr:hasConditionExpression ?conditionExpression }
}
ORDER BY ?penaltyRule ?remedialMeasure ?affectedTarget
