PREFIX lorsp: <https://w3id.org/legal-ontology-rag/ontology/source-provenance#>

# Source/provenance projection. RuleComponent bindings are added with the normative-rule module.
SELECT DISTINCT ?assertion ?provision ?provisionPath ?expression ?resource
WHERE {
  ?assertion a lorsp:SupportedAssertion ;
    lorsp:groundedIn ?provision .
  ?expression a lorsp:LegalExpression ;
    lorsp:containsProvision ?provision .
  ?resource a lorsp:LegalResource ;
    lorsp:hasExpression ?expression .
  OPTIONAL { ?provision lorsp:structuralPath ?provisionPath }
}
ORDER BY ?resource ?expression ?provision ?assertion
