PREFIX lornr: <https://w3id.org/legal-ontology-rag/ontology/normative-rule#>
PREFIX lorsp: <https://w3id.org/legal-ontology-rag/ontology/source-provenance#>

SELECT DISTINCT ?generalRule ?legalException ?provisionCitation ?citationText ?citedExcludedProvision ?redirectedRule ?sourceChunk
WHERE {
  ?generalRule lornr:hasException ?legalException .
  ?legalException a lornr:LegalException ;
    lornr:exceptionTo ?generalRule ;
    lorsp:sourcedFromChunk ?sourceChunk .
  OPTIONAL { ?legalException lornr:citesExcludedProvision ?citedExcludedProvision }
  OPTIONAL {
    ?legalException lornr:hasProvisionCitation ?provisionCitation .
    ?provisionCitation lorsp:citationText ?citationText ;
      lorsp:refersToProvision ?citedExcludedProvision .
  }
  OPTIONAL { ?legalException lornr:redirectsTo ?redirectedRule }
}
ORDER BY ?generalRule ?legalException ?provisionCitation ?citedExcludedProvision ?redirectedRule
