PREFIX lorsp: <https://w3id.org/legal-ontology-rag/ontology/source-provenance#>

# Source/provenance projection. RuleComponent bindings are added with the normative-rule module.
SELECT DISTINCT ?assertion ?evidenceSpan ?exactText ?sourceChunk ?sourceFile ?provision
WHERE {
  ?assertion a lorsp:SupportedAssertion ;
    lorsp:supportedBy ?evidenceSpan .
  ?sourceChunk a lorsp:SourceChunk ;
    lorsp:containsSpan ?evidenceSpan ;
    lorsp:derivedFromFile ?sourceFile .
  ?evidenceSpan lorsp:exactText ?exactText .
  OPTIONAL { ?assertion lorsp:groundedIn ?provision }
}
ORDER BY ?assertion ?evidenceSpan ?sourceChunk
