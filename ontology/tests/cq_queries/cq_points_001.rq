PREFIX lorlc: <https://w3id.org/legal-ontology-rag/ontology/legal-consequence#>
PREFIX lornr: <https://w3id.org/legal-ontology-rag/ontology/normative-rule#>
PREFIX lorsp: <https://w3id.org/legal-ontology-rag/ontology/source-provenance#>

SELECT DISTINCT ?penaltyRule ?pointDeduction ?pointValue ?affectedLicense ?requiredRole ?sourceProvision
WHERE {
  ?penaltyRule lorlc:imposesConsequence ?pointDeduction ;
    lornr:hasApplicability/lornr:requiresRole ?requiredRole .
  ?pointDeduction a lorlc:PointDeduction ;
    lorlc:pointValue ?pointValue ;
    lorlc:affectsTarget ?affectedLicense ;
    lorsp:groundedIn ?sourceProvision .
}
ORDER BY ?penaltyRule ?pointDeduction
