@prefix ex: <https://w3id.org/legal-ontology-rag/test/temporal-change#> .
@prefix lorlc: <https://w3id.org/legal-ontology-rag/ontology/legal-consequence#> .
@prefix loroc: <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#> .
@prefix lornr: <https://w3id.org/legal-ontology-rag/ontology/normative-rule#> .
@prefix lorsp: <https://w3id.org/legal-ontology-rag/ontology/source-provenance#> .
@prefix lortc: <https://w3id.org/legal-ontology-rag/ontology/temporal-change#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ruleResource a lorsp:LegalResource ;
    lorsp:hasExpression ex:earlierExpression,
        ex:laterExpression .

ex:earlierExpression a lorsp:LegalExpression ;
    lorsp:representedBy ex:earlierFile ;
    lorsp:containsProvision ex:earlierProvision .

ex:laterExpression a lorsp:LegalExpression ;
    lorsp:representedBy ex:laterFile ;
    lorsp:containsProvision ex:laterProvision .

ex:amendingResource a lorsp:LegalResource ;
    lorsp:hasExpression ex:amendingExpression .

ex:amendingExpression a lorsp:LegalExpression ;
    lorsp:representedBy ex:amendingFile ;
    lorsp:containsProvision ex:amendingProvision .

ex:earlierFile a lorsp:SourceFile .

ex:laterFile a lorsp:SourceFile .

ex:amendingFile a lorsp:SourceFile .

ex:earlierProvision a lorsp:LegalProvision ;
    lorsp:structuralPath "NĐ 168 Article 13(8)(b), original expression" .

ex:laterProvision a lorsp:LegalProvision ;
    lorsp:structuralPath "NĐ 168 Article 13(8)(b), amended expression" .

ex:amendingProvision a lorsp:LegalProvision ;
    lorsp:structuralPath "NĐ 238 Article 3" .

ex:earlierChunk a lorsp:SourceChunk ;
    lorsp:derivedFromFile ex:earlierFile .

ex:laterChunk a lorsp:SourceChunk ;
    lorsp:derivedFromFile ex:laterFile .

ex:amendingChunk a lorsp:SourceChunk ;
    lorsp:derivedFromFile ex:amendingFile .

ex:earlierRuleVersion a lornr:PenaltyRule ;
    lornr:hasConductSpecification ex:earlierConductSpecification ;
    lornr:hasApplicability ex:earlierApplicabilityProfile ;
    lorlc:imposesConsequence ex:earlierAdditionalSanction ;
    lorsp:groundedIn ex:earlierProvision ;
    lorsp:sourcedFromChunk ex:earlierChunk ;
    lortc:validDuring ex:earlierInterval .

ex:laterRuleVersion a lornr:PenaltyRule ;
    lornr:hasConductSpecification ex:laterConductSpecification ;
    lornr:hasApplicability ex:laterApplicabilityProfile ;
    lorlc:imposesConsequence ex:laterAdditionalSanction ;
    lorsp:groundedIn ex:laterProvision ;
    lorsp:sourcedFromChunk ex:laterChunk ;
    lortc:validDuring ex:laterInterval .

ex:earlierConductSpecification a lornr:ConductSpecification ;
    lornr:usesConductConcept ex:noPlateConduct ;
    lorsp:groundedIn ex:earlierProvision ;
    lorsp:sourcedFromChunk ex:earlierChunk .

ex:laterConductSpecification a lornr:ConductSpecification ;
    lornr:usesConductConcept ex:noPlateConduct ;
    lorsp:groundedIn ex:laterProvision ;
    lorsp:sourcedFromChunk ex:laterChunk .

ex:earlierApplicabilityProfile a lornr:ApplicabilityProfile ;
    lornr:requiresRole ex:driverRole ;
    lorsp:groundedIn ex:earlierProvision ;
    lorsp:sourcedFromChunk ex:earlierChunk .

ex:laterApplicabilityProfile a lornr:ApplicabilityProfile ;
    lornr:requiresRole ex:driverRole ;
    lorsp:groundedIn ex:laterProvision ;
    lorsp:sourcedFromChunk ex:laterChunk .

ex:earlierAdditionalSanction a lorlc:AdditionalSanction ;
    lorlc:affectsTarget ex:earlierTarget ;
    lorsp:groundedIn ex:earlierProvision ;
    lorsp:sourcedFromChunk ex:earlierChunk .

ex:laterAdditionalSanction a lorlc:AdditionalSanction ;
    lorlc:affectsTarget ex:laterTarget ;
    lorsp:groundedIn ex:laterProvision ;
    lorsp:sourcedFromChunk ex:laterChunk .

ex:earlierTarget a lorlc:ConsequenceTarget .

ex:laterTarget a lorlc:ConsequenceTarget .

ex:earlierInterval a lortc:ValidityInterval ;
    time:hasBeginning ex:earlierBeginning ;
    time:hasEnd ex:earlierEnd .

ex:laterInterval a lortc:ValidityInterval ;
    time:hasBeginning ex:laterBeginning .

ex:earlierBeginning a time:Instant ;
    time:inXSDDateTime "2025-01-01T00:00:00Z"^^xsd:dateTime .

ex:earlierEnd a time:Instant ;
    time:inXSDDateTime "2026-08-15T00:00:00Z"^^xsd:dateTime .

ex:laterBeginning a time:Instant ;
    time:inXSDDateTime "2026-08-15T00:00:00Z"^^xsd:dateTime .

ex:changeEffectiveInstant a time:Instant ;
    time:inXSDDateTime "2026-08-15T00:00:00Z"^^xsd:dateTime .

ex:occurrenceInstant a time:Instant ;
    time:inXSDDateTime "2026-08-16T09:00:00Z"^^xsd:dateTime .

ex:noPlateConduct a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không gắn biển số"@vi .

ex:driverRole a loroc:LegalSubjectRole ;
    skos:inScheme loroc:subjectRoleScheme ;
    skos:prefLabel "Người điều khiển xe"@vi .

ex:subject a loroc:LegalSubject ;
    loroc:hasSubjectKind loroc:naturalPerson .

ex:occurrence a loroc:ConductOccurrence ;
    loroc:hasConductConcept ex:noPlateConduct ;
    loroc:occursAt ex:occurrenceInstant .

ex:roleAssignment a loroc:RoleAssignment ;
    loroc:rolePlayer ex:subject ;
    loroc:playsRole ex:driverRole ;
    loroc:inOccurrence ex:occurrence .

ex:explicitAmendment a lortc:LegalChange ;
    lortc:changeType lortc:amendment ;
    lortc:effectiveAt ex:changeEffectiveInstant ;
    lortc:changesEarlierRule ex:earlierRuleVersion ;
    lortc:producesLaterRule ex:laterRuleVersion ;
    lorsp:groundedIn ex:amendingProvision ;
    lorsp:sourcedFromChunk ex:amendingChunk .
