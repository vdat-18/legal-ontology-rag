{
  "schema_version": "1.9.0",
  "embedding_profile": "bge_m3",
  "embedding": {
    "batch_size": 64,
    "max_response_bytes": 16777216
  },
  "lexical_retrieval": {
    "vncorenlp_max_heap_megabytes": 512,
    "vncorenlp_timeout_seconds": 120
  },
  "llm_execution": {
    "max_retries": 2,
    "retry_delay_seconds": 120,
    "max_response_bytes": 1048576
  },
  "quality": {
    "bundle_overlap_threshold": 0.5
  },
  "stages": {
    "chunk_screening": {
      "batch_size": 50,
      "max_concurrency": 4,
      "max_output_tokens": 16384,
      "temperature": 0.0
    },
    "document_metadata": {
      "opening_chunk_count": 5,
      "closing_chunk_count": 5,
      "max_output_tokens": 1024,
      "temperature": 0.0
    },
    "fact_extraction": {
      "batch_size": 1,
      "max_concurrency": 4,
      "max_preceding_chunks": 2,
      "max_following_chunks": 1,
      "max_output_tokens": 32768,
      "temperature": 0.0
    },
    "evidence_relation": {
      "batch_size": 10,
      "max_concurrency": 10,
      "retrieval": {
        "retrieval_pool_size": 30,
        "max_candidates_per_fact": 10,
        "rrf_k": 60,
        "bm25": {
          "k1": 1.2,
          "b": 0.4,
          "delta": 0.5
        }
      },
      "max_output_tokens": 4096,
      "temperature": 0.0
    },
    "scenario_planning": {
      "batch_size": 10,
      "max_concurrency": 10,
      "max_output_tokens": 4096,
      "temperature": 0.0
    },
    "candidate_generation": {
      "batch_size": 5,
      "max_concurrency": 10,
      "max_output_tokens": 8192,
      "temperature": 0.0
    },
    "candidate_evolution": {
      "max_output_tokens": 8192,
      "temperature": 0.0
    }
  }
}
