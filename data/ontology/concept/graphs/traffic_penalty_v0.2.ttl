    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đeo thẻ tên của nhân viên phục vụ trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6032965e411a3b4fd0d11cbfaf21526263726d1bfff4fb1e91117ae74830fb24> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cho thuê phương tiện khi người thuê phương tiện để tự lái không có giấy phép lái xe đang còn điểm, còn hiệu lực phù hợp với loại xe cho thuê"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6042287c8a47ae0bfd5a3b8e4431ce7d717163e33a57f95b7134c2500ed7675e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng không có tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60787dd6bcdd9f24cc57f137d58ce4c2e6dc7c5d97db9937d755cbe2fb8e9d73> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tổ chức bán vé không kịp thời"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60dc1d69fe995318cd96f551ba94c5d281b2065550755b2006059c04a29f5e2d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60e310066f7026bfb018195b9865a685b15d7390ae07f65fdaba523ea40c478e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng có tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

