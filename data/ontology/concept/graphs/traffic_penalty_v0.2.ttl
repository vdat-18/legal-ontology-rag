    skos:prefLabel "Lắp đặt thiết bị thay đổi biển số trên xe trái quy định (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/99a35d5643a5d8fd8722a27724d9d84e273250042f83aafbfad9d7b619ed0e09> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng bàn trượt, pa-tanh, các thiết bị tương tự trên phần đường xe chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/99a5e600b7e75c5e2c16cf77b0d54d1a1f3e37fe3096b8b34194a24f65de52b2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xây dựng biển quảng cáo trong phạm vi hành lang an toàn đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/99c80c954d0988bd5a87054828c97047bb9712adcb7890c2067434c156834f9d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng chở không đúng loại hàng quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/99e36c9f9426ed82d1cd667f365e6060545efb8e0ce49baf6cd7ab36f3d25c10> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9a029d842120a3200239626e5f5cb1d23fbc71326039ba3bbec65b23153a2238> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi ngược chiều trên đường có biển “Cấm đi ngược chiều”, trừ các hành vi vi phạm quy định tại điểm đ khoản 11 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9a22effd21676ea4ad8452304b5291aa9fa2b53c4d6a40a99cd0c2b2de1fcd27> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cửa xe mở không bảo đảm an toàn gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9a572ccf22aca5323ae271fb3d510161833d414c8daa066120ea34d4bb54a1d1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Neo đậu tàu, thuyền dưới gầm cầu hoặc trong phạm vi hành lang an toàn cầu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9a611d9e07c331ca913e1b5e2df17cc4510e4c7713a50029ca3d59a0f56df0e5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9ab558a112da0bc4ffb79e0a552c49057b37e99f0cc6724a3046150cbe76a60c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9addd018b719e04b4ba81e82679c8b80fb82c73210fd6352882ce52c62eb3bdf> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy giao xe cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông (bao gồm cả trường hợp người điều khiển phương tiện có giấy phép lái xe nhưng đang trong thời gian bị tước quyền sử dụng)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9af1d7895729a4f616f8dff19846188563ec33d5da8da0948826ae86b5d08a39> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe, kể cả rơ moóc và sơ mi rơ moóc, sử dụng chất liệu khác sơn, dán lên chữ, số của biển số xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9b22673790303fa0d8b961628abfba719a5ecae662805a4b5136799d6ddbb133> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng trả hành khách quá thời gian quy định, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9b2cba7d3a6764e9c3129f974a0ea3402388e56397861f50817d92ba22ea4e2c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đón hành khách tại nơi cấm dừng, cấm đỗ hoặc nơi đường cong tầm nhìn bị che khuất, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9b4fdd3f4192a867e8c1afa61a79ae4461bf84a02ae0d3ce172a4043e771734b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không nhường đường cho xe xin vượt khi có đủ điều kiện an toàn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9b50a4db7e89278ea9e2cce331d1ee7cd384cc9007e6616efe84d363c29e127b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không nhường đường theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9b516b4a3a0b632e6473956f9bcc22b69d202d4ee2e6cbe313d0346343072dd9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phương tiện không thuộc quyền sử dụng hợp pháp để kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9b8c6b3f507934ce620907bae484bf427e0ec86f61dfddc1392de83a1a3e538c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đội “mũ bảo hiểm cho người đi mô tô, xe máy” khi điều khiển xe tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9bb9fda4deef033945b87c43177ff6918cd0086e09f1d8eff87e0075db88b76f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phù hiệu kiểm soát không do cơ quan có thẩm quyền cấp"@vi .

