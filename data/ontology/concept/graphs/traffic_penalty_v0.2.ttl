    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi vào đường cao tốc, trừ người phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f1d9c6f19deb393daa34e3c8286ccd93f167a86235cf1ee30464476a751f6d32> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe tham gia giao thông tại Việt Nam không có văn bản chấp thuận hoặc cấp phép của cơ quan có thẩm quyền cấp theo quy định (đối với loại xe tham gia giao thông tại Việt Nam có quy định phải được chấp thuận hoặc cấp phép)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f212d76e52e9454d79b87b6a3dfc58d79dd6fcf49c3798ed92c509756a1d38bc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không làm thủ tục cấp chứng nhận đăng ký xe, biển số xe trong trường hợp thay đổi chủ xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f275adea0bf5c688beef39f54d7d5f59867093f3795b6ce1549e42659b08cdc3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tái phạm hành vi quy định tại điểm h khoản 14 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f2835594b3c9646f7f3b8dba3d6eff99a2e031176f53db0f90ae31cee04b6f31> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển, dẫn dắt vật nuôi, điều khiển xe vật nuôi kéo đi vào đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f2a5e9e117bc43c14078fa845e4baf2c5dd2526dcc8f5afd64858a53d4f1306a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi xe bằng hai bánh đối với xe xích lô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f2b14e4e7f1d9ee282feea90d1a2b81af6d1d8dc667cf9e0b3ad4389f189f930> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bảo trì công trình hạ tầng kỹ thuật sử dụng chung với đường bộ gây ảnh hưởng đến an toàn công trình đường bộ, an toàn giao thông đường bộ hoặc cản trở công tác vận hành, khai thác, bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f2c234fe56a4ee2b4c8767b8ecb310e60565d3bfbb407d6863839e603c4b2b4d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kéo rơ moóc, sơ mi rơ moóc kéo thêm rơ moóc hoặc xe khác, vật khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3144596b4d1023fec79341cb2c4a485a688ffc9f9a4206629d64e8ae665ee4f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm hư hỏng công trình phụ trợ gắn liền với đường bộ, cấu kiện, phụ kiện của công trình đường bộ, trừ hành vi vi phạm tại khoản 4; điểm a, điểm c và điểm d khoản này"@vi .

