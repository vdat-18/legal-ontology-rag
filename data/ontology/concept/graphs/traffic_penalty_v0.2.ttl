    skos:prefLabel "Bố trí người trực tiếp điều hành hoạt động vận tải nhưng không đáp ứng đủ điều kiện theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae8dcc13092f0648a8a2b20ffaa3adf47f8d025f568ed840a85138403be763f9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có hệ thống chuyển hướng không bảo đảm tiêu chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae90355202d8fe129ac34a95d891217050d19995ece7d9ed5d7b537c30c0201b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe, bao gồm cả hàng hóa xếp trên xe và người được chở trên xe, vượt quá tải trọng cho phép của đường bộ trên 20% đến 50%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae9ddc2b190ddab75b65f0a3a682076f00c78fd710cc6107abd7d97e994c2457> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
