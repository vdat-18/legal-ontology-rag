<https://w3id.org/legal-ontology-rag/data/concept/conduct/d28776ce13909dda4b0996cea804f2a02f040e8d2ab5d5652b31eb7f5924d874> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe gắn biển số không rõ chữ, số của biển số xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d2d77f95900ee01d01ca055aba11e2daf2eee95081d4cf99779f715c2d02a3e4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trả hành khách không đúng nơi quy định trên những tuyến đường đã xác định nơi đón, trả khách, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d2d7961d905c5bbbd5cc9914cee484711a09cb90389cd23405212486aeb9f65b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d2f2fc0d81ab24ed45dc1371c59ae4d687feb26d803703418417f448c7805afb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe không sát mép đường phía bên phải theo chiều đi ở nơi đường có lề đường hẹp hoặc không có lề đường, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d2f7f1e3ef992523ffecd99b336a345c8b6aedb1dfed8560072ff0964011d121> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cải tạo xe ô tô loại khác thành xe ô tô chở người"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d305c1acd66d15a47838274e4a647b3538d91b06313c3786b79fc66d8642152b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe rẽ phải tại nơi có biển báo hiệu có nội dung cấm rẽ phải đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d36b4b6696bcd0c38cd83c6be49e69f3a0ed9f677070bee961e8ca85ab804d93> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d377f018f090a8a33fa5c434f7737236ba333723e015869f6ccd337395c41c29> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe, kể cả rơ moóc và sơ mi rơ moóc, gắn biển số bị che lấp."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d37ef3b7cd9c8fd10b3ab3524de9dc4c3303d9f8f73744012f3d3d17ef5f3f96> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dùng tay cầm và sử dụng điện thoại hoặc các thiết bị điện tử khác khi điều khiển phương tiện tham gia giao thông đang di chuyển trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d39ade6c524d486f97a2e4c780f0c037bd5253a58ad3c8bb6ef5abc203bcdef0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) mà không sử dụng cơ cấu khóa hãm công-ten-nơ với xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d3bf774fd3113ec18e8d1a44b639104b19a453597ca3abbcfb5d2b34b3aab16a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở loại hàng không đúng với thông tin ghi trong chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của rơ moóc, sơ mi rơ moóc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d3eb85e55b91f30784cb7ca202462f402bd69e5b812281e0aa37d8c8503fd2a2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe bố trí học viên tập lái trên xe tập lái vượt quá số lượng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d41ffc5a86a09992a56e4eb881d1b89caafe6932626ca38933455e2480080e56> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đặt, treo biển hiệu, bảng quảng cáo trên đất của đường bộ ở đoạn đường ngoài đô thị trừ việc đặt, treo biển hiệu, bảng quảng cáo tại lòng đường và trừ hành vi vi phạm quy định tại điểm a khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d42cb199e6a6ad6d6fe73d74fd4052fd1a122ab88aa9d47ba5bbc76d03886b3b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Nằm trên yên xe điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d4392225ef48b6da2a94bedd46cb3ce519fde66e6153ef31151beab07a9f726d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giáo viên dạy thực hành chạy không đúng tuyến đường trong giấy phép xe tập lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d4490cf4a51a99608b01f5cab6ccf945a80b75a7bd4fe5df76e6bf58c7a94ef2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
