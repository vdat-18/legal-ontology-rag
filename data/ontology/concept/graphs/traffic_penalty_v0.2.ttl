    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người được chở trên xe ô tô không thắt dây đai an toàn (tại vị trí có trang bị dây đai an toàn) khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7f81e8c548ab72b55fdceff5229374d6ce8f5d5ebda7129ab926b98e99050f63> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
