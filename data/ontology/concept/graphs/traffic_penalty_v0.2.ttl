    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không gắn biển số (đối với loại xe có quy định phải gắn biển số)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/92bea5ec9935c8cb253b5c7620e6104e10c259ba694734c842de0a724eea7044> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định trong giấy phép lưu hành, trừ các hành vi vi phạm quy định tại điểm a, điểm b khoản 3; điểm b, điểm c khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/92c172d1ae1145c8a1a10abcd7f7bb0043ea80b1cd4a678c3827a3748c069e91> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
