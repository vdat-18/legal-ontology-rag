    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng tiêu chuẩn chất lượng dịch vụ vận tải đã công bố."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c01f69707387aa7d342c807b420c69b848306308f6fe1d5803c7fd2cbd1c60c9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cấp lệnh vận chuyển, giấy vận tải cho lái xe nhưng không đúng theo quy định đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c044075466ebdf32bcb6da0f1ecc7e4d2826d5a70b08e55632bd7e3a8179ae42> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe taxi sử dụng phần mềm tính tiền mà trên xe không có thiết bị để kết nối trực tiếp với hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c0713fe30b5e466aeca1972ea6a350efd9cb920cea43ce4619bdbf95d6566553> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chở hành khách không có phù hiệu theo quy định"@vi .

