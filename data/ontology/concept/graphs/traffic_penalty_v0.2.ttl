    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cắt, hàn, tẩy xoá, đục sửa, đóng lại trái phép số khung, số động cơ (số máy)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0357eca80ebf98f262f0042ed689585de0d50c95aa6dd6aa295e8129a98f3bae> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để cản trở việc xử lý tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/035b443634a14b19cbac9ffb18cbf593dd134bb3ed4bbbf97bd1036a0acee0f4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bố trí lái xe cho người thuê phương tiện để tự lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0373e4b0ce84b5e54dc3b36665f0ffbb5fb588d0a5227c8726e7f7a5492ad074> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
