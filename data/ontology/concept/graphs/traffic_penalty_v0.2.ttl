    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên đường cao tốc không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f4324dc54d3704adf8e267659a2f3b5458c88562d28ef1978411d5a3c29b67dc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe không sát mép đường phía bên phải theo chiều đi ở nơi đường có lề đường hẹp hoặc không có lề đường, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f4683c14f42a03de46801242c321a4cb5a7633c50e6d7667d7c048cc158cbf89> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để tổ chức, cá nhân không có giấy phép kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ điều hành phương tiện và lái xe để vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f46afea82f7feccc1448983589ef96fa97c7b8cf079f2119e53a5a3fcbb3449c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
