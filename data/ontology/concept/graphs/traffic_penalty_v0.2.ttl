    skos:prefLabel "Điều khiển xe rẽ phải tại nơi có biển báo hiệu có nội dung cấm rẽ phải đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0010e7fcca206406615e525c54b185c8d329f9d4930b6c22013741e789ba52e5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không bố trí người cảnh báo, hướng dẫn giao thông khi thi công công trình trên đường bộ đang khai thác theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/003bbfa1bf036f8b9ad848eb1de62231854080514b58ca0831b944cb860727ac> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tuân thủ các quy định về dừng xe, đỗ xe tại nơi đường bộ giao nhau cùng mức với đường sắt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0081fcd6468a2498a912bc5e719def1a5e6dc84a5f85ae780f663a522376ef6b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dán lên chữ, số của biển số xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/009a5848a5752e20ed37c15cf7a3dbbb3d4b2b3df91a7a86ddf85761d9bc89d5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên dốc không chèn bánh, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00cdac5679932049c68c7eecda5380158f5ae1140019062885aae225685255e9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đấu nối trái phép vào đường chính, đường nhánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00fce75f7da9c6357a6483701cbd2169474fbd16801bbbbe10e440b80647828e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc tháo dỡ biển quảng cáo, các bộ phận của biển quảng cáo khi có yêu cầu của cơ quan quản lý đường bộ, người quản lý, sử dụng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/011925386ee1a2c4051b488bafd672601ef1b928836130acae9ab89903dee324> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đặt biển cảnh báo “Chú ý xe đỗ” theo quy định trong trường hợp gặp sự cố kỹ thuật (hoặc bất khả kháng khác) buộc phải đỗ xe chiếm một phần đường xe chạy hoặc tại nơi không được phép đỗ xe, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/014ca1114a1b39b71de31f7011d8c0a59b72fe1f58d6a021e6ade875c0c9f04c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phương tiện thuộc sở hữu của thành viên hợp tác xã để kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ mà không có hợp đồng dịch vụ giữa thành viên với hợp tác xã theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01768a417c5d9906838236cc6a91006fdcdb6f6c4806d59cf43aa2a76fef4985> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng trên xe phải chằng buộc mà không chằng buộc hoặc có chằng buộc nhưng không bảo đảm an toàn theo quy định, trừ hành vi vi phạm quy định tại khoản 10 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01947f7d9f435e452e08588a1a54d9075cf886fc3e8191a8fbc12ae54acadb2b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01a879bbd0323fee4086eb6c13b325d9468b865be87508c89c6eb6c87d191314> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không quy định quy trình nội bộ về kiểm tra, xử lý vi phạm, xử lý sự cố trong quá trình thực hiện thanh toán điện tử giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01b8b69d3fffb34a03e20dec840ee0c7ceaaf8dc80c337280cde0cf3b5cd27a8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 100% đến 150%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01bbec1a68ed17faed551607bec771285389795b31250c4dbf36a3b76c208e0e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không cấp lệnh vận chuyển, giấy vận tải cho lái xe đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01f626bfde175c12fd1a63de763b943caad449b99b7f25ba8a82207595545ee7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01f69ab8b3eba5583f52a320ffaabaacd1e912220ff9eae843a2b95f023c4598> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng hợp đồng điện tử không có giao diện phần mềm cung cấp cho hành khách hoặc người thuê vận tải theo quy định hoặc có nhưng giao diện không bảo đảm các yêu cầu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02123ce7185a18579c4182b9ddb93ebf78f549b756eec5ccda9cb278f31df442> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông (bao gồm cả trường hợp người điều khiển phương tiện có giấy phép lái xe nhưng đang trong thời gian bị tước quyền sử dụng)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0242fa73448e5f7276164c2bcbb45ec47b4406771aaa6972bd7106f20f43d967> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô giao phương tiện cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/026661aaf5b8b828561d65c60825538e842858f300fb88838b292a8c9b1dfc25> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý chuyển thẻ đầu cuối từ phương tiện này sang phương tiện khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02698b2cd67835cfbeffc73a26440be7460fdda387af89652536548099f9882d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Mở tài khoản giao thông nặc danh, mạo danh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/028c2b5015fd33c31d97e86b8e0f7cbefb86dd04547975475c67c81deb058414> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự"@vi .

