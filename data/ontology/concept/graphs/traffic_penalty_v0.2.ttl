    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/14a1ce17f3219b5f34c1b7e6bcd8907b4159e964c891ae2f1f0fd7866a1172c0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tuân thủ đúng quy định tại các quy trình, quy chuẩn kỹ thuật có liên quan trong chứng nhận, kiểm định xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/14a47e88fc8ab23548130925a42c003bae705ad30d61afc57206fbee9784b632> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thực hiện các hoạt động thể thao khác trái phép trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/14c38bfaa4cacf21973798dbeb277c6b6fcbf456ad45fb2081bf4322d3e7be81> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Ký hợp đồng để chở người trên xe bằng xe ô tô không kinh doanh vận tải hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/152e1c4b9ed3ecc618fa0a3acf5b4afe09616599087e46f8f1685e47560a5ffb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe, kể cả rơ moóc và sơ mi rơ moóc, không gắn biển số đối với loại xe có quy định phải gắn biển số."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/153055976a60af33e1a5669394def59ae60d29b8468d744a500c3e3fbb6d4919> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định về biển số, quy định về kẻ hoặc dán chữ, số biển số, thông tin trên thành xe, cửa xe (kể cả rơ moóc và sơ mi rơ moóc), trừ các hành vi vi phạm quy định tại điểm b, điểm c khoản 12; điểm d khoản 13 Điều này và các hành vi vi phạm quy định tại điểm b khoản 3 Điều 39 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/155f0fc72d1c30c0c46c15c977adc3be0ba98bba697976ed18efb94b3b9da664> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng chức trách, nhiệm vụ được phân công trong chứng nhận, kiểm định xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/155fb7753f09deed1b600adaf71ef7e047fe4e7d7947d063ebe5fe07ece31001> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để người ngồi trên xe khi xe xuống phà, đang trên phà và khi lên bến (trừ người lái xe, trẻ em, phụ nữ mang thai, người già yếu, người bệnh, người khuyết tật)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/158872d85142844ab1325b91fa867b4dac29611eb2ee8164340e1e856f56e8f0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy điều khiển xe gắn biển số không rõ chữ, số"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1593db997d826a9891f690fbcdf71f18e90b072a11952885bdb36c87cbcaf0df> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giao phương tiện để thực hiện hành vi vi phạm quy định tại điểm a khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/15ec216d1ab346453bca21dba62ad182e2416b0bb710bcaed4fd5d5fd1180c93> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/161b6a6c19aedd11b0f2a72000c109b5db9f5e1f32353ea795fd0406a99a1c3f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đáp ứng điều kiện về năng lực khi thẩm tra đối với dự án nhóm C, công trình đường bộ đang khai thác theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/162b4e9014dcddc3182d7c91e49ed1edc96f443b590ead08231554489d55206b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không nhường đường cho xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/16542df5de05d57fd345b01e41d989f3177f1faeefb6a0cb327b19e68e875237> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xây dựng biển quảng cáo trong phạm vi hành lang an toàn đường bộ mà không có văn bản chấp thuận theo quy định, trừ hành vi vi phạm quy định tại điểm d khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/165916db2542996bcde36a2bbe53a2474ae2f7d97e9d27399843ae338dd24a63> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đánh số thứ tự ghế ngồi, giường nằm trên xe ô tô chở hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1662d6bfa28744b18b123f53c245a62c5007b70d24f71c9f470167f703e97aee> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cản trở người, phương tiện tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1678ea676096ddee788fa2bf4cafefafb409618be8f5bdeba706cb2d33cc58fe> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1685da57e1dd547f8820cdc434a9b5c7656905874f76f32e38f1884a10734b9e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm là thuốc nổ, khí đốt, xăng, dầu và các chất dễ cháy, nổ, chất rắn khử nhạy khác đi qua các công trình hầm có chiều dài từ 100 mét trở lên"@vi .

