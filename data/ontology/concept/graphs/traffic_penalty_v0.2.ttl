    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc lưu trữ thông tin, dữ liệu từ thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e890f85644de007d41f0044792c70011339aa167e798b87af5856a8b913f6258> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
