    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người không có tên trong danh sách hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/104696c30ce1ced72908f00c6b017af61e5f1ced0e67b1ab93f63a51868d5f41> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có lập nhưng không cập nhật đầy đủ, chính xác lý lịch phương tiện, lý lịch hành nghề của lái xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/105ac1e7be2337252af467e62676bdd68147151aa04318613a8b6800a25f6be9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chiếm dụng đất của đường bộ hoặc đất hành lang an toàn đường bộ để xây dựng nhà ở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/10aeec7f52e54cdf03edbd15aeddb80cd569b62d989fa2f746e081fce53b27a4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở trẻ em dưới 10 tuổi và chiều cao dưới 1,35 mét trên xe ô tô ngồi cùng hàng ghế với người lái xe (trừ loại xe ô tô chỉ có một hàng ghế)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/10c5cf60423efeadee6c27b8044362c91c828096b419a2c3ebb0ab1a32ef0a46> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có hoặc không gắn phù hiệu theo quy định, có phù hiệu nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/113ca68e346009963d6f10ada8836f1254ea7de34a5e7fc36c9dcc9aff6d6bc8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý lấp mặt bằng trong phạm vi đất dành cho kết cấu hạ tầng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/11536883a40c517d20e20f2e52f0935063e52e30a0d33b5b917db6fda3db021e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm có giấy phép vận chuyển hàng hóa nguy hiểm nhưng hết hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/11853efb9977c72a482044036c9162eb043c2cbbae62f0c40cfddd5c03762a42> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có hoặc không đủ người quản lý trên mỗi xe ô tô theo quy định tại khoản 3 Điều 46 của Luật Trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/119ed3e92ab6657b5a0b665e539f0a90b95bf9210e1424e06923cc4e1f574200> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện quy trình đối soát"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/126cc256a6f89c5f696679accaff2e02a1691ca648c035ffb84fa32733b3c39d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/12beb06e7a2579e453320da40508461740e0b814bac36a9d2d755a8a9a645826> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có phù hiệu kiểm soát đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/12d670731ef1fb78763f64c6ddcbdb496c6547b36c27dd5b77890ddd10e91340> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức kinh doanh vận tải, dịch vụ hỗ trợ vận tải có phần mềm có ghi nhận đánh giá của khách hàng về chất lượng phục vụ của lái xe nhưng không gửi thông tin đến đơn vị kinh doanh vận tải theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/12db27aa24e1caa89e39f60f319089f2e41b3e3b09504b4d80ea11007114fcff> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trái quy định gây ùn tắc giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/12ec8e4a1aae82613a5137fbb4dae9d222cf2ac3ff85cff90a859aeefb25159b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện không có giấy chứng nhận kiểm định khí thải xe mô tô, xe gắn máy hoặc có nhưng đã hết hạn sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/12f8311ccf8171cbb7d487978b2f4f9b94b9c4258fe0cdfcd328be885a8a44ff> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không nhường đường cho xe xin vượt khi có đủ điều kiện an toàn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/12f8ec37e900462a14f314508a53f79a492beafd5a3d727b34cb5905409b69c9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy chở theo từ 03 người trở lên trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/130b8cd2c3e8f87412ca23c00cc67980ba8cf01565dcea4feb1a6f37f893e5f3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đặt biển cảnh báo “Chú ý xe đỗ” (hoặc đèn cảnh báo) về phía sau xe khoảng cách tối thiểu 150 mét khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe trên một phần làn đường xe chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/133c39df391e7f900af9fa7e3a8c5378ddd39007c7f170f8ccbce60ede3c3e8a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/134a17fd33cdf1d8ec1611dc295d448c0eb4049afe08a6fa13e08e34bd756ea6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển vật thể bay, tàu bay không người lái, phương tiện bay siêu nhẹ hoạt động trong phạm vi khổ giới hạn đường bộ gây cản trở hoặc nguy cơ mất an toàn cho người, phương tiện tham gia giao thông đường bộ, trừ tàu bay không người lái, phương tiện bay siêu nhẹ được cấp phép bay"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/134a737bcf8e96aef09ee747258fa5833d72eab732328f0c4e27a5496c918aa3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không hoàn trả nguyên trạng hành lang an toàn đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/136e9e2f0ce2e0511867add5b2f30074c63606fb3d3b478f88ca3aa0157ded52> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp quyết định giá cước vận tải nhưng không có giấy phép kinh doanh vận tải theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/137ff11adb4673d15e2e724cc01a96b8f5f870561443fafe96dd82e1d2657100> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe ở lòng đường gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/13943d56af2a9736f847f25fce519b011878382000e313f9fb038e878cd546da> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để xe ở lòng đường, vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/139cedf939284ffb56102e5edcfbb5864570ce1f354b9bb1515f12e488d00875> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công công trình trong phạm vi đất dành cho kết cấu hạ tầng đường bộ không thực hiện đúng biện pháp tổ chức giao thông trong hồ sơ kèm theo giấy phép thi công hoặc văn bản chấp thuận của cơ quan có thẩm quyền, trừ hành vi vi phạm quy định tại khoản 1; điểm b, điểm c khoản này; điểm a, điểm b khoản 3; điểm a, điểm b, điểm d khoản 4; điểm a, điểm b, điểm c khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/13ac916ce90e391442754740e574f9015ac814fea5755fd4acac207946972b9c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không mua bảo hiểm cho hành khách theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/13c7b1937bf71634a574b05c56d8cac572a569ed8e5bb05cefbf21f9d89ea6e5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh không có màu sơn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/13f7ac6ee95c6b46f7b9a3ea49950216125422c519cea3a5cbb83b211cca58c6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải lắp thiết bị giám sát hành trình của xe nhưng thiết bị không hoạt động hoặc không đúng quy chuẩn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1434add256874057244ba5d2cf42a9390231b2b7825629a9917c66bdbf4d59d0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không quan sát để bảo đảm an toàn theo quy định mà gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/14367ae41ae94d73b922f676426cbb19f86be404c68572b9547eb771f281b347> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe trên một phần làn đường xe chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1439771820e6679d36948620596060e21e07f1fb4301e4186f6d46fdb055cb5b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy trình nghiệp vụ để phương tiện giao thông đường bộ (đối tượng phải mua vé) không có vé đi qua trạm thu phí"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/143c18385037346021553cb7c6e06898d07933958e44c8798bbdded0f49a2917> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải, xe ô tô đầu kéo hoặc xe vận tải nội bộ có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng thiết bị không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/143f5a015ad9faf4ee1a1c87fdea1455b8245439615750e1fb220230ea1c9a73> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không xây dựng công trình đường bộ để bồi hoàn, thay thế cho phần công trình bị ảnh hưởng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/144066dfa9acfc59a9737cebb42c1d8465c91e6a948bb3fe41b3b745951566e5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách từ 08 chỗ trở lên (không kể chỗ của người lái xe) có lắp thiết bị ghi nhận hình ảnh khoang chở khách nhưng không ghi được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/144ecc0c820aefdcc85afde7d972dc541e6cc4afb9f67f300e8b735331dc4c89> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng mà trên xe không có hợp đồng vận tải, danh sách hành khách kèm theo, thiết bị để truy cập nội dung hợp đồng điện tử và danh sách hành khách theo quy định hoặc có các giấy tờ, thiết bị này nhưng không bảo đảm yêu cầu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/145051754592682c530073c0eade02bb69347b874aa050bd9bb2a9e9260ed09e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không xây dựng quy trình thực hiện giao dịch thu phí, giá, tiền dịch vụ khác"@vi .

