    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cấp lệnh vận chuyển, giấy vận tải cho lái xe nhưng không đúng theo quy định đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9894178e1b1fcc0110d7f7cce4f6bb7c6ed9fcb60e54b8fba91c66e9c134aa34> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải không cung cấp cho đơn vị kinh doanh vận tải giao diện và công cụ để thực hiện được việc quyết định giá cước vận tải với hành khách và người thuê vận tải trên phần mềm."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/98cbbf8c32b418927dae99a3eec1a7f05b825c3b25936cefbee92b9a88033106> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc niêm yết thông tin trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/98d46d841302c2a3c9762c21e7072521943f7ac55ded49f03b33fb4a20b968ab> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện các quy trình nghiệp vụ do nhà cung cấp dịch vụ thanh toán điện tử giao thông ban hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/98daa5c3298b61d145b1e9812e15b1578c473e27f5d11a4f31f663b5e334b1b3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để đe dọa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/98ea8d969bc798ce5df4bb9a1436d6e45c77bf6ca9a2a8e8ddd4bfde780ecada> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không ký kết hợp đồng cho thuê phương tiện để tự lái với người thuê"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/990e6c9fa5d0b62dc6e5ec8df3e2b002f256d5839c1ae77c11b11c4f5df8a131> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe ở lòng đường gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/991eff01a9313087fffe13e0605c0c5f292d5d575f898b40fb94c4cb86d4de05> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để rơi hàng hóa xuống đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/993eb4fd396616d76dd76c300e88fc88bf71445deb4c771a35e351d07cab2326> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng vượt khổ giới hạn của xe hoặc của đường bộ ghi trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/999445edfb5dcd0103c98c5594627f6509d60d9f714f2707bcbbacfdbe6a8a43> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
