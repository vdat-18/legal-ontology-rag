    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe đăng ký tạm thời hoặc xe có phạm vi hoạt động hạn chế hoạt động quá phạm vi, tuyến đường hoặc thời hạn cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f4d400788ece073587cb035e62d58ccd58e2d165dfeca99e175ad80d1fbda7ff> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng tổng trọng lượng (sau khi đã xếp hàng lên xe) vượt quá quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f539f5c61b65bc975369964c3ce1a4ae282dedd1f39b4b068bf6593427b538dc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
