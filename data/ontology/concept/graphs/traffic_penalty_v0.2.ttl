    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây cản trở đối với xe cơ giới xin vượt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/76beaa5d0e8427ffb35a7a8d0c40fdb40f1014b595c00fb1dcc76fb4dabe0040> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
