    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải không cung cấp tài khoản truy cập vào phần mềm ứng dụng hỗ trợ kết nối vận tải cho cơ quan quản lý khi có yêu cầu."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d9b7ea5109fd6bcd393988ac1880f6865105fbe15f948da1496c7c64c87ec6c6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
