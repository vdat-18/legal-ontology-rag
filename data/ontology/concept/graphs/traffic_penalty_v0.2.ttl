    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm b khoản 6 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5d8469fe1af0aa3aa9c55236668ea2a109a0a7f1e85681f73345f8ca6a21c857> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện không gắn biển số (đối với loại xe có quy định phải gắn biển số) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5d8781adc210b86da802dee9dfdb5dfcf245d504c3d5da4a717d629400b4ce76> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy sửa chữa hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5d94c9fd3d75b0a5b6b4e04dd82362a8bb91fec50fd0de6c6d5b39b4ac970bd8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lưu trữ hồ sơ, tài liệu, dữ liệu kiểm định, cải tạo xe không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5d9cc40fab43435166c0451e7330aa8185d19223200dceaba5c3943776e9cbc4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có biện pháp ngăn chặn kịp thời các hành vi lấn chiếm, sử dụng trái phép đất hành lang an toàn giao thông đường bộ, đất của đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5de4324283465002f674ec08260e01eab15b97b4cb36d0f2573f075631cb9b72> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô tải, kể cả rơ moóc và sơ mi rơ moóc, có kích thước thùng xe không đúng với thông số kỹ thuật được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5df44d914284ffdedf5ea0ed3fb48cb3eb9388878ad0e040d7166676db639ef9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng thẻ nhận dạng lái xe của lái xe khác để đăng nhập thông tin khi điều khiển xe tham gia kinh doanh vận tải hàng hóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5df973046e297279d510bed86d0f7c8daab761d25979d9c718b5a618e25cdd6a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe sử dụng xe tập lái có giấy phép xe tập lái nhưng hết hạn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5e529d55ba23da60b1fc8d9de852e95e0c619286168d3bb1e9340d78d5997b92> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không cung cấp thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5e7637b4652f6373cd995e0193b34537a9359e22d649f321ea4950ba1f0e520b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe, kể cả rơ moóc và sơ mi rơ moóc, gắn biển số không đúng với chứng nhận đăng ký xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5ea09e0bab8b3d072164fecc12e715dc32e0b0c99f0cd51aed37cfc24063c928> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người từ đủ 16 tuổi đến dưới 18 tuổi điều khiển xe mô tô và các loại xe tương tự xe mô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5eb0cdc8cc391c71accb5fbcfed520e4a68b6daf99a61367ba4ddfe69283466e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải lắp thiết bị giám sát hành trình của xe nhưng thiết bị không hoạt động hoặc không đúng quy chuẩn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5eb4973b586c0ddeda9cece92919cf01a3e9248b955935942018a4d4f623143d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện tháo dỡ công trình hạ tầng kỹ thuật sử dụng chung, công trình lắp đặt trong công trình kỹ thuật sử dụng chung khi có yêu cầu của người quản lý, sử dụng công trình đường bộ để đầu tư, xây dựng, nâng cấp, mở rộng và bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5ed55c3dcaa96c77b919274e09db412f9727ace83bbe9cd1c99fd1c7eb8073af> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5f11ede2230bd922908c8a8e1cb9154c8dc77eefcbf82fdcd57e247612f5aa90> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xếp hàng hóa lên xe ô tô mà không ký xác nhận việc xếp hàng hóa vào giấy vận tải theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5f3841f667443c0d3ca3d7d929fc9c2350ab8ae48b1ec525bab7420e8f9fd611> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô hai bánh có dung tích xi-lanh đến 125 cm3 hoặc có công suất động cơ điện đến 11 kW và các loại xe tương tự xe mô tô sử dụng giấy phép lái xe đã bị trừ hết điểm hoặc không do cơ quan có thẩm quyền cấp, bị tẩy xóa, không còn hiệu lực hoặc không phù hợp với loại xe đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5f514489df66ca118de3f97b1adad8f8f76b16e2101fc864b3b38a81c9b9ef8b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm thay đổi chữ, số, màu sắc của chữ, số, nền biển số xe, hình dạng, kích thước của biển số xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5f6948eece0811fd1fcdaeb565c839c8aece7f821cc095f12b2835958f97c7d0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc cập nhật thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh khoang chở khách lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5f74077c2461ad52e10b7d9d420ae0cf5e63824c5815a51d4d28d33fbca8b923> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp thêm ghế, giường nằm trên xe ô tô trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5f7f82cebbd6223f5d68506e98e00a677dabd908f2df6007ef67ca77ccced7c4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng vượt quá chiều cao xếp hàng cho phép đối với xe ô tô tải (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5fbc01951d72ea1a22bb38e09583ca662d9735cacf81bc77c83ce88ac2c5d0bd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe thô sơ trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau không sử dụng đèn hoặc không có báo hiệu ở phía trước và phía sau xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5fc30f6ed0aec96fdc8094af65528612e728101f30c74e55a17280eba6b253d2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải không có hướng dẫn cho hành khách về an toàn giao thông và thoát hiểm khi xảy ra sự cố trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/600d65440183044c64cfd4e9de93291b4a4cb654edb569d7a8bb20c7145f87b9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không theo dõi, giám sát hoạt động của lái xe, phương tiện trong suốt quá trình hoạt động vận tải nội bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60285b828aea966e0e974fbf9c314e95691341590a5f3d94a853968185d1f400> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bám xe khác, vật khác"@vi .

