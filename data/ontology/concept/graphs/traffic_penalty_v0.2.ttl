    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp đặt thiết bị âm thanh, ánh sáng trên xe gây mất trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0316daa77893d90daf8eee06a0dee5b085da2cf189448d52825c6bd5b53ea4b0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không trợ giúp người bị nạn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0317fbcd23e5ac8dcc1502d9a77ecbc9faacffbc62a7fc865f1b4c96b35714e7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng giấy phép lái xe không do cơ quan có thẩm quyền cấp"@vi .

