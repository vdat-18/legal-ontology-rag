    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe vận tải nội bộ để vận chuyển người, hàng hóa không đúng đối tượng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c8c2167cb7a3a3cf92cb7709e683ffa83dcdd526a22a054e90de4cc7bec25c20> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
