    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên điểm đón, trả khách, nơi đường bộ giao nhau hoặc trên phần đường dành cho người đi bộ qua đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f4c520fbab78a07ef55543b36c88f71e1e56b28c319b1cbb944bb4610c7897d9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
