    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trong phạm vi bảo vệ công trình đường sắt, phạm vi an toàn của đường sắt"@vi .

