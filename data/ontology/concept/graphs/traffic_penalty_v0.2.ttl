    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng không có báo hiệu kích thước của hàng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3690e87585ed67c10b7f6f119195a160fbae4c8a003ba548a15cc2c15cc2ade> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người từ đủ 16 tuổi đến dưới 18 tuổi điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f372dc43fcf13ea4d0c0e0e3fccc3fa28344dbe9c29b18e5cb5ffd337f9be60b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy đưa phương tiện có chứng nhận đăng ký xe tạm thời, phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f37f3c2dade2a34f5dad3b97452754865cc9144fd6092dd71b5487d40f33cb26> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng trên nóc thùng xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f39b22fe541026f9c764233770f61547e8c8a2007a993027e3c8d6a78380d975> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Kiểm định khí thải xe mô tô, xe gắn máy không đúng quy định, tiêu chuẩn, quy chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3a184da2042bcf65ee16ecff133ddef1dcdeb05574051762d0cfbd7f32cff1f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở quá số người quy định được phép chở của phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3a6e981d7b94f8002e6f1e41a58f02e7cc2f8e8aeb9972136a0a9031503f6fe> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng không có tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3be64ce5ed38820e8164e5b3cefaebb39da115923f10e793150be1060df3945> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách không có thiết bị in hóa đơn (phiếu thu tiền) được kết nối với đồng hồ tính tiền theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3c17603c9a0e9a32c65ace1503c2441465f8d34d271d8703657901bb97b8ec4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi ngược chiều của đường một chiều gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3ec6f5bf995ef7257ad06291b083a6f194767738c281596721b586bb83e78b9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe làm rơi vãi hàng hóa, vật liệu xây dựng, đất đá, phế thải, bùn, hàng rời xuống đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3fe42c57914046b8b006cdfbd7a5c25a736f6d8939a1dbb5b29151b27ae6892> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Mang, vác vật cồng kềnh gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f416642329a8d980cfc19b4869a1b5b00c76121a2dc9e2da4ad696d0a9df0d67> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tuân thủ các quy định về nhường đường tại nơi đường bộ giao nhau, trừ các hành vi vi phạm quy định tại điểm n, điểm o khoản 5 Điều này"@vi .

