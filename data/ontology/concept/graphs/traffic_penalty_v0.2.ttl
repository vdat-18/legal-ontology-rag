    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chăn thả gia súc ở mái đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4d7d7d0eefd2dfe2450ca1c5fc492e66e2f79863469bb9742b0d49305a548133> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
