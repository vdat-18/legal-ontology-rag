    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lùi xe trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4d92032b4e7e84633bc3272c29c54481aee9f47467663c68d29cad8fafaf7b5a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy không làm thủ tục thu hồi chứng nhận đăng ký xe, biển số xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4d99278cc7223547e74e963fd6e3959fcc166a60bbe3e16ed15e3f22f8a97c95> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách sử dụng phần mềm tính tiền không bảo đảm các yêu cầu theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4db69e3d5187040696e8c27cbaa2b2b0ccd20959dcf49118d535bc865ac9ef6f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4df2fecb347cecc7901bc827292d0a5828f782f059f2c807e85c21cf7a89d903> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tránh xe không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4e0f61c3c52c2fb8efcc87dabd32ce7bd6a37026cf7a2738bcb3414dcec6e1f7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không gắn đủ biển số"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4e171f39597c9d3c2e3248882f0976fd1f97f41da15e7117db46064d65d3fef2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện không gắn biển số (đối với loại xe có quy định phải gắn biển số) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4e30128fe93f1c6602637626c73df3a1644965e0687d8bacc08a6a49d889095f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4e8e1d351c2ad6ff1658b9d3c66d9e4151f54cdad2d147173ab3bbf325916438> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để chướng ngại vật, vật cản khác trái phép trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4ea097f4750f4991434bc073466fd68fcd066fd2a6266932a450643bdbc9879c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng giấy phép lái xe đã bị trừ hết điểm, giấy phép lái xe không do cơ quan có thẩm quyền cấp, giấy phép lái xe bị tẩy xóa, giấy phép lái xe không còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4ee02203ffb8ded1c8de383d65c80d240061c70dc147811638a9c829691b8896> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý san mặt bằng trong phạm vi đất dành cho kết cấu hạ tầng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4efe346bf811e9d0ab3e7394ccb3d55592dacd849028f76fa3077fd90a6e7c60> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra, kiểm soát của người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ, trừ các hành vi vi phạm quy định tại điểm b, điểm d khoản 11 Điều 6; điểm đ, điểm g khoản 9 Điều 7; điểm b, điểm d khoản 9 Điều 8; điểm c khoản 4 Điều 9; điểm b khoản 5 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4f510745f6b8ce82ba75b632afe32d1e79ad345c84e9e07fb983240726c09aa4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vượt xe không có tín hiệu trước khi vượt hoặc có tín hiệu vượt xe nhưng không sử dụng trong suốt quá trình vượt xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4f5a871f7ab98635e79b10dbc1bf89897ab3e72743580e1044f3a376b005bf8e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có giấy phép lái xe quốc tế do các nước tham gia Công ước của Liên hợp quốc về Giao thông đường bộ năm 1968 cấp (trừ giấy phép lái xe quốc tế do Việt Nam cấp) nhưng không mang theo giấy phép lái xe quốc gia phù hợp với loại xe được phép điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4f67cd3ce3a03a71a39c533209dd9e4fefb9daee3d6145c36213f2eb9f28f1d3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Mua biển số xe không phải là biển số do cơ quan nhà nước có thẩm quyền sản xuất hoặc không được cơ quan nhà nước có thẩm quyền cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4f812af515ac28679e3bbfe2e94e0602c9de0347f79c486869d1c14465f7bb00> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có kính chắn gió hoặc có nhưng vỡ không có tác dụng (đối với xe có thiết kế lắp kính chắn gió)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4f816cb929969e4aa7cdd0acdfbfce483a1b2578763e0699e7773896ead835c0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để rơi hành lý, hàng hóa trên xe xuống đường"@vi .

