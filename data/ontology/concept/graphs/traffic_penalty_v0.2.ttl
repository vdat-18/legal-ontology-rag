    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người trên thùng xe trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f68e7dda35bdc3d93e8e07052f1fc8b90021301fdf924444c099d4b613a97e34> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách có thiết bị in hóa đơn (phiếu thu tiền) được kết nối với đồng hồ tính tiền nhưng không sử dụng được."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f6b701ec611bd06f7fe46f4fdd4cd7de57df0c2e35e17c9dfe341840ec7ebed7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy trình quản lý, vận hành trạm thu phí theo quy định để số lượng xe ô tô xếp hàng chờ trước trạm thu phí trên một làn xe (tính từ cabin thu phí đến xe cuối cùng của hàng xe chờ) từ 750 m trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f745c474dc15a4a0b20b257946f1764babcf8e038ef92fad98c70de07b340c59> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
