    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe lạng lách trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b209b546e274c9cd06d00103a853615602d04ddb2d4829a973f4b1f6ad6a00fc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
