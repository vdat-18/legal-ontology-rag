<https://w3id.org/legal-ontology-rag/data/concept/conduct/945b8dfe655e1dc7cfea20bbf1b476ba0c98e1ab1ff9beb8b2b970c74ff79d52> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy bằng một bánh đối với xe hai bánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/946183f1f1c1923863f7776bdb45b96a573ef633d0d1a64c9c88f975829b9763> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chở người bốn bánh có gắn động cơ kinh doanh vận tải, xe chở hàng bốn bánh có gắn động cơ kinh doanh vận tải không gắn phù hiệu theo quy định"@vi .

