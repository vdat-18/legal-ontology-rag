<https://w3id.org/legal-ontology-rag/data/concept/conduct/7919699b96af163d46166f9ef103ec3a8fe17d38e79cd095504fec17345d0410> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khai thác đất, cát, đá, sỏi, khoáng sản khác làm ảnh hưởng đến an toàn công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/79471b5145081abea66ecaa9da20ed93991c0032c219768d64ec87658aaf3bef> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hành khách theo tuyến cố định có mang theo lệnh vận chuyển nhưng không ghi đầy đủ thông tin hoặc không có xác nhận của bến xe khách nơi đi, bến xe khách nơi đến theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/795c31e4408f87fe0aaa97a53d46e265fc9cabab799cf6364a42c84079f988df> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô đầu kéo, xe vận tải nội bộ không lắp thiết bị giám sát hành trình của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/796c8a9e9acef49dbe7d2dccc78fbb16298839b9938f643e463ba35b001857df> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
