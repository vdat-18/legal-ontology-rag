<https://w3id.org/legal-ontology-rag/data/concept/conduct/7ff38e5ccc8bf41b34c9e7e336d41e28926a376ee00585af7007b7bbb3848562> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô (kể cả rơ moóc và sơ mi rơ moóc), xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cứu hộ giao thông đường bộ, xe cứu thương không lắp thiết bị ghi nhận hình ảnh người lái xe theo quy định tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/80146ec861f4f0a459191218000015878fbc3809c1dee35911db6b194cc0152e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8042838fc468b4711609ca7c667994073ae01154ba0e521e4ebc31e3d2dab848> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đeo phù hiệu “Giáo viên dạy lái xe” khi giảng dạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/80442bfc8a9c75c42e42299d0845bedaece4bfee06c94ce1f51c0c8a76bb2da4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/805785816df6115715a8ea24460fa2652a770a4264c71274a388bcc312d8a407> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không sử dụng thẻ nhận dạng lái xe để đăng nhập thông tin theo quy định khi điều khiển xe ô tô chở khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/80cf6cfea24872d4a05b4c43352c364ad9e6a0dabe09dfed989105959ee4052b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để làm mất trật tự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/80f40428cb56cdf98d4e4952a453ec0cbb130b60ea408c9567735f02091321c6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để người lên, xuống xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8124f4647eba37459cb72eebd1dce360a8fe8e557c2be40dd97272f6e38334a6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô đầu kéo, xe vận tải nội bộ không lắp thiết bị giám sát hành trình của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/812d033caa2f0070fc1371af26739c082f2e665e42dfd6e9755ad70c728bf37d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng rời, vật liệu xây dựng trên xe mà xe không có thành thùng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/813055d95cfcd806b74ea917cf8417c1477e193890d138330ba679600576c340> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xâm phạm tính mạng, sức khỏe, tài sản của người bị nạn, người gây tai nạn giao thông đường bộ hoặc người giúp đỡ, cứu chữa, đưa người bị nạn đi cấp cứu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/813dfe46134f5d3f199d94c5b0436e4e685876e8ac20095e504d9da9736728f1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm thay đổi chữ, số, màu sắc của chữ, số, nền biển số xe, hình dạng, kích thước của biển số xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/819e00ba2188ce2294b2a6357254a8526c11fbca046002201488e2774586953f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không lưu trữ thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/81d5d1397b09b20213863fe803d946511c265b7174dbe15cff5d9d3eea2fd694> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô chở người từ 08 chỗ trở lên (không kể chỗ của người lái xe) kinh doanh vận tải hành khách không lắp thiết bị ghi nhận hình ảnh người lái xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/81dd09f11f42f0418453b36cff97c3747c2385a4ef63bc66d59942d707dc3200> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để trái phép vật liệu, chất phế thải trong hành lang an toàn đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/81fd7c1ac2e97fc4357d804f3a1c6ce65ef00f50de893625d0557b8e0ab5a14d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có giấy phép lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/820034a7baf9f39001fe8304b3bd6a146a9a7c28268faabed5be76b6c8178865> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/821b9755ee7a0755c9a7465d9daf04858de6d24adbddf46374f432ed4c4803c2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dùng chân điều khiển vô lăng xe khi xe đang chạy trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8225cfe61ff22f407efca4051583a814b8d4b55a49c6151217d370d14879fc41> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dựng cổng chào trái phép trong phạm vi đất dành cho kết cấu hạ tầng đường bộ gây ảnh hưởng đến an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/823d09bb8eae71e31c753e9e6d918de66f68565a1992216dde7e599c8a15149d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bến xe xác nhận vào lệnh vận chuyển khi xe không có ở bến"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8254b0d0312ce63ce31968f920a921859af3d307749516e50ca9ef78173a9190> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Quay đầu xe ở phần đường dành cho người đi bộ qua đường, trên cầu, đầu cầu, ngầm, gầm cầu vượt, trừ khi có hiệu lệnh của người điều khiển giao thông hoặc chỉ dẫn của biển báo hiệu tạm thời hoặc tổ chức giao thông tại những khu vực này có bố trí nơi quay đầu xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/826ffbd08f1539f3a546365680060c10803b68e7c4b1f9c6ca4dabb35b21bc56> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) không đúng số khung, số động cơ (số máy) của xe (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/827b8f97959ce96d3dc076d3ef3f74083af4830dfb10f7a32dc04db409141caa> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kéo theo xe khác, vật khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/82917b6c28e430af1418787d5a75e345b41142a3f877d2df209dfa2349b53e59> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/82987e6d4d8d4ddd2fa0709fe09ecdd777a354ff67f226922146d96232fc6d6b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có dây đai an toàn phù hợp với lứa tuổi hoặc không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/82a2525bda30e134c1e1243857ec6c7b8e8b95aa938c23e34ef75680dd97ab16> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đáp ứng điều kiện về năng lực khi thẩm tra đối với dự án quan trọng quốc gia, dự án nhóm A, nhóm B theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/82abdb648e8cda4ae3f2264c8f454f3e2c8a76125566005a76a3aab8b4301644> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/82c66e52e73eda5fd502e3eb4caf10332845173466088768396de499b5737c0e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy đưa phương tiện không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/82d9f03a8dd3e90b3143ad0baeb9bbada9ece71fbfde1cab467ef14aae8035c8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm vận chuyển động vật sống, thực phẩm tươi sống không mang đủ giấy tờ theo quy định (đối với loại động vật sống, thực phẩm tươi sống khi vận chuyển phải có giấy tờ)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/82f0670020e42e0e49581936deb27d0062b1e2fbe4e30eee3019fd0c5ccbe0b8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý cải tạo kết cấu, hình dáng, kích thước của xe không đúng thiết kế của nhà sản xuất hoặc thiết kế trong hồ sơ đã nộp cho cơ quan đăng ký xe hoặc thiết kế cải tạo đã được cơ quan có thẩm quyền phê duyệt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/830f86b4d4acec0d4777aa9192f7cb2526dac7a1ac12e24c50dc831b65fa8526> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở trẻ em dưới 10 tuổi và chiều cao dưới 1,35 mét trên xe ô tô ngồi cùng hàng ghế với người lái xe (trừ xe ô tô chỉ có một hàng ghế)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/831827d50d361573129eff380550b01522400e78f7e2b9ce60f01bf17aecb56a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tổ chức tuyển sinh lái xe mà không có giấy phép đào tạo lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/832334943d81acbff875a48cb70bcaf428b4bc79f3999bcc5c8038d461f2a3d2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy đưa phương tiện không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/834aef7f6cbc6794b2e45c488051ecb1cdd63625462514379251a28f472f301d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 80 miligam/100 mililít máu hoặc vượt quá 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8389510c0424b4b389b46a77b64591ed20f418541c6f617b1de5739c96a0565e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng tiêu chuẩn chất lượng dịch vụ vận tải đã công bố."@vi .

