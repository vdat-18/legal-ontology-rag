<https://w3id.org/legal-ontology-rag/data/concept/conduct/79cd4f2632f0605f9d25aed6871eb82838ea143c8cde5509a0bad48f45590ad4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường hoặc có nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/79d4874a9fb51ff6b41f1bac63dfaebf5bac64385b65dedf0a3506853ecd7f5c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng có tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/79d6d717eb7108083114f85a191698f98f6e84794caaccc1ba16179c6f35a15f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô chở khách có giường nằm hai tầng để hoạt động trên các tuyến đường cấp V và cấp VI miền núi."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a1d54b246e844cf67b1a1fe99bb6756b8740bab21f050d2ab608bf40f79573f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người không có tên trong danh sách hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a25ccc6228c32710b6d68a42bf03b50fd57a3cf74519d3d8b89417396b6d6a8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Rời vị trí lái, tắt máy khi dừng xe, trừ trường hợp rời khỏi vị trí lái để đóng, mở cửa xe, xếp dỡ hàng hóa, kiểm tra kỹ thuật xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a37d875df315ef07e829da8ca96bd4259758c25b5db87d8bfa9a61b2f0de66c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc hiệu chuẩn đối với nhóm thiết bị cần phải thực hiện công tác hiệu chuẩn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a45d55cf6e697d47cdcdd6ba88b313c992741ad06efc43e414973b91814060e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công trên đường bộ đang khai thác không thực hiện đầy đủ biện pháp tổ chức giao thông để xảy ra tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a53f635b22d487e4d05a441342eba9509237a760efe67a3015dcd3c6ae3fc5d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc quản lý thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh khoang chở khách lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a57db091b1206b6a73349cb82618927aecc486ba3aa3208b9e803644d4e45c2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lùi xe ở đường một chiều, đường có biển “Cấm đi ngược chiều”, khu vực cấm dừng, trên phần đường dành cho người đi bộ qua đường, nơi đường bộ giao nhau, nơi đường bộ giao nhau cùng mức với đường sắt, nơi tầm nhìn bị che khuất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a6d47f441fa7f031d3ca5cc25cc8c4b4a08d19d6785b93d1448fb1c03726303> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thông báo phương thức tính tiền sử dụng trên xe taxi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a73c1a2c57c4455098be0601aa5b5e66ab1cdd201e4abed7346fc0c458cd5be> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7a8014d502fffeaf9384532b5986956a06288c88fee81ca0fc21f1ea6a17cb52> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hành khách theo tuyến cố định không có hoặc không mang theo lệnh vận chuyển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7aa106c9f422056d24ca58aea918e829f9c3e39190a829639cfcc40a0722ac2d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý thay đổi tổng thành khung, tổng thành máy (động cơ), hệ thống phanh, hệ thống truyền động (truyền lực), hệ thống chuyển động của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7ae0ec000d1eb7f8bde3d103750edfb647df3098f1cf5238774b3c75da7888c5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp đặt thiết bị thay đổi biển số trên xe trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7aeacdb9b9d190b481f77b0d76ba48270b33c8b33b360b227dd0f374074b1d69> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ không lắp thiết bị giám sát hành trình"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7b00259e7ffe806608ad07bd0b3af6b151f91d7d81a2ff5b6ac6f88a93ddc3d6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7b12c34ec2cfeaba83e2258b8141eba4f87e1b1ff2bb1aa860f7900c83786ce3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe đổ trái phép rác, đất, cát, đá, vật liệu, chất phế thải ra đường phố"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7b34340a5603dad9d653fd2c01df3e2018258c7fb0c71dc85e523ff1d0df85ff> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên dải phân cách cố định ở giữa hai phần đường xe chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7b5ab0923bfc0143b842f42ecba99de9f6cda327443de7b243e04de5cb593759> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách từ 08 chỗ trở lên (không kể chỗ của người lái xe) có lắp thiết bị ghi nhận hình ảnh khoang chở khách nhưng không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7b61531e7f4d5c02c4c0ec73409c757a961b73c7d18fa9d2242eb0b7db5b106d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7b749238aa5f92e33e44a591ab70a32785fd2f7ab1a8b3fea72295ba5180a24f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để người đu bám ở cửa xe, bên ngoài thành xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7b7ca181828af2fbf50c17db971ce34642b399de367c528fd58ceed6527930ee> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không kê khai giá dịch vụ vận tải hành khách bằng taxi theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7b97df1c31e7aa4b0807607cf2f4e535cc955c3e58f42bb7159672a1a0cc4ccf> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện ra tham gia giao thông khi bị tạm giữ giấy tờ, quá thời hạn hẹn đến giải quyết vụ việc vi phạm ghi trong biên bản vi phạm hành chính mà chưa thực hiện giải quyết vụ việc vi phạm theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7bc13483f3dd555d4dc2ba17e94c48f3e12fd49c6c09bdc3734f0af893ddc8b3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy chở người ngồi trên xe mang vác vật cồng kềnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7bc563cd455f31ab9d9247e3d861dd6b29eda2b8d479d57a7181c6f285b8cdbf> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi qua đường không có tín hiệu bằng tay theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7c41124271e1a51e0550bf6f721f483957ff4b2d12ba595e3fcfd557bc82ba10> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng có tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7c5a78a84a92383e1025142d2e38e5dfedfa4d85baa790401cc3011eef475d12> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khai báo không đúng sự thật để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7c7164f460a4272f6508dead5e7112546ee1353e56971ae3722639c42cf0afb3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cố ý thay đổi dấu vết hiện trường vụ tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7c72e59fd978759099c13332d4a3ae698af93a92549bcf8b4ae1dca3403aafd7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ hoặc xe thô sơ đang đi trên phần đường dành cho xe thô sơ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7c8b015ac5e8531bd2121196f3db976b9368ee7321670660e24e859bb40f5bb8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng giấy chứng nhận kiểm định khí thải xe mô tô, xe gắn máy không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7cb798079200274b73863067315ee3231b4250d37596f3a59c047decb467825a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải, xe ô tô đầu kéo hoặc xe vận tải nội bộ có lắp thiết bị giám sát hành trình nhưng thiết bị không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7cccbd2c2007c9229b5380fba7215193a74f6de6e1c602514b1656d9b636ea66> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý đập phá bó vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7d082fe6bf7724c6fac35dfb53b0cf9f5c2a9706c27636812f18009bd44df50b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bến xe không kê khai, công bố thông tin về giá dịch vụ xe ra, vào bến xe theo quy định của pháp luật về giá"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7d19d5d45f83135afe80ff1ab0f17fa0aa3fe416f35b01af337aeda0816fc062> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy bằng hai bánh đối với xe ba bánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7d4e633045b2962eefa0d5c3c764d54de758a5216ee46dd36b59635bf1fe81d3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng các nội dung thông tin đã niêm yết (tuyến đường, lịch trình, hành trình vận tải)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7da24848cd8fd6fb8178094dde74bd9bea1f7e8d40ec38e43f9007a3255635a6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển hướng không nhường đường cho người đi bộ, xe thô sơ đang qua đường tại nơi không có vạch kẻ đường cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7daaa562ed34c8d234a5d520d08c507f1519f69fd1b5ee6389075d5db7fb12c0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy đỗ xe trên cầu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7dc686ff3b268dcbf2cad6335ab1c9dd877510ae373bb9eced3af974f3fcf37a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây tai nạn giao thông không dừng ngay phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7dd6cf1f6a1f7a45ed1b7f4c6297d9c5e16193985d5351180907454ad2ea2dc4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe đạp máy không đội “mũ bảo hiểm cho người đi mô tô, xe máy” khi tham gia giao thông trên đường bộ"@vi .

