<https://w3id.org/legal-ontology-rag/data/concept/conduct/3a06de1d07c04cccf133e7a56512822ceaf011c4d6bc78a7210ecaf70cba318a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3a3b3330fa33488cd058c482140918a2cf6e726bf03ffd83e09f980af1a55db1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
