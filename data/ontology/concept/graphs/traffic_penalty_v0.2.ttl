    skos:prefLabel "Trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm b khoản 6 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9d64fcfae8ec4f5e479127b34aa8d704410255e15c7967680c3cd01d939fff6f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Can thiệp nội dung thẻ đầu cuối"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9da6d4ee910db59af0e9b1559f00acc5e7aa69a1eec813901d93d9fed9d44be7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không khai báo để trốn tránh trách nhiệm khi bị phát hiện vi phạm pháp luật về trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9db5eead8f3e5ee068815106ddb1c362988346af31223d43962c48137e935aa1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm c khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9dc26641ad118e03e0b79f347f4cfeaaea9db0a8e3b36a8879e00984e3ed728d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trên dải phân cách cố định ở giữa hai phần đường xe chạy, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e02feb4909474c5ac6c717a2b81f0ea16282da6c5c724327e24d56dfa261a78> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không đi bên phải theo chiều đi của mình"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e17d352777e2e260715fe335f442330e6eae8606c5088d7023f2537a5a644f7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Niêm yết không đầy đủ, chính xác các thông tin tại bến xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e21131d86c2f25738bfeccc247531bf75d9229b05cf5fd161ab1ba23e6f76c6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) đã hết hạn sử dụng, hết hiệu lực (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e22eb5d6e1b8913e74ce6c523c82c6f587b5b3e5010bf96226f7c2fbd7418a6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe đánh võng trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e2f1c42b9e714f542f6336153c0cf6a589a48b4e7859f5cac2666b9b6253e23> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải quá thời gian quy định tại khoản 1 Điều 64 của Luật Trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e5d29e19451b57675196fe390862d51fcefae5202df96d8ee3394f02053a40b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi ngược chiều của đường một chiều, trừ các hành vi vi phạm quy định tại điểm đ khoản 11 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e61400a7b20f1296e6861c2038adb6eacfc770f62a4f7b37346ac2e457f71ca> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định trên 35 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e625c5f5e7769bb4304add0e5647c18bac904b32aa90ce95862a4f6f852e224> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e62a7baf8d5d83f4cd36bb7f351e5836c1e1d0fdb1cdba6a9181e07f8e64dc0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dùng các thủ đoạn khác để trốn tránh việc phát hiện xe chở quá tải, quá khổ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e7107932ce8442fa012c2a0442aac834869c89b73034d65a6fc83e7fbf3cf5b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy tẩy xóa hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9e8ed6e77bd4c781f1cbb04f41fe32c459694b19138d7e960c31540c92c79b60> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 150%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9ea7ecf03a3be45f8e51fc42e97541a4bd07b70bbe452f10fd85f5d7e532094c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chất liệu, vật liệu, thiết bị làm thay đổi khả năng nhận diện thông tin biển số xe của phương tiện, thiết bị kỹ thuật nghiệp vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9eade1c19663c4dcf13e541c846c58bcc18c3afe97d56b36d3a8a2460b4209d7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”, trừ các hành vi vi phạm quy định tại điểm g khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9ec4f5099ef224dce75205db5b793cf0f7e03553bbaef6e6c649a620f1a6c8c6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp ráp trái phép phương tiện giao thông cơ giới đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9ef730f57cd252aa4d42fc02d69001c7b638a1fb192bea0674b48a75714bc615> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô kinh doanh vận tải hành khách có kích thước khoang chở hành lý (hầm xe) không đúng với thông số kỹ thuật được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9f363e6453e70e115c65b0c7841bae8445549c7498dba156934736ac091235d0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đặt biển cảnh báo “Chú ý xe đỗ” (hoặc đèn cảnh báo) về phía sau xe khoảng cách đảm bảo an toàn khi dừng xe, đỗ xe trong hầm đường bộ trong trường hợp gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9f4872b805f921d05bacbf9dcf55f3c59043f06c689de10d1b6ef92748a2dfaf> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không quản lý số tiền trong tài khoản thu tiền sử dụng đường bộ độc lập và tách biệt với các khoản tiền khác của nhà cung cấp dịch vụ thanh toán tiền sử dụng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9f50b493e1321e90a8ea376e222971af75caad291421caf4785eeb54deaee958> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) đã hết hạn sử dụng, hết hiệu lực (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9f6ac7866be8ceab711d758c3ecdb3ba64a374b86e4caddc9466569b458fcbc7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hàng hóa không mang theo giấy vận tải bằng văn bản giấy theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9f886c53ad2a49568bd90ac73209cef918f8fa159f862cf0700da2b99cb686d9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đặt biển cảnh báo “Chú ý xe đỗ” theo quy định trong trường hợp gặp sự cố kỹ thuật (hoặc bất khả kháng khác) buộc phải đỗ xe chiếm một phần đường xe chạy hoặc tại nơi không được phép đỗ xe, trừ hành vi vi phạm quy định tại điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9fad241e915b7e672da6e8ce7fe811d0cf6d9a5bc0e12dd05662a60f7341d0ae> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định về biển số, trừ các hành vi vi phạm quy định tại điểm g, điểm h khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9fcece8c3c523869266f3603bfcb9369e4af80d89f7bdce61b576342d5326d0a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a0383276da1fbedfbd2756d420da07aafcdb57f22d6f1978ee2fb5529347b7b2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe; biển số xe; giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a0505ecb4370e7f801ad952506d1b045de7a65706f4306682df648b008f84be3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giao phương tiện cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 2 Điều 22 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a05bf3fedcf55208aeda9d900a801ed3dbf8762e1de8a20bd759e1dcab8243c6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có đủ đèn chiếu sáng, đèn soi biển số, đèn báo hãm, đèn tín hiệu, cần gạt nước, gương chiếu hậu, dây đai an toàn, dụng cụ thoát hiểm, thiết bị chữa cháy, đồng hồ báo áp lực hơi, đồng hồ báo tốc độ của xe hoặc có những thiết bị đó nhưng không có tác dụng, không đúng tiêu chuẩn thiết kế (đối với loại xe được quy định phải có những thiết bị đó), trừ các hành vi vi phạm quy định tại điểm h khoản 3 Điều 20, điểm đ khoản 4 Điều 26 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a07789ff40d39f743bd031f5c4c349457ac2d6a4e7c264c0f2d382abcc873d4f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô tham gia kinh doanh vận tải hàng hóa không lắp thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a0ded042e1c559fd15aaa5814b1ee9bfb75c977bc58c2461106a6082e687571d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đón hành khách không đúng nơi quy định trên những tuyến đường đã xác định nơi đón, trả khách, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a11f02449cc0c81a956e0416f670e5f0d6b763f809dc6371c5269db72ec386e0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a15becb861f35186f131fea05b303583e00519b445535f98a0057bf5865a3388> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không nhường đường cho xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a164b8c4baee5c17127642d3e3f4366fea7148eabb6302deeb4b7d94d61e0aac> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thu tiền vé nhưng không trao vé cho hành khách (vé giấy hoặc vé điện tử)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a185fbef5cc908d66edf9bc812104b71e887f421e3867f49d4c0bdb34ec43739> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Rải vật sắc nhọn trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a19be60a899ad26ee84516a13dea2d3fe834e9e69eb7da3fd8cf6e65bf59add6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe ngược với chiều lưu thông của làn đường, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a19e1ba1e4e6bb58b8f9f28f1d78f2d0a5321b09f537e69b8a41c2a7e82e6cf5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không làm thủ tục cấp chứng nhận đăng ký xe, biển số xe trong trường hợp thay đổi chủ xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a1aabe70867762e1f4ff1565391c5fa57c5301ae923bc23c6438c8af11d73248> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy tẩy xóa hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a1c9e68afb71fdad73e6568bcdd92b88e6f041cfb5954ed1da5af4ae6a4a8c24> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a1d2e47d1919b7a7553bad073594d2e779fca8d95eb3ca43cb31510f6b9c81db> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cản trở người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a1edc182cd4e261ed5dcccc03171616aeed950d418ff54070776f798d0ce58bd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không lưu giữ hồ sơ tài liệu liên quan đến công tác đào tạo theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a2157b2143911bcf0309c9b5080dbc4b4e86b00d6fed3e9e1fe17de985148e93> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy đưa phương tiện có chứng nhận đăng ký xe nhưng đã hết hạn sử dụng, hết hiệu lực tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a24218b605c203556f89ab937404697a324cce224b8b183ce44e2479a2a4ad8f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không quan sát để bảo đảm an toàn theo quy định mà gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a28a70a3c4ae63cb5d0b43c3c091846c40f5e23b4393cb2072f056c06c5f9bc6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trong phạm vi hành lang an toàn giao thông đường sắt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a2b3528bf7cf42c55aea66b3fa952fd7fce5ed92a1f0a466b15a312302aaa562> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô (kể cả rơ moóc và sơ mi rơ moóc), xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cứu hộ giao thông đường bộ, xe cứu thương có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a2c8e63f29600e74c120cd8dd075b4d7f639535fb78e88c7d6766f8d9e1f196b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải cho phép đơn vị kinh doanh vận tải hành khách theo hợp đồng sử dụng phần mềm để xác nhận đặt chỗ cho từng hành khách đi xe trái quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a2efc006343a61d89b1b011140c530588ae523aa278ceab804d68c0b550f0e46> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách in ra phiếu thu tiền nhưng phiếu thu tiền không có đầy đủ các thông tin theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a3161fcc6c5bc6a626c839b19532bbda9e6eb70cbfcae4c2b7f3932b32c27b09> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm quy định về tải trọng, khổ giới hạn của phương tiện, của đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a317438a9fed8025357e750d9672c2f6a2bb16dc63851d8f2ccc03f495650f50> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Ngồi trên mui xe, nóc xe, trong khoang chở hành lý"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a31e54551bfa1969f98d51acb1274c758c0cce14b3181295235a60fad85616c7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a33a8bb306f4f018444f7e885c106245345b179405964b6bbce3045fcb2ba17e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có số giảng viên cơ hữu đảm nhận giảng dạy theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a343a21a222fa4dfaf429c80d8062d0ce224dc5cc9b851d5f39ffcd9fff1bd0a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Nhận đặt chỗ để chở người trên xe bằng xe ô tô không kinh doanh vận tải hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a355b0b6f10342c98e5f07c0dd15586f111819798391fef5cb743c819111e03f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Ngồi về một bên điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a35b50ea4ea18328c6dff0c48e16264b5bc6e5f546a6581a380488907fdfefa1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tái phạm hành vi điều khiển xe đánh võng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a35eaad0006e07a32abc87a02f9ea12d299f757f5d9ab272f28b7afd1b351f7d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ số lượng giáo viên dạy thực hành lái xe các hạng để đáp ứng với kế hoạch sử dụng các xe tập lái dùng để đào tạo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a3627f7295da89e4d4008dd67b749bd1770d98311f87ee6f68eb92989a60a54f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sản xuất hàng hóa trên lòng đường, vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a388841edf2197f0189af5e9ad15b4e47c8cb0ca37c1d3c502f04eb4d6a19615> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trái quy định gây ùn tắc giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a3ca8ca7a0101f0ed96546a4e419d9b1ce5d9277a146250fcbb15b8447b8cff9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng còi liên tục trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a3f33a04a16a97adb33b2b87d360fe80b9e9cfa681cc6c28f92bcb4dd9a17b46> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định trên 20 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a3f64a8e23bb9bf4b3c092401bd4fa8569c872a247442a68210b56dfedc67f96> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng nội dung đã đăng ký, niêm yết về giá dịch vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a424526cddb4d7cdc063d24e712ef4525f8cebb52e55288419f5eb110888ed69> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a424a101b3e88b0274f1501580b92eabd4b5f24ab7de37889aa43834c9c1112b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có niêm yết thông tin trên xe nhưng không chính xác, không đầy đủ thông tin theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a4284d78a2e3a6d293a22ff8acfb3eb836e22f7d906c7d38e837f54f6f0cd31e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có đèn chiếu sáng gần, xa hoặc có nhưng không có tác dụng, không đúng tiêu chuẩn thiết kế"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a431408f495183d6d1c2bd2155c42bf1426e1a6838547e3f192f4496e5288db1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có giáo án của môn học được phân công giảng dạy theo quy định hoặc có giáo án nhưng không phù hợp với môn được phân công giảng dạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a46649d13948cdc4a4ef671ccefe4def1c9a7957c31c6a407e4988bfadcd751e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tuyển sinh học viên không đủ điều kiện tiêu chuẩn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a498bfb0572b541383061db23e9c64254925a19eadc57ce7a1ff8249669c3f45> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe đạp, xe đạp máy sử dụng ô (dù)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a4aa1690f421695e9430120b3d6a84839762c20a4aa5fb6b4ae52da86643c67b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe tuyển sinh học viên không đủ hồ sơ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a4dba9e91479d4dc41fd9bb65bfa00f2b1b72041071d32c76d0e7e1d35b259ed> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tuân thủ các quy định về nhường đường tại nơi đường bộ giao nhau, trừ các hành vi vi phạm quy định tại điểm n, điểm o khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a4f998be6b5e661e97734b53ec532ba4511de021cc963f2fec2c86e994b6a2c7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm mà không làm sạch hoặc không bóc (xóa) biểu trưng nguy hiểm trên phương tiện khi không tiếp tục vận chuyển loại hàng hóa đó"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a521f47f22e0e03890ad2515e6f33837900ea8bdb8e5024993aaab94f77c0873> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người được chở trên xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy sử dụng ô (dù)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a545c75969dd8cd2ae2676f3c730fcb17ff43f1a9073faa6cb7644a8a25371fb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tắt máy khi dừng xe, trừ trường hợp rời khỏi vị trí lái để đóng, mở cửa xe, xếp dỡ hàng hóa, kiểm tra kỹ thuật xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a5a32ecde69a998f21d74c95a4cbbcb32361bd63b0e65b4a5526d2765fc2b7ff> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm hư hỏng hệ thống thoát nước đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a5b63ef9538476e328a539b8079c6bdf5cf21353ed5f72e522f07103ed754a70> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc truyền thông tin, dữ liệu từ thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a5df0af81248915f4f38379abc55e088216035c4a279e7c52fa39d6c7614e63d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a5ebf54d20002349179887706348c491e14e3647350eea8cdfc46cd0284be75a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a623fff8ea1dff80c3c5c47f0444dfa1326d406291705c686075426e6ca9203a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không cắm cột thủy chí ở hai đầu đường tràn, ngầm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a638ee9db8f76939c7319e295c5de7e1556ba3ef048ed9435a47aa38af083173> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô giao phương tiện cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a677949c2e493e56c7916a11b99d62b41947af76f131b9a975be715bdf273989> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển hướng không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a6821e6d7f2fe60c383f7ddb1ab96c1e8977eea033fcdc6d2063cb8751bd25db> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a6ac52edf516e9a405c08617c37401d762c71d69021482ecbd1112f3869e978f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe vận chuyển động vật sống không có kết cấu phù hợp với loại động vật chuyên chở theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a7052fc2cc801547a5d13a14f37c0b83294d02f8f190cf887997bf9770194de8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có niêm yết thông tin trên xe nhưng không chính xác, không đầy đủ thông tin theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a73e0e54564af1266528c01dba11b49a736b4dfa6d307b4ae6ddae95fe3d7659> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp đặt trên xe thiết bị âm thanh, ánh sáng gây mất trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a751bff8c2c3bb81d213c4bcd54bfdab3dc34a9e553bcb46045b8a7e046aec68> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm quy định về tổng trọng lượng (khối lượng toàn bộ) của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a76a9692a1079cb07327918bc3aeebd60b226e96df2d2156862e085b14b4c387> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định từ 10 km/h đến 20 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a79e56ef22f8e0c700e67fb035b278462b11394f5b1afbf07886761abd22da40> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a7b72925e84e49cda6115f48111615adcbf10e7f25970141a6a14385dfe7007d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe bánh xích tham gia giao thông không có giấy phép lưu hành hoặc có giấy phép lưu hành nhưng không còn giá trị sử dụng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a7eba51336eaab570f5ec85921ac6b61028744d5b197fa0338fb88379a7c4940> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe máy chuyên dùng sử dụng giấy phép lái xe bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a81602628dd232693853d88270178cd77fb9f140dea22f5a5edf57d01606208e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a8178427bf63b488491190819db45b632adcbf8ac5a16bd66995e4a4335fc9aa> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở theo 02 người trên xe, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 12 tuổi, người già yếu hoặc người khuyết tật, áp giải người có hành vi vi phạm pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a82b4230a124b42e2e1594881449dbbadf5a41396ba41e154e4ac4bae2c40c2a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người ngồi trên xe sử dụng ô (dù)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a83111a6918e039d76c869e79f72b40dca8e3832452a338982e8cd097fa35783> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp đặt trên xe thiết bị âm thanh, ánh sáng gây mất trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a83800ffda9c1ba807b51c5f22644d4568bfb5967ea549848cd17946016ccf01> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng nội dung đã đăng ký, niêm yết về tiêu chuẩn chất lượng dịch vụ vận tải, dịch vụ hỗ trợ vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a83bd75651123911c7181518f814dcbc57c209b342208904417185062339ea3a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không chạy đúng tuyến, phạm vi, thời gian quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a84defd288acc0154229906ca97a15d3b9021664b3016bee89962a442949062a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kéo theo xe khác, vật khác (trừ trường hợp kéo theo một rơ moóc, sơ mi rơ moóc hoặc một xe ô tô, xe máy chuyên dùng khác khi xe này không tự chạy được)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a86fcc7863c0bcaff2513d2d60c400da319c8ba57162d198d1f73539181fa3fb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người được chở trên xe đạp, xe đạp máy kéo xe khác, vật khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a89a72f97ea50379410ea2c54dcc958be601645162d02bf8c1fac941a3d6d849> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đốt lửa trên mặt đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a8b7274f1f6d74f00e30445a5f4d0f582648707e84077ed1e10e8fcf984d08dd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Rời vị trí lái khi dừng xe, trừ trường hợp rời khỏi vị trí lái để đóng, mở cửa xe, xếp dỡ hàng hóa, kiểm tra kỹ thuật xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a8bd53861afbc9519972f0c9cf6cfb3b5029a5c24daebeeb5e8849658af3c03e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để chướng ngại vật, vật cản khác trái phép trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a8ce1d6bab189ea3dd8a919e312436623f4514dd5749f0c86fbcaeac2e04b17a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khi có điều kiện mà cố ý không cứu giúp người bị tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a8dd102ed0f76a16fc8b9b3ed5f6a84449e828f70b9df917fa9d416cbce9a0f2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân sử dụng các giấy tờ, tài liệu không đúng sự thật để được học mà chưa đến mức bị truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a90693ce08b1ae8af027043f6a7a47e8c84215c57e3da6b4813c4e7a5cd15de5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe đạp máy đội “mũ bảo hiểm cho người đi mô tô, xe máy” không cài quai đúng quy cách khi tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a986017804ec627cc0c20c27f5a4ff711bf479c72355aaa3b2e1963b3041c509> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở vượt trên 50% đến 100% số người quy định được phép chở của phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a98ec4cdab5ff3684760f76c0fcd37663b3e3259655351f03b1798bb4c777fe8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lưu trữ không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9bab9bce6ab68951b1a36ceda0efc146898019b3d8346460f9c0e4085ed6bd5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đe dọa người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9bdbbba9ab9af601758cf0a09b20c6d4d057b5610b46d005082f29af388b50b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công công trình trong phạm vi đất dành cho kết cấu hạ tầng đường bộ không thực hiện đúng biện pháp tổ chức giao thông trong hồ sơ kèm theo giấy phép thi công hoặc văn bản chấp thuận của cơ quan có thẩm quyền, trừ hành vi vi phạm quy định tại khoản 1; điểm b, điểm c khoản này; điểm a, điểm b khoản 3; điểm a, điểm b, điểm d khoản 4; điểm a, điểm b, điểm c khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9d07f1edefb17197176b9b89be2ec2865ef7d11274060def048a3e60108258f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9d3559d9b376e785a5f9cbf407115ecd690ef18fc5effed8b8da278b00c6b8d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch thông tin, dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9ddddbd9333eb7d6d460209b23ae44666091eb8e72252da2094b5db7abe2840> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chở hành khách liên vận quốc tế không có ký hiệu phân biệt quốc gia"@vi .

