<https://w3id.org/legal-ontology-rag/data/concept/conduct/b22d762f6b5d42026b36e198b1e7e295e131bb74475f5739b01bf0725cdbc231> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng không có báo hiệu kích thước của hàng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b22f5ee1f35af7b58af505d6b8f8476b9e67ee6d7f1827d1bc8be76c61764af0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
