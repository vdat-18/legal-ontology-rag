    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khi ra, vào vị trí dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf6d9a567c6b830ebeb7432e18da60bcddb9d63f498b5724e335910a2e7f4a4e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không khắc phục, điều chỉnh các lỗi, sai số phát hiện được thông qua quá trình đối soát"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf7044814f57f04699f7279a79a5b662ce348cf39c3e5acd586947b32656004e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dán lên chữ, số của biển số xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bfc0d4a23c00a2cbdd1441c192994dc54f532fa7cc760c9a508321eb717a15b8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe ở làn dừng xe khẩn cấp trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bfd2c6219a6f12669c43dc249a7b1982142f523d2c38e31625f0658d08fa5a1b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe không đúng vị trí quy định ở những đoạn đường đã có bố trí nơi dừng xe, đỗ xe, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c0013669697b58c7d8448884d54998cecc28fc4fe388fd6c8129f9c27be165fb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành hiệu lệnh của đèn tín hiệu giao thông"@vi .

