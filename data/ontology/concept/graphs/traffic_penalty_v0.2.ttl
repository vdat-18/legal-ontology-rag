<https://w3id.org/legal-ontology-rag/data/concept/conduct/d9421aa9c03c97bfbc0c0f80b224643421a37bf17e73049d391a13be7099c9c9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị giám sát hành trình lắp trên xe ô tô"@vi .

