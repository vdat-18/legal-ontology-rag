    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đi bên phải theo chiều đi của mình"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31478bf09e02e8ad12418722d1b2ddf1aad7191aa9a5c52bd5a67bf4d4add087> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý thay đổi phần mềm sát hạch, thiết bị chấm điểm, xe sát hạch khi chưa được sự chấp thuận của cơ quan quản lý nhà nước có thẩm quyền"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31c74249334f3a27f026daffc47ca484f72dc0c6f180e43c8d29f468b1c746a3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện công khai số thu hàng ngày, số tiền các phương tiện còn nợ tại từng trạm thu phí"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31ecf51d706481e27316a3c8fd8954d13247304b57a5b51ab3b71c1015c479c5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không bố trí nhân sự thực hiện theo dõi, giám sát hoạt động của lái xe, phương tiện trong suốt quá trình tham gia kinh doanh vận tải theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31f0241f0b7dec1c5f2815178a7210fba8b0fa5ba55ecae9fe9f07774ee354a4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở vượt trên 50% đến 100% số người quy định được phép chở của phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31f9197b74f6ae92d9bcd48112552107ba9f7e76104ed1bcaf4e865bebc0b0de> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên đường dành riêng cho xe buýt, trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước, trên phần đường dành cho người đi bộ qua đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/322002d4937dcf8812d5fb11dd00229f5e3e5733d797f6700377514838cbf077> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công trên đường bộ đang khai thác không bố trí báo hiệu, rào chắn tạm thời tại nơi thi công theo giấy phép thi công hoặc văn bản chấp thuận của cơ quan có thẩm quyền"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/32359228e4c15d7832b149bd93df641f291d507bbe17a73e73e1660dc428f0a0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe tạm thời hoặc phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3239e1a327a28cf34b94a2d0dea694229e880bd3d3ba029716162e521f125ca4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
