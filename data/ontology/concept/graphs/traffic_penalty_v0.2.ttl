    skos:prefLabel "Sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f78157c8b0e9c07a64d31bd5375daf208fa1b7e75ffd8c5be2a12b10cdd721d5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe bốn bánh có gắn động cơ để vận tải người nội bộ trừ mục đích kinh doanh vận tải hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f8222480847b926b98f99e0e3e3daa4f70be6fc5a41056f90ab8ba1300151eb8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
