    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bày, bán máy móc, thiết bị, vật tư hoặc sản xuất, gia công hàng hóa trên lòng đường, vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/529577b7f733a1ef076635735a550e25e3dff5b3047c9c28ad981851ffcb0285> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chở người bốn bánh có gắn động cơ kinh doanh vận tải, xe chở hàng bốn bánh có gắn động cơ kinh doanh vận tải không có hoặc không gắn phù hiệu theo quy định hoặc có nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5316f38d79a3ba335e5c1d961000a317aaf3832ddeac6b2b2ae077eef8d685ce> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp khi dừng xe, đỗ xe trong hầm đường bộ trong trường hợp gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/532ae8d21a652071df99fda3dd2fb306104b470d3f2684d777b8e3cc0f6bef33> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên xe được kéo, trừ người điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5343193ee45c999ee3ac9625c1f9c02a0e1dba725dbaf6e5f874110f99888ea3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xâm phạm tính mạng, sức khỏe, tài sản của người bị nạn, người gây tai nạn giao thông đường bộ hoặc người giúp đỡ, cứu chữa, đưa người bị nạn đi cấp cứu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/53ef5cc6ec23a16de25cb4e9cd76244ffbff2cfa76b49eafade1bd5ad953062a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe ở lòng đường gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/53f622b81a22e140f5e9e92b2f048aa1540fd926ba598234575523df33f489e4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách theo tuyến cố định, xe ô tô kinh doanh vận tải hành khách bằng xe buýt không có chỗ ưu tiên cho người khuyết tật, người cao tuổi và phụ nữ mang thai theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5417cdb516a33024599115ed1a6623ac38587200dc79bf064d5107fe209a4b9e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe trong hầm đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/547750c95d3796593a9b49faf00c2c600880fa558a8b2d6246f43797e4798527> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải có niên hạn sử dụng không bảo đảm điều kiện của hình thức kinh doanh đã đăng ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/549244b2ba20662d97f77b7f1109814a3e40eda45893c77a841b1d2b325aee8f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/54c1c19fcf49ea0eecc5a0ff97aa83b23852576ee5823978435498c9652fac49> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe; biển số xe; giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/54f30c76dc99f60ec0bab463bd26cefcda1a888b31531c04a5296951b16eb436> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có tín hiệu trước khi vượt hoặc có tín hiệu vượt xe nhưng không sử dụng trong suốt quá trình vượt xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5535657f4de2381222ed0bdfd7c2b0a19a10963b41c7141223b3fff829d2c150> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi dàn hàng ngang từ 02 xe trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5547a352b3cb96db1d1ceea556bfa17fd902ffc0c143607072a2d29a6cc5e898> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/555966d7916f267f2db89a38c9d370fc3a9c001f5e28486e8ba55b1120355290> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường đường cho: các xe đi ngược chiều; người đi bộ, xe thô sơ đang qua đường tại nơi không có vạch kẻ đường cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/556a7232ef0d9af1e954345b0bc29581fee9db91d88def006f7b6a714ca9ae86> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khi ra, vào vị trí dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/55f76bee03a1911d01e8997a3c451d11f71bda37b41959c312cf4cf059eaf223> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có bộ phận giảm thanh, giảm khói hoặc có nhưng không có tác dụng, không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/560d31e98a23e447f62656f19eb7d69c312d65e64b10d21283497a5378f19676> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng trên nóc thùng xe; chở hàng vượt quá bề rộng thùng xe (kể cả bề rộng rơ moóc và sơ mi rơ moóc); chở hàng vượt phía trước, phía sau thùng xe (kể cả rơ moóc và sơ mi rơ moóc) trên 1,1 lần chiều dài toàn bộ của xe theo thiết kế được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/563dc5f727e153f07804b72ce1a4876f2437c67c35d40c5a5d8ab055cda9458a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có tờ khai phương tiện vận tải đường bộ tạm nhập, tái xuất theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/567e3d08aa0e7eb181bafa975ba85fed3172f2ba8d8761767d4bd8f170745ca9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô đầu kéo không lắp thiết bị ghi nhận hình ảnh người lái xe hoặc có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định hoặc làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/56c05f3fe0348cf16ac50949e4fc238093e87fd81dc4d346638ab049c9f35247> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tổ chức khám sức khỏe định kỳ cho lái xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5707bcf782d2a255a988fdc3eba5ca42ca84675c7a281f471d486d6b32b67f43> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe tạm thời, phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5717a1f6513d747dc59ab67e943b3270370a306a1ab1d47f262f85003c794b46> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có thiết bị giám sát hành trình hoặc có lắp thiết bị giám sát hành trình nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định hoặc làm sai lệch dữ liệu của thiết bị giám sát hành trình lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/572a2677189433301387c49543bedb346274f11bbbc581703befc3dac583d515> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không khai báo, khai báo gian dối hoặc cung cấp thông tin, tài liệu không đúng sự thật để trốn tránh trách nhiệm khi bị phát hiện vi phạm pháp luật về trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57786205a41f43a24d3a8a7fd2dd7681ba1c2e7a303de46766b2da87fc46c0e6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có phù hiệu kiểm soát theo quy định hoặc có nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57984009efefe75043b72e22e26e347eda41050eeaa79d6a835447cdbc8cd349> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô chở hành khách, ô tô chở người (trừ xe buýt) chở quá số người quy định được phép chở của phương tiện, trừ các hành vi vi phạm quy định tại khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57d15c9ff2c7327b5b9c3b34798d2daaa9c9e05ea0686101f1cd640784c1b219> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Buông cả hai tay khi đang điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/58168dc0de8f0fa7a61e63e7c7eba44e18fc3b720bfbfb73934d6a9f85ff982c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tẩy xóa, sửa chữa hoặc giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/588f366eb2dd11a96587c6c018a79d80fa31b0d5cd16ac2c6b9652e19b32a66d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy tốc độ thấp mà không đi bên phải phần đường xe chạy gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/58ee32553b49931abfe666f416a49e2b8c74e40f69707fa885f8fe316987786b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe không đúng số khung, số động cơ (số máy) của xe (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/597fd01a696032831320f0e9765c8102fcf213b1052c20487769a4ab2f7cba82> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc ký hợp đồng đào tạo, thanh lý hợp đồng đào tạo với người học lái xe theo quy định; có ký hợp đồng đào tạo, thanh lý hợp đồng đào tạo nhưng không do người học lái xe trực tiếp ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a113e5ea2ef5e630a2b78522c4bdc7a9d73c24d6264d27ed3a504ea84d20823> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông; đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển gây tai nạn giao thông; quay đầu xe không đúng quy định gây tai nạn giao thông; chuyển hướng không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a358053833b4c97c106118e0b320cb31abc165ef8cfd912114b439caee5ac11> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe không sát theo lề đường, vỉa hè phía bên phải theo chiều đi hoặc bánh xe gần nhất cách lề đường, vỉa hè quá 0,25 mét; dừng xe trên đường dành riêng cho xe buýt; dừng xe trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước; rời vị trí lái, tắt máy khi dừng xe hoặc rời vị trí lái khi dừng xe nhưng không sử dụng phanh đỗ xe hoặc thực hiện biện pháp an toàn khác; dừng xe, đỗ xe không đúng vị trí quy định ở những đoạn có bố trí nơi dừng xe, đỗ xe; dừng xe, đỗ xe trên phần đường dành cho người đi bộ qua đường; dừng xe nơi có biển “Cấm dừng xe và đỗ xe”, trừ hành vi vi phạm quy định tại điểm đ khoản 4, điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a55c9b50636084a84f6cf92f172e92ac8c3cc23dcd4de1eb5e12c7b38b4fdf1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng các nội dung đã đăng ký, niêm yết về: giá cước; giá dịch vụ; tiêu chuẩn chất lượng dịch vụ vận tải, dịch vụ hỗ trợ vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a804ad625bf73c306f65c3b630f95ca1ab07365f772b78518f37c551d4da2a5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng chân điều khiển vô lăng xe khi xe đang chạy trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a9ac2568ca6ab1a10897cba3492a2d6471a5c37e5d2279a0ee7bf982c0a3639> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có còi; đèn soi biển số; đèn báo hãm; gương chiếu hậu bên trái người điều khiển hoặc có nhưng không có tác dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5aed7476ba9c2159d4a4d20d42557c270d3a347efffc405f8797d7bd52fb04c8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5b20651ae581a39906c079227512c90b5402c21b383ae00e38b386428e177ddb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khi có điều kiện mà cố ý không cứu giúp người bị tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5b41019a9eafd5ae1da3f0949ff51609a9c368247e6a9c8c3262e9e67d5df25b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe không đúng vị trí quy định ở những đoạn đường đã có bố trí nơi dừng xe, đỗ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5b65cd676e16dda1d7d10c77e3955cdc1ac28e518d96273432d6c276f4e3f00e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển loại xe sản xuất, lắp ráp trái quy định tham gia giao thông (bao gồm cả xe công nông thuộc diện bị đình chỉ tham gia giao thông, rơ moóc và sơ mi rơ moóc được kéo theo)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5b82ff0ff73fa2833e4abbca22dff8ca6150e68a9c525da96050d51e69a7b9ab> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe đạp, xe đạp máy sử dụng ô (dù), dùng tay cầm và sử dụng điện thoại hoặc các thiết bị điện tử khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5c135c4a1d837eb2599a7110422b61a15207f7a81392bc92150cf4243712f393> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ không có dụng cụ, thiết bị chuyên dùng để cứu hộ, hỗ trợ cứu hộ theo quy định tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5c604bc9d5ab9320d4cdb1aa759fa1873a313d976301cf5c3bd0e1773f5743b9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không bố trí người áp tải trên xe vận chuyển hàng hóa nguy hiểm đối với những trường hợp quy định phải có người áp tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5c8bd8d8dae73948c3f0ec753d7796a2df84bb3f84ff904f401675c8814136d4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Ném gạch, đất, đá, cát hoặc vật thể khác vào người, phương tiện đang tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5cab98117b78c112318f5b934debdf91bfc75bc90263ed420621264821f80498> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng trái phép lòng đường, vỉa hè để: họp chợ; kinh doanh dịch vụ ăn uống; bày, bán hàng hóa; sửa chữa phương tiện, máy móc, thiết bị; rửa xe; đặt, treo biển hiệu, biển quảng cáo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5cb8cd186df9542e98f1e2c944a74d74b275136bdbf22899171fc89b1df3f191> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đổ, xả thải, làm rơi vãi hóa chất, chất thải gây mất an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5ccadf6a0e102457efa4f8aeffd10bd2a8da6ee9e0a5962fc7f5251933a8387c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tẩy xóa, sửa chữa hoặc giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5ccf5013af950e6b76fd2c9a3a5560542ed4f9fef8ae646c64eeb23ffbf845ac> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có tổ chức khám sức khỏe định kỳ cho lái xe nhưng không đầy đủ các nội dung theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5d0af771db32d8f14d0f00602b3c2411923bb3a0c3ecdcb44ab612b79e2bcfb1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng vượt khổ giới hạn của xe hoặc của đường bộ ghi trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5dc0258032c1b90e835039d11bc1b0ba0b238503062b6e695f3c68002b88a187> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không gắn biển số (đối với loại xe có quy định phải gắn biển số); gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5de45d1e3e5f28502e7406c7b0b40ad40cbff6c3d0dcc2734d21dd5a470c562a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có từ 02 lượt đăng kiểm viên trở lên bị xử phạt theo quy định tại khoản 1 Điều này trong thời hạn 12 tháng tính từ lần bị xử phạt đầu tiên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5df3e0995c60185240888080f3943b27b730d324818461f02cd1bf0d81dac843> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không đi bên phải theo chiều đi của mình hoặc điều khiển xe đi qua dải phân cách cố định ở giữa hai phần đường xe chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5ec74ac69f634e8a5621234a3267ae1e5a1d0e0b9ae86ea063fac5649cede4e0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, rơ moóc, sơ mi rơ moóc và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5fcc3c4b746415a696b24abeafd7adbbdb8a51df843769eb84f03702e78eee0b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy dưới tốc độ tối thiểu trên đoạn đường bộ có quy định tốc độ tối thiểu cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/601c5fb9190603e739d058a8feaff2f51247d08ff5c6e76e63ec88a51b708788> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe hoặc sử dụng chứng nhận đăng ký xe đã hết hạn sử dụng, hết hiệu lực (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/603d0103d9d708ec4463e17335500967f1bc8d62fae7a25fdb86cedc4d36e758> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có hệ thống hãm không bảo đảm tiêu chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60793ca1b8f3ecc035fb90e8d26790708d15fecd88e229bb53b5c422b0773904> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ thiết bị giám sát thời gian học lý thuyết, thời gian, quãng đường học thực hành lái xe của học viên hoặc có các thiết bị đó nhưng không hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60a938cbdf7bbc9294b9fc593432a6cbeabba1491ff811504a11ed9c102c0f52> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 20% đến 50% đối với xe xi téc chở chất lỏng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60af98a8925d1894e537bd1c10ae08a7e9168d2d4f84ca0de6f228c265e9234a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe tham gia giao thông tại Việt Nam không có văn bản chấp thuận hoặc cấp phép của cơ quan có thẩm quyền cấp theo quy định (đối với loại xe tham gia giao thông tại Việt Nam có quy định phải được chấp thuận hoặc cấp phép)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60d9d816810d03ba37052aa879990f84d38be6ee7bace109a63f1d61a489e577> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đi trên vỉa hè, trừ trường hợp điều khiển xe đi qua vỉa hè để vào nhà, cơ quan"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60f31f6c7b7bc39c46a8270587d698d48b8fea684519461f84f5b0e3b821ddd5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60f8fbd5ccc91a5963fc66609b78329f9286fb71787b36d8ec8cd3c718721241> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải có lắp thiết bị giám sát hành trình của xe nhưng thiết bị không hoạt động, không đúng quy chuẩn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/613793ea65d35d19d764974722449f0d5962caa742d92aab76320af5e7a3d50c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có giấy phép lái xe nhưng đã hết hạn sử dụng từ 01 năm trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/624d17053da6ca518feb4791c56ec5a76fdcf7bb0d8adec927134f504499542e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe tạm thời, phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/625e6cb613ab29753a0bdd6534bc4a74ce9f2d8b55e73e2df7559705ccd7efbc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hành lý, hàng hóa vượt quá kích thước bao ngoài của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6289bcf21aa5fa7b0ef72ce8947769036172de599b2eb99fc86b316dd0fc643b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe có trên 50% số xe sát hạch lái xe trong hình được cấp phép không bảo đảm điều kiện để sát hạch theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62b1cc4e142b696b34feb2491dd95d0c4cc1d9709b3d214743c5bacbe4bb8054> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để người mắc võng nằm trên xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62e0ab48db710d2a7d07b022f07bfd5cef4caee9794c531b72f377684cdb163f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tẩy xóa, sửa chữa hoặc giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62ecfe9b1d3052e3f5b5f3113a55f3b3100fb3153ca944cb102ab616fed07b17> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chở hàng trong đô thị không chạy đúng tuyến, phạm vi, thời gian quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62f4f339634fe60010a57e44bf15e1862a33e62dd4f1e45db0b3942a01468ac0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa ra các yêu cầu trái quy định về trình tự, thủ tục đăng kiểm đối với cá nhân, tổ chức"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63232601a3a4168d5b93f877224789cd50db5da103ccd0dd00c87b41386f17e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xúc phạm, đe dọa, cản trở, chống đối người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/637cb1d791cf5950a2af9e7bafa2e3b45eec9e84792fce9e95232cb30a84aad1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục khai báo với cơ quan đăng ký xe theo quy định trước khi cải tạo xe (đối với loại xe có quy định phải làm thủ tục khai báo)."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/638c046ff6cf1b7607c9acadb77a585c457951e3bde7551a39d24272a74c55cd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xếp hành lý, hàng hóa trên xe làm lệch xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63b99d9075dc82cabdadce485d8d774d0cd257daffad5bab3c3c9d37d50f3d25> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63c13db4bede5f1e5caa23c131a097e301dcde83971abf4bf54a9428a40217a2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lạng lách trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63ceef708e02beb3425e083960c5cb51fcff93eb525900cc1df2bf368ea0c703> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có đèn chiếu sáng gần, xa hoặc có nhưng không có tác dụng, không đúng tiêu chuẩn thiết kế"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63d56f58dac2b803d8fede121eebf401c05106b9ba7d3f638b6be01c28df7650> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng mà trên xe không có hợp đồng vận tải, danh sách hành khách kèm theo, thiết bị để truy cập nội dung hợp đồng điện tử và danh sách hành khách theo quy định hoặc có hợp đồng vận tải, danh sách hành khách, thiết bị để truy cập nhưng không bảo đảm yêu cầu theo quy định, chở người không có tên trong danh sách hành khách hoặc vận chuyển không đúng đối tượng theo quy định (đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63ee99a5569410d3eca3f1bfe87d39037428eb0951ddeb96b5ed9230678d5928> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/644d5d0e65acb635dcee9a0ad9075ad2815d62cd92dac66a016846d2d1fcf351> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đánh số thứ tự ghế ngồi, giường nằm trên xe ô tô chở hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65c5f589f2643b45448928eb5e9d4a33489f489c8c3cc4b0845fcbca4b3e0f8b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có biển báo dấu hiệu nhận biết là xe chở trẻ em mầm non, học sinh theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65f49a802abaef9e04d7fc815ba3a874a143f59debe81fde301abc560bf51640> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện không có chứng nhận đăng ký xe tham gia giao thông hoặc có nhưng đã hết hạn sử dụng, hết hiệu lực."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66123370c1d88cb17495be36a938e57fc435175e51476b7728305483f81aba94> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để xe ở lòng đường, vỉa hè trái phép; đỗ xe ở lòng đường gây cản trở giao thông; đỗ xe trên cầu gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66939019277c567b95433f25b5aa1fdc19f69cbc3ea15017ee72a139ed020413> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66aed89951e341347edd68c76f110e284398e4fa27f71b7ff4c2acb886209ebb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không quan sát để bảo đảm an toàn theo quy định mà gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66c85ba0f98eb09ff3420524582d24e2a2cd246590f4c82551e2d89f20da6cd2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách không có dây đai an toàn tại các vị trí ghế ngồi, giường nằm theo quy định, trừ xe buýt nội tỉnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66e19b5a88e42e70f700d0517a84850c1e3874e5c5e7c7853a13ecf7da3a4c8f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe hoặc sử dụng chứng nhận đăng ký xe đã hết hạn sử dụng, hết hiệu lực (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/678f720f26cea3cdabeae8035656edc9587094bba629c4c3b725cc8b06f75de1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đóng cửa lên xuống khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/680e7c24dc09866ba885b2af545c970d09c94c054916ccc1baae6bf56f626c19> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ số lượng xe tập lái các hạng để đáp ứng với lưu lượng đào tạo thực tế tại các thời điểm hoặc sử dụng xe tập lái không đúng hạng để dạy thực hành lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6820e9c7c704195279d2685b4a8e96ea3ce530122d1d1a8b532c4d9d4e66624a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện không gắn biển số (đối với loại xe có quy định phải gắn biển số) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/68253100c52c2b99619e46912b62ea518926d4aadced19c1d5dbe740a5d4de37> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 20% đến 30% đối với xe xi téc chở chất lỏng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/683404e7e4f078a98c4b9889284b485ce11a357db93a3fe483bd1455ee5abe3d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/68672789571d1c5f41d6be17e816c5b7abde2dff09d70c417c93853c1568cb8d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không còn hiệu lực"@vi .

