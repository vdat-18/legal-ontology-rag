<https://w3id.org/legal-ontology-rag/data/concept/conduct/6c15dba94b715dae48827fceedb7acfa9e214132a99e9a529c8786e28ed720df> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6cffdd55b520417d9ba58f0db7b4eb1638fc3caed4db6f4ff9db5257d3d9a75a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng tổng trọng lượng (sau khi đã xếp hàng lên xe) vượt quá quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6d1c43f02102e7cd91e5f4cf5fff29b6591fc96117c41a446a246649d0efe7a0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
