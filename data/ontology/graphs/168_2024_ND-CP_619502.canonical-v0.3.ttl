    skos:prefLabel "Quay đầu xe ở phần đường dành cho người đi bộ qua đường, trên cầu, đầu cầu, gầm cầu vượt, ngầm, tại nơi đường bộ giao nhau cùng mức với đường sắt, đường hẹp, đường dốc, đoạn đường cong tầm nhìn bị che khuất, trên đường một chiều, trừ khi có hiệu lệnh của người điều khiển giao thông hoặc chỉ dẫn của biển báo hiệu tạm thời hoặc tổ chức giao thông tại những khu vực này có bố trí nơi quay đầu xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a90cb8a962386da7c29276341c02bb6ce542466967108ebd996bbda7c1e1a055> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a91346eff52cb2b8faf33d06be41bd2eb9b3805811933f5ada9c503265cada24> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường hoặc gây cản trở xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9430df8d460703520796bf287cada5155fff4059f239c9ee6c79d6d3c1a3b94> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Mua, bán biển số xe không phải là biển số do cơ quan nhà nước có thẩm quyền sản xuất hoặc không được cơ quan nhà nước có thẩm quyền cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a94e88fccb4f459ac2cb0987eec6b3126e6118a853b00dedea5086f0281aa121> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9799c2a0f9461e4934c72624c6542867b2e32446a7ca3be96119ab6eb54c1f1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đặt, để chướng ngại vật, vật cản khác trái phép trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9b04fbb4eac23cc05d5090170bff6661d4f4ffc54c3e965aa1843e70cc37a0f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đạp, xe đạp máy đi dàn hàng ngang từ 03 xe trở lên, xe thô sơ khác đi dàn hàng ngang từ 02 xe trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9ef69da8a9d94557eee51a750fca54fc133633fb0acf4b84532cbc38b4c84f5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục đổi chứng nhận đăng ký xe, biển số xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aa12c28de75b284960ae7e01b37cae4a521787c78f8d5577e6723870851f92c0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tổ chức đua xe trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aaa3f08fbf6cdc64416e1216589cf83cbd9b5e27d2d8581c72980f90f94628d5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chở hành khách không có hoặc không gắn phù hiệu theo quy định hoặc có nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab5a714d0d5579998fb1e377cdc4148de46d9ab0fca787326789ff5186689c3b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển, dẫn dắt vật nuôi, điều khiển xe vật nuôi kéo đi vào đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab668960ba4d79c0d1e6580f8a4223994ee4a7bfcd35c06ee89dae3b3e6fb0be> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có còi hoặc có nhưng còi không có tác dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/abbd1f1d1bb5b04261cb180f0ba59fa22235b7bad40b38d07a5928f3a081a3f6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý lắp đặt thêm cơ cấu nâng hạ thùng xe, nâng hạ công-ten-nơ trên xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/abcbe6270c02fc6184b8a084996c2c61347493970819d6d99c3f14b98d68adfe> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có dây đai an toàn phù hợp với lứa tuổi hoặc không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ac29d585802785a3b30747f261c5a3e40ec40ab84d1d2cc9365d8c83ef114c9e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô có tay lái bên phải tham gia giao thông mà không đi theo đoàn, không có người, phương tiện hỗ trợ, hướng dẫn giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/acaa6c40a56c8ebdc30c6a86aa77760d5f396fffe4880b237dfb6b3f043f791e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe máy chuyên dùng có tốc độ thiết kế nhỏ hơn tốc độ tối thiểu quy định đối với đường cao tốc đi vào đường cao tốc, trừ phương tiện, thiết bị phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/adc270334b4d1c2a643fbc1321fe11dfc474ac445bb0d4e343e3f87bcc83ff03> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc cập nhật hồ sơ phương tiện cho xe cơ giới, xe máy chuyên dùng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/af15531960b275a66c7bc48e94aba01491100dc941b689fc065772c2596cbcd5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ không lắp thiết bị giám sát hành trình hoặc có lắp thiết bị giám sát hành trình nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định hoặc làm sai lệch dữ liệu của thiết bị giám sát hành trình lắp trên xe ô tô."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/afc9aaa20f9b6c839f23bf25854346be96fcf81b7d8e13a92cd6ebc92d560d75> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe tại nơi không được quay đầu xe, trừ hành vi vi phạm quy định tại điểm d khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b0509e28aba58b3654230830096ceb71d3ad4aa194f8c4da14245b995a8464fc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên đường cao tốc không đúng nơi quy định; không có báo hiệu bằng đèn khẩn cấp khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe ở làn dừng xe khẩn cấp trên đường cao tốc; không có báo hiệu bằng đèn khẩn cấp, không đặt biển cảnh báo “Chú ý xe đỗ” (hoặc đèn cảnh báo) về phía sau xe khoảng cách tối thiểu 150 mét khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe trên một phần làn đường xe chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b06d51506d4d3628cf1e3ca4c3e12702217c67f7d02bd59fb0870f1c7a16a20e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người được chở trên xe ô tô không thắt dây đai an toàn (tại vị trí có trang bị dây đai an toàn) khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b0bea36ca155563e133de97da812b91823b46844e52fd86721f546c9dcc89b63> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b127fe60626004a75a39c25d16c131a2c85b27cf61787b7cda5e986ac0ad5870> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong cơ thể có chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b136cd7dd7125b836bf2b66d9db6ed8c12350596b2af48506d0161a35af411c0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kéo theo xe khác, vật khác, trừ trường hợp kéo theo một rơ moóc, sơ mi rơ moóc hoặc một xe ô tô, xe máy chuyên dùng khác khi xe này không tự chạy được"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b1ad8e1af5418f050d0c39cb2a2a5fedeb48e1fb44ef58bf227b33d8a96a6c96> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b1d28ff6e260b5b53acb74c49332e93d96103236b93c0a18abad26549d771f58> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển không đúng đối tượng theo quy định đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b2a6a839eae39ad73b5dbd88cd2588857c9cc27ef23d8fc1d1419c02e330ba3e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi, rú ga (nẹt pô) liên tục trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b2f305b6208c0629d324a527602bd6d6dac64cea17504a46d87562625d50ebef> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thực hiện kiểm định đối với phương tiện thuộc trường hợp bị từ chối kiểm định theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b35940c0448dd70d5de9f39f02dd291d3a526b86e66c59021946510b992dd826> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm rơi vãi hàng hóa trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b374dbab24bc0cb7ce5e165793aec0b3f18df3c92ed837eee9fe38ab25af4bc8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tổ chức khám sức khỏe định kỳ cho lái xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b3c5dbb3425ec6965dbc3db58402dba09a22b1846f5bc2dd52592e7384e31017> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có giấy phép lái xe quốc tế do các nước tham gia Công ước của Liên hợp quốc về Giao thông đường bộ năm 1968 cấp (trừ giấy phép lái xe quốc tế do Việt Nam cấp) nhưng không mang theo giấy phép lái xe quốc gia phù hợp với loại xe được phép điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b3cd745a7ee308d5ffdf58e9a075ea4f191b8503ef1e07e0d6ec8e431ccfffea> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe gắn biển số không rõ chữ, số"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b3e1a15fb50acdad646490d85cbe7b1e59acfc66c6c18ec2acfdc455f87c3fee> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 20% đến 50% đối với xe xi téc chở chất lỏng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b3e658fbc84abc0733ad1b3540ad352badea19ff0941894e2bf4a9d83d43ef4a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b45d2f78664db2113902762316f3d311070723e2359f237eb18fafe0fcf05975> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b48ef77db242c9641ac60583c47adf5778d6821cd3d1466369924378bdddd032> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe trong hầm đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b4a5bb52054c638f2bfa16a808043f4045e237ef7c840f739d487d1627398b64> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa, cung ứng dịch vụ có giấy phép nhưng không thực hiện đúng quy định ghi trong giấy phép, trừ các hành vi vi phạm quy định tại điểm b khoản 1, điểm a, điểm c, điểm d khoản 3 Điều 22; khoản 5 Điều 23; khoản 1, điểm b khoản 3 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b4b6064877953da066ecfd2ced1b988a4d7614ca3297a9aa170655217bd6b88e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đi vào đường cao tốc, trừ phương tiện phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b518a907635a6a53efa830efaa1a120228e04f4cb4b9b64066a612a0e16ca9b2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe bố trí học viên tập lái trên xe tập lái vượt quá số lượng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b54eabc5ccece59906814414f50581d6f8a0024ade37eba13c9fda8e8fb90e75> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe có trên 50% số xe sát hạch lái xe trên đường được cấp phép không bảo đảm điều kiện để sát hạch theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b5628241e6975e2eb84fb62faae0d379ce9787120effc686867a4728e39da477> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng chở không đúng loại hàng quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b57e967536d7fc191ee12e972c8fd022969da035c97a81eb598f7f0e0cbd5805> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ, để xe ở lòng đường, vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b5b37d268b8edcdbda0a5e420802ef00b32ad62b3710307e34b3d593bf6be869> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng đi không đúng tuyến đường quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b5c0c5a991bf254c359868c5345b6d6c10f8d3a24907a4459b2e550e33dc878d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có giáo án của môn học được phân công giảng dạy theo quy định hoặc có giáo án nhưng không phù hợp với môn được phân công giảng dạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b61546c4f8ba174a4a43c7951c39a585c62cf64353e88815d99274dc590715d1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe máy chuyên dùng không có bằng (hoặc chứng chỉ) điều khiển xe máy chuyên dùng, không có giấy phép lái xe (hoặc sử dụng giấy phép lái xe đã bị trừ hết điểm, giấy phép lái xe không do cơ quan có thẩm quyền cấp, giấy phép lái xe bị tẩy xóa, giấy phép lái xe không còn hiệu lực) hoặc không có chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b68f92046ef36a27bf37ddc099233df8d3e7f315ac6077c2777db089585bf32a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng tạm thời lòng đường, vỉa hè vào mục đích khác (theo quy định phải có giấy phép) mà không có giấy phép hoặc có giấy phép nhưng đã hết giá trị sử dụng hoặc thực hiện không đúng nội dung ghi trong giấy phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b691e4fd9252d20823e2e93f52bed1c83c3352a926cec5a066d68bad8d10ee4c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) mà bị cắt nóc trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6e76e7320cacca7b83c8e9d3a203cccea97b95558bc3ab9d4084f58c7344b4a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 30% đến 50%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b74d916599d420d5d2489d614e4e6e4b6d71ef6c1e487dff9d82bd1f9fd8b120> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo rơ moóc không có biển báo hiệu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b820b1fc4a6697aa95713c56384e9b4b20b5209f65f2b19e4074fc1ee03db184> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đá bóng, đá cầu, chơi cầu lông hoặc các hoạt động thể thao khác trái phép trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b88c07b9d0f3636a38afdbf246f874bb9f327363458f0a78616268b834da98fb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đăng ký tạm thời hoạt động quá phạm vi, tuyến đường, thời hạn cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b89985670ff77309bce6393bfd919587fe7742e663d349b075775511155edd11> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ, để xe ở vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8c700cc130cbf1e9d03d9599e287d95670ed4f778768b5b02112978532d26ec> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b98b67b12a851c6713577bc08aca986980e79015f8dd015acbf57a5f3997b266> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe hoạt động không đúng tuyến đường, lịch trình, thời gian được phép hoạt động hoặc phạm vi hoạt động theo quy định, trừ hành vi vi phạm quy định tại điểm b khoản 7 Điều 6 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b9bb744acc0e645853bd7f5e52031a35e32b88844e8e53ade85db3c4f28ea9e2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có biển báo dấu hiệu nhận biết là xe chở trẻ em mầm non, học sinh theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b9d4dbc47b2e56cc1f66bd357d0b79bfeb10fb064b4af9447524c6410fbf85db> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có kích thước bao ngoài vượt quá khổ giới hạn của đường bộ hoặc chở hàng vượt khổ giới hạn của đường bộ hoặc chở hàng vượt quá kích thước giới hạn xếp hàng hóa của xe tham gia giao thông, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba424ebc4aa2ce776f9fcafd08d23f12934688dcdf036ccc335f0877e010c8e3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều trên đường có biển “Cấm đi ngược chiều”, trừ các hành vi vi phạm quy định tại điểm đ khoản 11 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba9fbc06cd1a179c9971ee29220be4edca4e0149f741d944bcffda0f01ed87d5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không quan sát, giảm tốc độ hoặc dừng lại để bảo đảm an toàn theo quy định mà gây tai nạn giao thông; điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông; dừng xe, đỗ xe, quay đầu xe, lùi xe, tránh xe, vượt xe, chuyển hướng, chuyển làn đường không đúng quy định gây tai nạn giao thông; không đi đúng phần đường, làn đường, không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông hoặc đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển gây tai nạn giao thông, trừ các hành vi vi phạm quy định tại điểm đ khoản 11 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/baca630d08b9523b0049e8b1a191ce831bad4aab7c568cef8b25e20023fb225c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng tay cầm và sử dụng điện thoại hoặc các thiết bị điện tử khác khi điều khiển phương tiện tham gia giao thông đang di chuyển trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc2884457954611bc2ae7d9d11d7cd4d16499b3c81856679de93d78aee54a7bc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc45de0570ed5281efd28df09c9455d507b464e71d702076d26a80e6ea4cf806> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cấp lệnh vận chuyển, giấy vận tải cho lái xe nhưng không đúng theo quy định đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc4df7ed8a76d84333a49bad7dd16dd5d8e53dfa8f71096c7d40350f41291a6a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không phù hợp với loại xe đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc72e6ee4bb88810c96de28c8fbc676a62f46b22fbec20e0aff6c08f5dac803a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm là thuốc nổ, khí đốt, xăng, dầu và các chất dễ cháy, nổ, chất rắn khử nhạy khác đi qua các công trình hầm có chiều dài từ 100 mét trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc8e4412745a789bebe769ed53d6b93828a0b5d54ce9b71be50339c3775e2591> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lôi kéo bùn, đất, cát, nguyên liệu, vật liệu hoặc chất phế thải khác ra đường bộ gây mất an toàn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bcb4b773d93ad166df39ae918670c2ff3acbaa1130b44a49ab39c39edf069220> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có hệ thống chuyển hướng của xe không đúng tiêu chuẩn an toàn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bd71cdc6b956c2d28394158e57dc8f01691bdf380cc981aad9e75613ee217809> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp đặt, sử dụng thiết bị thay đổi biển số trên xe trái quy định (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bda230e828b6ce105848f1f821b07706168ee60c7a54a934693acef3b5d8244c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy dưới tốc độ tối thiểu trên đoạn đường bộ có quy định tốc độ tối thiểu cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bdb79e8286d28258f9235693aea6fa463b6a8a3b6a6fa311e402a4ba70b47728> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi, rú ga liên tục; sử dụng còi hơi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bdbbfad1bfd2cedff649286b8ce4da3af588a45f00dd87e0c69c3cdd16734096> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người ngồi trên xe đạp, xe đạp máy sử dụng ô (dù)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be5fb9c6b30ba8334ff5d16f2e14063cad9c05e100874e20d48f0cb20bc0e9b5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đu, bám vào thành xe; đứng, ngồi, nằm trên mui xe, nóc xe, trong khoang chở hành lý; tự ý mở cửa xe hoặc có hành vi khác không bảo đảm an toàn khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bed4accbb57ef486bf43058d731678487bee10b5f2650605881b2c3584c2cf1e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách không có nhân viên phục vụ trên xe đối với những xe quy định phải có nhân viên phục vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf53a5beea59b1e88353a1656681eb1f165ee7025c14878ebaa865367bd9cd0e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không chạy đúng tuyến, phạm vi, thời gian quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf5e954e640eeb16411c0708d78751c09238cc756ce7390d61833b393ea07eaa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không đáp ứng yêu cầu về vệ sinh lưu thông trong đô thị"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bfe05676834597aad5bcaf5ab608235ef88b696486082a376ce832f4bfb454ef> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 100%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bff1e2c012768301ad3c48f908df3a26b16a129f91616f42bd814d54de2cb95b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lạng lách, đánh võng trên đường bộ; sử dụng chân chống hoặc vật khác quệt xuống đường khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c0eaddd03616e957f3a3fdd57844adcd6b0d2fca3f62f6524940803b9082dcc5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy kinh doanh vận tải không mang theo chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c1ca01121fddb9839d826f366a76626cf9001f57a6468e7612ab9b7181cf46e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có kích thước bao ngoài vượt quá kích thước giới hạn cho phép của xe theo quy định, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c21aedc0c7d9f6b56469f599636b5ddc2bba26239b9118f0b53f4846d7a4295a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe tự ý di chuyển vị trí các phòng chức năng; thay đổi hình các bài sát hạch mà chưa được chấp thuận của cơ quan quản lý nhà nước có thẩm quyền"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c23256a38b504dda562733eaa98ff77e1b979fba69f3c35c849792e66305958b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe trên đường cao tốc, trừ các xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2737e3e41ec8ae8b6de20b5b287ee0bbebec3659edd30a2baaf9750be5e2405> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe có trên 50% số máy tính sát hạch lý thuyết được cấp phép không bảo đảm điều kiện để sát hạch theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2ac4b165f830ab023aa74e0df7f6659a5565290eae6d192c5e625854a0fc47d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2b5fbe5d166b0dec8eaa6be80779b84cfb0686fbde42a0faa9c8dc0d76acb43> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để người ngồi trên xe khi xe xuống phà, đang trên phà và khi lên bến (trừ người lái xe, trẻ em, phụ nữ mang thai, người già yếu, người bệnh, người khuyết tật)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2e3fb7e308fe6888b2d3c9ef44aa32cbcfd1e921972be456ba63c0319dd4022> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe ở đường một chiều, đường có biển “Cấm đi ngược chiều”, khu vực cấm dừng, trên phần đường dành cho người đi bộ qua đường, nơi đường bộ giao nhau, đường bộ giao nhau cùng mức với đường sắt, nơi tầm nhìn bị che khuất; lùi xe không quan sát hai bên và phía sau xe hoặc không có tín hiệu lùi xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c364426318607ae925fc9092739e52688620b72ec6bba8e6ebe1d0d6f03b0b99> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện niêm yết công khai các trình tự, thủ tục thử nghiệm, chứng nhận theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c3b8a69fdbc84fe01b2bf93a4b665f90adcdd265e563fc96777ee50c5787ecc3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi, rú ga liên tục; sử dụng còi hơi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c4be5b26ce7c81a731817e069add0c9e7b16d3f879029428d11d529931a8da45> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có hệ thống hãm hoặc có hệ thống hãm nhưng không bảo đảm tiêu chuẩn kỹ thuật; điều khiển xe có hệ thống chuyển hướng không bảo đảm tiêu chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c572d474fbb3ecaf5552d0577397bb65c0be3d2545266a75abf1e7e04526ca88> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Ném gạch, đất, đá, cát hoặc vật thể khác vào người, phương tiện đang tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c5954e4fd8f75dd86cc9574eb7fdd4c6111782274d3739179f5d6404f839dc16> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 50% đến 100%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c5a81fa2c0b81255987a19ae7da2b283c0ad8853ee886f400375f39edc616e56> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước hoặc chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề” khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c5ff6b30acb9d87e8163e00ab02b0c8a160c3829ad6ca54b8bf38a352c4c0b3f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 100%"@vi .

