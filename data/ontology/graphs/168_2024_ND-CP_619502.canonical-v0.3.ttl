    skos:prefLabel "Vận chuyển thực phẩm tươi sống không chấp hành quy định về an toàn thực phẩm, vệ sinh dịch tễ, phòng dịch và bảo đảm vệ sinh môi trường theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7d83051cbfa7158556776486646a421cc1676719804d8e0b7350c63eddb867fd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe thành nhóm từ 02 xe trở lên chạy quá tốc độ quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7ea9c9fe93cdb2bb707022f0a6a1a1c7e0b6e7fafea085aaa6275c09309a6ce7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đặt biển cảnh báo “Chú ý xe đỗ” (hoặc đèn cảnh báo) về phía sau xe khoảng cách đảm bảo an toàn khi dừng xe, đỗ xe trong hầm đường bộ trong trường hợp gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7eaebb44660ffcef142a4a5f2485854c900987b423a5a747fc5ff996d0059a51> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng đón, trả hành khách quá thời gian quy định, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7ee3073938758d5d34bacb09d59ab9593fda82ba0d80628fa3ca9ce662a0cbb3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm mà không làm sạch hoặc không bóc (xóa) biểu trưng nguy hiểm trên phương tiện khi không tiếp tục vận chuyển loại hàng hóa đó"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7efc910fb30662ecccea1483fb68860abc8f972e729bd8f853de165f338dcb2a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Nằm trên yên xe điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7f416c0dd9d930c10cc181a74c180997a43e6aaf83bdbd6b51895d2ec878c3da> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe tại nơi có biển báo hiệu có nội dung cấm quay đầu đối với loại phương tiện đang điều khiển; điều khiển xe rẽ trái tại nơi có biển báo hiệu có nội dung cấm rẽ trái đối với loại phương tiện đang điều khiển; điều khiển xe rẽ phải tại nơi có biển báo hiệu có nội dung cấm rẽ phải đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7f7189febea2ab26367260fdd5373c0e24ae600226f851f304205b4eeb304f05> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe che khuất biển báo hiệu đường bộ, đèn tín hiệu giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7f76a3c03a6d3200453e86da83ad5632075bff522992b96f8ff24749d77889b0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7fa13ad4beb816869de8ad91431bf700a3574fe3c851871e2f214e20f08c8c36> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7fd16c10b6c9ac6d49f34161e83cc18ff123ac79b151ffd29a83d5813f256f01> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Gây mất trật tự trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7ff3798b8d78faafcc5575ccd99f9ccb0c56619b0b65fd61c88ca1b3999c4dc3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vượt bên phải trong các trường hợp không được phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/80018f116a0cb1f60f816de7bd14c921e762f3f7e6e894674cd719f5bf3ce23f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách theo quy định của biển báo hiệu “Cự ly tối thiểu giữa hai xe”, trừ các hành vi vi phạm quy định tại điểm d khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/806d0377b8af006265b9622f1353be447f7bb56593a9cc429558e16447e6df96> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng chân điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/808588d0213509264d598bc63ed6d4492b6e6e8036ddccfd27cfb166d8fef091> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đón, trả hành khách không đúng nơi quy định trên những tuyến đường đã xác định nơi đón, trả khách, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/809d57f00b1704fff48104cb432d716318375ece4c95dc8a842c0969b30cb7d5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy phép lưu hành còn giá trị sử dụng nhưng đi không đúng tuyến đường quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/80c55da6817e7bc72183b58113acd01d32e3de94644f10e4e49acf227529fa86> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/81385558789f6b93e2f2e80593a7063774fc3978303222afc04722b469fd4e73> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành nhưng đã hết giá trị sử dụng hoặc sử dụng giấy phép lưu hành không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/814d99a2b25cdefe08a36444ca623375316dca4bab937357b0c76729c0b3e9e7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải không lắp thiết bị giám sát hành trình của xe (đối với hình thức kinh doanh vận tải có quy định phương tiện phải lắp thiết bị) hoặc lắp thiết bị nhưng thiết bị không hoạt động, không đúng quy chuẩn theo quy định hoặc làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/82375208d013add24dc1921ffc7af6ea3ea5066970d7d8e8818065f84c6fc4f7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đi ngược chiều trên đường cao tốc, trừ các xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/823a27d10ffba45303643276923533dd516a4ddc2777ae5966e02736e19a3e8e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có dây đai an toàn phù hợp với lứa tuổi hoặc không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8243ee3124ef8e47a02035fc5979040e187adac477e33cc57c94f9254a0bf68d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người được chở trên xe đạp, xe đạp máy bám, kéo, đẩy xe khác, vật khác, mang vác vật cồng kềnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/826b1d741317e372e9bbc8522f8fd196f6ff57bfd7f6fb5cffebf54a4d979e65> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đua xe ô tô, mô tô trái phép trên đường giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8272d09191cca8c9af1a24a8e95c617394c86313813dddd939acdc393eabc6d5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tái phạm hành vi điều khiển xe lạng lách, đánh võng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/836d65dc0c0ed07090f3fe3135699d2cf9408479ecf27c8eaf08c4cfd191f35c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước hoặc chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/83a9b3c7e4a12f679084e5168fa776909b26429403aaf5c563d398cdc0e618c5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/84e495f555ced024cb07833049cf4e77f037395faf138611244289887b969483> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển “Cấm đi ngược chiều”, trừ hành vi vi phạm quy định tại điểm b khoản này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/84f83df352106db07c6e6ffb2dfad6704f31cc98c63d9e71ff4cc8093d615f15> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy xe trong hầm đường bộ không sử dụng đèn chiếu sáng gần"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/84f99f411dc3f36ff5b96cab05b814aff607e276f4f91acb166c9a08ca40229a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có bộ phận giảm thanh, giảm khói hoặc có nhưng không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8505908fad8755b32aff9f075379ccb028dd2314e5581caff86cdcd851c373c0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/85459e063afb45777b9b865c8963bc18b47e2e81d6ce0c5045074c801c40634c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô chở hành khách, ô tô chở người (trừ xe buýt) chở quá số người quy định được phép chở của phương tiện, trừ các hành vi vi phạm quy định tại khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/85962170776a46ede7ba9c2e8c418f2c8ab5eb5fc11efc9c2ed2003651205f27> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy trong hầm đường bộ không bật đèn hoặc không có vật phát sáng báo hiệu; dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/86dafc39bbfafb16b4a151af3775f7e7e46705d30a0f837ebd8f4aaec028170e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước hoặc chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”, trừ các hành vi vi phạm quy định tại điểm g khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/86f20f3fb8496910a98cf85f22e486dc9f64f3cbcc78d5cc7b0396cd5a7f612b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy quá tốc độ đuổi nhau trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/870863c2f638ce4482ece42fc0592ec2d40e1fa9384caac3010f27fa327f5024> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8722cd538d00c48cb09ddda881b710e9ec2ebecdaa4d71e51eca3aafff6f6b76> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đổ trái phép rác, đất, cát, đá, vật liệu, chất phế thải trong phạm vi đất dành cho đường bộ ở đoạn đường ngoài đô thị"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8724e8888feb2031840739b2f318226997fd3a96d281ebf0f16dbc863a7d96d0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để vật nuôi đi trên đường bộ không bảo đảm an toàn cho người, phương tiện đang tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8758eeba60f84534d918bfce5cd965ab47a2380a48cf11a3c638660f3c1ef0c0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vượt xe trong những trường hợp không được vượt, vượt xe tại đoạn đường có biển báo hiệu có nội dung cấm vượt (đối với loại phương tiện đang điều khiển); không có tín hiệu trước khi vượt hoặc có tín hiệu vượt xe nhưng không sử dụng trong suốt quá trình vượt xe; vượt bên phải xe khác trong trường hợp không được phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8764c432cb0085e1c248c4fd17b73231b58dbf1b4b65cf3758ca0683892826be> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hành khách không lắp thiết bị giám sát hành trình của xe theo quy định hoặc có lắp thiết bị giám sát hành trình của xe nhưng thiết bị không hoạt động theo quy định hoặc làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/877c12291a0677600ee8cab28bb070e45de792e430ce8f3aa0abf3645f101096> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có phù hiệu kiểm soát theo quy định hoặc có nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/87985b1acbcba10864510cbd8b0cbed7636b7635241cc567fe598bb287da42e1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/879bbe12b2c28c5cbe41ee6712a6302f9738d7195702a3597fd9519dcbe66c62> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng nội dung thông tin đã niêm yết trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/87b096b6199c70bc8ef1f5bdb3e912181b03a6528d6333979d78622aa47b17a5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng không có giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/87b8965f14270c99774a781a06dcdf414e1d113457eac6e55cc6e633cfc8e836> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc cung cấp, cập nhật, truyền dẫn, lưu trữ, quản lý thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/87d2117ad20b1764bb42f17b9b472a8629b60e6a8db288a2abcf1aa0f5c90384> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sản xuất biển số trái phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/87df2d3280172543e04d1527fbd13b12335b08f64d277a971f88092b4f68e180> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng điện tử không có thiết bị để truy cập được nội dung của hợp đồng điện tử và danh sách hành khách hoặc có nhưng không cung cấp cho lực lượng chức năng khi có yêu cầu, chở người không có tên trong danh sách hành khách hoặc vận chuyển không đúng đối tượng theo quy định (đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân)."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/87e03b7e56a01fb270818e81fea6b978c61a93264b72a702b7b95fd6afaf493c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện quá niên hạn sử dụng tham gia giao thông, trừ hành vi vi phạm quy định tại điểm i khoản 7 Điều 26 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/87fb4b062ff662b82042b2c89cb1eeefa9ab0786de26110dd64f96367e84196d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi khung, máy, hình dáng, kích thước, đặc tính của xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/88670cf24a914988c9a52cc22ed51a0458a83120eb8cd5c4627ecee65c8233c3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/889cecd7179162974281985746ec4e60bb9e0f2d5876db96d666b0367cb53e27> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8929b303c2ebe5560d1860c57724454381399f0e47739898dbcd788f44a71955> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe ngược với chiều lưu thông của làn đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/894b1c7e9a9e6a582fc8f8cb8ae9e1e16a46de0bad8fe4afb45355ee441da85e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hành lý, hàng hóa vượt quá khổ giới hạn cho phép của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/89baeb0e8577c5d482107452fd02f8eddb872fb440007c447638a11fba75e280> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Phân công người không đủ điều kiện thực hiện nhiệm vụ của đăng kiểm viên, nhân viên nghiệp vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/89e52f8cf28de5bc2c52e9421734e4628733c401f261f750d9389d9e6ea7ec53> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng thẻ nhận dạng lái xe để đăng nhập thông tin theo quy định hoặc sử dụng thẻ nhận dạng lái xe của lái xe khác để đăng nhập thông tin khi điều khiển xe tham gia kinh doanh vận tải hàng hóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/89f5c987566005be2509af54b93b9755e60cc3a4c3e54d0ccf0e3d7639e2306b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh hoặc không có thiết bị có chức năng cảnh báo, chống bỏ quên trẻ em trên xe hoặc không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh và thiết bị có chức năng cảnh báo, chống bỏ quên trẻ em trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8b57a934be2884598b370fa36eb426dde5f69224cf38a2ec9a377a323ad3b684> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải để đón, trả khách; nhận, trả hàng trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8b6d99dfd9d1728452f36286dc2bf40740b020b76c47e8d924a83c3c5127c8ab> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8bb4a6515e2da14b2e67133d93ed38d0328b369b41e61057473bad4e3349456e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh hoặc chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm đ khoản 2, điểm c khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8bde0ff85328f5e97b8960bc4c5b18c431e2d88ab7acb59ed8cb79818e177794> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Mua, bán biển số xe không phải là biển số do cơ quan nhà nước có thẩm quyền sản xuất hoặc không được cơ quan nhà nước có thẩm quyền cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8becc8f6705ae36a6757d46de360891a9166163953921ecd8f95d2267da6ef39> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh của đèn tín hiệu giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8c630befd9d186364f10e26ba5a4946409e951726a50a12bea4afbcd004d639f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ; xe thô sơ đang đi trên phần đường dành cho xe thô sơ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8c6619b71594deecf315a1a564b2292e397c13c4987ed14c639fd26fc404347a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển “Cấm đi ngược chiều”, trừ các hành vi vi phạm quy định tại điểm đ khoản 11 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8c7a55faed453df71bf49bc1b9025e6afcdee33d311da81e6841723c430f7192> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng mà trên xe không có hợp đồng vận tải, danh sách hành khách kèm theo, thiết bị để truy cập nội dung hợp đồng điện tử và danh sách hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8c7e0863f4a155d95bef3f9bcc07243c9d475f59195a05014bceedde48e243be> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không báo hiệu bằng đèn khẩn cấp hoặc không đặt biển cảnh báo “Chú ý xe đỗ” theo quy định trong trường hợp gặp sự cố kỹ thuật (hoặc bất khả kháng khác) buộc phải đỗ xe chiếm một phần đường xe chạy hoặc tại nơi không được phép đỗ xe, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8cc824509d65c1db996426549aba921dd00f5eb98592cbe6030e8819381147a5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển phương tiện không có giấy phép liên vận, giấy phép vận tải đường bộ quốc tế theo quy định hoặc có nhưng đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8ce41d3af54965eb4068e6c7b7b1b1c1cbd9ab3c6fc7c020cb27b49512ffe077> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải có chất lượng không bảo đảm điều kiện của hình thức kinh doanh đã đăng ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8ceb3ab88ed917aeedb505d007fe02387abedc7334f15f7a739e5080c0e0f430> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy không có hoặc không mang theo danh sách hành khách theo quy định, chở người không có tên trong danh sách hành khách hoặc vận chuyển không đúng đối tượng theo quy định (đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân), không có hoặc không mang theo hợp đồng vận tải hoặc có hợp đồng vận tải nhưng không đúng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8d1e036fc0e9dd386b60cbefc03ff7fa8c86dbaf6e0855221db691bee93330bf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định, trừ xe đăng ký tạm thời) hoặc có nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8d4741c1dc38ad3ca97f66a9d462db9305bb17d24eb6ec61756d7b66b8b947d9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khi có điều kiện mà cố ý không cứu giúp người bị tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8d5a88f35b3354a1abed9550d229fe8453c223bffda530bf007a3a4f49bfd920> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8d8ef108bf962b97de0e5093d3b9cb9ddfc4d50c202e45ac8131ad31142b1d0d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về trọng tải, tải trọng, khổ giới hạn xe, vận chuyển hàng siêu trường, siêu trọng của người thi hành công vụ; chuyển tải hoặc dùng các thủ đoạn khác để trốn tránh việc phát hiện xe chở quá tải, quá khổ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8da4dce6dc383b0e69f0e14a1376c973b35d1eb09361772c6b199a10061f5db8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi tổng thành khung, tổng thành máy (động cơ), hệ thống phanh, hệ thống truyền động (truyền lực), hệ thống chuyển động hoặc tự ý cải tạo kết cấu, hình dáng, kích thước của xe không đúng thiết kế của nhà sản xuất hoặc thiết kế trong hồ sơ đã nộp cho cơ quan đăng ký xe hoặc thiết kế cải tạo đã được cơ quan có thẩm quyền phê duyệt; tự ý thay đổi tính năng sử dụng của xe hoặc tự ý lắp đặt thêm cơ cấu nâng hạ thùng xe, nâng hạ công-ten-nơ trên xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8e2e7d04d62319f67176b86defe72a94755e50101bf21a0fcead961565bc21bb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Phơi thóc, lúa, rơm, rạ, nông, lâm, hải sản trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8e3ab13939d5d17b10b218f6d984c5cddc82a2c4305707ae1f68939a1a82e38f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Rời vị trí lái, tắt máy khi dừng xe, trừ trường hợp rời khỏi vị trí lái để đóng, mở cửa xe, xếp dỡ hàng hóa, kiểm tra kỹ thuật xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8e5a5877dcfd7271ee80f0a7f02734bfd59377ec39df832f1defc41cd06aecde> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đạp, xe đạp máy buông cả hai tay; chuyển hướng đột ngột trước đầu xe cơ giới đang chạy; dùng chân điều khiển xe đạp, xe đạp máy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8e9f74a56d418e73fc7621ec90d595e183f5a6c23d9333c8dcc47bed32fb7699> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có từ 02 lượt đăng kiểm viên trở lên bị xử phạt theo quy định tại khoản 1 Điều này trong thời hạn 12 tháng tính từ lần vi phạm đầu tiên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8ea4520eeae94cf794cd2eb55eeb65ec8c70e402de3a97c51a2eb65d5828b46c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xâm phạm sức khỏe của người khác đi trên xe, lái xe, nhân viên phục vụ trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8f69712bc75f6100ffab3245d81379491d5c725581404c239bd23e4dce18ed81> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không cấp lệnh vận chuyển, giấy vận tải cho lái xe hoặc cấp lệnh vận chuyển, giấy vận tải nhưng không đúng theo quy định đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8f9198311fd2a55bf348f0ccea08b92324dd19a516114ac2398129ec1c6dfd6c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe tạm thời, phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8fa58b22068e675f337ef8523cce79ff268524d9ab8e98c17fafd4ba2bbe370a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi tổng thành khung, tổng thành máy (động cơ), hệ thống phanh, hệ thống truyền động (truyền lực), hệ thống chuyển động hoặc tự ý cải tạo kết cấu, hình dáng, kích thước của xe không đúng thiết kế của nhà sản xuất hoặc thiết kế trong hồ sơ đã nộp cho cơ quan đăng ký xe hoặc thiết kế cải tạo đã được cơ quan có thẩm quyền phê duyệt; tự ý thay đổi tính năng sử dụng của xe hoặc tự ý lắp đặt thêm cơ cấu nâng hạ thùng xe, nâng hạ công-ten-nơ trên xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

