    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lắp thêm đèn phía trước, phía sau, trên nóc, dưới gầm, một hoặc cả hai bên thành xe, trừ đèn sương mù dạng rời được lắp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1cf7712d2d78e476430e5e6b4b122ad511b478e6e8eaa1af5534ab30317b6793> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, chỉ dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d17db2ffda82b3774046fb8dd3872ba7e1cc1214c7d3c01aa97da6537e46a92> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng, cung cấp hồ sơ, tài liệu giả để thực hiện việc kiểm tra, chứng nhận, thử nghiệm nhưng chưa đến mức bị truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d34f0665ea7e9890388937741c3c3563f8478b75d172fc74779c2d2b8be5c07> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người được chở trên xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy bám, kéo, đẩy xe khác, vật khác, dẫn dắt vật nuôi, mang vác vật cồng kềnh, đứng trên yên, giá đèo hàng hoặc ngồi trên tay lái của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d978f2fb6974925928d34c0002f980a0ce40e91289dca1a6fb102962c0b5b76> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển tải, xuống khách hoặc các hành vi khác nhằm trốn tránh phát hiện xe chở quá tải, quá số người theo quy định của pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1db2321d306544d562a7e1fbb0a457567b5ac6157da2218aa2c90e4e466bb433> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm, hàng độc hại, dễ cháy, dễ nổ, động vật, hàng có mùi hôi thối hoặc hàng hóa khác ảnh hưởng đến sức khỏe của hành khách trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1dce2749526fc23572a2c0b826f657327d72312db441481b62a36c7c389a091e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không hướng dẫn hành khách đứng, nằm, ngồi đúng vị trí quy định trong xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e1c5d8ba65e2ee9b2fea23305acf36dff494e751ed0cd9363c73d5514779dc1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe điều khiển xe khách giường nằm hai tầng, xe ô tô đưa đón trẻ em mầm non, học sinh chưa đủ số năm kinh nghiệm theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e29c40cdb4f3d653cd28fc0bd00741da9b18a61bfa7e844bb734bd6f33583c2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không quan sát hoặc không bảo đảm khoảng cách an toàn với xe phía sau hoặc không giảm tốc độ hoặc không có tín hiệu báo hướng rẽ hoặc có tín hiệu báo hướng rẽ nhưng không sử dụng liên tục trong quá trình chuyển hướng (trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e4dbdcc8da4f99ead0b473982604a5dd41a567fe1a23b75a20c8ef165d3ab8a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người từ đủ 16 tuổi đến dưới 18 tuổi điều khiển xe mô tô có dung tích xi-lanh từ 50 cm3 trở lên hoặc có công suất động cơ điện từ 04 kW trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e59fb18f7d641e181d1d4065f25c20c3c997d4b9684a8cc1dd786879d4b1bcb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, người quản lý trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được hướng dẫn về quy trình bảo đảm an toàn khi đưa đón trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1edb2ad5a87c52ccc3e026728b70077a9b6b078dcea07dad07a8f50516d6dd79> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh hoặc không có thiết bị có chức năng cảnh báo, chống bỏ quên trẻ em trên xe hoặc không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh và thiết bị có chức năng cảnh báo, chống bỏ quên trẻ em trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1efdec66f3cc8b182fbda942e9ebafa3be8de68861877dd52f96c6e8c583a53f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để người lên, xuống xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f47cb941fb57b0f2b206194e924aa5ec9d24c888f397e64b259203c1a0dc05c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi qua đường không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f501ddd87f9f7183ca26601669da4e180539f02cb4c2c4b65e02291e4681020> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành chở người, hàng trên xe tập lái trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f7567c636150eb8a3c8068636c8c817a072ad718f87da871389f0465db4b188> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe đào tạo không đúng nội dung, chương trình, giáo trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f7aa94b8003255a946533f81cda3d44d59a6b456e4a5b9e1a84ff055ab33332> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển phương tiện không gắn biển số tạm thời hoặc gắn biển số tạm thời không do cơ quan có thẩm quyền cấp (nếu có quy định phải gắn biển số tạm thời)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/203a98147959a021ffeaab5b46921ba114af048fdda741265b4f1ba1e3069524> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) dưới 01 tháng tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/203c127910259fadec527124fb670fa2009726777b9e4801182e60722beaa249> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe không sát theo lề đường, vỉa hè phía bên phải theo chiều đi hoặc bánh xe gần nhất cách lề đường, vỉa hè quá 0,25 mét; đỗ xe trên đường dành riêng cho xe buýt; đỗ xe trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước; đỗ, để xe ở vỉa hè trái quy định của pháp luật; đỗ xe nơi có biển “Cấm đỗ xe” hoặc biển “Cấm dừng xe và đỗ xe”, trừ hành vi vi phạm quy định tại điểm đ khoản 4, điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2052c45964ed772bc96a12024b482f7301e03492072ab8c119992034da2fd9eb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe không lưu trữ hoặc lưu trữ không đầy đủ hồ sơ theo quy định của 02 khóa đào tạo trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/20c25e9496d46ccf25fd245b9bbecd520f99da61a5a0ea12e3aaf3e6fa521b95> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 (đối với xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô), khoản 2 Điều 56 (đối với xe máy chuyên dùng) của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/20d70a5c99c02625a03e0feb988e2daf4c7026df41925b15be0d6292edafb0cc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/20e4204dcb242633de590068f7a4d39e4e83b1bb497fbe8de66f34bd0fe100f2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng nguy hiểm mà xe ô tô không dán nhãn, biểu trưng nhận diện hàng hóa nguy hiểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/20f136fe67a8aba9dbc3a6af8ec18a7014be81084b97be07e55754255611b7e0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường rộng; dừng xe, đỗ xe không sát mép đường phía bên phải theo chiều đi ở nơi đường có lề đường hẹp hoặc không có lề đường; dừng xe, đỗ xe ngược với chiều lưu thông của làn đường; dừng xe, đỗ xe trên dải phân cách cố định ở giữa hai phần đường xe chạy; đỗ xe trên dốc không chèn bánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/210a77cad23abd4afb7a973824ce29a6650ed310add0c1162c5ba1c9530308ea> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người ngồi trên xe sử dụng ô (dù)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/21185d34b24f4bbe8afc25996a6a3f99ba09d0ea39ce6069288686eb056e1ee9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng rời, vật liệu xây dựng, phế thải để rơi vãi xuống đường hoặc gây ra tiếng ồn, bụi bẩn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/21966ea9a855b3a9fc943fa58f3b2bc02112bfeec4dda887ff6cee1ae3e31978> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đánh võng trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2288bc15ca74be1efac75efe857cab33acdf084ae9d1e0c49e2bb6146d0c6cff> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để hành hung, đe dọa, xúi giục, gây sức ép, làm mất trật tự, cản trở việc xử lý tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/230fac78e7f89b3f78e95aee4ad7a1e5837694a6d2b3ff64e5dfe3af1e3317e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên đường dành riêng cho xe buýt, trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước, trên phần đường dành cho người đi bộ qua đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/23316c169f77d38487d2ac249d6570de9b51944d62eed8795c347ffd814c035e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe đã bị trừ hết điểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/236e1d08c8d4ac968a0fa52a0dd3a886abfa27fcbd17c2ff0fc51c7dbdec77d3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp đặt, sử dụng thiết bị thay đổi biển số trên xe trái quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/239414b11431421624458a698a881f0667fbfd57b9c142c24485c8f33b7986e4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe gắn biển số không đúng với chứng nhận đăng ký xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/23f138b7f2b4cf639b2f71ce07bd9bf631affa9028768ecb3373c794e718cc3f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa là phương tiện vận tải, máy móc, thiết bị kỹ thuật, hàng dạng trụ không chằng buộc hoặc chằng buộc không theo quy định (trừ việc vận chuyển máy móc khổ lớn (quá khổ) trên phương tiện chuyên dùng và phải có giấy phép lưu hành trên đường bộ)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2425142bd590846fa82d14d02c6395bad6a6c86e3f8ed4235db0e1fd0b0d3a8e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/248308b81c0b1b2e28f6b4dc69479743527c0160db7357938e455cfe578d9cb9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy trong hầm đường bộ không sử dụng đèn chiếu sáng gần"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/24dbd932cca3734d4ced598bf291cd8fcd01407c88a18534406012fec43060e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe tại bên trái đường một chiều hoặc bên trái (theo hướng lưu thông) của đường đôi; trên đoạn đường cong hoặc gần đầu dốc nơi tầm nhìn bị che khuất; trên cầu (trừ trường hợp tổ chức giao thông cho phép), gầm cầu vượt (trừ những nơi cho phép dừng xe, đỗ xe), song song với một xe khác đang dừng, đỗ, trừ hành vi vi phạm quy định tại điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/24fde668b894f936f45649d85c48eff4bbc2aeb1e43ea606328abe9666ca2b41> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có hoặc không gắn phù hiệu theo quy định (đối với loại xe có quy định phải gắn phù hiệu) hoặc có phù hiệu nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/25a2174ba112daff29db0056a302d8680c4bade4598af124a6e32cd72286b34c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng có hợp đồng vận tải, danh sách hành khách, thiết bị để truy cập nhưng không bảo đảm yêu cầu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/25dd9ce17b1c5ca0b8aeb17b61e37b69822fd228c50c12bc875997375e977d7b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khai báo không đúng sự thật hoặc sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/26a493b4f10840c833324739eb3bc81ed7efafe0980c5f1b93eef2c1d8630a09> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thay người điều khiển khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/275ebc21d8232e3dd5d08d15fce2be8a040835f516999c8612216f3da1d2eaee> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, rơ moóc, sơ mi rơ moóc và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường đối với loại xe có quy định phải kiểm định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/278f19770e16a3c5555e10060dea4092b61297290da3bbe5b9f65588862b69cb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để vật nuôi kéo xe mà không có người điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/27bee9ce46f47299d7be45fad8ca360028386a638a87ce53c727adbb64f89db9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Hoạt động quá phạm vi, tuyến đường, đoạn đường được phép hoạt động"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/27ec055beb3f36f0014ce10b2335eb635a8d8187c0906949060315438af6456f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu ưu tiên không đúng quy định hoặc sử dụng thiết bị phát tín hiệu ưu tiên mà không có giấy phép của cơ quan có thẩm quyền cấp hoặc có giấy phép của cơ quan có thẩm quyền cấp nhưng không còn giá trị sử dụng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/281ed318466965591c93c11d284bdf65547f374577f0556fee3dc4254b10b0b6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông (bao gồm cả trường hợp người điều khiển phương tiện có giấy phép lái xe nhưng đang trong thời gian bị tước quyền sử dụng)."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2851e021aeabf891f0912012d3bd0e9207e1673e48e0ea2a72ce1520047aaa02> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giảm tốc độ và nhường đường cho xe đi đến từ bên phải tại nơi đường giao nhau không có báo hiệu đi theo vòng xuyến; không giảm tốc độ và nhường đường cho xe đi đến từ bên trái tại nơi đường giao nhau có báo hiệu đi theo vòng xuyến"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2867fd2d0054e414bcca89539ef013945d90412a3dc28e53084c2bb6f862702b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện không có giấy chứng nhận kiểm định khí thải xe mô tô, xe gắn máy hoặc có nhưng đã hết hạn sử dụng hoặc sử dụng giấy chứng nhận kiểm định khí thải xe mô tô, xe gắn máy không do cơ quan có thẩm quyền cấp."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/28f521eead95f70e52228d7dc5402a3e4353624a8d32705013144fb5b4b24fcb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe, quay đầu xe trong hầm đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/29150852ba10eafc0fea11fc687fa0495a41472e68c27f604b614ef44d66aa0e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng vượt quá chiều cao xếp hàng cho phép đối với xe ô tô tải (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/296dac4ec90e9702a35ecb1c164b41d1bae992a6e78862bf5ea6e9e2a4e5c7e1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giảm tốc độ và nhường đường cho xe đi đến từ bên phải tại nơi đường giao nhau không có báo hiệu đi theo vòng xuyến"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/29bdae01f28ae82ec53aa8df369c47ef72c200e5717a89889bebf58a65239edb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa; sử dụng chứng nhận đăng ký xe không đúng số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2b5fd88da1a6976979ea26480c668734fce86aa0a978253f5e5ec9b726e6648a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc cung cấp, cập nhật, truyền, lưu trữ, quản lý thông tin, dữ liệu từ thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2d010dad3a5aa5b284b621ddfdc08fd821082c8e2f1b205e7a768b3c46faf8c4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đánh số thứ tự ghế ngồi, giường nằm trên xe ô tô chở hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2d183ce040f9aa9282ecea0fccd53687266859168f1f5012da3ec8ec4189c619> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường theo quy định, không báo hiệu bằng tay khi chuyển hướng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2d184c917e05a4b8f4216052d4c615671a3908a645a1fd239efaff627e0a34bf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, người áp tải vận chuyển hàng hóa nguy hiểm mà không được tập huấn về vận chuyển hàng hóa nguy hiểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2e48430112186923887f8d96cc0062b2fe090bdacf723e9d7de8a4840f330eeb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tránh xe, vượt xe không đúng quy định; không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2e666c23785b6317a47e23d301801493d44bd5b0a49751d79a1b8a116051f8c5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) tham gia giao thông hoặc có nhưng đã hết hạn sử dụng, hết hiệu lực; đưa phương tiện có chứng nhận đăng ký xe tạm thời, phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2e7fc9b4a7b590074cb9104e8ebec7390929bc985759b37d2678b8d7f03760d0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có tờ khai phương tiện vận tải đường bộ tạm nhập, tái xuất theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2eaef68c48db7eeebe37c65a8a138c79d284296b053fefe0a8ba7117960889fa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa là phương tiện vận tải, máy móc, thiết bị kỹ thuật, hàng dạng trụ không chằng buộc hoặc chằng buộc không theo quy định (trừ việc vận chuyển máy móc khổ lớn (quá khổ) trên phương tiện chuyên dùng và phải có giấy phép lưu hành trên đường bộ)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2ed06f3628f180fede709003d73caa0899f3ee2fdefb7ae08394ef638cf100f2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy kinh doanh vận tải không mang theo chứng nhận bảo hiểm bắt buộc trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2ee16c1bfa8bd01c746fb66314b070e8e2db1178da2a1cbe22b2bd2618e25b25> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe trên đường cao tốc; đi ngược chiều trên đường cao tốc; quay đầu xe trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f4859ae9f4864d4c5dddb8afd8c36600d12f3aeffde24a92caf99f4f436a292> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên mui xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f895b15e48f868df4fea56165b5b4b127557b6e8a58a30b48753a16ecbc4a3d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp kính chắn gió, kính cửa của xe không phải là loại kính an toàn."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f9b668cc46ca6a92484335782f2514b34f8f6ae578172cdcd2588ec2e5f9a15> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) không đúng số khung, số động cơ (số máy) của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/301f3c71b1c90747d4d441e33eed21ea8fc8577c2320e658c81dbd134ab71d27> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người đang điều khiển xe sử dụng ô (dù), thiết bị âm thanh (trừ thiết bị trợ thính), dùng tay cầm và sử dụng điện thoại hoặc các thiết bị điện tử khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3057bce5c9dfd2e36c90cf8f22fdae9d04680c92135ef2b3b8566182318e0b53> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3147a86647727f949a7f46e03f0ae35938ec2fca345ae1b9ebdecdb7c70c8882> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng hoặc sử dụng không đủ đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31928f85f75378170a3053437c640b4c77e79eae9962111c7cc8e698e72d689c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không duy trì việc bảo đảm về điều kiện, yêu cầu theo quy định tại Nghị định của Chính phủ quy định về điều kiện kinh doanh dịch vụ kiểm định xe cơ giới; tổ chức, hoạt động của cơ sở đăng kiểm; niên hạn sử dụng của xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31a2997a46a7341d94f9940107971dc38e20325fc9a070811346258075162d96> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý lắp đặt thêm cơ cấu nâng hạ thùng xe, nâng hạ công-ten-nơ trên xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31cae5fb9e09302aad4a7d0a8b0c4e163be618c01a4bf8fbfe1d1230e51810a1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xếp hàng hóa lên xe ô tô mà không ký xác nhận việc xếp hàng hóa vào giấy vận tải theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/32565048ba32215e03b87effe751087fd8c2405e35fbb52188fcfc07a5ca34b8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô chở hành khách (kinh doanh vận tải hành khách theo tuyến cố định, hợp đồng) chạy tuyến có cự ly lớn hơn 300 km chở quá số người quy định được phép chở của phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3291b2f9d9fa5fe723fe9562d8ae05d566736331ff7878027e8d86c985a50045> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe vận chuyển động vật sống không có kết cấu phù hợp với loại động vật chuyên chở theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/32caa71d56705e79f708c7d0b22d27988d6145945fce3a327f18f91c95f9ea05> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe đã bị trừ hết điểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3327ece3bb4d20a56f3323c0643bff47e21026856ca5bf62a307b2b892592173> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đón, trả hành khách không đúng địa điểm đón, trả hành khách được ghi trong hợp đồng, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/34188c45e49dc9034b315c8afd674ce3c42b5287dbb82143dbb3a3affb2a2771> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh không có màu sơn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/341c5c9fb4e826b3c627bad34f024ac4b6fb7c5e1cc8a73123ac5a346a692163> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nối chắc chắn, an toàn giữa xe kéo và xe được kéo khi kéo nhau"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3495cf3d4e1e55e12a21db849d6c7918119dcac8aba6c1228df9c87a7a621af7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tụ tập từ 03 xe trở lên ở lòng đường, trong hầm đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/35207d9c4f351b433b6f2f9546cb1bdfbf5645361841a2980f35ffa1812ff06f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng hoặc sử dụng không đủ đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/354dfee708343850290104211e1c1869a3e31ae19c05068f7760129f73a9704d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đua xe gắn máy, xe đạp máy, xe đạp trái phép trên đường giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/35c159b899b9f5ae35b7e4d9019e3ffedf437df36b9b0e28091fd237df2be77b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng không có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) hoặc có nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/35f3e13b90049e64d5a5bf9bff3cbfdef8d25e6ef3dad958ac4ab2dd74d1163c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có dây đai an toàn phù hợp với lứa tuổi hoặc không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3636be208af26740d95e9d81b82f1794c526dc706e601b4c32fa09e19ddc4de1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đổ trái phép rác, đất, cát, đá, vật liệu, chất phế thải ra đường phố"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/366c4d0a93caf49bb953ef89ac2bdacd5984dfcf126e765a64342bdbebe8a5b2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/36bb0b778d4ca28df257b8532e44d59f66d1d0d63e4e71e18c3ac3d034408378> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải không lắp thiết bị giám sát hành trình của xe đối với hình thức kinh doanh vận tải có quy định phương tiện phải lắp thiết bị"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/36f2c5abccf66f3ee9eb7c0019900eda6b07c3eced8fee52a67fefb5f40ff2f4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc niêm yết thông tin trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3703532659057f8d79200b6cb028f3e22707ca9df1f3777100f6a2cb2ffdc4d1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng chức trách, nhiệm vụ được phân công trong chứng nhận, kiểm định xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3766d01fbb8d416dd56100e37dd01e2ebf3bff55610579702177ef97f78faad6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, trừ hành vi vi phạm quy định tại điểm c khoản 9 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/37904c34e88bd3f1f16d6e36570f66ec0cb57d1136eec63fc51ae656887f09ed> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách không có hướng dẫn cho hành khách về an toàn giao thông, thoát hiểm khi xảy ra sự cố trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/37f4bda50418ac8053719ac40e3e6a449299503424ba42f5613b5f48f1b55500> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vi phạm quy định về kinh doanh, điều kiện kinh doanh vận tải bằng xe ô tô để xảy ra tai nạn giao thông gây hậu quả từ mức nghiêm trọng trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/381523284a09e95897b1ddb158cc5c41c8a2100d3bad5f6ac342c5621952cc94> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho xe thô sơ đang đi trên phần đường dành cho xe thô sơ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/382a835fcfae7e760af880dda5a72fbf92e0709e071b1092ad86d8ea9e954762> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Gây tai nạn giao thông không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, không ở lại hiện trường hoặc không đến trình báo ngay với cơ quan công an, Ủy ban nhân dân nơi gần nhất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/38496a3b9e37ddc0eb55a517daaed41cd7ee3c6bfc75ec12f7f8018f838e136b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thắt dây đai an toàn khi điều khiển xe chạy trên đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/390d9c246c2ac8848d4719c9a4a54e1fdecd43bfa0dd2308b018ee6d282b80e7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm a, điểm b khoản 7 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/39516e242c10bb41b83ab1cd70d7e15801bb1b280627004e8824c4858b9a0c60> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh của đèn tín hiệu giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3979780c29e70c6477d9ce089883c6fa54acca73098a585d8c4adfddc65b7379> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không đủ điều kiện để thu phí theo hình thức điện tử tự động không dừng (xe không gắn thẻ đầu cuối) đi vào làn đường dành riêng thu phí theo hình thức điện tử tự động không dừng tại các trạm thu phí"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/39b72a872790b9d28b62b2275416c0fcf60f54f5b75b3eb55d06686fb6c1b372> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để vật che khuất biển báo hiệu đường bộ, đèn tín hiệu giao thông"@vi .

