<https://w3id.org/legal-ontology-rag/data/concept/conduct/cf331630be5694dd70f83f7383fdabcc620943aad43849859a856c93d56505a2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Mở cửa xe, để cửa xe mở không bảo đảm an toàn"@vi .

