<https://w3id.org/legal-ontology-rag/data/concept/conduct/fb64f69cdbb759ae5a98c2afcd8bff61950c8341e63edca790b1a5252bd911de> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện giao thông thông minh không có giấy phép hoạt động hoặc giấy phép hoạt động hết hạn sử dụng hoặc hoạt động không đúng nội dung ghi trong giấy phép tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fbb1f22d36641522bf0caeb31dd9c0500b53f4ba7e4e700381c50c378e351003> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp đặt, sử dụng thiết bị âm thanh, ánh sáng trên xe gây mất trật tự, an toàn giao thông đường bộ."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fbe0464a5b5c834e6cf40c846c5e05d657684a7ef6a728d2eb62de13e04f2431> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tổ chức tuyển sinh, đào tạo lái xe mà không có giấy phép đào tạo lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fc3591eba5ddb8245bfd3cde9d733469ea1a89f02d3f7d15d742325fc0a1d138> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bịt mắt điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fc8b20967253eb9b84a3bdcd4a54231ca01c6f592f58ec7ad91f852de7b39d35> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa, cung ứng dịch vụ không có giấy phép (đối với trường hợp phải có giấy phép)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fc953987300dcd9ef008c2e49ec2405fc11d686b52b08ebcc2e28ab26c3cc9fa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fd1464c02e85d4f56ae1b5388017acbc8e450db9c33883d976eab2aa5dd57955> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vi phạm quy định về kinh doanh, điều kiện kinh doanh vận tải bằng xe ô tô để xảy ra tai nạn giao thông gây hậu quả từ mức nghiêm trọng trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fd4b9462f509833676c4b0ed6aa55689c3d559ab6fd090bb8fc70b4fed9c0a76> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fd88da2199347b1cc502aef02ea5fc279f23465bc4ab1cdc1de4cc9b339c53c5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe rẽ trái tại nơi có biển báo hiệu có nội dung cấm rẽ trái đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fe5b7feee9c374dd2123b444b15165a5c7a05cd89827872f37f43b82db07e8a6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy định trong giấy phép lưu hành, trừ các hành vi vi phạm quy định tại điểm a, điểm b khoản 3; điểm b, điểm c khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fe8f521279065b93eeb10fba3b595d691a582e70551452a1e353e6a2705d35d2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 150%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/fee33cd32abbd6c0b4cf6561e04e2c8587a9fefd92faa0f1094865b67c4db27c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi tổng thành khung, tổng thành máy (động cơ), hệ thống phanh, hệ thống truyền động (truyền lực), hệ thống chuyển động"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ff178aa170edd464c3b5cd5ffbf7cfb1380be6f3c506d3c94e220a87eea5a5c1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định trên 20 km/h đến 35 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ff3e8477a9fd4574d30f5793af25b37e37cf973a2a27388b5c01b7d5695e379c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không quan sát, giảm tốc độ hoặc dừng lại để bảo đảm an toàn theo quy định mà gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ff8fcfe8e7218284b29f2179ff0be594692820eb85a3acf5acde0727d1035d92> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ffa0d1b08cd633020098ef2d2289f9fdc28aa70d97b3dc9d114054007c57bb86> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe tại bên trái đường một chiều hoặc bên trái (theo hướng lưu thông) của đường đôi; trên đoạn đường cong hoặc gần đầu dốc nơi tầm nhìn bị che khuất; trên cầu (trừ trường hợp tổ chức giao thông cho phép), gầm cầu vượt (trừ những nơi cho phép dừng xe, đỗ xe), song song với một xe khác đang dừng, đỗ, trừ hành vi vi phạm quy định tại điểm c khoản 7 Điều này"@vi .

