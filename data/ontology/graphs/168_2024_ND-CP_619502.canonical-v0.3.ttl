    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy định về biển số, trừ các hành vi vi phạm quy định tại điểm g, điểm h khoản 8 Điều này."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/15b7d00ef4c261077ec9431bafe6b95b018deb2a3252f15a13b7a7d078ffece4> a loroc:RegulatedConduct ;
