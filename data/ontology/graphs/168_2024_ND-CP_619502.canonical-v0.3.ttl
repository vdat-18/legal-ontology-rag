    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chạy đúng tuyến đường, lịch trình, hành trình vận tải được phép hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4d18eef451b946f9d7f9897735b4f4ed788b85997e0071c26e225bc7c52a8450> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) dưới 01 tháng (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4d2adff30e67ed3da9d0e8f881ee03514f009020db1e82ac8fd5275444eb5f53> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chiếm dụng dải phân cách giữa của đường đôi làm nơi: bày, bán hàng hóa; để vật liệu xây dựng; để xe, trông, giữ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4e4c72ba6297631b553c3764a5183168cd0a93b07ca9c71d1b92870949f23814> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi qua đường không có tín hiệu bằng tay theo quy định"@vi .

