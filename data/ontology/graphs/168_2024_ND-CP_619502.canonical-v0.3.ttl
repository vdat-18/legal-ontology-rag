    skos:prefLabel "Vận chuyển hàng hóa mà sắp xếp, chằng buộc hàng hóa không bảo đảm an toàn hoặc gây nguy hiểm cho người, phương tiện tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ab78e1958521d4de1594c81debacd4144a6694f97118da2f51ba8327c9258ca> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lắp đèn chiếu sáng về phía sau xe"@vi .

