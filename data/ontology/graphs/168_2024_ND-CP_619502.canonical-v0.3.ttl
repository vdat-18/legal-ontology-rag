    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khai báo không đúng sự thật hoặc sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ca26da5aabfe40aa9eae2ce31cd0d8c163c46da1cb1bf306a83cb3e3c97ec233> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra, kiểm soát của người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ, trừ các hành vi vi phạm quy định tại điểm b, điểm d khoản 11 Điều 6; điểm đ, điểm g khoản 9 Điều 7; điểm b, điểm d khoản 9 Điều 8; điểm c khoản 4 Điều 9; điểm b khoản 5 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/caa1476ece54d4b6e466ba8fbc3903fb5cb45bfde46535da1518e7f6c65254dd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cb089485ab25961d6ca9cda5730377384a68de8cb66950ffc14855f01286f391> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Gây tai nạn giao thông không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, không ở lại hiện trường hoặc không đến trình báo ngay với cơ quan công an, Ủy ban nhân dân nơi gần nhất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cb33a65bfffa183645629805ad29979d079bfa24507163b660919c9fe1e59fe9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Phân công người không đủ điều kiện thực hiện việc thử nghiệm, chứng nhận"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cb41a0be11be03755375feb9e2a7bf3c5fbe4625944dd7fa33ed7e97b6a99286> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ sân tập lái hoặc sân tập lái không đủ điều kiện theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cbc682caeea3e5174008582efdb7b570e67e97c6c7933e4d0fc0d56fb7b2e2bd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dẫn dắt vật nuôi chạy theo khi đang điều khiển hoặc ngồi trên phương tiện giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cc37cd0d5058bfff4c9d815ff976cbe9f461a08251ed03bf9bfb4de59e38feda> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để hành hung, đe dọa, xúi giục, gây sức ép, làm mất trật tự, cản trở việc xử lý tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cc936b26e6ea9fb9341bc5cd215de9a313d02d10a4139c6f126aab8739748c14> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe ở đường một chiều, đường có biển “Cấm đi ngược chiều”, khu vực cấm dừng, trên phần đường dành cho người đi bộ qua đường, nơi đường bộ giao nhau, nơi đường bộ giao nhau cùng mức với đường sắt, nơi tầm nhìn bị che khuất; lùi xe không quan sát hai bên, phía sau xe hoặc không có tín hiệu lùi xe, trừ hành vi vi phạm quy định tại điểm đ khoản 11 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccaf84fde95f34d0c3271df7431afb8213e65c22dd32ed22b1caa53135cdd60e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tẩy xóa, sửa chữa hoặc giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccd00b7ebf2d4915f3f0a29df113959c8ca1b824a8617ebd96368aa24ca67b5b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên xe ô tô không thắt dây đai an toàn tại vị trí có trang bị dây đai an toàn khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccf26ceed0013a4b311e4e57321519eeb6841061f775f430fdf5e9b219efbee9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy chứng nhận kiểm định khí thải xe mô tô, xe gắn máy không do cơ quan có thẩm quyền cấp."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cd1a8cb3cf6ff7a424e3d148874c680350d3ba47de9f400c5e4b58fd22c0604d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hàng hóa không có hoặc không mang theo giấy vận tải bằng văn bản giấy theo quy định hoặc không có thiết bị để truy cập vào được phần mềm thể hiện nội dung của giấy vận tải theo quy định hoặc có thiết bị để truy cập nhưng không cung cấp cho lực lượng chức năng khi có yêu cầu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cd26b8353dd7987f97f10e6d33e0e049bb10c6cdce326e6eb88c14f37a28c062> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều của đường một chiều, trừ các hành vi vi phạm quy định tại điểm đ khoản 11 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdcae3105bf369cb9183356b541eae5a10def40aef7d4a8462cddb2152545d30> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không bố trí người áp tải trên xe vận chuyển hàng hóa nguy hiểm đối với những trường hợp quy định phải có người áp tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdf54ea94484135b0fbfcfb4e23d7f8f56abc3a311d36bc5dd68d66f1b5ec9f1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tổ chức tuyển sinh, đào tạo lái xe mà không có giấy phép đào tạo lái xe"@vi .

