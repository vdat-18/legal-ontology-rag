<https://w3id.org/legal-ontology-rag/data/concept/conduct/1272b93aefa17cc1b3664daa41b9366cdfb8ef3db77ba664dcefe5521d77ab3e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp đặt, sử dụng thiết bị thay đổi biển số trên xe trái quy định."@vi .

