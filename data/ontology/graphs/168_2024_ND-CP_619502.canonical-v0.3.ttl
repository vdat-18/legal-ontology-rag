<https://w3id.org/legal-ontology-rag/data/concept/conduct/00700014f898128b8197af2f0363c4cad6cf7153519aacc3f1126ba5c31ab4a0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tụ tập để cổ vũ, giúp sức, xúi giục hành vi điều khiển xe chạy quá tốc độ quy định, lạng lách, đánh võng, đuổi nhau trên đường hoặc đua xe trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00d7bdc824611f49290d111af627d894ad1e5d505a5a59f85b9f2ef290e2c12b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi tính năng sử dụng của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00e031d95f57bd55f102fae7760ca4e6d0a12285a55bf39eb97ecfc5aed45d33> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đeo phù hiệu “Giáo viên dạy lái xe” khi giảng dạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/017493a4120811b74f62342801a5afa10263d5461dea9b998396816eb5e45685> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe ở phần đường dành cho người đi bộ qua đường, trên cầu, đầu cầu, ngầm, gầm cầu vượt, trừ khi có hiệu lệnh của người điều khiển giao thông hoặc chỉ dẫn của biển báo hiệu tạm thời hoặc tổ chức giao thông tại những khu vực này có bố trí nơi quay đầu xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01f0337db111d7fb40e268da2f935197c738b588f950a3025e110fca5f5d557a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe, biển số xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/025736123bd909280769721753e5effcf5600cdc5f63e230ca139ecfa6042836> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đi trên vỉa hè, trừ trường hợp điều khiển xe đi qua vỉa hè để vào nhà, cơ quan"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02e015c24a855b73d46e80308b6556aba47e2181fffd7e92c914aa604cde53c8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cố ý thay đổi, xóa dấu vết hiện trường vụ tai nạn giao thông, trừ các hành vi vi phạm quy định tại điểm g khoản 4, khoản 8 Điều 6; điểm b khoản 5, điểm c khoản 9 Điều 7; điểm d khoản 5, điểm c khoản 8 Điều 8; điểm a khoản 4 Điều 9 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02e59653270d921b7efb54eb3f2fd04cd9c7eab17a0912be2093a8349ecaa638> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe ở lòng đường trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/03be85f52ae86febadb88a23222e5261b84e7672739c21f1d6dc2f5d8bb334ea> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng máy tính trong phòng sát hạch lý thuyết kết nối với đường truyền ra ngoài phòng thi trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/03e0db94724b1612044d211f08b08d8b45bbbaba8a95abf5821879ca7a06aeca> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục cấp chứng nhận đăng ký xe, biển số xe trong trường hợp thay đổi chủ xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/044f08848c21cbfa806d0b74b6f39890370ed88308af02427b35d5897bfdefeb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người đang điều khiển xe hoặc chở người ngồi trên xe bám, kéo, đẩy xe khác, vật khác, dẫn dắt vật nuôi, mang vác vật cồng kềnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/045226b60e071e2ed0dd2ea31fc10fb0438b5506826b64613cb7c34b3cd34d42> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thuê, mượn linh kiện, phụ kiện của xe ô tô khi kiểm định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/04df8b45e0f1234b80760349075e9c25af17752e087dd8675222b177496a8cb3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0529007ae2798b8b635ca6dd83074bf46956ccdffa7c01cc468820306dcde627> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) đã hết hạn sử dụng, hết hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/057148f7e61601fdd385bfa461f410a5c175861362dcd1ba467b7eef67a84207> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi xe bằng một bánh đối với xe đạp, xe đạp máy; đi xe bằng hai bánh đối với xe xích lô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05cc067d864873646beee1e545a1ed9aaa9abe18391fb718ad0ba7a73e149f39> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục đổi chứng nhận đăng ký xe, biển số xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05d86094c23689a2549be34fca4f4c09095f7deef47e8033ebdb454f90e09f63> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thực hiện việc thử nghiệm, chứng nhận không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0650f6003b6ba24e8a004d83f6f9a2d819964afbe09974c8f0b86b29af8a94e2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều của đường một chiều gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/06517ed407e9fb97405833b9ac3e2567fa96cba334b1e1db68eaa5e6401b5f48> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe không có đủ màn hình để công khai hình ảnh giám sát phòng sát hạch lý thuyết, mô phỏng các tình huống giao thông, kết quả sát hạch lái xe theo quy định hoặc có đủ màn hình nhưng không hoạt động theo quy định trong quá trình sát hạch"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/068c3c52c5a80050e5609ee07e58cc5c402a4999c5f088519da6d9ab79eeaf33> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/06b0a8d49a9f354ec3479cc5a928b0a3a5f96eb63fb7581d3dc842b8ff1f6a21> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng nguy hiểm mà xe ô tô không lắp đèn hoặc tín hiệu cảnh báo theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/06fc0f1b73a09fec563bdf3c940040767666289c76d9b44507f4691434ef5f15> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lưu hành phương tiện trên lãnh thổ Việt Nam quá thời hạn quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0708b515c36c3c43448e2e712703f35c371ba05f49489a85d17cbe78eccfb6f5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tránh xe không đúng quy định; sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau; không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0763e3a640ea7bf0de8b0c82ebf8b20ad1a454b39ec75273e790ec7e12c1d1bc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe sử dụng biện pháp kỹ thuật, trang thiết bị ngoại vi, các biện pháp khác để can thiệp vào quá trình hoạt động làm sai lệch dữ liệu của thiết bị giám sát thời gian học lý thuyết, thời gian, quãng đường học thực hành lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/07baf515b3fe095a6b496a072da5c5dfdd3fa48cee2444ba6044872698f076ae> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe thành đoàn gây cản trở giao thông, trừ trường hợp được cơ quan có thẩm quyền cấp phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0813dd7079ba8e5bfe911cb6d806215dbdc882abc4186232d7e3e2a6103fc8f9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ các quy định về nhường đường tại nơi đường giao nhau, trừ các hành vi vi phạm quy định tại điểm c, điểm d khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/08563dcf7a29c409b8b3f58391698ab2cf8fbb1a06dd2e485d2c9135175e171a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện biện pháp bảo đảm an toàn theo quy định khi phương tiện bị hư hỏng trên đoạn đường bộ giao nhau cùng mức với đường sắt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0859b19ed88101f7bcc4ca48ad053ffdcdb0ed54f0d3cf99a37c0c14dcf516b7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy ở làn dừng xe khẩn cấp hoặc phần lề đường của đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/08dd6dadef7e63b230c5abbe05ee44cb8b424d5b966f15fa10e3ec181c6a60dd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/093009a7fb573726031f6ade7be14155aa2388924a6ec9784986138d8391b395> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải hành khách lắp thêm hoặc tháo bớt ghế, giường nằm hoặc có kích thước khoang chở hành lý (hầm xe) không đúng với thông số kỹ thuật được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/093f8e8e8c0f906bee036beadb5e6c74d89db181854cbf9d4100971bc42fb49a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện biện pháp bảo đảm an toàn theo quy định khi xe ô tô bị hư hỏng ngay tại nơi đường bộ giao nhau cùng mức với đường sắt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0941cfa6230213696c542b2548706ac70a4225ddda35157e72f5c75415fcb699> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đi bên phải theo chiều đi của mình, đi không đúng phần đường quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0973c54ce042dac3a2baf3c243327b7ad9b2df74cdb1e130a714fcf34fe0f131> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải có lắp thiết bị giám sát hành trình của xe nhưng thiết bị không hoạt động, không đúng quy chuẩn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0989be98ce5aa05cb93d474d0e5dcc65e16440d9dc3f0031d96b090916e55099> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành chạy không đúng tuyến đường trong giấy phép xe tập lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/09929eb9adf075ba962d4ed7c5f92c74c456e15bced4a3ff38e6daffa69df505> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/09a9f6b2c322607bfec9d79fb7f40f63d5c7ad8821e9d90329ff268baa584c87> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng thiết bị, dụng cụ không đảm bảo theo quy định của pháp luật về đo lường để kiểm tra chất lượng xuất xưởng xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a048de0ffbd8c640bbaa71ee64278fe5a405ea5fd2342c674dd2fabcff5f655> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, trừ hành vi vi phạm quy định tại điểm c khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a0ccbce03ea2b56ac03aac23290a6eb8d7f05323c4f894179e9714ed67722c1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 10% đến 30%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a17103d432a2c9ba0cf3ab6c665177f1f7ea02bab5ca457fb742dbfac7bf09b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi nhãn hiệu, màu sơn của xe không đúng với chứng nhận đăng ký xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a4e41a70f17034067f2385d361ef8290d0060340b5a1ed1ff11da45b406f3c1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thực hiện hành vi vi phạm gây tai nạn giao thông không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, không ở lại hiện trường hoặc không đến trình báo ngay với cơ quan công an, Ủy ban nhân dân nơi gần nhất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0ae8bdb65c360f06ee3ba1b713e3c4f27cd7460650e64ce3e07a87d7c4eb82c5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh hoặc chỉ dẫn của đèn tín hiệu, biển báo hiệu, vạch kẻ đường, trừ hành vi vi phạm quy định tại khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0b07db0d5b5d57789199936d4c08a6dad5696a7b3e02a8e0d8caed552abc9485> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe không lắp đủ camera giám sát phòng sát hạch lý thuyết, mô phỏng các tình huống giao thông, sân sát hạch theo quy định hoặc có lắp camera giám sát nhưng không hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0b3ee5f7c96a8026f93f2d3a166135a772b724354523f9b98f5900c987af61bf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đổ trái phép rác, đất, cát, đá, vật liệu, chất phế thải ra đường phố"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0b453044c1dc4b913f997374bd8a35a872839d61259a2e463790c192490187b3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng chân điều khiển xe đạp, xe đạp máy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0b54dc30fd6f9f0d04d2e3f2588f33af7698fc3253ddcf4997b47ccaf078a861> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe trung chuyển chở hành khách không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0b7b011d19dc754bdb57fae1f80366b6a8bde8b1f2141aecb176813813c7b9d6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0bec4b6bb34b7ab86f7d5a431f920b1ae4a3aeb6e50a3c95bb0b7e5b1e48be94> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hành lý, hàng hóa vượt quá trọng tải theo thiết kế của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0c30686471d654314c8086ae19afea7d2c94970538d3836ed82e1668e21f8653> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không đủ hệ thống hãm hoặc có đủ hệ thống hãm nhưng không có tác dụng, không đúng tiêu chuẩn an toàn kỹ thuật (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0c4977b340d24ad5a05bbb3b78c6170a322b896e287cd035e08b4940e7fd0c54> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ đi vào đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0ca3908dc08db6e62de0308ba7f01cdebac780916fc9e042d3b3f97f32bd202e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0d7915aae68ebfd391e4147af02012531d18b5d3dfad6a8fae235b0b258a747c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe bánh xích tham gia giao thông không có giấy phép lưu hành hoặc có giấy phép lưu hành nhưng không còn giá trị sử dụng theo quy định hoặc lưu thông trực tiếp trên đường mà không thực hiện biện pháp bảo vệ đường theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0db7ac3d1e96d2b9ad133d5261d21cab04a659fa5463cacf8da779c48ee7908a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở đất đá, phế thải, hàng rời mà không có mui, bạt che đậy hoặc có mui, bạt che đậy nhưng vẫn để rơi vãi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0e4536e1f9568c9a3c29e02ca685056d137d42bf013f3f8766da62d5f07adeee> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe ô tô tải (kể cả rơ moóc và sơ mi rơ moóc) có kích thước thùng xe không đúng với thông số kỹ thuật được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0e9ebce2e66227b2dd4c4f09ada96293048be137c267eba14724c4c84097e399> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0f300842d4fe12a5c77a9cc0cf03b754fad770ea8dce44ee6db47b7bc325bc2e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có giấy phép lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0fc231e36632871b64585e0db05207760be5e7bab11a4fa35ed6290d019ba991> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều trên đường có biển “Cấm đi ngược chiều” gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1008781d67e35a952712ae965ce07c9170c32c3dcc769b1ffa3c06bb99949d76> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cản trở người, phương tiện tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/101602467bf64d6d3fce1b8c8e3b9438185c91667ac408dce5fda5a477cdd921> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô chở người từ 08 chỗ trở lên (không kể chỗ của người lái xe) kinh doanh vận tải hành khách không lắp thiết bị ghi nhận hình ảnh người lái xe hoặc có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định hoặc làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/10547840eb600b4e946ce37bb3997aaa8bc7e18765c0f60e9455739a1d5ae190> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1071fb6a2ab5b40b1c69d496396c954005482bc4b087a70a557d322e19166841> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe tại vị trí: nơi đường bộ giao nhau hoặc trong phạm vi 05 mét tính từ mép đường giao nhau; điểm đón, trả khách; trước cổng hoặc trong phạm vi 05 mét hai bên cổng trụ sở cơ quan, tổ chức có bố trí đường cho xe ra, vào; nơi phần đường có bề rộng chỉ đủ cho một làn xe cơ giới; che khuất biển báo hiệu đường bộ, đèn tín hiệu giao thông; nơi mở dải phân cách giữa; cách xe ô tô đang đỗ ngược chiều dưới 20 mét trên đường phố hẹp, dưới 40 mét trên đường có một làn xe cơ giới trên một chiều đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/107af0ec0acd043f3e98f0b8ae824d9e5da87ddd4b1e5aecc3ae620929e3dec7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường cho xe xin vượt khi có đủ điều kiện an toàn hoặc gây cản trở đối với xe cơ giới xin vượt, gây cản trở xe ưu tiên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/111450b176c83e7199afa6b2b0f71364db32734ad8ecb284301241efc63314e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lạng lách, đánh võng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/112e02a4b46024a99cbe8f1837c82dc11dfbeb58c2c962fd492966058ecb745b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/119fe354e97cd3448714c6717bc83d38f872af36ba2642f99aa5e1d6e21eb94e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

