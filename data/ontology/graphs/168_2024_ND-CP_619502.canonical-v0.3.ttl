    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải không lắp thiết bị giám sát hành trình của xe đối với hình thức kinh doanh vận tải có quy định phương tiện phải lắp thiết bị"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3b63ae42155124d289d7e8499b3e6bf1efedcdd26bcec80823de6f236db846af> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh không có màu sơn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3bc8adb0c0b6aad0b4abeec6db27d8a65f2366f7c7329ebcdbaecd9e2380ea09> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải có niên hạn sử dụng không bảo đảm điều kiện của hình thức kinh doanh đã đăng ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3c85c908de419603d4ae57d80a87b2350d303c182323ac0493f93112a87170b4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ hệ thống phòng học; phòng học không đủ trang thiết bị, mô hình học cụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3d647c5e6e171ac1841fc4e248e3836716e9644ec6faaa9714fc8da98f0c28ae> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người được chở trên xe đạp, xe đạp máy sử dụng ô (dù)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3db9927132b3ae4102d6ca133b8002523e95c7acc13619814dce4a2eb75e9fd5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp đặt, sử dụng thiết bị âm thanh, ánh sáng trên xe gây mất trật tự, an toàn giao thông đường bộ."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3f32492d1e5c200f70e2debae575bb7e140ff7d20161ae70814ccc67cac81feb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong cơ thể có chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3f9daa57fc961cd77ba6c6f9f3bdceba56e21a2ebf982ed974d52629e24e72a7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng không có báo hiệu kích thước của hàng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3fa31b976185f59362cf5140ea0d0cb341f50db8c436b5eceb2728990058059d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm a, điểm c, điểm d, điểm đ khoản 2; điểm a, điểm d, điểm đ, điểm e, điểm n, điểm o khoản 3; điểm a, điểm b, điểm đ, điểm e, điểm i, điểm k, điểm l khoản 4; điểm a, điểm b, điểm c, điểm d, điểm đ, điểm i, điểm k khoản 5; điểm a khoản 6; khoản 7; điểm b, điểm d khoản 9; điểm a khoản 10; điểm đ khoản 11 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3ff1b8da6b7c5a3ec8cba151f5dbab1c415f0d20bb24ef4aca6cc389f292fb3f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe tổ chức đào tạo lái xe ngoài địa điểm được ghi trong giấy phép đào tạo lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3ffaaa6fa8a66f38fa19935bcac067be8c40e9ee0e66c5f82517df888aa69c0b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đi đúng phần đường, làn đường gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/402365c2ff524398cfcbf687a8db289af938015ba923570c2bbbf8289741c78b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe tại nơi đường bộ giao nhau cùng mức với đường sắt; quay đầu xe tại nơi đường hẹp, đường dốc, đoạn đường cong tầm nhìn bị che khuất, nơi có biển báo hiệu có nội dung cấm quay đầu đối với loại phương tiện đang điều khiển; điều khiển xe rẽ trái tại nơi có biển báo hiệu có nội dung cấm rẽ trái đối với loại phương tiện đang điều khiển; điều khiển xe rẽ phải tại nơi có biển báo hiệu có nội dung cấm rẽ phải đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/402516d7eb5437687a41e9ee8ec26331e9ab990951b1519f16b1a547b165fa57> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đơn vị sản xuất, lắp ráp, nhập khẩu thiết bị giám sát hành trình của xe ô tô không báo cáo về việc cập nhật, thay đổi phần mềm của thiết bị theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/407f60b4b7a31cb5464da22344ad21c90959af08f7bda44c731b2b5b41e47a9a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Mượn linh kiện, phụ kiện của xe ô tô khi kiểm định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/409235193c8ee4f2924725112f0b60f5b4181b3b33b33415409e946a72b7bf64> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/40cddc5d86bb342bc7340bf4f518cdbccf90d97ff5748d9833499ab02e437aa6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đủ dụng cụ đựng chất thải của vật nuôi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/41bc59fb3f7ae232f11e0cebff446d92e4792389e2dc49beceb19baade2f741f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ, xe cứu thương không lắp thiết bị ghi nhận hình ảnh người lái xe theo quy định hoặc có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không ghi, không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định hoặc làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/424488b206097ed0e0a3ba62e3cf8429d6401ee2b6cb541d34da0d8de77460e0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên đường cao tốc không đúng nơi quy định; không có báo hiệu bằng đèn khẩn cấp khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe ở làn dừng xe khẩn cấp trên đường cao tốc; không có báo hiệu bằng đèn khẩn cấp, không đặt biển cảnh báo “Chú ý xe đỗ” (hoặc đèn cảnh báo) về phía sau xe khoảng cách tối thiểu 150 mét khi dừng xe, đỗ xe trong trường hợp gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe trên một phần làn đường xe chạy trên đường cao tốc."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/436f08f7f3f88bf4eee8fd233417a241097d30b7066b48ff9c8451867a23ef22> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ không lắp thiết bị ghi nhận hình ảnh người lái xe hoặc có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định hoặc làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/44b3df60c4cc1eab24283a64e42ae8bb267ac942017631e1080eed1677f4a44c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe, biển số xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/44e94db18ece70cc7d8271e64d9c8fed4f589d7c1a1f5d6ae585b587f7c3b8b6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lạng lách trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/451fa2e78ceebc3d10b8145465b6b765bbcf3466bb42de6c55fa28581837a8bc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm d khoản 9, điểm đ khoản 11 Điều này, hành vi bị cấm đi vào công trình thủy lợi và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/45ff05714d4ac70f8915e0d2e38695e2146dd81f1f8c0a793dc4aa80be37a3cd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển phương tiện không gắn ký hiệu phân biệt quốc gia theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/46076b0d30898e42e53c961d8363891547bf43585326c0f614495ab9b05518c4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Kiểm định, cấp giấy chứng nhận kiểm định cho xe cơ giới, xe máy chuyên dùng, kiểm định khí thải xe mô tô, xe gắn máy không đúng quy định, tiêu chuẩn, quy chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/460e3ec9de24a50a176a3fa91621ecc808c4e407343a139a1d8eee8b683058f9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải quá thời gian quy định tại khoản 1 Điều 64 của Luật Trật tự, an toàn giao thông đường bộ; không thực hiện đúng quy định về thời gian nghỉ giữa hai lần lái xe liên tục của người lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4623d6269ba42cb4ca6aae8938a5dc951c8a6b18d91e1f4b3ae7c8d85a314f72> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ các quy định khi vào hoặc ra đường cao tốc; điều khiển xe chạy ở làn dừng xe khẩn cấp hoặc phần lề đường của đường cao tốc; không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/46a770a06484f7b55e110f9ca25d975cf049f38dc955657eaae0d07f96592aea> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi hoặc sử dụng phần mềm sát hạch, thiết bị chấm điểm, xe sát hạch khi chưa được sự chấp thuận của cơ quan quản lý nhà nước có thẩm quyền"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4713edc02ed8e0d801c005f5604e1d87fb64b7b3882b02d56327bdf31070801c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4771935a100b6b3405d1060ba25f7a74f2a3067e817bdbe33e3172590fd620eb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không gắn biển số (đối với loại xe có quy định phải gắn biển số)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/490e3cb230733d1bb81a050aa36e9d9dd56b18a107e38b1c198c413808065494> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hành lý, hàng hóa vượt quá khối lượng cho phép của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/491aebaea40c416725c54e709ceea41bed8eaddc079d984c9693da7859ce9ba8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lưu trữ hồ sơ, tài liệu, dữ liệu kiểm định, cải tạo xe không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4938039fbcc137109dc88021c60a13e3db4aa2fefb3c918a785560cd74964487> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tập trung đông người trái phép, nằm, ngồi trên đường bộ gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/496486d40d934696a6bdada07cab1466183529316d8a62f1ee4e7e6d5cef50ed> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy bằng hai bánh đối với xe ba bánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/49a6383c9e757c0af0c9bd96c630b5f0ac901d4b50a3e8aaba61d10e96aed951> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đi vào đường cao tốc, trừ xe phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/49b7f92effc94331c879fca9e7f6d5549feed22283b8101d0d66e56c1d9de6d8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô tải (kể cả rơ moóc và sơ mi rơ moóc) có kích thước thùng xe không đúng với thông số kỹ thuật được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/49fe934bbfa3bdfdba2ba5b919df2d133a8f48b88b0781febcc71b1f8f4ad176> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường hoặc gây cản trở xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4a59ef06befdff9559fd8cf0a2785ba3d321b2305707aef5b4ad3bdc314455c4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm không có giấy phép vận chuyển hàng hóa nguy hiểm hoặc có nhưng hết hiệu lực hoặc không thực hiện đúng quy định trong giấy phép vận chuyển hàng hóa nguy hiểm, trừ các hành vi vi phạm quy định tại điểm a khoản 6 Điều 20 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4a8419f48100c2523ac53c95a7949400afea5041e11951761927b1db70fd7772> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giấy tờ của phương tiện không có bản dịch sang tiếng Anh hoặc tiếng Việt theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4af588f81df14d6e1f665a5e8ca5f13ac5229bc529a76b5f406d3bf0bb6367c2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có niêm yết nhưng không chính xác, không đầy đủ thông tin theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4b60049800904ff318b0797d9fa8617114391f7b65fa33e2948341e34f0eeec5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách an toàn để xảy ra va chạm với xe chạy liền trước hoặc không giữ khoảng cách theo quy định của biển báo hiệu “Cự ly tối thiểu giữa hai xe”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4c2ebf59abba5e81e640e886632b09740374232314fca64a45a0519b7fe98449> a loroc:RegulatedConduct ;
