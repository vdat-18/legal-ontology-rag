    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy quá tốc độ quy định từ 10 km/h đến 20 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7d2d146ac317cda09d57e8ec3d070924958897de79cecda1c99d53fadec62cd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe đột ngột; chuyển hướng không báo hiệu trước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c81a23112556108d9bba49e594717947c7aeab4c6a5ed2712fff4f1113d983c2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy tốc độ thấp hơn các xe khác đi cùng chiều mà không đi về làn đường bên phải chiều đi của mình, trừ trường hợp các xe khác đi cùng chiều chạy quá tốc độ quy định"@vi .

