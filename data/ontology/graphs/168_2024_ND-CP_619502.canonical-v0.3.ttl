    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) mà không sử dụng cơ cấu khóa hãm công-ten-nơ với xe hoặc có sử dụng cơ cấu khóa hãm nhưng công-ten-nơ vẫn bị xê dịch trong quá trình vận chuyển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dcc93768de089504a795647eceb5886421abade528847e97c23d2e9290afd021> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu nội dung cấm đi vào đối với loại phương tiện đang điều khiển; đi ngược chiều đường của đường một chiều, đường có biển “Cấm đi ngược chiều”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dccb08a5a55fd45bc4d39e9bdbe27683ff9d18962f5ec28412419c990b24f0dc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có giấy phép lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd05f948d5eea2b35f91ce91aa70e4cbff75a273811e53586e783a4d372ad297> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe tập lái không có mui che mưa, nắng; không có ghế ngồi gắn chắc chắn trên thùng xe cho người học theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd0eeec2c99a7f06c759de218a3e36543e6459358d11cdf80e227fe1a1521805> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo chứng nhận bảo hiểm bắt buộc trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd233d9b840e3f1b44724ac18b291cefe03d2021d3bc98f9370729193ae6b2e2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd662c09b49266eccda3879dc4db36d952741553ba58e50018d542da8bf7ad01> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người từ đủ 14 tuổi đến dưới 16 tuổi điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy hoặc điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd6ceb0012a131d89004ec71f9cf8bc0312f96c3c8f0f5fc7712d6ac7834c9d6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khi ra, vào vị trí dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd77e76e07efd3481c15127744635d54a1fb614a7c8c612ec1e2a5391369711f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp kính chắn gió, kính cửa của xe không phải là loại kính an toàn."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd91d373f6a711e03a22d5cc95503fa7a9a8a33affde20541b3c006f2787acf1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hành khách theo tuyến cố định không có hoặc không mang theo lệnh vận chuyển hoặc có mang theo lệnh vận chuyển nhưng không ghi đầy đủ thông tin, không có xác nhận của bến xe khách nơi đi, bến xe khách nơi đến theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/de094474fb18685985172f8b1f6a0e54ca0d81ee090d2d757759478ef3fa125e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không niêm yết hành trình chạy xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/de3cde7065ddcb9dd7c56a1660cac3a89020c60c39c59962f621f71681dbac71> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng nội dung thông tin đã niêm yết trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dec60ed807a5bda4f99ec6548f3e72a73cdbfc5020373ff5741fed531115c3be> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người ngồi trên xe không đội “mũ bảo hiểm cho người đi mô tô, xe máy” hoặc đội “mũ bảo hiểm cho người đi mô tô, xe máy” không cài quai đúng quy cách, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 06 tuổi, áp giải người có hành vi vi phạm pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/def0e326b768598df2180d77d4b331b6bc8bea6aae351d8a968e1cb6b973d409> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không hướng dẫn trẻ em mầm non, học sinh ngồi đúng vị trí quy định trong xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df30002e240d269c1f0ed87e2e05a8e59379749fbfdd09c7513db141bdf55182> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe; biển số xe; giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df8236ba565b255dd5dd2acac24b90d08c6cf082cb74f9c65d42348d8889d727> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy phép lưu hành còn giá trị sử dụng nhưng tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe (bao gồm cả hàng hóa xếp trên xe nếu có) vượt quá quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df892f18719649d4c108551d88a30b72485ba5d56877ca00790b42426ce63b49> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chiếm dụng dải phân cách giữa của đường đôi làm nơi: bày, bán hàng hóa; để vật liệu xây dựng; để xe, trông, giữ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dfbf64d03a1ac0d26d84829321742a72c0209cd658d26c537c50567c6738b5de> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có các bộ phận chuyên dùng lắp đặt không đúng vị trí; không bảo đảm an toàn khi di chuyển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dfe5f787fca9c3c9dd5dd7e05a5fdca673a7d4ea912cb92dc7062f43b4d2622d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu thương không lắp thiết bị giám sát hành trình hoặc có lắp thiết bị giám sát hành trình nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định hoặc làm sai lệch dữ liệu của thiết bị giám sát hành trình lắp trên xe ô tô."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dff13565b09b67855ac11821e4cb9bde166dceb01c9f814050ccbbb0c94816a9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dff6ad2f13097d05e768668f23b2882dc296f7023901fba3df023270d78c646a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e03a3b663f069cd453a60233c952cbb16058e295832544591b79f59ac2593bb6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường rộng; dừng xe, đỗ xe không sát mép đường phía bên phải theo chiều đi ở nơi đường có lề đường hẹp hoặc không có lề đường; dừng xe, đỗ xe ngược với chiều lưu thông của làn đường; dừng xe, đỗ xe trên dải phân cách cố định ở giữa hai phần đường xe chạy; đỗ xe trên dốc không chèn bánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e05aeb6f6d57707827f6e808d183c46924fcebb7ca39eb45c0ca84590a29a116> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Rời vị trí lái khi dừng xe nhưng không sử dụng phanh đỗ xe (hoặc thực hiện biện pháp an toàn khác)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e06440c33e6c2c81283449b3c48a68fdbc2b0f49da77a250f7983e8b1c44f3d7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng bàn trượt, pa-tanh, các thiết bị tương tự trên phần đường xe chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e06edea34f49ca11c631742619433b552569c57bb224243ee4c1d37f6ecedd0b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cải tạo xe ô tô loại khác thành xe ô tô chở người"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e08163db0bae51f811b63a9917a7e517b44842fca8134bac4023b5249f185fdf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm sai lệch thông tin, dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e12c91c7315bb450838c7cd0151bb274ac19d2696ce9b295f749d8b0a46ee851> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, người quản lý trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được hướng dẫn về quy trình bảo đảm an toàn khi đưa đón trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e1707755100dadbdc3976a9bf60d6ddf09a0e9267d8f926170b7e25797bd8e64> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đe dọa, xúc phạm, tranh giành, lôi kéo hành khách; đe doạ, cưỡng ép hành khách sử dụng dịch vụ ngoài ý muốn; chuyển tải, xuống khách hoặc các hành vi khác nhằm trốn tránh phát hiện xe chở quá tải, quá số người theo quy định của pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e17a145431812d0040d7cf27e8efc8881ad2981a7ca8d4ef3729a0c4f65fcdea> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển vật thể bay, tàu bay không người lái, phương tiện bay siêu nhẹ hoạt động trong phạm vi khổ giới hạn đường bộ gây cản trở hoặc nguy cơ mất an toàn cho người, phương tiện tham gia giao thông đường bộ, trừ tàu bay không người lái, phương tiện bay siêu nhẹ được cấp phép bay"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e18e1d2f45fb38ec5f6197011860222e0f7e6d369eec484c106eefe834cc0b9b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe không có hệ thống âm thanh thông báo công khai lỗi vi phạm của thí sinh sát hạch lái xe trong hình theo quy định hoặc có hệ thống âm thanh thông báo nhưng không hoạt động theo quy định trong quá trình sát hạch lái xe trong hình"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e21830a8bdd55ee67b6f711fb49ce24684d051639dbd6a16dbc338476d9f0b22> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển khách liên vận quốc tế theo tuyến cố định không có hoặc không mang theo lệnh vận chuyển, không có danh sách hành khách theo quy định hoặc chở người không có tên trong danh sách hành khách, trừ hành vi vi phạm quy định tại điểm b khoản 1 Điều 37 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e23337f51e496ef3f618186ba281c221787fa2cd1b5d2da8a22f761fbe351164> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe đạp, xe đạp máy, xe xích lô chở quá số người quy định, trừ trường hợp chở người bệnh đi cấp cứu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e2547c575319ecf65350b78b514497f96473169adfa259e7752e35a4906dd012> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe mô tô ba bánh không quan sát hai bên, phía sau xe hoặc không có tín hiệu lùi xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e2770bcb7015ecf1fa2bc6723d2ceb440ef4ce1cefdeb3537cf8694692b679e8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đánh võng trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e2981b63730efb7e541af2203601df49ff490e8b13c50bfef1b9741587a49a17> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe ô tô kinh doanh vận tải hành khách lắp thêm hoặc tháo bớt ghế, giường nằm hoặc có kích thước khoang chở hành lý (hầm xe) không đúng với thông số kỹ thuật được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e29873d099b30544271df8d0bf3ab8b2699e83e6ae6f17239d2c88001802bb2e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi không đúng quy chuẩn kỹ thuật cho từng loại xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e29e155d341c38e3949f0ca15f9cfdc0360f9d8e07ae1670c0a317e6b16878c3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e2cbc8e7e53a5373f33eb30387a6f07572aee4227bdf74878ced8d6091bac142> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe (bao gồm cả hàng hóa xếp trên xe, người được chở trên xe) vượt quá tải trọng cho phép của đường bộ trên 20% đến 50%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e2cf525ca232ca98b40a3d4e6cc291a390548a0832cbb8aaefc4adb632f23a46> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm mà không mang theo hồ sơ vận chuyển hàng hóa nguy hiểm do người thuê vận tải cung cấp theo quy định, giấy chứng nhận hoàn thành chương trình tập huấn an toàn hàng hóa nguy hiểm phù hợp với loại, nhóm hàng hóa nguy hiểm đang vận chuyển (nếu có)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e30e85a512eed6a3f4112a8c8b49ad07f240d353f6f39410838e4115574ff616> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có đủ đèn chiếu sáng; không có bộ phận giảm thanh, giảm khói hoặc có nhưng không có tác dụng, không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e318b9e0477cb58df08de383b734d0d019b87ba726a08a28d4230fdf626895f2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên điểm đón, trả khách, nơi đường bộ giao nhau, trên phần đường dành cho người đi bộ qua đường; dừng xe nơi có biển “Cấm dừng xe và đỗ xe”; đỗ xe tại nơi có biển “Cấm đỗ xe” hoặc biển “Cấm dừng xe và đỗ xe”; không tuân thủ các quy định về dừng xe, đỗ xe tại nơi đường bộ giao nhau cùng mức với đường sắt; dừng xe, đỗ xe trong phạm vi hành lang an toàn giao thông đường sắt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3b4db32b044ddb4e6e40bbc0b1843f198a48b13cd9f45802aabf96babf88cf4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe tổ chức tuyển sinh, đào tạo không đúng hạng giấy phép lái xe được phép đào tạo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3deb4b2ca35bf09650b57f8463979bdc013ef76618f8c324af9be2340608acd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng hoặc chất thải để nước chảy xuống mặt đường gây mất an toàn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e40d62e42b06feb02a137a8798ad683dab72e465be1635ee6bc78adace0948dd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường đường cho các xe đi ngược chiều; người đi bộ, xe thô sơ đang qua đường tại nơi không có vạch kẻ đường cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e44351ebbdc52014d43b517fb5201ef8b86b165c3943dddcaab37f6c7bd7e569> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có biển báo dấu hiệu nhận biết là xe chở trẻ em mầm non, học sinh theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e474144f9fc8c85c5f2742845b76d60957542206e7c1880631ef33970750d671> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có đủ đèn chiếu sáng, đèn soi biển số, đèn báo hãm, đèn tín hiệu, cần gạt nước, gương chiếu hậu, dây đai an toàn, dụng cụ thoát hiểm, thiết bị chữa cháy, đồng hồ báo áp lực hơi, đồng hồ báo tốc độ của xe hoặc có những thiết bị đó nhưng không có tác dụng, không đúng tiêu chuẩn thiết kế (đối với loại xe được quy định phải có những thiết bị đó), trừ các hành vi vi phạm quy định tại điểm h khoản 3 Điều 20, điểm đ khoản 4 Điều 26 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e4f14e794f1cf38a9444ebd547af4816b5c6f5cc32022e92b2dbfc1b4b9de7b0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển, dẫn dắt vật nuôi đi không đúng phần đường quy định, đi vào đường cấm, khu vực cấm, đi vào phần đường của xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e55fb9e7772861078907e55a835ae1749a8afdc9b89ee912a1bafe20e5134da2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) đã hết hạn sử dụng, hết hiệu lực (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e59d31ac4446a30969ccffe7695e7cb1b8d60f7a68abbd16aff213f723a83b9b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Ngồi về một bên điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e5e04a590ea86de05b94c6fbdc1dc1ff1a21f47e49e0eb70bca3d41076a04314> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đi đúng phần đường, làn đường gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e600c4d34cb537ef240792ad39174851a56e63af73e119658fa28f870c453218> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện không có giấy chứng nhận kiểm định khí thải xe mô tô, xe gắn máy hoặc có nhưng đã hết hạn sử dụng hoặc sử dụng giấy chứng nhận kiểm định khí thải xe mô tô, xe gắn máy không do cơ quan có thẩm quyền cấp."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e60307d42ea9ee843ac3bf9bf6c0ed47a9e2c5e8ededd1e7e8c00db658e9a3d9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đội “mũ bảo hiểm cho người đi mô tô, xe máy” hoặc đội “mũ bảo hiểm cho người đi mô tô, xe máy” không cài quai đúng quy cách khi điều khiển xe tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e636a3f219375024f6a4690045fd8620ecbc2697cc159bda47cbdde2157f1e37> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc cung cấp, cập nhật, truyền dẫn, lưu trữ, quản lý thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e720774f78d9f161747020720e8383e3835b67133c48f85f043b81109fc24ff8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không dọn sạch chất thải của vật nuôi thải ra đường, vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e7743dbbb845c95ed153c431a231f4ec500c17fb24913e490ca2d54c0ecafa6b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải quá thời gian quy định tại khoản 1 Điều 64 của Luật Trật tự, an toàn giao thông đường bộ; không thực hiện đúng quy định về thời gian nghỉ giữa hai lần lái xe liên tục của người lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e7898ba406cb3c41cb1df9202e763ce8922129859b743ecfb2b1330354bd3780> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tránh xe đi ngược chiều không đúng quy định, trừ hành vi vi phạm sử dụng đèn chiếu xa khi tránh xe đi ngược chiều quy định tại điểm b khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e805ae2ede729713c75aa37d2f0d2146ccdfdcbb49bc100cd07b38db8fbb7e4a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không đi bên phải theo chiều đi của mình; đi không đúng phần đường, làn đường quy định (làn cùng chiều hoặc làn ngược chiều); điều khiển xe đi qua dải phân cách cố định ở giữa hai phần đường xe chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e8156ee074ece91959433b95d909b514e87979e332befdba2315be576c173e2d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bám vào thành xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e8cf653b98f7ba71de21bed5f721141caf5bdc8d0f1c69e5fbd1f640f9913181> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường cho xe xin vượt khi có đủ điều kiện an toàn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e91b16a0c5f7cce78c794c181c0292aa8374faf950edf6d387244f5f379c3def> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e91df3372d384d134e8863a2790dc95676df91abbe79b6e01503769379529f02> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e93107b27a1926d062e18239deaf979fe4c8d506fc8cf3965e4c10b238b33ff1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e9a70ed98571cd4cae143dd62710418313319b50666913748e43636a9532971b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e9d79ded1296111d55f7391d694098119306c7e5e4079300a805fd1b7ad20a1c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi khung, máy, hình dáng, kích thước, đặc tính của xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ea29a4342a87bf48c00019f0230d60c00fc716ae0e1a785d723b7ff7d92c56aa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để vật che khuất biển báo hiệu đường bộ, đèn tín hiệu giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ea2ee3ad08e9013e593f2ca2e0a3e4ab3fd493b4099ec64c9c1f2eeafd54ede0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không gắn đủ biển số hoặc gắn biển số không đúng vị trí, không đúng quy cách theo quy định; gắn biển số không rõ chữ, số hoặc sử dụng chất liệu khác sơn, dán lên chữ, số của biển số xe; gắn biển số bị bẻ cong, che lấp, làm thay đổi chữ, số, màu sắc (của chữ, số, nền biển số xe), hình dạng, kích thước của biển số xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ea354debf3b90c72cf8ee8280ee4e411bc12cb531f49c9b5d4e4aa8bf3c1a9f9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) dưới 01 tháng (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ead99f6075dc9a4e6e864f90aeff2446bbcd4f2c75b9331b53ea55e5fbc703fb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe xét hoàn thành khoá đào tạo hoặc cấp chứng chỉ sơ cấp hoặc cấp chứng chỉ đào tạo cho học viên sai quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ebd896e42d0c4c104d68ad798b379b847d136b72f63730af269878ddb408146a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có giấy phép lái xe nhưng đã hết hạn sử dụng dưới 01 năm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ebec4dbfd71d740f70edc9a907a1f68a6259cc7edcd1ac12bc59cf21abe1f7f5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ebf7e629031f66021dfbfaafecfbb5f83319108078fa4f9b3955eba9122675ab> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ, xe cứu thương làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec471c756d72d6867dddd8aff745e3be2e477de16748da807cfef5ee17eb363f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện đã bị cắt, hàn, tẩy xoá, đục sửa, đóng lại trái phép số khung, số động cơ (số máy) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ecca3fc7fdd9e1d33fb950d404a18c4f35a1ae1b9b88548997c31b439c9404d1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) không bảo đảm quy chuẩn, tiêu chuẩn kỹ thuật của công-ten-nơ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/edf66d3279a18fcaf9e61c2b04d0fa31eae312775a11c624c60ea1af97a215c6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe đã bị trừ hết điểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/edf8479e0ab73798db5984155886ab3f96cf41b9060f97ea1b4936e31fd32fdc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ee245d3396e9d87b2c8faff27c1317e34f0c97a7d6ef0a94905190bd2337ec5d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường rộng; dừng xe, đỗ xe không sát mép đường phía bên phải theo chiều đi ở nơi đường có lề đường hẹp hoặc không có lề đường; dừng xe, đỗ xe trên dải phân cách cố định ở giữa hai phần đường xe chạy; đỗ xe trên dốc không chèn bánh; dừng xe nơi có biển “Cấm dừng xe và đỗ xe”; đỗ xe nơi có biển “Cấm đỗ xe” hoặc biển “Cấm dừng xe và đỗ xe”, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/eed82104e704d1968c485f9c6d887b4556f4c8568f7b5b7c0a0088cb690e3b2d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành không ngồi bên cạnh để bảo trợ tay lái cho học viên thực hành lái xe (kể cả trong sân tập lái và ngoài đường giao thông công cộng)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ef09cc311f3f9874a1b55913512257641ac861862ca72604c6575aaabbf68d2a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không đủ điều kiện để thu phí theo hình thức điện tử tự động không dừng (xe không gắn thẻ đầu cuối) đi vào làn đường dành riêng thu phí theo hình thức điện tử tự động không dừng tại các trạm thu phí"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ef23980ced0e497766741a35abb00a2b6be713789558b27ef6226df08f16f2fd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f06c61f3a6dfead0fd8a8bae01e57a7aba3e7da25010d77aa04298ec726611fe> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng tạm thời lòng đường, vỉa hè vào mục đích khác (theo quy định phải có giấy phép) mà không có giấy phép hoặc có giấy phép nhưng đã hết giá trị sử dụng hoặc thực hiện không đúng nội dung ghi trong giấy phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f10619c8c5c756e9ca445d77d7bcde8540342162126dc2c52974e1654160baa8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng không có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) hoặc có nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f117d68c74fb18725a7d645c926c72a6426faa3648151ea43e44fb61f619da02> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước khi chạy trên đường cao tốc hoặc chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”"@vi .

