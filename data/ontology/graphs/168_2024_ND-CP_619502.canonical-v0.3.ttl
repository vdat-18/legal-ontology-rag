<https://w3id.org/legal-ontology-rag/data/concept/conduct/dae9b81cb5c04031b12fb06315b2eaa637989cecb2d7def4ab2e11b61f32d0dd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có hệ thống hãm hoặc có nhưng không có tác dụng, không bảo đảm tiêu chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/db4dba09c029d04bf613aa19090b49efff09ee380af1267e61e080406d57c209> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ đúng quy định tại các quy trình, quy chuẩn kỹ thuật có liên quan trong chứng nhận, kiểm định xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/db89131431e3c84cda2be2d53bece1b0bf7b9c35b7d4dd6a29c784b2b83b938a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không do cơ quan có thẩm quyền cấp"@vi .

