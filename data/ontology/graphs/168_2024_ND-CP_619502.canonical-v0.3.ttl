<https://w3id.org/legal-ontology-rag/data/concept/conduct/15e110cc296931d261934d1bc187a7c6577ea31e0202924bd9ed95fbc07bb89f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bán hàng rong hoặc bán hàng hóa nhỏ lẻ khác trên lòng đường, trên vỉa hè các tuyến phố có quy định cấm bán hàng, trừ các hành vi vi phạm quy định tại khoản 7, khoản 9 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1621ffa213d5d2efc1ef108151c0a12b3d5e16edc32196de2af0015701cb5884> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường đường cho các xe đi ngược chiều; người đi bộ, xe thô sơ đang qua đường tại nơi không có vạch kẻ đường cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/16a66914ef581edad7bbd21279da1f85a7d793e183ebf1ff2266c24aea3e4f1b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không quan sát hoặc không bảo đảm khoảng cách an toàn với xe phía sau hoặc không giảm tốc độ hoặc không có tín hiệu báo hướng rẽ hoặc có tín hiệu báo hướng rẽ nhưng không sử dụng liên tục trong quá trình chuyển hướng (trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức); điều khiển xe rẽ trái tại nơi có biển báo hiệu có nội dung cấm rẽ trái đối với loại phương tiện đang điều khiển; điều khiển xe rẽ phải tại nơi có biển báo hiệu có nội dung cấm rẽ phải đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1711206ef1c6749b3f9353c848abf3bc0db6aa490e866937a896fa57e2a6b9db> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có giấy phép lái xe quốc tế do các nước tham gia Công ước của Liên hợp quốc về Giao thông đường bộ năm 1968 cấp (trừ giấy phép lái xe quốc tế do Việt Nam cấp) nhưng không mang theo giấy phép lái xe quốc gia phù hợp với loại xe được phép điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/172438849aab5b4e4fe0ec498a5619d4dabe41dd0536a12de799475a9bc43db0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/174c1a13279ce3168fa4e429955343f321d05f7f6108819d831150184de26345> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/17fc4330447a528da262e564ff2b167e0e8fc78b7b2c3f91200307a7ba4c3d23> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe mô tô và các loại xe tương tự xe mô tô kinh doanh vận tải không mang theo giấy phép lái xe, trừ hành vi vi phạm quy định tại điểm b khoản 5, điểm c khoản 7 Điều này"@vi .

