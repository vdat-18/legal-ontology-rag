    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe không lưu trữ hoặc lưu trữ không đầy đủ hồ sơ theo quy định của 02 kỳ sát hạch lái xe trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cfc88729ce765c8341ce38b483c6f5fbdc81b2746b5ef016d20956855690714a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy bằng một bánh đối với xe hai bánh"@vi .

