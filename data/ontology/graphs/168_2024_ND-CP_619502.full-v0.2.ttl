    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô có tay lái bên phải tham gia giao thông mà không đi theo đoàn, không có người, phương tiện hỗ trợ, hướng dẫn giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/acbc94f422e56874e46b7d7766ce9b62370a87d25be9071c498da14bb0b05f40> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) đã hết hạn sử dụng, hết hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/acf0c0426dab2bbe7ba4cbd16423de2e1ffb64c3551f4a277d2bb8a0c0c9cc84> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tránh xe, vượt xe không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ad4c2892410c3193ae03587d3c8358a125e868f640193e65252f7eb3cd4edf9c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người từ đủ 16 tuổi đến dưới 18 tuổi điều khiển xe mô tô có dung tích xi-lanh từ 50 cm3 trở lên hoặc có công suất động cơ điện từ 04 kW trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ad78cca04fb0a49dbda77832142f2c08ca356bee0039bc501c7f722b902bbb4f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ad99d3dd20b213fb80251a5a9ccc0230320c0646688429bbf86045493bbe443b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không lắp đủ bánh lốp hoặc lắp bánh lốp không đúng kích cỡ hoặc không bảo đảm tiêu chuẩn kỹ thuật (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/add0338b6b95f08d56bd73ff51862ebf7d80e1de5e1c00ab6f420fe2d195d96c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe; biển số xe; giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae6dc134a2b0b0922e9bfc71eeb2531219d1900eb1731a3ad912e63b38fa027e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy trong hầm đường bộ không sử dụng đèn chiếu sáng gần"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aed7a369afc33990564447ae7989d687876d0ae1439c26eaf4342c1055610f02> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không gắn đủ biển số hoặc gắn biển số không đúng vị trí, không đúng quy cách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/af32e91e5634d5f2c402710ea379d51391956f3f44528481b165a6e02231d300> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng không có giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/af8d28fdd2d25a62bc9477ee1ed467976735424ba2659735ae84b6bfca45b23b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe rẽ trái tại nơi có biển báo hiệu có nội dung cấm rẽ trái đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/afc9aaa20f9b6c839f23bf25854346be96fcf81b7d8e13a92cd6ebc92d560d75> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe tại nơi không được quay đầu xe, trừ hành vi vi phạm quy định tại điểm d khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/afd83afc58f933d074d22a06c1044c72ddb95b9b212e95dd140e32fb684bc9ac> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b00fb40d41090438a9c5ca49e5765949d82ba3dc009c2f41f98bb6c1d0d7b115> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 2 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b06d51506d4d3628cf1e3ca4c3e12702217c67f7d02bd59fb0870f1c7a16a20e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người được chở trên xe ô tô không thắt dây đai an toàn (tại vị trí có trang bị dây đai an toàn) khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b0bea36ca155563e133de97da812b91823b46844e52fd86721f546c9dcc89b63> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b136cd7dd7125b836bf2b66d9db6ed8c12350596b2af48506d0161a35af411c0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kéo theo xe khác, vật khác, trừ trường hợp kéo theo một rơ moóc, sơ mi rơ moóc hoặc một xe ô tô, xe máy chuyên dùng khác khi xe này không tự chạy được"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b1a62c371b010c0c8d19d43510959487b5275934b4fb65f85d9537039fccf6ff> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

