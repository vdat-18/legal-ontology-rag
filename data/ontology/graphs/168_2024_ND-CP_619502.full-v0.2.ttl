    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đi vào đường cao tốc, trừ phương tiện phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b4f70eafc1d26182654593b5ddf89f595ad253b0a15aec46ab3853aa4842ad6f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu ưu tiên không đúng quy định"@vi .

