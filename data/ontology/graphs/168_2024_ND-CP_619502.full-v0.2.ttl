    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe ô tô kinh doanh vận tải hành khách lắp thêm hoặc tháo bớt ghế, giường nằm tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b34e0d33b673197f9d72be95d7e0b3157f107c999b8d2baec30ce1a2f0491c34> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi xe bằng một bánh đối với xe đạp, xe đạp máy"@vi .

