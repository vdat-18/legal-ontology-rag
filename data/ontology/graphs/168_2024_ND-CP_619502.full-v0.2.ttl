    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở trẻ em dưới 10 tuổi và chiều cao dưới 1,35 mét trên xe ô tô ngồi cùng hàng ghế với người lái xe, trừ loại xe ô tô chỉ có một hàng ghế"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d53cf4a6e5a71c24fbfa54d59f10bea3bf89ee9d89bd9a0fb92be375af0a7ea8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe ô tô tải (kể cả rơ moóc và sơ mi rơ moóc) có kích thước thùng xe không đúng với thông số kỹ thuật được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d54d61487d0467a8b3123462b71f53b1e04fd02c8474b4103b1903c7901ad388> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d5dd7dc66f6c2ccba0aff21ada546e5215c36f00fc027fc1f6b62f570c57ff48> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện giao thông thông minh hoạt động không đúng nội dung ghi trong giấy phép tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d6769fbd804ee2e14bfcfa1595ef009b35ac37db60fea0ff7090988f24ea17b7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d676eedcdddf848861dd4d9b7e44f0c542e47ca36e3ce8cf4e46a21e792ceea8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm sai lệch thông tin, dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d750cf3ad324bc02736d3b913d0a3b0fc05221025b53d58659901f9d0dfe6ec4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe (bao gồm cả hàng hóa xếp trên xe, người được chở trên xe) vượt quá tải trọng cho phép của đường bộ trên 50%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d7946885df5538e051aed6c7ddec552957b447204b40d746de0cbc321b7c0ec7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe trung chuyển chở hành khách không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d79a2010f1ecb4dfdbc9a694c6f27ee4a6061ead70a10a6d51a61c354ce95659> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Hủy hoại, làm hư hỏng, làm mất tác dụng thiết bị điều khiển, giám sát giao thông đường bộ, thiết bị thông minh hỗ trợ chỉ huy, điều khiển giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d7abbf0cd11ee657d97a088530052fd77a7da09c89a8a692429c3e8a481f05da> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) dưới 01 tháng tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d80b4c2b983df9ce0a7fccc5b051d9ca162c83104c2e2d82c4751bef6ba4ec9b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe tạm thời, phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d82000058c1af4abd1f79805b9c175a8b1d3f76accc328477de9152358e0adfd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng tổng trọng lượng (sau khi đã xếp hàng lên xe) vượt quá quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d8c140b0c750b60a7ac02eb39ddfdb5a0eb40987570816b3eea6bfa597d49b4e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành không mang theo giấy phép xe tập lái hoặc mang theo giấy phép xe tập lái đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d96e637a35f6aafd919da813d368822e0fe67c647a492d721d955ea4bf19cb01> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách an toàn để xảy ra va chạm với xe chạy liền trước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d9a924468bc80213240a4558462856dc9f2fdddba12d0a56eb9791986e6204dd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe tham gia giao thông (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d9eb28b36598e7dd41131a52110acec9bb872c8ab1c45f971a90cb14f4eb8533> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vượt bên phải trong trường hợp không được phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/da3b89caa28f008cea814712b23bc8ad853d7dac5011a92fd21b8bd5c31067a4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe tại nơi đường hẹp, đường dốc, đoạn đường cong tầm nhìn bị che khuất, nơi có biển báo hiệu có nội dung cấm quay đầu đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/da4988152bd8cdace52380bd96a03c4dedc88f56ed833e165e5584a80d09b65a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Ngồi trên mui xe, nóc xe, trong khoang chở hành lý"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/daaee92490ca849e9aed4afc233647888c6fd3df6a4c81228549f71ef004d764> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe bánh xích tham gia giao thông không có giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/db4dba09c029d04bf613aa19090b49efff09ee380af1267e61e080406d57c209> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ đúng quy định tại các quy trình, quy chuẩn kỹ thuật có liên quan trong chứng nhận, kiểm định xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dbf7a181c60b9bf56c1d4155e8001b4bba03565784f4e9d6b94b09e10132ce3d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) đã hết hạn sử dụng, hết hiệu lực (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc10c478fdff465c8d1451acea193f927fb6d9c3b9e9888eea029643d44ff566> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng tạm thời lòng đường, vỉa hè vào mục đích khác (theo quy định phải có giấy phép) có giấy phép nhưng đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc37aa439deb8f232c03a9de3804b9070a6b0fb3d2910322f31918e769cdac81> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển không đúng đối tượng theo quy định đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc4ac0253711e9e366283a78a30e399abc7fe23b0282ad0d3a3c09774706378d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không niêm yết hành trình chạy xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc8771b94a5d8e2057edd7d7b3980ad7dac248b7275415458b4861c368b0ad54> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển gây tai nạn giao thông, trừ các hành vi vi phạm quy định tại điểm đ khoản 11 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd05f948d5eea2b35f91ce91aa70e4cbff75a273811e53586e783a4d372ad297> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe tập lái không có mui che mưa, nắng; không có ghế ngồi gắn chắc chắn trên thùng xe cho người học theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd6ceb0012a131d89004ec71f9cf8bc0312f96c3c8f0f5fc7712d6ac7834c9d6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khi ra, vào vị trí dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd77e76e07efd3481c15127744635d54a1fb614a7c8c612ec1e2a5391369711f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp kính chắn gió, kính cửa của xe không phải là loại kính an toàn."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ddf18938a63553961684a7ee44136df92c37d28f2980b8fcdcfd5614b7411cb6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đi đúng phần đường, làn đường, không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/de0e9203c96f340222180b99b6f109085a5ecb01edab762f64729cd52222d6de> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đón, trả hành khách tại nơi cấm dừng, cấm đỗ, nơi đường cong tầm nhìn bị che khuất, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dea3cfdee78c36114f800b261e86ffff6e863e47d5cd1af2aadd4b43ac18c7a4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cấp lệnh vận chuyển, giấy vận tải cho lái xe nhưng không đúng theo quy định đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dea77c1208d8c04f85a3c77690bdc029c5afe53e91f8669592818fcf9479b8fa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe, biển số xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/def0e326b768598df2180d77d4b331b6bc8bea6aae351d8a968e1cb6b973d409> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không hướng dẫn trẻ em mầm non, học sinh ngồi đúng vị trí quy định trong xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df4867493ee56f4c2ca6e98ddfdd997640b8baf95c8aecd134226d080b94989c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có đèn chiếu sáng gần, xa không đúng tiêu chuẩn thiết kế"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df56c0bbdd1ae32d2c0de27092e549a76b5b2bf3614082d8e4fdb35ed8447aa2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô chở hành khách (kinh doanh vận tải hành khách theo tuyến cố định, hợp đồng) chạy tuyến có cự ly lớn hơn 300 km chở quá số người quy định được phép chở của phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df8236ba565b255dd5dd2acac24b90d08c6cf082cb74f9c65d42348d8889d727> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy phép lưu hành còn giá trị sử dụng nhưng tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe (bao gồm cả hàng hóa xếp trên xe nếu có) vượt quá quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df873d6aa2042955b7ec4c600005b4bff7752b0ea3cc3721c2e9deee3eb35e36> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chở hành khách liên vận quốc tế không có hoặc không gắn ký hiệu phân biệt quốc gia"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df892f18719649d4c108551d88a30b72485ba5d56877ca00790b42426ce63b49> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chiếm dụng dải phân cách giữa của đường đôi làm nơi: bày, bán hàng hóa; để vật liệu xây dựng; để xe, trông, giữ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dfbc98e5a41dab69c03d80c5008ac80d0bd9ebf8dc7bf5a4d088893635ac31ca> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ không có dụng cụ, thiết bị chuyên dùng để cứu hộ, hỗ trợ cứu hộ theo quy định tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dffa7b7776e2f5d1ab228e997762221e2a8c264de31274928612e1a737fb8054> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe trên dốc không chèn bánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e05aeb6f6d57707827f6e808d183c46924fcebb7ca39eb45c0ca84590a29a116> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Rời vị trí lái khi dừng xe nhưng không sử dụng phanh đỗ xe (hoặc thực hiện biện pháp an toàn khác)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e06440c33e6c2c81283449b3c48a68fdbc2b0f49da77a250f7983e8b1c44f3d7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng bàn trượt, pa-tanh, các thiết bị tương tự trên phần đường xe chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e06edea34f49ca11c631742619433b552569c57bb224243ee4c1d37f6ecedd0b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cải tạo xe ô tô loại khác thành xe ô tô chở người"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e08163db0bae51f811b63a9917a7e517b44842fca8134bac4023b5249f185fdf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm sai lệch thông tin, dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0b4e0db17a9ff628e771ad7af4e437dd99ed561f3674d00bc9fe9785864e90b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Gây tai nạn giao thông không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, không ở lại hiện trường hoặc không đến trình báo ngay với cơ quan công an, Ủy ban nhân dân nơi gần nhất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0bb5a6dbdf15401fd46b850141947e95f0c8bb0b2d18bd78da3a5d9f3782a7e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe máy chuyên dùng sử dụng giấy phép lái xe đã bị trừ hết điểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0f8d9d31aa8b3318e03621f920c3e5b6a077662a3e8f1e3015d179c60f3065c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có hệ thống chuyển hướng của xe không đúng tiêu chuẩn an toàn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e17a145431812d0040d7cf27e8efc8881ad2981a7ca8d4ef3729a0c4f65fcdea> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển vật thể bay, tàu bay không người lái, phương tiện bay siêu nhẹ hoạt động trong phạm vi khổ giới hạn đường bộ gây cản trở hoặc nguy cơ mất an toàn cho người, phương tiện tham gia giao thông đường bộ, trừ tàu bay không người lái, phương tiện bay siêu nhẹ được cấp phép bay"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e18e1d2f45fb38ec5f6197011860222e0f7e6d369eec484c106eefe834cc0b9b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe không có hệ thống âm thanh thông báo công khai lỗi vi phạm của thí sinh sát hạch lái xe trong hình theo quy định hoặc có hệ thống âm thanh thông báo nhưng không hoạt động theo quy định trong quá trình sát hạch lái xe trong hình"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e1fbded8529a84a77010c5535516895e9b1bcb4e7fcb42ccb6b69b71094c8f4c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không quan sát, giảm tốc độ hoặc dừng lại để bảo đảm an toàn theo quy định mà gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e21e5f0dc50b58cf60e9e0c3dcf058787effd90b6970e076b4f78d0f4da32076> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi không đúng quy chuẩn kỹ thuật cho từng loại xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e23337f51e496ef3f618186ba281c221787fa2cd1b5d2da8a22f761fbe351164> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe đạp, xe đạp máy, xe xích lô chở quá số người quy định, trừ trường hợp chở người bệnh đi cấp cứu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e24e036a9204af0b291eda929385688f99f1dff055e2b93c5250e3cac3bf2a8c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ, xe cứu thương có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không ghi, không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3b4db32b044ddb4e6e40bbc0b1843f198a48b13cd9f45802aabf96babf88cf4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe tổ chức tuyển sinh, đào tạo không đúng hạng giấy phép lái xe được phép đào tạo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3e929d674cd6778dfc8560402f853aea7a697806905090879c79b8a58774db0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đội “mũ bảo hiểm cho người đi mô tô, xe máy” không cài quai đúng quy cách khi điều khiển xe tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e43eb8372de68408c66ea623aa00b4708c25aca571add22e4c8d7a8c0cac70d1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng nơi cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e44351ebbdc52014d43b517fb5201ef8b86b165c3943dddcaab37f6c7bd7e569> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có biển báo dấu hiệu nhận biết là xe chở trẻ em mầm non, học sinh theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e44d6f10d833cf261cf035cbb87129b93eeab6af4b7131b4dd699f503ca3440c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe, quay đầu xe, lùi xe, tránh xe, vượt xe, chuyển hướng, chuyển làn đường không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e487b308955497a714d7a67361b75e55393fc02915a203ec7cd935640ab28310> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách không có dây đai an toàn tại các vị trí ghế ngồi, giường nằm theo quy định, trừ xe buýt nội tỉnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e51cd5c21a7ff9a3a73ef36376b0b8d277ef66e65ef563930db329781f79abd6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng tay cầm và sử dụng điện thoại hoặc các thiết bị điện tử khác khi điều khiển phương tiện tham gia giao thông đang di chuyển trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e5279967edc5cab239da6e1800728c9bdfa5b8db28aeabb2e6e1075ab39f10b5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tổ chức tuyển sinh, đào tạo lái xe mà không có giấy phép đào tạo lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e58534184944997856eaa0fdb3475cdc917215414bbbdf76affe833164d8f2d0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng chở không đúng loại hàng quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e60a6ec309c336bd92fda3c79141d6d78a642e71c3a2b188d6e06aa79471d208> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e68be48199b93a68d3c94f78a2ab53e02b1edc7f3e4cc09e1b5b2f52a84ca1f7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người được chở trên xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy đội “mũ bảo hiểm cho người đi mô tô, xe máy” không cài quai đúng quy cách khi tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e6993e04ced2f870d8f1642ced4ec1ca3d13fb978e2416af77a142bfeef7d24d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong cơ thể có chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e7065b5cfac9694abeaaf8bad5a9966770c978c96a00732046ad5b20036f37b0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e719c0d68fb905aa8280eb7bb995951c840984cb957a73e8b9e86722d1f9e0f7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e720774f78d9f161747020720e8383e3835b67133c48f85f043b81109fc24ff8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không dọn sạch chất thải của vật nuôi thải ra đường, vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e721b69803c40f90cb6e04b9027b1e2ae387307bdf54ef1856570d0cfa836645> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e731d47ae445842c780bf6908c503852e3ae757e997636bb76040adc1e95c8b4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi không đúng phần đường hoặc làn đường quy định (làn cùng chiều hoặc làn ngược chiều)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e81e11534ad1bf97e7e1648a02ad75fd69cd5dc44ff4841e1141cc6fb6f3b444> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển, dẫn dắt vật nuôi đi vào phần đường của xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e81f30476cc94c3e23d443446847bae3004bc6c91940c3063ab71003d5c657c9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định từ 10 km/h đến 20 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e8eb0a24f838961e709f953775944062c4b6870ccc2977fe541648e2577ca95f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e907318813de509f53a9fcb30f605844aec90698bc17c068d3e9698d6fa89eca> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có niêm yết nhưng không chính xác, không đầy đủ thông tin theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e91df3372d384d134e8863a2790dc95676df91abbe79b6e01503769379529f02> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e98a94fd00eef97456744d14c7bdbf14ca37ed8faebb5a71c34424549fe38551> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e9eb1cf698bbc98dac87d7825068fd1bf4fab6f901c8465fcc0004b74dba115e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách không có hướng dẫn cho hành khách về an toàn giao thông, thoát hiểm khi xảy ra sự cố trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ea29a4342a87bf48c00019f0230d60c00fc716ae0e1a785d723b7ff7d92c56aa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để vật che khuất biển báo hiệu đường bộ, đèn tín hiệu giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ea394a9b2b593a525bc60f23f1126001deff863f20467fa4db838f3ad367b0e5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường đường cho các xe đi ngược chiều"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ea613ba3f2098a3437f8e341fb5a596f40873c91bba5efed582d9d5dc2a10048> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng thẻ nhận dạng lái xe để đăng nhập thông tin theo quy định khi điều khiển xe tham gia kinh doanh vận tải hàng hóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ea69d67761bfe3195b615eb5a1e9720b39a9ccba2d0ddef8bfeefff73fdc3fc1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe ở phần đường dành cho người đi bộ qua đường, trên cầu, đầu cầu, gầm cầu vượt, ngầm, tại nơi đường bộ giao nhau cùng mức với đường sắt, đường hẹp, đường dốc, đoạn đường cong tầm nhìn bị che khuất, trên đường một chiều, trừ khi có hiệu lệnh của người điều khiển giao thông hoặc chỉ dẫn của biển báo hiệu tạm thời hoặc tổ chức giao thông tại những khu vực này có bố trí nơi quay đầu xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/eaaf27ac4916a93ab71a98b1d9de4f9b97856b96e65c5cbf3977ab790f152b99> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không ghi, không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ead99f6075dc9a4e6e864f90aeff2446bbcd4f2c75b9331b53ea55e5fbc703fb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe xét hoàn thành khoá đào tạo hoặc cấp chứng chỉ sơ cấp hoặc cấp chứng chỉ đào tạo cho học viên sai quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/eb2e98cbcddc670678519d7b68fd8a1fac851c655d29e68c298497a88df3e22d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng trái phép lòng đường, vỉa hè để: họp chợ; kinh doanh dịch vụ ăn uống; bày, bán hàng hóa; sửa chữa phương tiện, máy móc, thiết bị; rửa xe; đặt, treo biển hiệu, biển quảng cáo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/eb57c91ea5e645afb7785948a0b7512b5965b6bfa4de6bbf786f9d1f13d5827a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ebdabb6f79bfc5b4a6f8ceeb59e2b3214262f9136f18dd6f2e0af7035fe7aa5f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chở hành khách sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec185b1bf96f641a6b453cef89c20512defce90b3151cedd391118007ddcf20a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vi phạm quy định về kinh doanh, điều kiện kinh doanh vận tải bằng xe ô tô để xảy ra tai nạn giao thông gây hậu quả từ mức nghiêm trọng trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec3011470eaff51a3afd5572fc822c1911631bbdfc8bdbf714e6a1da0c4cb729> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec3fa7edeb75d44c77a23097308706ffb2e835a548c82eacd566d11c8a550ff3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe, quay đầu xe trong hầm đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec471c756d72d6867dddd8aff745e3be2e477de16748da807cfef5ee17eb363f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện đã bị cắt, hàn, tẩy xoá, đục sửa, đóng lại trái phép số khung, số động cơ (số máy) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ecca3fc7fdd9e1d33fb950d404a18c4f35a1ae1b9b88548997c31b439c9404d1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) không bảo đảm quy chuẩn, tiêu chuẩn kỹ thuật của công-ten-nơ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed14d8b426a70fa6d828f7e12770092ff0912ae560b0535fab597f925d52ce86> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed286de31f894fe015bfa19bd3015629c1a0a795fce456533fbe1f1e01eddc13> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải hành khách lắp thêm hoặc tháo bớt ghế, giường nằm hoặc có kích thước khoang chở hành lý (hầm xe) không đúng với thông số kỹ thuật được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed53cd2fd64bcdd6d9adc8768652c3c3906fbb01daa3e5fe33498d8e9858e4d2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không báo hiệu bằng đèn khẩn cấp theo quy định trong trường hợp gặp sự cố kỹ thuật (hoặc bất khả kháng khác) buộc phải đỗ xe chiếm một phần đường xe chạy hoặc tại nơi không được phép đỗ xe, trừ hành vi vi phạm quy định tại điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ee1957bcba3780630d95199a044271dc74348bc194a97d0133a9738300cab5cf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc cập nhật hồ sơ phương tiện cho xe cơ giới, xe máy chuyên dùng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/eed82104e704d1968c485f9c6d887b4556f4c8568f7b5b7c0a0088cb690e3b2d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành không ngồi bên cạnh để bảo trợ tay lái cho học viên thực hành lái xe (kể cả trong sân tập lái và ngoài đường giao thông công cộng)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ef07745474f9e03ee04855fab9409d1e8f3520bb3bce6a08d353728c23eb4b74> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không hướng dẫn hành khách đứng, nằm, ngồi đúng vị trí quy định trong xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ef2de220fb2f53336cecc9e5f1eb576d0509e2a4ab7cdce8d4e12e7409de8a12> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đóng lại trái phép số khung, số động cơ (số máy)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ef3d10a6eda271129f8ad669fcad1cab811c52005ce51518c5d7e3aa90590186> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Rời vị trí lái, tắt máy khi dừng xe, trừ trường hợp rời khỏi vị trí lái để đóng, mở cửa xe, xếp dỡ hàng hóa, kiểm tra kỹ thuật xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ef46e56631f3fc5bb7d9dc44d2bc092634449554c970fd0694604b5efb4ad5a8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/efade9b85eb24a0b1adf24df8a00fad4624de714deb4ac1ce128b570d97403e8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) dưới 01 tháng tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/efd0fb5b5b480be24381c1f50108ff76ab415e64b4d4cc0f60e33961b495166e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe (bao gồm cả hàng hóa xếp trên xe, người được chở trên xe) vượt quá tải trọng cho phép của đường bộ trên 20% đến 50%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f07126c076b4619a0d01e5fceba3ca6d46086b5ed277899b79d8ca69026fc7e0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tẩy xóa, sửa chữa hoặc giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f0a5df0bcbe6d51bba01d41aa0b4965a0289bb86f0401f084351e49f98e78a0a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
