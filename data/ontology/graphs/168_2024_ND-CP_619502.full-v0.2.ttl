<https://w3id.org/legal-ontology-rag/data/concept/conduct/14beda3226f52152bd617b352b23a87952818de260ea6921093d90d80c04014f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc"@vi .

