    skos:prefLabel "Khi ra, vào vị trí dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5572e853322dda56753ca2c3fe9c314cafa90879159188049acc1f9a9cdc0b65> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Hàn trái phép số khung, số động cơ (số máy)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/55c0c9bf9c4c78ed81981d9da454857499df77ca8eac5f8456ac4db940b2e9d3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng đi không đúng tuyến đường quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/55cc25162af0d64903b22784842c5895ed32db1bb3348609c2b4022efe215023> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/563dc5f727e153f07804b72ce1a4876f2437c67c35d40c5a5d8ab055cda9458a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có tờ khai phương tiện vận tải đường bộ tạm nhập, tái xuất theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/569ea4542b479d2f9018fca3c49a0e0d23d4054bb283d9a3767a6cb6bf7b30c5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khai báo không đúng sự thật để được cấp lại biển số xe, chứng nhận đăng ký xe nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/572a2677189433301387c49543bedb346274f11bbbc581703befc3dac583d515> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không khai báo, khai báo gian dối hoặc cung cấp thông tin, tài liệu không đúng sự thật để trốn tránh trách nhiệm khi bị phát hiện vi phạm pháp luật về trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57786205a41f43a24d3a8a7fd2dd7681ba1c2e7a303de46766b2da87fc46c0e6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có phù hiệu kiểm soát theo quy định hoặc có nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5785fa29626dc32061cb17934934a25ad360c7ea2122763403505a9f4c2a3c84> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu thương không lắp thiết bị giám sát hành trình."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57a09fa955b971a84e39db008e5f2b742467e6db8d2f6607b75847fad8d256fe> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cung cấp hồ sơ, tài liệu giả để thực hiện việc kiểm tra, chứng nhận, thử nghiệm nhưng chưa đến mức bị truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57a2391799e524a87aa97ea99eda9cbd019b191e3b2f8b7b0230dba0d07e8eef> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi khung, máy, hình dáng, kích thước, đặc tính của xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57e27c57abf6d90febfde150f43bb9c23f5e7eac78ec75ca28065acb5e1f523e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy không có hoặc không mang theo danh sách hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57e335dd7421c4accc9489b13aa7dfb2449b92030bec56a90210d5465ab32ec5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ, xe cứu thương làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/584c7f6fac4692ff2800c35a8f982bdc040c41cb317a1ea60c37c1f637338a8e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đón, trả hành khách không đúng nơi quy định trên những tuyến đường đã xác định nơi đón, trả khách, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/587bf04c7ae15ea495e6716b065f8816aa486ee5e278daa9635e08f4b3b3d039> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy định về biển số, quy định về kẻ hoặc dán chữ, số biển số, thông tin trên thành xe, cửa xe (kể cả rơ moóc và sơ mi rơ moóc), trừ các hành vi vi phạm quy định tại điểm b, điểm c khoản 12; điểm d khoản 13 Điều này và các hành vi vi phạm quy định tại điểm b khoản 3 Điều 39 của Nghị định này."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/587e0a5c70f7e1083195b242d29c48cf2763df06fe57033200b1dd5eb21c12f4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường hoặc gây cản trở xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/588f366eb2dd11a96587c6c018a79d80fa31b0d5cd16ac2c6b9652e19b32a66d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy tốc độ thấp mà không đi bên phải phần đường xe chạy gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/58af40901363930bc132cf0a31bae001034c834cf5877f339aa67f0f53efad67> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có đèn soi biển số"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/58e310aff52e2c3a80163558f0624a38d69b6bcc0e64b0771133eceea524b878> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách theo quy định của biển báo hiệu “Cự ly tối thiểu giữa hai xe”, trừ các hành vi vi phạm quy định tại điểm d khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/58f99c928f048cc60953f22e6e157d075f6fb7aa137e8e73dc34605c0ae07c1b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có đủ đèn chiếu sáng, đèn soi biển số, đèn báo hãm, đèn tín hiệu, cần gạt nước, gương chiếu hậu, dây đai an toàn, dụng cụ thoát hiểm, thiết bị chữa cháy, đồng hồ báo áp lực hơi, đồng hồ báo tốc độ của xe hoặc có những thiết bị đó nhưng không có tác dụng, không đúng tiêu chuẩn thiết kế (đối với loại xe được quy định phải có những thiết bị đó), trừ các hành vi vi phạm quy định tại điểm h khoản 3 Điều 20, điểm đ khoản 4 Điều 26 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5942a7969575ca33d0e5fd3ee041f8cbc6242693c6a625c5166dd778fb4caf1f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có đèn báo hãm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/597fd01a696032831320f0e9765c8102fcf213b1052c20487769a4ab2f7cba82> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc ký hợp đồng đào tạo, thanh lý hợp đồng đào tạo với người học lái xe theo quy định; có ký hợp đồng đào tạo, thanh lý hợp đồng đào tạo nhưng không do người học lái xe trực tiếp ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/59b3d88e74338345860f639a437cc7e47e4f2808b48ef30448a33d69312c600f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô chở hành khách, ô tô chở người (trừ xe buýt) chở quá số người quy định được phép chở của phương tiện, trừ các hành vi vi phạm quy định tại khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/59cea9a6aebd832c299e3e88f02c28ab909e8f6e4a3a1624c6e38538a492b4f6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng điện tử vận chuyển không đúng đối tượng theo quy định (đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/59fb0afe70b471b8d7bfa8e8406dd46d4a9c07da6d8eb2ac3be305c75251140d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a169f592dfdcae958ecdc14c5a0e28e1086b5c5122a8881fdbfba455b4f667c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe điều khiển xe khách giường nằm hai tầng, xe ô tô đưa đón trẻ em mầm non, học sinh chưa đủ số năm kinh nghiệm theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a3fb17e501d26637272555a1c2f0c69f88a5de8f20def947e4b3e58e75529d0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng vượt khổ giới hạn của xe hoặc của đường bộ ghi trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a423f7e6f472767aa0fe07ca3081b892741018a0d72de961d1afdd51089eae5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a55c9b50636084a84f6cf92f172e92ac8c3cc23dcd4de1eb5e12c7b38b4fdf1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng các nội dung đã đăng ký, niêm yết về: giá cước; giá dịch vụ; tiêu chuẩn chất lượng dịch vụ vận tải, dịch vụ hỗ trợ vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a582d46611f5dae3df520ff6d2ba265e1a74834ab2c09767f43d7878fd3561e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện gắn biển số không đúng với chứng nhận đăng ký xe tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a5c6075461cdf06d52aa6ad11971f5fff45747d2fea65d448332d7ac9b3e8b0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện giao thông thông minh có giấy phép hoạt động hết hạn sử dụng tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5a8b829b88aca68e84005a7a3d1993d86e87d4950b21d0c4f75b86c0c661481d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe gắn biển số không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5b20651ae581a39906c079227512c90b5402c21b383ae00e38b386428e177ddb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khi có điều kiện mà cố ý không cứu giúp người bị tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5b41019a9eafd5ae1da3f0949ff51609a9c368247e6a9c8c3262e9e67d5df25b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe không đúng vị trí quy định ở những đoạn đường đã có bố trí nơi dừng xe, đỗ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5b7eff56e3bb705fe5ac8cf712e0cdc2e8baa14788a3f2a4a531b82434e3118c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe máy chuyên dùng sử dụng giấy phép lái xe không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5b82ff0ff73fa2833e4abbca22dff8ca6150e68a9c525da96050d51e69a7b9ab> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe đạp, xe đạp máy sử dụng ô (dù), dùng tay cầm và sử dụng điện thoại hoặc các thiết bị điện tử khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5c0e870a563ab19025a293a51694b0f91604b23698474f5d6666a0d1fae0ec3d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe máy chuyên dùng sử dụng giấy phép lái xe không còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5c689e1331dcd752f13b46350bee02eda5c3a2d5b3fc87979447de4338b0d1e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi không đúng phần đường, làn đường quy định (làn cùng chiều hoặc làn ngược chiều)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5c6fd17758f1e7c4328d57cd0cff1c365abcf6df434edbf74ab110f1db14d240> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người ngồi trên xe không đội “mũ bảo hiểm cho người đi mô tô, xe máy”, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 06 tuổi, áp giải người có hành vi vi phạm pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5c8bd8d8dae73948c3f0ec753d7796a2df84bb3f84ff904f401675c8814136d4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Ném gạch, đất, đá, cát hoặc vật thể khác vào người, phương tiện đang tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5c9a000cad5258ed8aaba8b847a6ff1ade78769f32abeff21405d7f35a6bf497> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều đường của đường một chiều, đường có biển “Cấm đi ngược chiều”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5cb8cd186df9542e98f1e2c944a74d74b275136bdbf22899171fc89b1df3f191> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đổ, xả thải, làm rơi vãi hóa chất, chất thải gây mất an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5d7c084b9335cc494181ed39feb448cffbeddca4c150ffe351d55c4b821f24e3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô không có chứng nhận bảo hiểm bắt buộc trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5e0d275251e67a961408f593b84cdea71b8cdf15ad46ebf7dc2a9ab92429a9c0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Mang hóa chất độc hại, chất dễ cháy, nổ, hàng nguy hiểm hoặc hàng cấm lưu thông trên xe chở khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5e863b2b80e5b9ff3cd6fb2371a288568a880888dd132a4e50b211423ae4de68> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển “Cấm đi ngược chiều” gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5ea33a33727d1c502af466000483f41c8309fa23699327fe371cf7646f79583e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ các quy định khi vào hoặc ra đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5ebb6a86bcbc3131be092e5766d0cc10722d2c50d4d1d4cf567e920a6d5a5db7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đi qua dải phân cách cố định ở giữa hai phần đường xe chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5ec74ac69f634e8a5621234a3267ae1e5a1d0e0b9ae86ea063fac5649cede4e0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, rơ moóc, sơ mi rơ moóc và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5f7249898ebf7789a5ef19c1187f3bb6615ee73ccead69ee9d3515a7a1c1c9a2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bày, bán máy móc, thiết bị, vật tư hoặc sản xuất, gia công hàng hóa trên lòng đường, vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5f862ced4bd347e52f03b92c3524d5788b67a7de32a066458f6228a2135de7c4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa ra các yêu cầu trái quy định về trình tự, thủ tục đăng kiểm đối với cá nhân, tổ chức"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5faed01af0b514b61fe07e20f0483687bf3724c146e421b08970e5756153c7c1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thực hiện việc thử nghiệm không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5fcc3c4b746415a696b24abeafd7adbbdb8a51df843769eb84f03702e78eee0b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy dưới tốc độ tối thiểu trên đoạn đường bộ có quy định tốc độ tối thiểu cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/606b796fd3c8be7292c0434c280ee50553ffe9598676bbed3eff726685205a70> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe, quay đầu xe trái quy định gây ùn tắc giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60793ca1b8f3ecc035fb90e8d26790708d15fecd88e229bb53b5c422b0773904> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ thiết bị giám sát thời gian học lý thuyết, thời gian, quãng đường học thực hành lái xe của học viên hoặc có các thiết bị đó nhưng không hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60af98a8925d1894e537bd1c10ae08a7e9168d2d4f84ca0de6f228c265e9234a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe tham gia giao thông tại Việt Nam không có văn bản chấp thuận hoặc cấp phép của cơ quan có thẩm quyền cấp theo quy định (đối với loại xe tham gia giao thông tại Việt Nam có quy định phải được chấp thuận hoặc cấp phép)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60b1cf6822ae6ce5044395733902b5da1d17416c7bae25cd8c7bf9f4b3a3e270> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe tạm thời, phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60f28cbdc16b08b0fd72064f659dc5ebc4eb891616c2dfecc417ee92091a67e1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ, xe cứu thương có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không ghi, không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60f31f6c7b7bc39c46a8270587d698d48b8fea684519461f84f5b0e3b821ddd5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/60f9b2ee8cb1d523633795332a54e11f72309f6736c0cee99543f5cb7572a344> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6132a3057a8b0a00d46bd832c705f50d7a392ebf9c19a534c386f2e9c748c028> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/613e410d877e815fb39a7f9932ae6053c49430c5fbef9b7c52a9d982cac55b30> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có giấy phép lái xe nhưng không phù hợp với loại xe đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6177dbc80543f920d89ae2796b022555ffa1a95dcb9770229b25db79ba9573e5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô chở người từ 08 chỗ trở lên (không kể chỗ của người lái xe) kinh doanh vận tải hành khách có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/61fdeef497a709a91cfc93fe3957a9a13577c08e511bb9935ba69f74ca989949> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có hệ thống hãm nhưng không có tác dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62377e1b812616036e63f9275d651e8e7dd5e5a1fc7314fb843853920c04258b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên đoạn đường cong hoặc gần đầu dốc nơi tầm nhìn bị che khuất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/627aeaf27cb58014ca1e515a46c824f693b4e607a67f3d458a0608b2a71aa8e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6289bcf21aa5fa7b0ef72ce8947769036172de599b2eb99fc86b316dd0fc643b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe có trên 50% số xe sát hạch lái xe trong hình được cấp phép không bảo đảm điều kiện để sát hạch theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62ecfe9b1d3052e3f5b5f3113a55f3b3100fb3153ca944cb102ab616fed07b17> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chở hàng trong đô thị không chạy đúng tuyến, phạm vi, thời gian quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63232601a3a4168d5b93f877224789cd50db5da103ccd0dd00c87b41386f17e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xúc phạm, đe dọa, cản trở, chống đối người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/633ff1e54f819bd8b9f53a207f0c5ee5a78a097881a33b5a4d3f8caf9d90d694> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển động vật sống, thực phẩm tươi sống không mang đủ giấy tờ theo quy định (đối với loại động vật sống, thực phẩm tươi sống khi vận chuyển phải có giấy tờ)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63540170ba15cd2f2603b10d7833c88aa81d718f86c0dacea18072d9ff26f0bd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc niêm yết thông tin trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63ab875c761bdd6ceb35efb517fa8e7067bd2271cacf5c813cd74f5a9b42da6c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên nóc xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63b99d9075dc82cabdadce485d8d774d0cd257daffad5bab3c3c9d37d50f3d25> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/646c06aa6df86d41c683a32cb5e13b79e749ba30a439fa7ce677af2002b60a5e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có giấy phép lái xe quốc tế do các nước tham gia Công ước của Liên hợp quốc về Giao thông đường bộ năm 1968 cấp (trừ giấy phép lái xe quốc tế do Việt Nam cấp) nhưng không mang theo giấy phép lái xe quốc gia phù hợp với loại xe được phép điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/646d7e80f4fa31caf48691854c0954886994b1e0ac8cbcf4ac9f0eea26e28c23> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định trên 20 km/h đến 35 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/64d15831df1c0b077bedbcbaf46dcf507c198f95aa873e696c69087d28f8fcdf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng tạm thời lòng đường, vỉa hè vào mục đích khác (theo quy định phải có giấy phép) mà không có giấy phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/64fda3ba3538c5570ab84f286cac69d73e85400a4a7321a31452157b71891107> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe dán, lắp phù hiệu, biểu trưng nhận diện tương tự của các cơ quan nhà nước, cơ quan ngoại giao, tổ chức quốc tế tại Việt Nam"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/653081e4f11302800c6f5baf9d5f89b17df33e79c3dca1309ba32edcbc60e1b8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/658af4ec19fa2a15263d9a84bf07c67c3ea35b9e6d4b53ef8889acab767a1ecd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng thẻ nhận dạng lái xe của lái xe khác để đăng nhập thông tin khi điều khiển xe tham gia kinh doanh vận tải hàng hóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65f914fd49c87d269a58ae80977aa25605ba2ce3781f4022778c57fd790094a5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Buông cả hai tay khi đang điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/666e46f16340b568f31c37e8cda6daa65c673cd9ecf33b34b26ba9d94f0269a1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đi bên phải theo chiều đi của mình, đi không đúng phần đường quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66939019277c567b95433f25b5aa1fdc19f69cbc3ea15017ee72a139ed020413> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66e6b332ad2efb1789c2786e66b3e6f3e70f7ab23c13b82dce42a02038a3e16a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách theo quy định của biển báo hiệu “Cự ly tối thiểu giữa hai xe”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6730ea25d15424eeac4492956fe6282984188ed3416ade0a707bd9c9418e3b6e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe gắn biển số bị bẻ cong, che lấp, làm thay đổi chữ, số, màu sắc, hình dạng, kích thước của biển số xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/67782221c947aca1059f1fa177fb02a627d2a4c11dfd371778953f3dcb18d8e2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển loại xe sản xuất, lắp ráp trái quy định tham gia giao thông (bao gồm cả xe công nông thuộc diện bị đình chỉ tham gia giao thông, rơ moóc và sơ mi rơ moóc được kéo theo)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6792d5285ebe2126f7159c7e62510a1c272d3247dfd468599ddc45848e68b619> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hướng dẫn của lái xe, nhân viên phục vụ trên xe về các quy định bảo đảm trật tự, an toàn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/67abccbaaec6ae8c663c0cc395e4afd333d5373d8217a739c3cf1322764ecbd8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi hoặc sử dụng phần mềm sát hạch, thiết bị chấm điểm, xe sát hạch khi chưa được sự chấp thuận của cơ quan quản lý nhà nước có thẩm quyền"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/680e7c24dc09866ba885b2af545c970d09c94c054916ccc1baae6bf56f626c19> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ số lượng xe tập lái các hạng để đáp ứng với lưu lượng đào tạo thực tế tại các thời điểm hoặc sử dụng xe tập lái không đúng hạng để dạy thực hành lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/68253100c52c2b99619e46912b62ea518926d4aadced19c1d5dbe740a5d4de37> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 20% đến 30% đối với xe xi téc chở chất lỏng"@vi .

