    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển “Cấm đi ngược chiều”, trừ các hành vi vi phạm quy định tại điểm đ khoản 9 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0bd069dc654573cf40210f3441fd2b07d7e3e11bb10453d7014016e051da4763> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đi vào đường cao tốc, trừ xe phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

