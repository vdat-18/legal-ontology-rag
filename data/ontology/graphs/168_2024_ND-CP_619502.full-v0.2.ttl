<https://w3id.org/legal-ontology-rag/data/concept/conduct/0002cb208ebd718081952ebffae6cfd92269e8ecc531d56b2c90ea0bb7ac3c8e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đe dọa, xúc phạm, tranh giành, lôi kéo hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0010dcae4c343779ec03f21246550248075ce2922bfd5868f7be6aec4bc61cb7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Phân công người không đủ điều kiện thực hiện nhiệm vụ của đăng kiểm viên, nhân viên nghiệp vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00700014f898128b8197af2f0363c4cad6cf7153519aacc3f1126ba5c31ab4a0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tụ tập để cổ vũ, giúp sức, xúi giục hành vi điều khiển xe chạy quá tốc độ quy định, lạng lách, đánh võng, đuổi nhau trên đường hoặc đua xe trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0097a20339e1e453c6d1bbd1de3b6017b2fde953a48acc9d8d01f86690b3730e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chở hành khách không có hoặc không gắn phù hiệu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00d7bdc824611f49290d111af627d894ad1e5d505a5a59f85b9f2ef290e2c12b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi tính năng sử dụng của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00e031d95f57bd55f102fae7760ca4e6d0a12285a55bf39eb97ecfc5aed45d33> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đeo phù hiệu “Giáo viên dạy lái xe” khi giảng dạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01243e80edf30c36ba70b28ea9e300c570a57d062fb83d410b4e030c3998dba5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/013bc17231ee2bd13169e363e5812bdc6b17bcdd792a46c2b9529f3bc895c7f7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có kích thước bao ngoài vượt quá kích thước giới hạn cho phép của xe theo quy định, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/014a291dabc7b042d7a3755dd5082388a3bcde10f46079ab7908e1d205598f28> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe gắn biển số không đúng với chứng nhận đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/017493a4120811b74f62342801a5afa10263d5461dea9b998396816eb5e45685> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe ở phần đường dành cho người đi bộ qua đường, trên cầu, đầu cầu, ngầm, gầm cầu vượt, trừ khi có hiệu lệnh của người điều khiển giao thông hoặc chỉ dẫn của biển báo hiệu tạm thời hoặc tổ chức giao thông tại những khu vực này có bố trí nơi quay đầu xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0189da57be2a9710418848866b6d185fc6d91c05394353fa254482abbde97121> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng điện tử có thiết bị để truy cập được nội dung của hợp đồng điện tử và danh sách hành khách nhưng không cung cấp cho lực lượng chức năng khi có yêu cầu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01aee9696e2bcaf182ff5390ff19be5aba7e0d4aedb402d246ea86709f3c81f9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) không gắn biển số (đối với loại xe có quy định phải gắn biển số)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02497f8a2affe7a3385404c11d856ae1f2880fe39c4dc4eda62450ad4fd4b9f8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh hoặc chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm đ khoản 2, điểm c khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02b7cdcdaaef5c7fbcaddc7430f0b091c9c41c6ce85b589083c618ecd948e2c8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe tại nơi đường bộ giao nhau cùng mức với đường sắt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02c8ce58c91b1dee49834173b4d6ea2cc0e9b43a390037c2f5858d5c4cc50665> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02e59653270d921b7efb54eb3f2fd04cd9c7eab17a0912be2093a8349ecaa638> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe ở lòng đường trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0301ef7cd6b4a824c8cd9dd10fe9db3411cb89271c2249e08108e4fb318b442a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tránh xe đi ngược chiều không đúng quy định (trừ hành vi vi phạm sử dụng đèn chiếu xa khi tránh xe đi ngược chiều quy định tại điểm b khoản 3 Điều này)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0350d2b41ada917cb2f46fe2ace8c9c83140a671b6c8f04254a8f0575ca5d0b9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0358836b75ffb60ac5b969fdfc944649ae4b6e5164761bb0557d415c4d02b97a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ không lắp thiết bị giám sát hành trình."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/036b607172dc0acd1cf465e646f6e0ce41321b1d7a6ecb1e9248e1a4ee6942d7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải không có dây đai an toàn tại các vị trí ghế ngồi, giường nằm theo quy định (trừ xe buýt nội tỉnh)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/03819fe0f84a2fb01d4814cfd025970a82ebcbebcc6fde3a0d52b56ba0170d72> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe nơi có biển “Cấm đỗ xe” hoặc biển “Cấm dừng xe và đỗ xe”, trừ hành vi vi phạm quy định tại điểm đ khoản 4, điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/03d24a33cfd9fb14327b0ba36ef1ce006cf5d1c9e2424e8a91091fadddada62b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người ngồi trên xe đội “mũ bảo hiểm cho người đi mô tô, xe máy” không cài quai đúng quy cách, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 06 tuổi, áp giải người có hành vi vi phạm pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/03e0db94724b1612044d211f08b08d8b45bbbaba8a95abf5821879ca7a06aeca> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục cấp chứng nhận đăng ký xe, biển số xe trong trường hợp thay đổi chủ xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/03e595e17f2505f25492150e302fb2ed088328bc38e05251efb5fd6136fe005e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/042aac7ecc471a7bcc05b90dc0910b537ba900635ee8dae7fdc0d670eba066f3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe không đúng số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0570e07eeab2edc2d3f39e6580a63f4fe37bf6b2ba648575bf916a5f416f68a2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe máy chuyên dùng không có bằng (hoặc chứng chỉ) điều khiển xe máy chuyên dùng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/057ce34fba258d525a678c0c47d2e273fccdf2f6fb2d016e64efdbe63aba3bb9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe, quay đầu xe, lùi xe, tránh xe, vượt xe, chuyển hướng, chuyển làn đường không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/059437d5fdd935c90184de52764eaf5bfacafdf206e766219d084ecde0bda32f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, nhân viên phục vụ trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được tập huấn, hướng dẫn về nghiệp vụ vận tải hành khách và an toàn giao thông theo quy định, trừ các hành vi vi phạm quy định tại điểm c, điểm d khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05d0be639bcd14a3c176f15d93f2218e16169e3129483b79ae0707b59a135576> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/06517ed407e9fb97405833b9ac3e2567fa96cba334b1e1db68eaa5e6401b5f48> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe không có đủ màn hình để công khai hình ảnh giám sát phòng sát hạch lý thuyết, mô phỏng các tình huống giao thông, kết quả sát hạch lái xe theo quy định hoặc có đủ màn hình nhưng không hoạt động theo quy định trong quá trình sát hạch"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/06c6d75a0346de113e60dbfa4663d4e60acb97f14d1dbe3981cc2b68d4b73191> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe máy chuyên dùng sử dụng giấy phép lái xe bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/06fc0f1b73a09fec563bdf3c940040767666289c76d9b44507f4691434ef5f15> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lưu hành phương tiện trên lãnh thổ Việt Nam quá thời hạn quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0763e3a640ea7bf0de8b0c82ebf8b20ad1a454b39ec75273e790ec7e12c1d1bc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe sử dụng biện pháp kỹ thuật, trang thiết bị ngoại vi, các biện pháp khác để can thiệp vào quá trình hoạt động làm sai lệch dữ liệu của thiết bị giám sát thời gian học lý thuyết, thời gian, quãng đường học thực hành lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/079e9e0f1ec857ccc9dc6a50ec7a7dfcd6c726afadc475f4edb7ce9657b29b6b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải không có hướng dẫn cho hành khách về an toàn giao thông và thoát hiểm khi xảy ra sự cố trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/08563dcf7a29c409b8b3f58391698ab2cf8fbb1a06dd2e485d2c9135175e171a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện biện pháp bảo đảm an toàn theo quy định khi phương tiện bị hư hỏng trên đoạn đường bộ giao nhau cùng mức với đường sắt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0857f048625e924c5ad65461ed940554cf12e98b18c8c801141cdad2d8dd2aa5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải quá thời gian quy định tại khoản 1 Điều 64 của Luật Trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/08dd6dadef7e63b230c5abbe05ee44cb8b424d5b966f15fa10e3ec181c6a60dd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0989be98ce5aa05cb93d474d0e5dcc65e16440d9dc3f0031d96b090916e55099> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành chạy không đúng tuyến đường trong giấy phép xe tập lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/09e2f105cd6560d6c5d8f26978325dcaa474576f47674c8cd8f6a1f95291da7b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a081ff22d105fbf6446655e487fcf3f179d23ab414a5521ad88c4305aed4e39> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm d khoản 9, điểm đ khoản 11 Điều này, hành vi bị cấm đi vào công trình thủy lợi và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a0ccbce03ea2b56ac03aac23290a6eb8d7f05323c4f894179e9714ed67722c1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 10% đến 30%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a17103d432a2c9ba0cf3ab6c665177f1f7ea02bab5ca457fb742dbfac7bf09b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi nhãn hiệu, màu sơn của xe không đúng với chứng nhận đăng ký xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a5e8c56b4be059ad2c39b6c6a22e84c4949e0a204514abf4174c8a0164d711f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hành khách không lắp thiết bị giám sát hành trình của xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0a9b3e69ccb733e249cd718ad1f3fc1ab2003253410d19c5d007c29b32822957> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào đường cao tốc, dừng xe, đỗ xe, quay đầu xe, lùi xe, vượt xe, chuyển hướng, chuyển làn đường không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0aa8565fd74ec54a366982d3ca39d5a062e290357ee50582e5f8a8d9d6ca3f63> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy không có chứng nhận bảo hiểm bắt buộc trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0abc7545b19f8b17bf9823395f1d62356abc4b5577f9c3e7a03a5fa661745f76> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng vượt quá bề rộng thùng xe (kể cả bề rộng rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0ae8bdb65c360f06ee3ba1b713e3c4f27cd7460650e64ce3e07a87d7c4eb82c5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh hoặc chỉ dẫn của đèn tín hiệu, biển báo hiệu, vạch kẻ đường, trừ hành vi vi phạm quy định tại khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0b07db0d5b5d57789199936d4c08a6dad5696a7b3e02a8e0d8caed552abc9485> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe không lắp đủ camera giám sát phòng sát hạch lý thuyết, mô phỏng các tình huống giao thông, sân sát hạch theo quy định hoặc có lắp camera giám sát nhưng không hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0b43b4f0dde0875f28868155b4163f2cf46ac677c0aeb7b21e323fd9ccbccce3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng nguy hiểm mà xe ô tô không dán nhãn, biểu trưng nhận diện hàng hóa nguy hiểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0b453044c1dc4b913f997374bd8a35a872839d61259a2e463790c192490187b3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng chân điều khiển xe đạp, xe đạp máy"@vi .

