    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe có trên 50% số xe sát hạch lái xe trên đường được cấp phép không bảo đảm điều kiện để sát hạch theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b56eb8fd0e13004f2b28b44e2a495be0d70ad4e63f669cb1883ba4350a3dc60c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục khai báo với cơ quan đăng ký xe theo quy định trước khi cải tạo xe (đối với loại xe có quy định phải làm thủ tục khai báo)."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b5749caccf408afc21d1b0411942a6743d93458f86700eb6ab0a3824a9616614> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lôi kéo bùn, đất, cát, nguyên liệu, vật liệu hoặc chất phế thải khác ra đường bộ gây mất an toàn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b57e967536d7fc191ee12e972c8fd022969da035c97a81eb598f7f0e0cbd5805> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ, để xe ở lòng đường, vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b593bcbcf9d492ab7a7e1c6dcdb844d541f6c50c53c6898a21454605bde900bf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu thương làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b5c0c5a991bf254c359868c5345b6d6c10f8d3a24907a4459b2e550e33dc878d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có giáo án của môn học được phân công giảng dạy theo quy định hoặc có giáo án nhưng không phù hợp với môn được phân công giảng dạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b5dd1e28cd4c0fe1060d9a4c847b78578f806322c06f65cf283c4d25f9060533> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe vượt quá tải trọng cho phép của đường bộ trên 10% đến 20%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b5df78bc630c91a66d2d33907a2818997a3dadca759f9c189ab455b10f8ecad1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy định về biển số, quy định về kẻ hoặc dán chữ, số biển số, thông tin trên thành xe, cửa xe (kể cả rơ moóc và sơ mi rơ moóc), trừ các hành vi vi phạm quy định tại điểm b, điểm c khoản 12; điểm d khoản 13 Điều này và các hành vi vi phạm quy định tại điểm b khoản 3 Điều 39 của Nghị định này."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b691e4fd9252d20823e2e93f52bed1c83c3352a926cec5a066d68bad8d10ee4c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) mà bị cắt nóc trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6e76e7320cacca7b83c8e9d3a203cccea97b95558bc3ab9d4084f58c7344b4a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 30% đến 50%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b73e2df4b6d4c73dbe7c89d5051a94925fc758290eab2cd7c6add00f6e6f2c49> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe đã bị trừ hết điểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b74d916599d420d5d2489d614e4e6e4b6d71ef6c1e487dff9d82bd1f9fd8b120> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo rơ moóc không có biển báo hiệu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7d2d79a1d62958c4a9b93a573ccac77133d20867438d73a1f67d79cb9f8b632> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên phần đường dành cho người đi bộ qua đường"@vi .

