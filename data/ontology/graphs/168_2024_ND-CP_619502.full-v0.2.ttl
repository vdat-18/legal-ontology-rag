    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d3dd68cc9caa483d178231bc62af51c98626870f1aec4a336e6e4411e30ba20d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển tải, xuống khách hoặc các hành vi khác nhằm trốn tránh phát hiện xe chở quá tải, quá số người theo quy định của pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d3fc30cddac10f8bc1a21ea570311eb9490c04b2050d78eaac86274854527eac> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe vận chuyển động vật sống không có kết cấu phù hợp với loại động vật chuyên chở theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d422020e7a589d947bf1539da29106210f89298910cb42347be830ae434563eb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy định về thời gian nghỉ giữa hai lần lái xe liên tục của người lái xe"@vi .

