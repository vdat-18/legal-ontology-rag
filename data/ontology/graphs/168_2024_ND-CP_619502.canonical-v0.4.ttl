    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ, xe cứu thương không lắp thiết bị ghi nhận hình ảnh người lái xe theo quy định tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c8e3f607f35edc5b08897d2badad8a6c72554bf52eaa5f3d38159883922d163d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c93c1f066943a11efefc7709a3c2d8b464d783dfcfe836c14be98444337abfa1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường hoặc gây cản trở xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c99b4a34dba855b9276669e358a02c85b0e915258b3047bb1c6bad8d84e11c67> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy trong hầm đường bộ không sử dụng đèn chiếu sáng gần"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c9bda9ab4f73e5c63cd9f14e26f5bf7b369aa41c2e46d85f5c20ea0c0c22567f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý mở cửa xe khi xe đang chạy"@vi .

