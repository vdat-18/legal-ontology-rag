    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng các thủ đoạn khác để trốn tránh việc phát hiện xe chở quá tải, quá khổ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/69cb7e91206e47a8ebfe744ffcd2adcb00340fb5d19134eb5f59fba657e9566a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Nhận, trả hàng trên đường cao tốc"@vi .

