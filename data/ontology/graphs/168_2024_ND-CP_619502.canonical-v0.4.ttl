    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chạy đúng tuyến đường, lịch trình, hành trình vận tải được phép hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4d18eef451b946f9d7f9897735b4f4ed788b85997e0071c26e225bc7c52a8450> a loroc:RegulatedConduct ;
