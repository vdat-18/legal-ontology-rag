    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải quá thời gian quy định tại khoản 1 Điều 64 của Luật Trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/25800ba2c6ccc26c4fc5acd69b8bf6fa0f2da8fd4949579f67639982d62b336e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe nơi có biển “Cấm dừng xe và đỗ xe”, trừ hành vi vi phạm quy định tại điểm đ khoản 4, điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/25a2174ba112daff29db0056a302d8680c4bade4598af124a6e32cd72286b34c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng có hợp đồng vận tải, danh sách hành khách, thiết bị để truy cập nhưng không bảo đảm yêu cầu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/268d790013087170131bd15217b52d486c4217ea97bd07c9ecc18ef740355b0c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng trái phép lòng đường, vỉa hè để: họp chợ; kinh doanh dịch vụ ăn uống; bày, bán hàng hóa; sửa chữa phương tiện, máy móc, thiết bị; rửa xe; đặt, treo biển hiệu, biển quảng cáo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/26a0491c899a037700d5428c09b7c67aa8a2e8bc785d6fc1f794bda57330f3e0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
