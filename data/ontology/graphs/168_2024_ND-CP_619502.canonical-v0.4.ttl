    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Mở cửa xe, để cửa xe mở không bảo đảm an toàn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ca26da5aabfe40aa9eae2ce31cd0d8c163c46da1cb1bf306a83cb3e3c97ec233> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra, kiểm soát của người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ, trừ các hành vi vi phạm quy định tại điểm b, điểm d khoản 11 Điều 6; điểm đ, điểm g khoản 9 Điều 7; điểm b, điểm d khoản 9 Điều 8; điểm c khoản 4 Điều 9; điểm b khoản 5 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/caa1476ece54d4b6e466ba8fbc3903fb5cb45bfde46535da1518e7f6c65254dd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cb089485ab25961d6ca9cda5730377384a68de8cb66950ffc14855f01286f391> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Gây tai nạn giao thông không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, không ở lại hiện trường hoặc không đến trình báo ngay với cơ quan công an, Ủy ban nhân dân nơi gần nhất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cb327b9fd425051cef29187f867067733e55e31c0ef0ca64c0b715904058fc1d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo rơ moóc, sơ mi rơ moóc kéo thêm rơ moóc hoặc xe khác, vật khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cb33a65bfffa183645629805ad29979d079bfa24507163b660919c9fe1e59fe9> a loroc:RegulatedConduct ;
