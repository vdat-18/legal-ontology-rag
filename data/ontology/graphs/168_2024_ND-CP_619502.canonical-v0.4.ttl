    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe trên đường cao tốc, trừ các xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f1470a18b6878e3bfe10eab90e7fcb0b31ea3249831844b2a5c18f9c5d17996c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có giấy phép lái xe nhưng không phù hợp với loại xe đang điều khiển"@vi .

