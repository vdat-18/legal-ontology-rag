<https://w3id.org/legal-ontology-rag/data/concept/conduct/d69a5e49eacfbe042c1ba663bfbd64aeb3a0607e8fff32a8f1c62c5fed3a21ce> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d6c90d4bc5ca6b18daff7841e05f6ea29c273c86112652199073e5e48a9ba3d1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy không có hoặc không mang theo hợp đồng vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d70bedf2b1d7e38c101077eed918aebd2318c9426df003925b074139f70545be> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào đường cao tốc không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d7364e34672f38343887afef5a71a0a54043e420f647366695ca6b5ada41176c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe ở làn dừng xe khẩn cấp trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d73a03488c036cc78f3ff9946d7a1b24a48dedd0c7e7f7f4331f65570fd50042> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d750cf3ad324bc02736d3b913d0a3b0fc05221025b53d58659901f9d0dfe6ec4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe (bao gồm cả hàng hóa xếp trên xe, người được chở trên xe) vượt quá tải trọng cho phép của đường bộ trên 50%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d79a2010f1ecb4dfdbc9a694c6f27ee4a6061ead70a10a6d51a61c354ce95659> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Hủy hoại, làm hư hỏng, làm mất tác dụng thiết bị điều khiển, giám sát giao thông đường bộ, thiết bị thông minh hỗ trợ chỉ huy, điều khiển giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d7c28be35b00f2c0421236839577dcfd83c4659f74613a87b00a283189f4e42e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe hoạt động không đúng phạm vi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d7c2b28b1d80f6be7cdf839fe94f5615b8af4ca7d5f14d320d58761ebe97dcee> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đổ trái phép rác, đất, cát, đá, vật liệu, chất phế thải trong phạm vi đất dành cho đường bộ ở đoạn đường ngoài đô thị"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d7ce0b20ebb06e7ded63f9ff83331b2ac7908fe00b63151927433bdb63c52096> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho xe thô sơ đang đi trên phần đường dành cho xe thô sơ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d87a5432005c4b543faf31dc682abc114e65903137ca725b9ce89723fc8de7b1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người không có tên trong danh sách hành khách đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d88f170cee61c856bfa3a282ea80eac0272cfbb55c78ab35d044ccf3a23f5ab4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định từ 10 km/h đến 20 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d8a90a104ffc8740db279289e24f1586b72ee88045c92617cea2eaed94ba441a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khai báo không đúng sự thật để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d8c140b0c750b60a7ac02eb39ddfdb5a0eb40987570816b3eea6bfa597d49b4e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành không mang theo giấy phép xe tập lái hoặc mang theo giấy phép xe tập lái đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d923af6a49cade263970b1df9c7c16f7d38e256e809d882afeec742b00c9a521> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển loại xe sản xuất, lắp ráp trái quy định tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d94fb61db07118b17d78a0c41210f762ab05d6e216f0ebe1713b607a256138f9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe trong hầm đường bộ"@vi .

