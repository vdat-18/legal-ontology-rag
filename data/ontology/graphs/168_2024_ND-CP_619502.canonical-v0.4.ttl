<https://w3id.org/legal-ontology-rag/data/concept/conduct/26a493b4f10840c833324739eb3bc81ed7efafe0980c5f1b93eef2c1d8630a09> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thay người điều khiển khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/26ca5731da1f9a1ee5da0ca93b7080f2664da0779323db67e3e7a947c9c6f969> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy chứng nhận kiểm định khí thải xe mô tô, xe gắn máy không do cơ quan có thẩm quyền cấp."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/275ebc21d8232e3dd5d08d15fce2be8a040835f516999c8612216f3da1d2eaee> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, rơ moóc, sơ mi rơ moóc và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường đối với loại xe có quy định phải kiểm định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/278f19770e16a3c5555e10060dea4092b61297290da3bbe5b9f65588862b69cb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để vật nuôi kéo xe mà không có người điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/27bee9ce46f47299d7be45fad8ca360028386a638a87ce53c727adbb64f89db9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Hoạt động quá phạm vi, tuyến đường, đoạn đường được phép hoạt động"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/27ec055beb3f36f0014ce10b2335eb635a8d8187c0906949060315438af6456f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu ưu tiên không đúng quy định hoặc sử dụng thiết bị phát tín hiệu ưu tiên mà không có giấy phép của cơ quan có thẩm quyền cấp hoặc có giấy phép của cơ quan có thẩm quyền cấp nhưng không còn giá trị sử dụng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/281d3cc5fb5df33ca7f94fbaa4b7c530d6d62633205dba747c70aacf2a5c8e1c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vượt xe trong những trường hợp không được vượt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/281ed318466965591c93c11d284bdf65547f374577f0556fee3dc4254b10b0b6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông (bao gồm cả trường hợp người điều khiển phương tiện có giấy phép lái xe nhưng đang trong thời gian bị tước quyền sử dụng)."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2842bb73d88dd8c09f5abdb788fc114691ea1c7c7419c13db7e06229ac7ef394> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có dây đai an toàn phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/289f3e9d4dcb6a6ff103d0460ba056290aae18c9a3c5342a5ad1380fb51728db> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô đầu kéo có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/28cff646d59f0d77f13bea981979a4ad727298b268e1f95d26044665a8d22ec9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy chở người không có tên trong danh sách hành khách"@vi .

