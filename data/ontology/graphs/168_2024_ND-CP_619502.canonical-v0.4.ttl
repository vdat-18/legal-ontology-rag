    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tránh xe đi ngược chiều không đúng quy định, trừ hành vi vi phạm sử dụng đèn chiếu xa khi tránh xe đi ngược chiều quy định tại điểm b khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e8156ee074ece91959433b95d909b514e87979e332befdba2315be576c173e2d> a loroc:RegulatedConduct ;
