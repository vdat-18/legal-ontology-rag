    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe trên đường cao tốc, trừ các xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c26282dba070158aa62541ea444670da2367dc56590e000d564794e44589250b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên dải phân cách cố định ở giữa hai phần đường xe chạy"@vi .

