    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lôi kéo bùn, đất, cát, nguyên liệu, vật liệu hoặc chất phế thải khác ra đường bộ gây mất an toàn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bcb4b773d93ad166df39ae918670c2ff3acbaa1130b44a49ab39c39edf069220> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có hệ thống chuyển hướng của xe không đúng tiêu chuẩn an toàn kỹ thuật"@vi .

