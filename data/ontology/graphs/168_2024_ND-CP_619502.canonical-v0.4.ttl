    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng đèn chiếu sáng khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b907f036bc390554e593322d203c125d24ab9e6868243fce8d2e00346899891e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Gây tai nạn giao thông không đến trình báo ngay với cơ quan công an, Ủy ban nhân dân nơi gần nhất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b9748f918eb6309ae7b7c498f6bbc53e6eee636931d687b49c24b4753e3b87c8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có các bộ phận chuyên dùng không bảo đảm an toàn khi di chuyển"@vi .

