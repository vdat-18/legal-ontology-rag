    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng tạm thời lòng đường, vỉa hè vào mục đích khác (theo quy định phải có giấy phép) có giấy phép nhưng đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dcc950f1179e689575a890a1e25f4d540932cb6f3b704ddcb7ff6f64932b7117> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dccb08a5a55fd45bc4d39e9bdbe27683ff9d18962f5ec28412419c990b24f0dc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có giấy phép lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd05f948d5eea2b35f91ce91aa70e4cbff75a273811e53586e783a4d372ad297> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe tập lái không có mui che mưa, nắng; không có ghế ngồi gắn chắc chắn trên thùng xe cho người học theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd0eeec2c99a7f06c759de218a3e36543e6459358d11cdf80e227fe1a1521805> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo chứng nhận bảo hiểm bắt buộc trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd6ceb0012a131d89004ec71f9cf8bc0312f96c3c8f0f5fc7712d6ac7834c9d6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khi ra, vào vị trí dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd77e76e07efd3481c15127744635d54a1fb614a7c8c612ec1e2a5391369711f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp kính chắn gió, kính cửa của xe không phải là loại kính an toàn."@vi .

