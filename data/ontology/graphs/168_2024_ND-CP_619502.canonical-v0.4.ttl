    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe đánh võng trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e29873d099b30544271df8d0bf3ab8b2699e83e6ae6f17239d2c88001802bb2e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi không đúng quy chuẩn kỹ thuật cho từng loại xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e29e155d341c38e3949f0ca15f9cfdc0360f9d8e07ae1670c0a317e6b16878c3> a loroc:RegulatedConduct ;
