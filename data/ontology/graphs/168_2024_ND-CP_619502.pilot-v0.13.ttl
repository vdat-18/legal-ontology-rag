    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cda980ab61456fb7fff0c27fbf1c072d845ca2d54e7acbf0aeffc7ae7913fec5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề” khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdab95c3701708474d6d0100ffa7ab307e0ef8dc7d0b6e57cb962c00f21b9e73> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
