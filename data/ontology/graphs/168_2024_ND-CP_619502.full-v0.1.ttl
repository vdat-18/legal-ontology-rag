<https://w3id.org/legal-ontology-rag/data/concept/conduct/90a110dfa5e84758609e8aceb1ab3100071aeec0de41af6c1ba8b6425ddd8fff> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/921960ffbb9f9de7c033cca5e1351d5daac0da54bd2def3c0a809197653fb4ae> a loroc:RegulatedConduct ;
