    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thay người điều khiển khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f109d7bcefbb5f81837a204c59f6b4f8058deff70a76dd283d52bd9e5e75d454> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có tổ chức khám sức khỏe định kỳ cho lái xe nhưng không đầy đủ các nội dung theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f15652d69dfa177a37e68648433c60f305ace9026ce28ba53329d570546eac33> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có thiết bị có chức năng cảnh báo, chống bỏ quên trẻ em trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f15e10ba8b12f9d991f0e2707841ee41dbafb8485717f690ccf8c50a09f06040> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng máy tính trong phòng sát hạch lý thuyết kết nối với đường truyền ra ngoài phòng thi trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f1e543003ca3e5556ba62c8f985158572fbe1d9bf840cd9b96aa71add5304414> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 80 miligam/100 mililít máu hoặc vượt quá 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f219305f057da94ba4a3f19869bc7790e685d8a4b691a27faa5a6299f93b5bfd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f28ba384ac15ef779cd66f8c90a1c7cfc2c943978e1f8f48258ab6abae13a422> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp kính chắn gió, kính cửa của xe không phải là loại kính an toàn."@vi .

