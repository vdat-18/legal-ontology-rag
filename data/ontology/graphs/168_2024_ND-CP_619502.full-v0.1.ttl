<https://w3id.org/legal-ontology-rag/data/concept/conduct/0aea7d58881df39fe3a3386c2e2ac005d5330be51c3f68de2d7d9a23e199a88e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xâm phạm sức khỏe của người khác đi trên xe, lái xe, nhân viên phục vụ trên xe"@vi .

