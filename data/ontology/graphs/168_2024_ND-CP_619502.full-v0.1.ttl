    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/17acce37ee91f87b9978d633c891de72619175f2a8048b3b8d5abf01dbbda16c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, người áp tải vận chuyển hàng hóa nguy hiểm mà không được tập huấn về vận chuyển hàng hóa nguy hiểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/17c1e7daea6b98edc9fcfb5dbbf354d4ea3e1232dcf8f7a994ead01efe5c3a9f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Gây tai nạn giao thông không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn, không ở lại hiện trường hoặc không đến trình báo ngay với cơ quan công an, Ủy ban nhân dân nơi gần nhất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/181675f4cb90d673cf2ef2048ff30353783c9bb5f4656c6901e79cbee98d6d56> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người được chở trên xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy bám, kéo, đẩy xe khác, vật khác, dẫn dắt vật nuôi, mang vác vật cồng kềnh, đứng trên yên, giá đèo hàng hoặc ngồi trên tay lái của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/182d345ac958df1d16701a9d005ef1ddfaa4d1b2e0dcac68ab27d04aa53dec90> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe máy chuyên dùng sử dụng giấy phép lái xe không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/18f7fae5ee7b93b750f362b2540130dd5f323bfca8b937343f7098b4588edd5a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe hoạt động không đúng tuyến đường, lịch trình, thời gian được phép hoạt động hoặc phạm vi hoạt động theo quy định, trừ hành vi vi phạm quy định tại điểm b khoản 7 Điều 6 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/195a5c4d023d251295343103b002579fac686032fba9530c72fe3dd10bf309ae> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Ném gạch, đất, đá, cát hoặc vật thể khác vào người, phương tiện đang tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/19a1f07ada7b0badc0e710f35b1a41e677e13c9faf566eba6109377dbae170ef> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/19cb385bfa76133ea18dbbcf86fd290fe964e44e54f866172e0b3928360e8f76> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong cơ thể có chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/19f419fb7b3f4a4d90e189d52aaad8e4222006d19a46b4f50a7321a80787c93e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ sân tập lái hoặc sân tập lái không đủ điều kiện theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1a3fed5ac1de7b57857a281e28ca7a8b963a52efadd728492247505c10a71cd5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô tham gia kinh doanh vận tải hàng hóa có lắp thiết bị giám sát hành trình nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1b9d47e2621285f6678acdd49256064bf258c17afb4ab89265b17a0a8f9b1dd3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển, dẫn dắt vật nuôi đi không đúng phần đường quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1be9d9d7868a5ac1512561232f289fc296b325325c7afbe6ba35e8a499d8b7f7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1c145cd41ab07bd9de2dedc72a3c7b2a2401e92273db3077726ec879b9033f3b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đua xe ô tô, mô tô trái phép trên đường giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1c3ed2c82c7e51ccbe3dbb3fca57aa6459632adf1da6d7155e07d11bfd43162b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng chân điều khiển xe đạp, xe đạp máy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1cd5eec3ffb3aebf861a2e253be822ed5f1b419a979f09848adcd628163f7a03> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ce5bb997c96c4fcd09655bfacbff50df218f0265198a5a1d78c6c14b7de63f3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe vận chuyển hàng hóa nguy hiểm mà không làm sạch hoặc không bóc (xóa) biểu trưng nguy hiểm trên phương tiện khi không tiếp tục vận chuyển loại hàng hóa đó"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d0ba1da9ca0e3bff3e07638d514c17b4a261d4df701f821413001e264c61bd4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) dưới 01 tháng tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d2b1da9e1d3bdc7caca9aeea2df91d3ecf3a59f4d8eef17a2a6f52a2d2b56b4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe máy chuyên dùng sản xuất, lắp ráp hoặc cải tạo trái quy định tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d42d52abdfa46ab441ef4cf0f757f7ff6665045ca0cf36a3fb015b827641fbb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để hành hung, đe dọa, xúi giục, gây sức ép, làm mất trật tự, cản trở việc xử lý tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d77df44def498deb6376da3a0b8d456ebee90c904bb6bdcaf5911f42f865d09> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e0bc8611e4dad88249b7aa6bf2cf959a90032210e70061fb524c34225876013> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm a, điểm b khoản 7 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e2e6fce9a6b850dbfdfe7d6760e260085347856b6de2f2fb5df62291e9eaf1b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lạng lách, đánh võng trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e551cc56408cb9344f4db91a92d479e701f1eef7c8d0bec91e4bab42148263a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1eb44b14c01d98de260c3fcf21ceae7a50a5143ed2473b8d6696e65a1be5ffe4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đi đúng phần đường quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f161101736250d22128f1aa9f7ffb861ee508351e6569c7a8cc03a7e833ba93> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đứng trên mui xe, nóc xe, trong khoang chở hành lý"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f32dca1b60f55503f00bb31d2bae24451eeab1228880ef21d10dab71d73dc92> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường rộng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f37da8c6649b44ce266b1c01469fb3e8d2c6a72622dbeb1ca17da66d91f1bd2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy có hợp đồng vận tải nhưng không đúng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f883851c065cdcc28923da44995774f5175c1a36a1f873bc91048510f4e36b9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển “Cấm đi ngược chiều” gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ff62477f041186adc8ee3086482313996819c1f8e0fc800fb732ea21556379a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/201a3a6e3d4200360f6c26ce8d5d2814960f9877c7f945fa68e8102a681bf8b2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm mà không mang theo hồ sơ vận chuyển hàng hóa nguy hiểm do người thuê vận tải cung cấp theo quy định, giấy chứng nhận hoàn thành chương trình tập huấn an toàn hàng hóa nguy hiểm phù hợp với loại, nhóm hàng hóa nguy hiểm đang vận chuyển (nếu có)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/20595125b35e9f0abfd41959ec0558a26e6d51bf89920a286636b102446f0488> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) đã hết hạn sử dụng, hết hiệu lực (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/20e8766b3f9dc5b855a3a9d44d6b75486c271d6925eaa8bffb84a8381fdfd372> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có đèn báo hãm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/21293f3799c013e6d6500978b4e31dbd0dc29c0782701234a2d72de2f86eafeb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/218ff8e98fd0037b28f2dff4971986308aa0f7676e1bcf3761dac7b1a0da543d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe ô tô kinh doanh vận tải hành khách lắp thêm hoặc tháo bớt ghế, giường nằm tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/21972300a26781b9a43f019071d0368f143ff0ae8ce8e8fc2169755a9f26dd10> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở theo 02 người trên xe, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 12 tuổi, người già yếu hoặc người khuyết tật, áp giải người có hành vi vi phạm pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/21c889710ea9e2c9e241c428ef5eec5575a804b39b97ad23d64e710873db0947> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy tốc độ thấp mà không đi bên phải phần đường xe chạy gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/223a348cca1061d11ffce2571d4d595fd20d82138a2cadb3bb6355587dbe2bb1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe ngược với chiều lưu thông của làn đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/226c982f2f07c0fa7e1a1d2fe2cf7c54f43b226cdc4f2b61b3f9b20dc1af90ce> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/22b987a6f9516c14582d68511f34ec2b9f25d57f13eae6c01608510859522671> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Mua biển số xe không phải là biển số do cơ quan nhà nước có thẩm quyền sản xuất hoặc không được cơ quan nhà nước có thẩm quyền cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/22f3c63baf797f1e3226df1050ea4630c4e66d7478b8ac6d6b89baa43a59bb05> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành không ngồi bên cạnh để bảo trợ tay lái cho học viên thực hành lái xe (kể cả trong sân tập lái và ngoài đường giao thông công cộng)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/235f2f528d0d8b5e881ea94ae88f2294076e183fff4a2cbcb7792722d1aa7e27> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có bộ phận giảm thanh, giảm khói nhưng không có tác dụng, không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/23b365cae451047ee7de2c72ee8eef24e6b56f22745e3535e737b0e3200d45c2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lưu thông trực tiếp trên đường bằng xe bánh xích mà không thực hiện biện pháp bảo vệ đường theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/23e400a0040987face56517db3ac5de968b64372cf8962d9038a7374d6fbf7a9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2426b0c3e2a4fa999dfe5157106f7f2d525b83ed10468062f8bc1ce32600dc85> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/246e818da2c932fe97d150f30167e35ae527998844ab3a4a8ce331f1299fe421> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2506e1c50e033ed0ddf2c7395ee318a9ab716fd67095becaa588ea41e72fea92> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không quan sát, giảm tốc độ hoặc dừng lại để bảo đảm an toàn theo quy định mà gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/25549c35d2ee4c2924a85370390045a902b6295c3fbbc9a24a31a5f0ff4ffd4d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đóng cửa lên xuống khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2579d045740d1b99b3632d58d4aa051f623705cfead3e8eadd0daa1e0b710454> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều trên đường cao tốc"@vi .

