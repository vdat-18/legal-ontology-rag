    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c59c6b9fe161ce514718173a35f74fd06572e4b28e74cd438045aaaf8c654f7e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lắp đèn chiếu sáng về phía sau xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c5d19ab0a6d9e0dfdbc0be300715caf0d130f73ebcbbb350d78247e63a57aa63> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe vận chuyển hàng hóa nguy hiểm mà không làm sạch hoặc không bóc (xóa) biểu trưng nguy hiểm trên phương tiện khi không tiếp tục vận chuyển loại hàng hóa đó"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c6034afe86e98313a2d60e552899d2dab8aa7faa98186291f1e918b6714e8f5b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách không có dây đai an toàn tại các vị trí ghế ngồi, giường nằm theo quy định, trừ xe buýt nội tỉnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c676a0253d95253f6f52693fa5448bbb67857eea3449b51d88939b547b3f9758> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người ngồi trên xe không đội “mũ bảo hiểm cho người đi mô tô, xe máy”, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 06 tuổi, áp giải người có hành vi vi phạm pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c6e98383e2711b6c405a05ffaaa6083ea024b0811d3b2bc8b40fcac8c70bb608> a loroc:RegulatedConduct ;
