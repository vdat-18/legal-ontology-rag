    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có tín hiệu trước khi vượt hoặc có tín hiệu vượt xe nhưng không sử dụng trong suốt quá trình vượt xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c28f53e74d55c4511057e83ba1c828e9003c3fe4fdb1a87e21178d52ad2aa623> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không báo hiệu trước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c3ba4afc38e09b30c2252ba3d199c0f6e665e58bc6a5f40e6ed77ae8e7db439f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ, để xe ở vỉa hè trái quy định của pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c3cdbb2e6f973cda4649e675da34d5fb915515b5de2dddd8cdbb74c0f84eafc9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng không có giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c418c47c4692c6f659ee9d5bab756c806e5233556bc971c7e3b278d79586710c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 20% đến 30% đối với xe xi téc chở chất lỏng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c441a960bff3257ac72ea90a737368251858b64a5c896f055c08d07659d88cb1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện không có chứng nhận đăng ký xe tham gia giao thông hoặc có nhưng đã hết hạn sử dụng, hết hiệu lực."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c50876bdfe007c8e7a6debfe2c4ec8317f94dfb22bbf83a21785d44376082daa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định từ 10 km/h đến 20 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c51093e78d1b2f3e64007bbe7cb5158a3f697c47423c00f963aea8e70622bff6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có kính chắn gió hoặc có nhưng vỡ không có tác dụng (đối với xe có thiết kế lắp kính chắn gió)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c517ea340d3b0a2505a6b680ad50cc460e6d73901a23f5bb32a2cb2b3dc7c3f7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cấp lệnh vận chuyển, giấy vận tải cho lái xe nhưng không đúng theo quy định đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c53f78d32b8a98c94ce7f0ed401645067fbeaa6352519c07c3424f36bc965f03> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển phương tiện không gắn ký hiệu phân biệt quốc gia theo quy định"@vi .

