    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường đường cho người đi bộ, xe thô sơ đang qua đường tại nơi không có vạch kẻ đường cho người đi bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/268293532e1d7f1dcaf351e79221950c5d1eecface54458e08ed2a46fa076765> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở đất đá, phế thải, hàng rời mà không có mui, bạt che đậy hoặc có mui, bạt che đậy nhưng vẫn để rơi vãi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/268692a79f91c569906d039bc327973baba28697f95f61a5f10d01056a1c2738> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm d khoản 9, điểm đ khoản 11 Điều này, hành vi bị cấm đi vào công trình thủy lợi và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/26e540a67b5d5893f01b5b52b22132ad156cae3a1542ae059b8bcc3ea2325c3e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp, không đặt biển cảnh báo “Chú ý xe đỗ” (hoặc đèn cảnh báo) về phía sau xe khoảng cách đảm bảo an toàn khi dừng xe, đỗ xe trong hầm đường bộ trong trường hợp gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe"@vi .

