    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/038ff9a4fe283bf1baa727c8df7bd122a969402f244ed1a7f5d9b6da17bb9c75> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe gắn biển số bị bẻ cong, che lấp, làm thay đổi chữ, số, màu sắc (của chữ, số, nền biển số xe), hình dạng, kích thước của biển số xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/046783680e2a731d875ef352277a7e1cedd6520cfb46928532cd99f2e201797f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không ghi, không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0489a6e70d6c3e059eaeffa3265563befce9dda1915dd4d7cb50da74c4124c2c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/04bac2e5e80b63617b56649fc659c9b90ea5ec757f693652aa145e3b640e561f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm mà không làm sạch hoặc không bóc (xóa) biểu trưng nguy hiểm trên phương tiện khi không tiếp tục vận chuyển loại hàng hóa đó"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0520de0d1266e97205be702d9832e082216899948a01978d31307af3ffc6c62f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dẫn dắt vật nuôi chạy theo khi đang điều khiển hoặc ngồi trên phương tiện giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05321dd77c3ff75d656ac7da024ab8718b0a4c369787e9370107a6739df27fe7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tụ tập để cổ vũ, giúp sức, xúi giục hành vi điều khiển xe chạy quá tốc độ quy định, lạng lách, đánh võng, đuổi nhau trên đường hoặc đua xe trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0536ba709f48e40315a23521a16bee9214325509faddeea50e30b5c2bbd62aa5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05aa44c709f01cf53b1d59f5a2f3ad9a8785a6a0fb12954126f4e5a1485821b6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bán hàng rong hoặc bán hàng hóa nhỏ lẻ khác trên lòng đường, trên vỉa hè các tuyến phố có quy định cấm bán hàng, trừ các hành vi vi phạm quy định tại khoản 7, khoản 9 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05aa573522820d981632b39144ef7c644f6b7febe8f40895cd4115d63748bc27> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe rẽ phải tại nơi có biển báo hiệu có nội dung cấm rẽ phải đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/061cffbf79d614278e54dc9065ad3745967ce09c7df40da39d6ef014c415ef4c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển không đúng đối tượng theo quy định đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0643c2c6c2b869ac5f81b4baebb4f64ad90df15045697b5e81c3cf0d9b5c19ec> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không khai báo, khai báo gian dối hoặc cung cấp thông tin, tài liệu không đúng sự thật để trốn tránh trách nhiệm khi bị phát hiện vi phạm pháp luật về trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0657edf8008552af28aba1204d30a5d35d964cea85f05d4003330425ca91eab2> a loroc:RegulatedConduct ;
