    skos:prefLabel "Trung tâm sát hạch lái xe có trên 50% số xe sát hạch lái xe trong hình được cấp phép không bảo đảm điều kiện để sát hạch theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ad3a19bffa819818c4a3f99881c129c0b267eb4b348a01b29102a3f1702ff49a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có hành vi khác không bảo đảm an toàn khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ad53152434650efd4a7f9e296457a68cef4bc477a0ef8c025128c7515b3cf713> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ad741fd9fbcc1545e41ea28694f8a17282bc76c41711f2d5cd05c2d5b20db0c8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
