    skos:prefLabel "Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c749ef84ff14fe59fa694157526d832eeff1ed1a0bdfe3962fc32f439f3e7b03> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh, chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm b, điểm d, điểm e khoản 2; điểm a, điểm c, điểm d, điểm h khoản 3; điểm a, điểm b, điểm c, điểm d khoản 4; điểm b, điểm d khoản 6; điểm a, điểm b, điểm c khoản 7; điểm a khoản 8; điểm b khoản 9; điểm a khoản 10 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7722ab3ce218ed47b44ec91b22cfa15874ce31802e086177f075c04e19a4706> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý mở cửa xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c777e8d700a6585a3320b9b0591cb54ad4c828ec99d6b5aba551c1fe07c601d7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c784679d0b6e0eb246671f263e09fd450afb3b6a03c0233c98bcd740e7d9ac22> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không cấp lệnh vận chuyển, giấy vận tải cho lái xe đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c79ba10347341de82a9180f33b8d6fa07e6dae4a66db988e271a79ba8ff06a74> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7fd2a2a5d5f104c3fcdd9e2e3f74ba86a0e35b1ab9087c78aa28a1025590bf6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ có lắp thiết bị giám sát hành trình nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c80e8b58abacb5da59033ded3e6f41775ddb94b4c783a198384578106da195f1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c841348b30358d6ab327d363f8b64bc628a2ac4b1e2501c604e09db1668656fc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ các quy định khi vào hoặc ra đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c8cebfdb7d6a3ecc9cc3aa196788fb624776b7f25d0a1b639b6c644222109317> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có hệ thống hãm nhưng không có tác dụng"@vi .

