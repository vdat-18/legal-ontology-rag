    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe rẽ trái tại nơi có biển báo hiệu có nội dung cấm rẽ trái đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/efb3ef2b12a6a7bb101cb13d3df5eec1b3db8962dcded92eda426714675e2dd6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người đang điều khiển xe hoặc chở người ngồi trên xe bám, kéo, đẩy xe khác, vật khác, dẫn dắt vật nuôi, mang vác vật cồng kềnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/efe16de695d8ae85e2c0853f1974c7479ce55ca1ce1f702e4e95283ca227342d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng điện tử vận chuyển không đúng đối tượng theo quy định (đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/eff051b3eb782105bbc000bee2cfb5a90b7b9157099745f55fd770a01626c863> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng đột ngột trước đầu xe cơ giới đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f0086c5016c5e83bfbe16d27c03e613acaedcd8cff2c4ecb1df5b207cdfc96db> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hành lý, hàng hóa vượt quá khối lượng cho phép của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f05c5f6117a894bdf3d6621ba6f2f6dfdf8d4718e1034cff86951d99d7100cc8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi nhãn hiệu, màu sơn của xe không đúng với chứng nhận đăng ký xe."@vi .

