    skos:prefLabel "Hủy hoại, làm hư hỏng, làm mất tác dụng thiết bị điều khiển, giám sát giao thông đường bộ, thiết bị thông minh hỗ trợ chỉ huy, điều khiển giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a6e035d87656e471ebdf581343a7275752bd2ac91cec859fd4f7e8667d1eb8dc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có thiết bị có chức năng cảnh báo, chống bỏ quên trẻ em trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a7a0bca4c08830bcf23a648338ce68b3ef5ff84666d92af0c345679f72381176> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đi bên phải theo chiều đi của mình"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a7c4dde0bd2a59f42d60dc1bc426a67b1cdd897ec4f7fb316cdb775fcb80bfbf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hàng hóa có thiết bị để truy cập vào được phần mềm thể hiện nội dung của giấy vận tải nhưng không cung cấp cho lực lượng chức năng khi có yêu cầu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a7db158520ce5031a91854f2b6456c5f8d06a70726cc1ad36371bd5934716991> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên thùng xe trái quy định"@vi .

