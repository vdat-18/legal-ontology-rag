    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc cung cấp, cập nhật, truyền, lưu trữ, quản lý thông tin, dữ liệu từ thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aa462df636e86660aa62286aab00a0cff343e2a8e96d1ae9ac37d6c046d25fbf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý lắp đặt thêm cơ cấu nâng hạ thùng xe, nâng hạ công-ten-nơ trên xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aa4a2feedb0f1de4296fbe1f92bb29e74b717f66dae45930160ad82241e92a1e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe xét hoàn thành khoá đào tạo hoặc cấp chứng chỉ sơ cấp hoặc cấp chứng chỉ đào tạo cho học viên sai quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aa8c1a8ccce400ce29f01d7384ed14b7f48477814aef3653a24135475f62925e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu ưu tiên không đúng quy định hoặc sử dụng thiết bị phát tín hiệu ưu tiên mà không có giấy phép của cơ quan có thẩm quyền cấp hoặc có giấy phép của cơ quan có thẩm quyền cấp nhưng không còn giá trị sử dụng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aaf953122a70c3c6bcb434f359fce2e2b70ef67662b57962551cb163c58966a5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng nguy hiểm mà xe ô tô không lắp đèn hoặc tín hiệu cảnh báo theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab02c2416d3252feb257389fad599b2d8756c9f81b15720c59a4dffdc21ed944> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đeo phù hiệu “Giáo viên dạy lái xe” khi giảng dạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab203fdd5ab422c499404ab412f287ef5e5ca29842030629a7ac7fa50289f2e7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô tham gia kinh doanh vận tải hàng hóa không lắp thiết bị giám sát hành trình"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab31c1934b85c5cb92080e8ecad2afdcc588b7447744f758c1cae041c3ca72f2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô đẩy xe khác, vật khác"@vi .

