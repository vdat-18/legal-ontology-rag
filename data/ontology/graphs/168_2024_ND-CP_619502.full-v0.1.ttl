    skos:prefLabel "Người điều khiển xe máy chuyên dùng sử dụng giấy phép lái xe đã bị trừ hết điểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7044ba50054c31f62034c7c5cf90d5889d74a8205449f46d50f718784dfdfbb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa ra các yêu cầu trái quy định về trình tự, thủ tục đăng kiểm đối với cá nhân, tổ chức"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b76a2f455369db5cfee6a164450a8590ea74bed75273003ed128bc30b1e91306> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi xe bằng một bánh đối với xe đạp, xe đạp máy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b78a8e8c6d70044161022dafe7eae5ba5ea659215a3930dfe9e44f0d45ee8b24> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe đạp, xe đạp máy, xe xích lô chở quá số người quy định, trừ trường hợp chở người bệnh đi cấp cứu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7926748f0f06ee2b9155d6744ed4806a369929300b654ec45305bd95364792e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chiếm dụng dải phân cách giữa của đường đôi làm nơi: bày, bán hàng hóa; để vật liệu xây dựng; để xe, trông, giữ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7ba0c91c2371c5c61b24d223f1616a02ce79309f148e9cfd06e86c95dfbe316> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không hướng dẫn trẻ em mầm non, học sinh ngồi đúng vị trí quy định trong xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7c0ea1d0b1dc9195d637fe52b901d5aff9dff516b5811b7f691d6458c8c5236> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe; biển số xe; giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7cfb5e586d48843bafcd864ed88b3172add0a8fd884a9db43d41f1110eb9d37> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bày, bán máy móc, thiết bị, vật tư hoặc sản xuất, gia công hàng hóa trên lòng đường, vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7db4d3233f6d267605811d61ce541ea1b8655659d3dd5f2c4efa7a333ad98b5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ, để xe ở lòng đường, vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8276bae71b0662a5c0de181021ced9b753ee07eb4df89c7bbd99d93eaac568d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách theo quy định của biển báo hiệu “Cự ly tối thiểu giữa hai xe”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b857e81b3e0a0556a97086c996a27214150f3f3c3ccf51ba86b0d2adec08f1bf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chạy trong hầm đường bộ không sử dụng đèn chiếu sáng gần"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8664632d41e1066e6cfc053d93011ae57b6ef96688dd441d39c7e414c4fec89> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng mà trên xe không có hợp đồng vận tải, danh sách hành khách kèm theo, thiết bị để truy cập nội dung hợp đồng điện tử và danh sách hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8bb0f283eadbee4695bfc0215cb0a1f143856a6fa4ccca79a873327d8de780b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng chức trách, nhiệm vụ được phân công trong chứng nhận, kiểm định xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8beed9074dc7b41227f5742198515ff1f4831bd368ed86d7a80f058e9e18cac> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8c348bd2a9f11ce157d468ec601ecd7556ec35c2dc45be4732255ab6f82942d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe niêm yết hành trình chạy xe không đúng với hành trình đã được cơ quan có thẩm quyền cấp phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b988517cb8b103fa78eb25fe0fef4ef7a461b86324fcd2c3b42c97b6bd200a08> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển, dẫn dắt vật nuôi đi vào phần đường của xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b98a818afe302dd4924110c5b3a2917406d6b8d1fbdbd03a5391101ccaed8505> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe mà bánh xe gần nhất cách lề đường, vỉa hè quá 0,25 mét"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b9cc3d6b63e5d2418cf82481334441f52e0701c9349851427ed7adb9b6336612> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hành lý, hàng hóa vượt quá kích thước bao ngoài của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba332129ec5768a73bf2811450aa4fe93a723270ef766e7e5b988e65df65cad1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đánh số thứ tự ghế ngồi, giường nằm trên xe ô tô chở hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba342bbda913bce0f8d57336d2e3cae40350a95d07e7ca305f3c930fece9edb3> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe được quyền ưu tiên sử dụng thiết bị phát tín hiệu ưu tiên mà không có giấy phép của cơ quan có thẩm quyền cấp hoặc có giấy phép của cơ quan có thẩm quyền cấp nhưng không còn giá trị sử dụng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba51391539b56a9fe4154b4692fa3971a4d8f8b41f2e863c2700a1f1d7d4b190> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba81d5e504c6010d9b587dd9ca0fd604630655444528c11ccce3d882e9e3241c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe nơi có biển “Cấm dừng xe và đỗ xe”, trừ hành vi vi phạm quy định tại điểm đ khoản 4, điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bb7a9ab6a5ce9b0cd9e228c697c97694064b7298eb8dda3c7349a1c4257b3cb4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không có gương chiếu hậu bên trái người điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bbfc31ca8764c0d8c6e72fbbe1b8b31ee5bf222fb0e57aa969c47f1e23d1cec4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên xe được kéo, trừ người điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc4a7f4141250736734a4d09a0691b13f721af538838413c437ddf34991da6a1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe ở phần đường dành cho người đi bộ qua đường, trên cầu, đầu cầu, ngầm, gầm cầu vượt, trừ khi có hiệu lệnh của người điều khiển giao thông hoặc chỉ dẫn của biển báo hiệu tạm thời hoặc tổ chức giao thông tại những khu vực này có bố trí nơi quay đầu xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc6792998b7159992f355b88369bd9dc235bcdcfb6bc5f6462ac0380301564dc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để hành hung, đe dọa, xúi giục, gây sức ép, làm mất trật tự, cản trở việc xử lý tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc8a83abf6069e702583d3f7f3db5186a4f34ac8f4f7b9e56a8709f3293fd2d0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bd8db9fae5bfee539d0308fda5c9ab66d3c0b70173aeaaf9b88fa5ff1f9cd78b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Cơ sở đào tạo lái xe sử dụng biện pháp kỹ thuật, trang thiết bị ngoại vi, các biện pháp khác để can thiệp vào quá trình hoạt động làm sai lệch dữ liệu của thiết bị giám sát thời gian học lý thuyết, thời gian, quãng đường học thực hành lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bdb6d6dc93ebf5058c750c87f49298506c6f42a463c40ac050f06d822f333c2f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành hiệu lệnh hoặc chỉ dẫn của đèn tín hiệu, biển báo hiệu, vạch kẻ đường, trừ hành vi vi phạm quy định tại khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be9014fb221ebfe0456d87e4c0d40292e2d4c99df0be445b9aa531ee2b21a0c0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải có niên hạn sử dụng không bảo đảm điều kiện của hình thức kinh doanh đã đăng ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf1d3ec1544b9bc433fd5a8400fd832d92b57c9f657d382b08c9f4ca03704f50> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện không có chứng nhận đăng ký xe tham gia giao thông hoặc có nhưng đã hết hạn sử dụng, hết hiệu lực."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf36a4c642ba05917f6441c7e9b3effeb072e8b913cb18f82cc7276e3de83f84> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đón, trả hành khách không đúng địa điểm đón, trả hành khách được ghi trong hợp đồng, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf5b751606d6e1a746ada54c05f55fe55a377265d68893e87cd7be4a1c288700> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng rời, vật liệu xây dựng, phế thải để rơi vãi xuống đường hoặc gây ra tiếng ồn, bụi bẩn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf7cb8ec6d94396437bb934e64e23123b28122fe7b5ab7568ee9213352b259cf> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo chứng nhận bảo hiểm bắt buộc trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf9fe1c62c7d327c70c0d169fd9a4e91f3a24723fd6ee5c39f25b67001195bd2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải có chất lượng không bảo đảm điều kiện của hình thức kinh doanh đã đăng ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bfa8c0ff9d447af30cb06d0a5d8c691067a773c5b7db22dc59d17ea22a0774e6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không khai báo, khai báo gian dối hoặc cung cấp thông tin, tài liệu không đúng sự thật để trốn tránh trách nhiệm khi bị phát hiện vi phạm pháp luật về trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bfab77cfa181a5911049094f2a115e8db50e20597bc9bbf9d07ac53551ca6774> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải không có hướng dẫn cho hành khách về an toàn giao thông và thoát hiểm khi xảy ra sự cố trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bfabbf8e0a98a3784e70cc3b5e205686fc45a4fdf67ab15c7942df456cb3881f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đơn vị sản xuất, lắp ráp, nhập khẩu thiết bị giám sát hành trình của xe ô tô không báo cáo về việc cập nhật, thay đổi phần mềm của thiết bị theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bfbd879b343b3bc9047700b807e70ac46203a57a2c48ffd83296e8bfd388c1ed> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong cơ thể có chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bff7f8e7fca9a0e0efae558ed3cd36d2be41fc045f3503d77859cf994db118fe> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để người đu bám ở cửa xe, bên ngoài thành xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c055de89d5942a20b4a711f00b65007b864c390daa6350f93e46188af0d0b98f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, người quản lý trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được hướng dẫn về quy trình bảo đảm an toàn khi đưa đón trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c0c008fd438cb36a8ccb41ae9d4e29ce22028c587cadd98b93a730859715af09> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c18f5f05a453ce5c423b8803d79864e4c42828ff419446c89904a1b4ce082c1d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đơn vị sản xuất, lắp ráp, nhập khẩu thiết bị giám sát hành trình của xe ô tô không có nhân sự cho từng vị trí công việc theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c1ed232ecf621b9ee33951bd2c4ca6d88d389ef7d1a84e75ec80015c6442ba31> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đón, trả hành khách tại nơi cấm dừng, cấm đỗ, nơi đường cong tầm nhìn bị che khuất, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c1ede2ad7735bf0cbcbfebd48635a0087e3d53c2edf2874065ecb2870c228412> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành để học viên không có phù hiệu “Học viên tập lái xe” lái xe tập lái hoặc có phù hiệu nhưng không đeo khi lái xe tập lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c21061211d9c89629fd94d9ee4384c8f9aaa60e605190086038a78366b7e12f5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe vượt quá tải trọng cho phép của đường bộ trên 10% đến 20%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2121481d36325b243d67ffb60f58139d1648d81950faf68aa29985deeec2b77> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô đầu kéo có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c25cab72b5af4a354fab33862ef63d4752dc6dab6a1c569900a30faf0fad9aa6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Phân công người không đủ điều kiện thực hiện việc thử nghiệm, chứng nhận"@vi .

