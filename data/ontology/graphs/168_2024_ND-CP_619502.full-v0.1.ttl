    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe, biển số xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f2b786f7d86efe44da5cf6b6f6adebada1b565340119e84ed5334dbce0616d90> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy phép lưu hành còn giá trị sử dụng nhưng đi không đúng tuyến đường quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f323bf457c6ecc71194087db600fecbf0157e4c622c6738ce451e9cfbba7c241> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục cấp chứng nhận đăng ký xe, biển số xe trong trường hợp thay đổi chủ xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f33f6d231d4f853e2522ac46a825231fb247bc0f637f13d45ab5d40cc73df407> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f34afd207fda15d5f6df2875b2c9a71f489adcc92935c2ddaa9ca1892356106d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe thực hiện hành vi đón, trả hành khách trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f39785b20f365a0f5117bd3064327f2b9d0b8ce98ed4886f45b5173487f66031> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3a7f36754252d39a6368a39beab86d981ff959e38eb1443cc9b5c6e846a481e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe tham gia giao thông tại Việt Nam không có văn bản chấp thuận hoặc cấp phép của cơ quan có thẩm quyền cấp theo quy định (đối với loại xe tham gia giao thông tại Việt Nam có quy định phải được chấp thuận hoặc cấp phép)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f40b758dbd19a9fdd8d0db7040d7281cf7506a4f9d8c7c156bb026f182eaa804> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f440bb9da28b725f31734aa4dd76a27a18996ca5000fc883c293d6d712207b84> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f4c7635aa28695844bae0a488be0d1a47da3d06b4940a5bf6b0816b2b144c65d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không đủ hệ thống hãm hoặc có đủ hệ thống hãm nhưng không có tác dụng, không đúng tiêu chuẩn an toàn kỹ thuật (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f4ece31fce560fd78f00f888ea768dd4a3d3f702855e79751ab95fbbe77f8a6b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f5ec406466f3094bd986189de3a0d3496ef0de22624edd24aba3d5d4896d42c4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giảm tốc độ và nhường đường cho xe đi đến từ bên trái tại nơi đường giao nhau có báo hiệu đi theo vòng xuyến"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f5f9f65c09a920771ebeb0353b99fce875071fd8d33f1534e706f19db2a75fc7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có hệ thống hãm nhưng không bảo đảm tiêu chuẩn kỹ thuật"@vi .

