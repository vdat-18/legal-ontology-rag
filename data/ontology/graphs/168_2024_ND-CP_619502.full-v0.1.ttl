    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người được chở trên xe đạp, xe đạp máy sử dụng ô (dù)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a7fabde5b338b67a9227264d7f1275dd3f173ceab02939998a687354877db1cb> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khi có điều kiện mà cố ý không cứu giúp người bị tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a7ff83d25c47501bcf2cb91ea2a57242557ee261b1666bbc75167a9216fc2938> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a84e08dfd1a68b502ba98d5b0a08a787c01a53a5779e537736f29f3157130b5a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe không lắp đủ camera giám sát phòng sát hạch lý thuyết, mô phỏng các tình huống giao thông, sân sát hạch theo quy định hoặc có lắp camera giám sát nhưng không hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a87336d1b05823310f14397d282d99128406645715cff05aaa8ec28994c9d19b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi qua đường không có tín hiệu bằng tay theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a88dbed2ebd7e28790c678dc9b63ef5500bab97cfde0ce8938def425ac73201f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Trung tâm sát hạch lái xe có trên 50% số xe sát hạch lái xe trên đường được cấp phép không bảo đảm điều kiện để sát hạch theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a891e0ebea504d1f91f45d1ba1ad567061f3b607941843c77d0a17e015c36a32> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bán biển số xe không phải là biển số do cơ quan nhà nước có thẩm quyền sản xuất hoặc không được cơ quan nhà nước có thẩm quyền cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a8acde8fb052de398949d2abf9141b8e70c1c2c20c79640b1a89ee9de0aac0ff> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi xe bằng hai bánh đối với xe xích lô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a8e27bf6384eaa4f6dd8526c1f35f4f43fab4c5bc90265390917d0baaf76d5b0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a8f199d878188dc4156b15b47a09e4f60bf25b92118ffe9cb2a27e39fc9baacd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 50% đến 100%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9113d9c532b502ce52625aa446869583f3e7e513c05a9afc1b37168ffeadd1f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy định về biển số, quy định về kẻ hoặc dán chữ, số biển số, thông tin trên thành xe, cửa xe (kể cả rơ moóc và sơ mi rơ moóc), trừ các hành vi vi phạm quy định tại điểm b, điểm c khoản 12; điểm d khoản 13 Điều này và các hành vi vi phạm quy định tại điểm b khoản 3 Điều 39 của Nghị định này."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9479ed8a6bddd82d041684f52477114858e6d3a23c64131c75af719d278459a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy không có hoặc không mang theo hợp đồng vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a98f3edaea8ecc3269860f2b71d3e11eb11f537c77e2d1322d15106dadb46702> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không quan sát hoặc không bảo đảm khoảng cách an toàn với xe phía sau hoặc không giảm tốc độ hoặc không có tín hiệu báo hướng rẽ hoặc có tín hiệu báo hướng rẽ nhưng không sử dụng liên tục trong quá trình chuyển hướng (trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a9cbe9159ebca24f5cb4f0d4e36c0bc66fb3dd92119ef4544a6e2711504d4d71> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe, quay đầu xe trong hầm đường bộ"@vi .

