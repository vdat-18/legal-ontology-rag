    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hành khách theo tuyến cố định có mang theo lệnh vận chuyển nhưng không ghi đầy đủ thông tin"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aca7e961c6d3e76102e1a13825cdc0c67ea6e144e9c7cb19ae74b5300ba258d2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) không bảo đảm quy chuẩn, tiêu chuẩn kỹ thuật của công-ten-nơ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/acb0fc7e88474da5fe2d1da4c4a7a389a13468b7fc966af2ce259565eecaf815> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi khung, máy, hình dáng, kích thước, đặc tính của xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/acb0ffc2afc9388baac3603dbe4e2ffc27b541a23f171db9b6541a9139516623> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp, không đặt biển cảnh báo “Chú ý xe đỗ” (hoặc đèn cảnh báo) về phía sau xe khoảng cách tối thiểu 150 mét khi dừng xe, đỗ xe trong trường hợp gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe trên một phần làn đường xe chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ace937e2e71c2fe15014d81c72beb324af5348f84b895606c2589fe02ab8af6a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có tổ chức khám sức khỏe định kỳ cho lái xe nhưng không đầy đủ các nội dung theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/acf288a36b93c7af0599ae0249d26f87afc6e3ab1af136b62c9edf91032afdba> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Mua biển số xe không phải là biển số do cơ quan nhà nước có thẩm quyền sản xuất hoặc không được cơ quan nhà nước có thẩm quyền cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ad0985c4daefedf14caa58473df79abe559d0aa075ec969807eb2ae73b5e1eaa> a loroc:RegulatedConduct ;
