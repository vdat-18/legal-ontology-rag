<https://w3id.org/legal-ontology-rag/data/concept/conduct/e9c4af106d9f124a10636f178d61e3ee7823908ae671cb81c10d4a803636df18> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để xe ở lòng đường, vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/eadb86321b2b655c2cb984efae87b0721ac92ac0c1415e21e4dbf5e94c465bd0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng chân điều khiển vô lăng xe khi xe đang chạy trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ebc31b6b36579617a4935ac32ffc9aeb5ea04fbb966c5ba11a0a44a910a3c14c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khai báo không đúng sự thật để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec07c8a1e73b3f846d4b1b0e140ae8f8b3aaa8141a9a845727473729eef11341> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy định về thời gian nghỉ giữa hai lần lái xe liên tục của người lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec24710f6d4d83c93a94b739a3c66b44a4c1f109131a0e95b16c78357b5062df> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa xe cứu hộ giao thông đường bộ không có dụng cụ, thiết bị chuyên dùng để cứu hộ, hỗ trợ cứu hộ theo quy định tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec4eff7ba938591d356331736441ab4435109805c26cf6ff1dee803a585724ac> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe máy chuyên dùng có tốc độ thiết kế nhỏ hơn tốc độ tối thiểu quy định đối với đường cao tốc đi vào đường cao tốc, trừ phương tiện, thiết bị phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ec5a03eaa38acbefbbebfc0aae9f15ab4f7154866c4689ae2dea5f1de1e7a269> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm d khoản 7, điểm đ khoản 9 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ecb178656ebf28cee1e9116db599ec9d78461e0b8dc3e671f34d2e5ad9739ace> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở hàng vượt phía trước, phía sau thùng xe (kể cả rơ moóc và sơ mi rơ moóc) trên 1,1 lần chiều dài toàn bộ của xe theo thiết kế được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ecbf0603ade23df848485e5e12075caee5dc5920b457dd2bd8cb4dd8a87176ad> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trước cổng hoặc trong phạm vi 05 mét hai bên cổng trụ sở cơ quan, tổ chức có bố trí đường cho xe ra, vào"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed09e99ab4f92331f9148b02ee9509b1cae805f386f8110942bb2cdb5f1a7b66> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe ở làn dừng xe khẩn cấp trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed4aab2fe7e2aac1e153755f46b6941c7b24d5c47277770477b6f487dacecc4f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện đã bị cắt, hàn, tẩy xoá, đục sửa, đóng lại trái phép số khung, số động cơ (số máy) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed6b223cdaca933205d3075920a98f416744923ebe3585370113565ec3406e5c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có giấy phép lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed7ff72f1c37067e62d7e67910dc2c9c5a935b49e6287c56db68239ebbb400b2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không chạy đúng tuyến, phạm vi, thời gian quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed9b27936c424030d8372ad7767518c90ebf550a5897cffe24b24c6707ce1148> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy kinh doanh vận tải không mang theo chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/edbebd371e702b3020bcd71dba99d6499ec221ca883b558a0d05dad98343f40e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hàng hóa không có thiết bị để truy cập vào được phần mềm thể hiện nội dung của giấy vận tải theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/edca378521c1cf717b4a49f11259ba784163d51a6afce70bbd56fd87000859c7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đe dọa người khác đi trên xe, lái xe, nhân viên phục vụ trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/edeb77d972669dfdedae06652029db410d32189cac3ce93163bf3627933d052d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Giáo viên dạy thực hành chở người, hàng trên xe tập lái trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ee02416ee03eac96c52e2b29e590206b5e8a60188c87867b927120001fac8160> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có tín hiệu trước khi vượt xe"@vi .

