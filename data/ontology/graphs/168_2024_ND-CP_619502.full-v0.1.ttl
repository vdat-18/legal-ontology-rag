<https://w3id.org/legal-ontology-rag/data/concept/conduct/0c98a1ba357d3afb348b1c3cb67aebfffdc1dab970b6ec5f05e0858f149bbc62> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
