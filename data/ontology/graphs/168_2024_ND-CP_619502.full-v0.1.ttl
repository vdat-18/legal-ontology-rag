<https://w3id.org/legal-ontology-rag/data/concept/conduct/29b2496779a2bde08a6a7a3a480889a0c5aa872376a7d87823d34e546b3f5810> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng bàn trượt, pa-tanh, các thiết bị tương tự trên phần đường xe chạy"@vi .

