    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Khai báo không đúng sự thật để được cấp lại biển số xe, chứng nhận đăng ký xe, giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2a2c77be011da8afa576d0e6f3f4c3fd56f7e3c46d455000ab640f03d2526509> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển “Cấm đi ngược chiều”, trừ các hành vi vi phạm quy định tại điểm đ khoản 11 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2a4fb4f11d0ccf7d02213319ffe2e7811ceca4391d7b43994db48a946177466c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
