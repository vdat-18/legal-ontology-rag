<https://w3id.org/legal-ontology-rag/data/concept/conduct/000b9a912163135e8d58febd3c6e0492ff5afaa87f0bf8ac63dfc630ee093144> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/006e8528d92ff085f7c3b67e2ebf7f734527a00bfa666d11f18d9dbc4d4b15d9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/008fd7c190da093b870d3d6486024788cdead2a580aafb4d9d601be27c072f77> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, rơ moóc, sơ mi rơ moóc và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường đối với loại xe có quy định phải kiểm định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/009b55709ab1df9e97fbc7d0e2e8b96b99114c2f59e32087b3a827ccb8f2269d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên buồng lái quá số lượng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00bbe97991eeac0f76faf5023029bb3cd0124efe30829211932eac4e915caa89> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 50% đến 100%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/018fe5b32d427ea94a8beebb882415a7b766944a7e4822d5a1c50403c5773cbc> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không nhường quyền đi trước cho xe thô sơ đang đi trên phần đường dành cho xe thô sơ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/021397d6acacb8a0e436ed52fcfd3015ad7618277e0da510ae67ed291d89a6ab> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không duy trì việc bảo đảm về điều kiện, yêu cầu theo quy định tại Nghị định của Chính phủ quy định về điều kiện kinh doanh dịch vụ kiểm định xe cơ giới; tổ chức, hoạt động của cơ sở đăng kiểm; niên hạn sử dụng của xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/025c415622795b2e485f48649f1382158c6e6cd73eccc0e5a11c4354bb011d06> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02db145c03632964f8bbfab51831f7c977bb4fb6da2440d8bab3b6ccef607103> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, rơ moóc, sơ mi rơ moóc và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/02ed023ee0068395222cb8d3fe6667aa642ec412ec1a8935baab7ea2fb8ea265> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển phương tiện không có giấy phép liên vận, giấy phép vận tải đường bộ quốc tế theo quy định hoặc có nhưng đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0302eee7a5891ecc885e00f18548f20529aa6296f98f780b3f3756f379d3161e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô có tay lái bên phải tham gia giao thông mà không đi theo đoàn, không có người, phương tiện hỗ trợ, hướng dẫn giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0349b87f17521bac864439207f648a78065e1e8e987cff1cd83d210724b96b3d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên nóc xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/037a5164dcbed05411be10f75abe37ad7505acedf534bf034f44fad7b038e62a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không hướng dẫn hành khách đứng, nằm, ngồi đúng vị trí quy định trong xe"@vi .

