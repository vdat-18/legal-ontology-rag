<https://w3id.org/legal-ontology-rag/data/concept/conduct/8d170917c8b52850396327ddc935b98511de559b69256c9c9351d3e2a47979ea> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/8f00c50ad8d8311bf565c02b89dcc919798c9c07237cc69c14fadccc9afa51c7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Có niêm yết thông tin trên xe nhưng không chính xác theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/912662ac1c4d1ac6022cadedb02a434f5858850818dcd7e2db608bb48e390bda> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lắp kính chắn gió, kính cửa của xe không phải là loại kính an toàn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/949527eca1b299ff368d973804e276159601075da2c08b7cad0730e5ce655a99> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kéo theo xe khác, vật khác, trừ trường hợp kéo theo một rơ moóc, sơ mi rơ moóc hoặc một xe ô tô, xe máy chuyên dùng khác khi xe này không tự chạy được"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/96db994776a0b927c317b7bd0721bddd0df996c1dd359db814337662f2fb1063> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/995ac3fd4c7e8c24c89aecbcfff57843da5d228d2967b93efb4910666b305688> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không lắp thiết bị ghi nhận hình ảnh người lái xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9f8b8ac15a3886bd3479e2b85e0b857aaef26efbc338e1f04909179db997a389> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có dây đai an toàn phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a4e6ef1904b5040727c3ca5b0bd233350b2b9dd89265a986cffdf7f9bd3f3840> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục khai báo với cơ quan đăng ký xe theo quy định trước khi cải tạo xe, đối với loại xe có quy định phải làm thủ tục khai báo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/a89424ababca7dcd48a41d5eb8dd7d1a62a1e3c730d33616f92d49a3e84cf0b6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe nơi có biển “Cấm đỗ xe”, trừ hành vi vi phạm quy định tại điểm đ khoản 4, điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/af37fd2cb438c9149d7718f3caff401d70655886cdab3677e70a54b86213fe54> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy dưới tốc độ tối thiểu trên đoạn đường bộ có quy định tốc độ tối thiểu cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aff9b1714a394fc5d0ebc8abf82195899b26d5ca308711186daed37479ef501c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở trẻ em dưới 10 tuổi và chiều cao dưới 1,35 mét trên xe ô tô ngồi cùng hàng ghế với người lái xe, trừ loại xe ô tô chỉ có một hàng ghế"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b13e05f8dc27170367ddf59b0aa2d2bc54e25e22a17ddef4bdc1efd83f0892a5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng đèn chiếu sáng khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b17cc373bc0686ce7308106e30133d211aac00e4a1ce92fc4583bf3c088c1665> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không sử dụng thiết bị an toàn phù hợp cho trẻ em theo quy định khi chở trẻ em dưới 10 tuổi và chiều cao dưới 1,35 mét trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b4e82f499b2a9292050763985e007f014e39e0425708afebdaf8f917849a50ef> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, người áp tải vận chuyển hàng hóa nguy hiểm mà không được tập huấn về vận chuyển hàng hóa nguy hiểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b69348d890eee2304093cc1356615014269ef577b56ffea3fb4c68ac862d62ce> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không làm thủ tục cấp chứng nhận đăng ký xe, biển số xe trong trường hợp thay đổi chủ xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2a925fb38b9206be5b724a4e41db6094b53b01cde416898235e7a61e2442629> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c528d056663b64947beea72bfcd836e3512ee18d9b5758b17a3cad22010f4a40> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe mà bánh xe gần nhất cách lề đường, vỉa hè quá 0,25 mét"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c8d8236bcababb85db75acacc3230be09c3f73051a25ddf2f56edbe22e7f8f11> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c9b448ca24f2fa22e3c002f3f940021b2e92e56672f03943bb79f7625415fd49> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe trên đường dành riêng cho xe buýt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccdc527245670745f005d49c67cde63f1267c2f1b6b750fe9ba855a1701623b9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên xe ô tô không thắt dây đai an toàn tại vị trí có trang bị dây đai an toàn khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d24421a5a12d607c0038440097909bc30c463cb295fbde106b60cbaa0cd1d9c9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý thay đổi nhãn hiệu, màu sơn của xe không đúng với chứng nhận đăng ký xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ddf2f010a7a522f7398dd6f59927a7be7fe5ad285c083cb81ffaf36ce68bf8da> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, người quản lý trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được hướng dẫn về quy trình bảo đảm an toàn khi đưa đón trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0950df1cd824f227e20c4ec8b19b9c4fabf4d5c3c8cc535805787fc45f7e1af> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng không đủ đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e1046d27d21ece094f2e35250368b9a5473a0c983555d8bdcb205368573d1d82> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng lái xe, nhân viên phục vụ trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được tập huấn, hướng dẫn về nghiệp vụ vận tải hành khách và an toàn giao thông theo quy định, đối với hình thức kinh doanh vận tải có quy định lái xe, nhân viên phục vụ trên xe phải được tập huấn, hướng dẫn nghiệp vụ, trừ các hành vi vi phạm quy định tại điểm c, điểm d khoản này"@vi .

