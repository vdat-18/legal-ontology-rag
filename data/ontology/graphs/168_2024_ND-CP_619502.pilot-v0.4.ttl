<https://w3id.org/legal-ontology-rag/data/concept/conduct/5e124662985b91c2462d78606fc6610b0fe838482f59c74733eb2f6598170b2c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe tại các vị trí bị quy định"@vi .

