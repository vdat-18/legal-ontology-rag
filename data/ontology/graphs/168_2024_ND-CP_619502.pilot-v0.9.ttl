    skos:prefLabel "Sử dụng còi, rú ga (nẹt pô) liên tục trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ce537a2c7f4787cfafbd20baf44f0e9ad3b5b8b4e0a7e66a8f780985ee142efd> a loroc:RegulatedConduct ;
