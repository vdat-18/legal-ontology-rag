    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe không dừng lại để bảo đảm an toàn theo quy định mà gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d0cc374b4963a43d37342ca7f8664d43d9b965e4678a13b1315d96a6b5f94f33> a loroc:RegulatedConduct ;
