    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Lùi xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d41159926fda2d836840e31c81fda55f020a2f4c950de6dc07a53e3ce901c196> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d6e222888a4060f6b9ad7aad7121e783ddd2039f1593157030bf444d2c0d974b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d7786086d89c4146ac750673a06c33bd218fa3164f98e9321a341836728a4078> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi ngược chiều trên đường có biển “Cấm đi ngược chiều”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d7bb708580a5e6f005df7e3aae117fc3960fbf8a9fedf4f169bda9bffce7f298> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp và không đặt biển cảnh báo “Chú ý xe đỗ” (hoặc đèn cảnh báo) về phía sau xe khoảng cách đảm bảo an toàn khi dừng xe, đỗ xe trong hầm đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/db0abf883d1413cf4948a1cb97d834953f56a288ae367bfd55b8c1f059e88986> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đỗ xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc3fbc7e0448d8f5ef91db9d26d7e075711a8338ae2fb99042398c89a97b428a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd551e385bbbe8086156a4bc9030d829adcbfc1b8a2fe2a1c360ac09f384a2d9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/de20e4cbdc6a07dde24161ef56d3d2919a4406fb0249485a17431fde2405d722> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe chạy ở làn dừng xe khẩn cấp hoặc phần lề đường của đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df7678c0c8545af9aecd50740dfd83bab930b0da1c24faeeef0b01161c0d7acd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không đặt biển cảnh báo “Chú ý xe đỗ” theo quy định trong trường hợp gặp sự cố kỹ thuật (hoặc bất khả kháng khác) buộc phải đỗ xe chiếm một phần đường xe chạy hoặc tại nơi không được phép đỗ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e4ebd9be81f185cfe9738e4e6d1777137ec3db19d69e6cc4c689bae66eba9cad> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e5c91a52ed64685f06fa8ee01c9f3c8e5d8c1c09dd9de7c1903227f7ade95e9d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đi không đúng phần đường hoặc làn đường quy định (làn cùng chiều hoặc làn ngược chiều)"@vi .

