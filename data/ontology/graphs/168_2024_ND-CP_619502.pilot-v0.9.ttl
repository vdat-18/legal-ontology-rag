    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ce22bbec30395b924128077d88d99de12216fdd2dfede8e017100406b491fbc3> a loroc:RegulatedConduct ;
