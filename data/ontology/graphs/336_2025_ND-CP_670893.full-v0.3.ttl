    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải không thực hiện đúng quy định về cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải, trừ hành vi vi phạm tại điểm e khoản này."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2c02db0d44114e1e448836d502d2864c02dcc1946d618e28e4ecd6a389c9f7f9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thu dọn ngay các biển báo hiệu, rào chắn, phương tiện, vật dụng thi công, các vật liệu tại phần đất của đường bộ, hành lang an toàn đường bộ theo nguyên trạng khi thi công xong"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2dd94f5e05b88f3045695457312168d115113e48b2200986a2572fd8f66bda51> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng giá dịch vụ xe ra, vào bến xe đã kê khai, công bố."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f18afcc6c69f391115ec767e298b31a483cd8b354f7cba55be5c02f3b4c031a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải tự ý điều chỉnh giá cước vận tải đã niêm yết trên phần mềm."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f201bacbf560f3f4ca65eac81e1ee6d68b931a8833bfba728324eda9fc0e166> a loroc:RegulatedConduct ;
