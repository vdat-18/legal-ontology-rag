    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thi công trên đường bộ đang khai thác không đặt đèn cảnh báo giao thông và chiếu sáng ban đêm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/309da335c9d39debe46afd13727ea69bc1fe90d4f5c0261dc6c27f10dcd2845d> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bến xe không kê khai, công bố thông tin về giá dịch vụ xe ra, vào bến xe theo quy định của pháp luật về giá"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/30de23c6e2daa7e753e628c19ff03ab6dd0d8f63f24086ba2a00fb74e0cb6fd7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để tổ chức, cá nhân không có giấy phép kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ điều hành phương tiện và lái xe để vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/311d9a2602e3e9b47dcc5d9c200ccde4307ef8e7e266e2b8ce8bc45348ea4ec0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
