    skos:prefLabel "Không bố trí người cảnh báo, hướng dẫn giao thông khi thi công công trình trên đường bộ đang khai thác theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00cdac5679932049c68c7eecda5380158f5ae1140019062885aae225685255e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Đấu nối trái phép vào đường chính, đường nhánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/00fce75f7da9c6357a6483701cbd2169474fbd16801bbbbe10e440b80647828e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc tháo dỡ biển quảng cáo, các bộ phận của biển quảng cáo khi có yêu cầu của cơ quan quản lý đường bộ, người quản lý, sử dụng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/014ca1114a1b39b71de31f7011d8c0a59b72fe1f58d6a021e6ade875c0c9f04c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng phương tiện thuộc sở hữu của thành viên hợp tác xã để kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ mà không có hợp đồng dịch vụ giữa thành viên với hợp tác xã theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/01a879bbd0323fee4086eb6c13b325d9468b865be87508c89c6eb6c87d191314> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không quy định quy trình nội bộ về kiểm tra, xử lý vi phạm, xử lý sự cố trong quá trình thực hiện thanh toán điện tử giao thông đường bộ"@vi .

