<https://w3id.org/legal-ontology-rag/data/concept/conduct/c0bbd7a679d5f9164d8a66ec2ce2765004c80321aeb27d32d1db40894acfd7aa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm giả thẻ đầu cuối"@vi .

