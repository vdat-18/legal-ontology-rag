    skos:prefLabel "Không bố trí chỗ ngồi ưu tiên cho người cao tuổi, người khuyết tật, trẻ em và phụ nữ mang thai"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ae4da23ac30b98b78d761fb98b723758a91e1c0a414025a7b86295b763542a8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Công nhận kết quả thi cho người không tham dự thi"@vi .

