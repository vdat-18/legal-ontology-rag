<https://w3id.org/legal-ontology-rag/data/concept/conduct/b9a2d2423a1d6522a94c78281c4161be9d7255f1b1295a4adf1d6a56b6232cc0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không bồi hoàn kinh phí để xây dựng đoạn đường thay thế theo quy định"@vi .

