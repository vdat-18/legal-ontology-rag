    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý chuyển thẻ đầu cuối từ phương tiện này sang phương tiện khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2a9d952b8be6bb6753d16c3706f68bf08f0aefe3969fa6e0236e12160ef2142e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không hoàn trả nguyên trạng hành lang an toàn đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2af212da300845f3e060d970223a87b7d040f49b847afcb9f837e419a12e18d4> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách lắp đồng hồ tính tiền không đúng quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2af244a5860c47334f8ed30f5bc979f2ac996542da9adeadfd67ef199c177d15> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện thủ tục công bố lại bến xe khách, bến xe hàng, trạm dừng nghỉ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2b9df093fdb0dad79772142592f6481206bd2ae439f8d3fd4693e10ca9de39f7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không bố trí người trực tiếp điều hành hoạt động vận tải"@vi .

