    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thực hiện không đúng, không đầy đủ quy trình đảm bảo an toàn giao thông cho xe ra, vào bến"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ebfdeffa00fd0f85524207914c8e932aeae9fa73f1a52884a35b33fbb4d9b2f0> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng hợp đồng điện tử không có giao diện phần mềm cung cấp cho hành khách hoặc người thuê vận tải theo quy định hoặc có nhưng giao diện không bảo đảm các yêu cầu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ecb1cb00c02be010a3be386753e41051d5c3df499144e985dc463dfe27d44bb8> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vận chuyển hàng hóa ký gửi không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ed9e16c83c27b42a4ee8364fb91c005a227c6196f6de855ddafadf77bafdd811> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng giảng viên tham gia giảng dạy không đáp ứng điều kiện về tiêu chuẩn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/edc87d0bcbc82694854317f87265e5c0a65692fefae6947f6e8b667fa9eae45a> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý treo vào công trình báo hiệu đường bộ nội dung không liên quan tới ý nghĩa, mục đích của báo hiệu đường bộ, làm sai lệch hoặc mất tác dụng của báo hiệu đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/edeb347ebc2224656d1adb25551233c860cc8f846e18e01ea07ef959c59098de> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tát nước qua mặt đường giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/eec2eeeae7eae223ad78e504d11fe79e423100e0cbe5f14c867bb270406fcc1c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý tháo dỡ tài sản của trạm thu phí"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ef073b8f4d8e0e7c61c0ddc1de8d73d7dc34d39fcb923b1bc70fcef90c6d7bb1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thông báo kế hoạch đào tạo và danh sách học viên trước khi mở lớp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f0a9cd3a3c444dd9de97d867cdddcbaa26c249e11a6e18ba5eebed027f2411b6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không có quy trình vận hành, khai thác, bảo trì đường bộ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f14dddbbd0416e0800c7c71cb2b2fe32dd7c07021566fad6d5222b97aaba382b> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách mà trên xe không có thiết bị để kết nối trực tiếp với hành khách theo quy định, đối với loại xe đăng ký sử dụng phần mềm tính tiền."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f2b14e4e7f1d9ee282feea90d1a2b81af6d1d8dc667cf9e0b3ad4389f189f930> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bảo trì công trình hạ tầng kỹ thuật sử dụng chung với đường bộ gây ảnh hưởng đến an toàn công trình đường bộ, an toàn giao thông đường bộ hoặc cản trở công tác vận hành, khai thác, bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3144596b4d1023fec79341cb2c4a485a688ffc9f9a4206629d64e8ae665ee4f> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Làm hư hỏng công trình phụ trợ gắn liền với đường bộ, cấu kiện, phụ kiện của công trình đường bộ, trừ hành vi vi phạm tại khoản 4; điểm a, điểm c và điểm d khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f3be64ce5ed38820e8164e5b3cefaebb39da115923f10e793150be1060df3945> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách không có thiết bị in hóa đơn (phiếu thu tiền) được kết nối với đồng hồ tính tiền theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f4683c14f42a03de46801242c321a4cb5a7633c50e6d7667d7c048cc158cbf89> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để tổ chức, cá nhân không có giấy phép kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ điều hành phương tiện và lái xe để vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f60f0403daf84b3d6bbec2185804a4589b06591cf79e805b4e9096a950776351> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Để vật liệu, đất đá, phương tiện thi công ngoài phạm vi thi công gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f68e7dda35bdc3d93e8e07052f1fc8b90021301fdf924444c099d4b613a97e34> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách có thiết bị in hóa đơn (phiếu thu tiền) được kết nối với đồng hồ tính tiền nhưng không sử dụng được."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f6b701ec611bd06f7fe46f4fdd4cd7de57df0c2e35e17c9dfe341840ec7ebed7> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy trình quản lý, vận hành trạm thu phí theo quy định để số lượng xe ô tô xếp hàng chờ trước trạm thu phí trên một làn xe (tính từ cabin thu phí đến xe cuối cùng của hàng xe chờ) từ 750 m trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f78157c8b0e9c07a64d31bd5375daf208fa1b7e75ffd8c5be2a12b10cdd721d5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng xe bốn bánh có gắn động cơ để vận tải người nội bộ trừ mục đích kinh doanh vận tải hành khách"@vi .

