    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tìm cách xâm nhập hệ thống thanh toán điện tử giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/21760c48c83803579a3b01be66e97a844b88ba4e719ed18c45c9dfbf1a7b075e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tự ý tháo dỡ bó vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/21bccb59f4d04549737ef7a914a04ef0201e0923aaf6e54b5238ede51e678230> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện đúng quy trình quản lý, vận hành trạm thu phí theo quy định để xảy ra tai nạn giao thông đối với các phương tiện khi phương tiện tham gia giao thông qua trạm thu phí, trừ hành vi vi phạm quy định tại điểm c khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/21d40e38fbe14d3b7f97cc646c20c8347039bbf2f8706a6c9ae4e91013e921e9> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thay đổi mức thu tiền sử dụng đường bộ khi chưa có chấp thuận bằng văn bản của cơ quan nhà nước có thẩm quyền"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/22cf136371cc54232a5b61f3cee0478b6f96a90c2982587b7109fe9b356dc355> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thi công công trình trên đường bộ đang khai thác không đúng giấy phép thi công gây hư hỏng, hủy hoại công trình đường bộ đang khai thác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/24963666514786e902c61dd6145d93418caff259e0c58029c97438cbfaf0df12> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc di dời công trình khi công trình ảnh hưởng đến an toàn giao thông đường bộ, an toàn công trình đường bộ mà không có biện pháp khắc phục"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/25507ea569b21fff7552e172a4a7d4cb5a2173ef0be3863a665e9b0794ac86bd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không thực hiện việc miễn giảm giá vé đối với người cao tuổi, người khuyết tật và các đối tượng chính sách khác theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/262b319198906bc3fba83fea86cc43fbf3e255d74bde87acddf4091d53cd3873> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không niêm yết nội quy, giá dịch vụ, tên và số điện thoại cơ quan quản lý nhà nước có thẩm quyền tại bãi đỗ xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/26ae5cd61091afd3f99f570e803fd78adfc76339fc158cba83477bbb20f9032e> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không bố trí dấu hiệu nhận biết công trình hạ tầng thuộc sở hữu khi lắp đặt vào công trình hạ tầng kỹ thuật sử dụng chung với đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/26f4f3953c02a1468d55a3839848b7801a783a80eb12d089d34f86850294b14c> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Thi công trên đường bộ đang khai thác không lắp thiết bị cảnh báo trên phương tiện, máy móc thi công"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/272e57ec3317778c60ad856f628fbeed3c8135848b13c1ef5f7331246339e803> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không theo dõi, giám sát hoạt động của lái xe, phương tiện trong suốt quá trình hoạt động vận tải nội bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/285987eba30998e657bfd765fe97218757561029bf2e38187f6775818843cbce> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Tổ chức điểm giao dịch đón, trả khách, bốc dỡ hàng hóa trái phép"@vi .

