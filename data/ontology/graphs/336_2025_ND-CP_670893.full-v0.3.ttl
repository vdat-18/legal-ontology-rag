<https://w3id.org/legal-ontology-rag/data/concept/conduct/c8ff514227a14286bb7708b9fc2628268e4b66dc4b8c43f3b6a17fb574cca2f2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
