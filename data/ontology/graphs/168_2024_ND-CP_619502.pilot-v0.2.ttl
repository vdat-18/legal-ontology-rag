    skos:prefLabel "Không sử dụng đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c58664411ca84c0431a5ff26e7658f1afc3de3c33cfd57cb43544e03247b45d6> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Xe không được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu của xe được quyền ưu tiên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7e724e30bb4e2b1d6c3b644e5f64e5049943b4234469ce185bea57a01e7f8e2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Không gắn biển báo hiệu ở phía trước xe kéo, phía sau xe được kéo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c974946c1ae1a3657dbe11c42b7d0a97190a40546ccad0f538c5c688f8e31246> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Bịt mắt điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cc51d6f1c7c1eb4c9a880ae9638355157800e127d895aff413894b5a1fba45db> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá ngưỡng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cca9dc27c608798d81fb0d64f99ece339891e2e9af7df9d1b38f974d5675bd35> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe trên đường mà trong cơ thể có chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cccf514435b73cdacc361d5eb13501f23197b4202b8123b8e1fb8b9b9bd2d0dd> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d2d0d65327573ad764b2a46ef3546d5b08b80520f546529219d1023afd6bcbb5> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Quay đầu xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d52d10a0a544d651e9c17b5495831826437f5a5851178d5a8dc02272bfc0ddd1> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Sử dụng còi trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d92de55f425c7882794bf0a029a8f23aa90a5c0320abe952aae037dcd6b3f6d2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Vượt xe trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dbd259ae67eb77dbac655e25a7b42dfdddc675a343b4be15653c7f42a2fc8990> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dùng chân điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc218db2da35b352c173ca5659da79873f980ab770cf63051d48d59793b097ef> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chở người trên buồng lái quá số lượng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/decb4d7d6cf6c26e15848620afd21543f0e9aa71cf915561eace077493ccccc2> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Dừng xe, đỗ xe, quay đầu xe, lùi xe, tránh xe, vượt xe, chuyển hướng, chuyển làn đường không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e97ffe7ea6f0e49f24a07694f467254a4552af1f38011fc6be0735b32e0b0c06> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Chuyển hướng không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f49fd2f0e744c25d748836b22acc392273ba2366c1bd6bcb7bdbe87608489b91> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe lạng lách, đánh võng trên đường bộ; sử dụng chân chống hoặc vật khác quệt xuống đường khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/f621c969b60a683841275c4e64bed4d2a8097bd25b165fdb63960abc535a4daa> a loroc:RegulatedConduct ;
    skos:inScheme loroc:conductScheme ;
    skos:prefLabel "Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không dừng ngay phương tiện, không giữ nguyên hiện trường, không trợ giúp người bị nạn"@vi .

