<https://w3id.org/legal-ontology-rag/data/concept/conduct/aaa6db4c377cc0dbccb9f8fb853598fec1f3140fa1000ce7f7b0af441af6704b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng máy tính trong phòng sát hạch lý thuyết kết nối với đường truyền ra ngoài phòng thi trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aabdff80e6685b25e8de140d42337f0b48f187e9a8969f821d3446969f556e33> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”, trừ các hành vi vi phạm quy định tại điểm g khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/aaebf9b88febd30ee9b67031c540b2340ebd75d42d5b5f08d415352401482000> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để vật nuôi đi trên đường bộ không bảo đảm an toàn cho người, phương tiện đang tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab21ca3ca9e132195136e7bd47d34a32fdbac25c2d2f2ca50313f9bd4df3d612> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe xếp hàng trên nóc buồng lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab3700e585e2776d30bd40a96fecd49160c94dcb04d9d7470e7b7398ffb4cb12> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe thành đoàn gây cản trở giao thông, trừ trường hợp được cơ quan có thẩm quyền cấp phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab73f6f9b71e520bfc87ddf7d1d965eba7b7472522582bbddf9ae203b2ac0f41> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lái xe, người quản lý trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được hướng dẫn về quy trình bảo đảm an toàn khi đưa đón trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ab7b50d5e87402a172d3acb7c73033f486d9a464c4a8a9599e32401a18965a02> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng có giấy phép lưu hành còn giá trị sử dụng nhưng đi không đúng tuyến đường quy định trong giấy phép lưu hành"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ac1e029b7de4d39d0580dce638d841133e529827b679380d0b2aebcefc2547dd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở thiết bị có hình dạng thùng hoặc có hình dạng như công-ten-nơ (không phải công-ten-nơ) vượt quá chiều dài toàn bộ được ghi trong chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của rơ moóc, sơ mi rơ moóc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ac57cd16bdffc388c39e8f95d7ccd40cc429ce8487e54dbc5c349cfb1da39a79> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc niêm yết thông tin trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ac6765605fb3b94f0c4aecb86727d1dea49b243b9acec2ae06a82a851ddb86d6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có tín hiệu vượt xe nhưng không sử dụng trong suốt quá trình vượt xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ac7d51fcbb15b54b40656eb1f2cd818b91860914c01383c60e3f53cd86420b74> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện biện pháp bảo đảm an toàn theo quy định khi xe ô tô bị hư hỏng ngay tại nơi đường bộ giao nhau cùng mức với đường sắt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ac93d3966a3a9e0725f19feca8190ba23706092baef9663680f9e55e7e6b4d58> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành hiệu lệnh hoặc chỉ dẫn của đèn tín hiệu, biển báo hiệu, vạch kẻ đường, trừ hành vi vi phạm quy định tại điểm a khoản 2 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/acbe192ee14f8412ac1c5d2f15af3609cd791698cb65fce8fabe0b243e3172a5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Quay đầu xe không đúng quy định gây tai nạn giao thông"@vi .

