    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không hoàn trả kết cấu hạ tầng đường bộ bị ảnh hưởng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/95e47b533b1e2605faea7a1fbbe5502b0911090189aea9a77a6171230c52bcbf> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không quan sát để bảo đảm an toàn theo quy định mà gây tai nạn giao thông"@vi .

