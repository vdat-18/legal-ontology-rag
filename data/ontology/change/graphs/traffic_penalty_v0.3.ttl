    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Mang vác vật cồng kềnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9622d35ba86d88689d4c8b9366fb474536009f7d312f3fa50971997ef321f208> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9625a3d83fc083eb873da944f877c788105c0de8d23347bdf80178cf89ff4158> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
