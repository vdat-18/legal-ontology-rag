    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không kê khai giá dịch vụ vận tải hành khách bằng taxi theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/77e0e26cec031efd828399da46a0a44ca29557d29667326c35223e028a0d405b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tháo dỡ trái phép công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/77e0e68d9dda5a35b0c09a174ed47d056d757d85821bcccb8c18287edfd4fd4c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe không đúng vị trí quy định ở những đoạn có bố trí nơi dừng xe, đỗ xe"@vi .

