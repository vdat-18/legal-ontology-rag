    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khai thác đất, cát, đá, sỏi, khoáng sản khác làm ảnh hưởng đến an toàn công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/79471b5145081abea66ecaa9da20ed93991c0032c219768d64ec87658aaf3bef> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
