    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy điều khiển xe đi qua dải phân cách cố định ở giữa hai phần đường xe chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/db5d320bbde7e9ad401a881e7d463af8b0c689f6ec7a175214e16ab409734436> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng còi liên tục"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/db8c0fe6b70b170a78f28a23c6b4af6da7dec135afbdf4e2f2476e01c58b75f8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tránh xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dbe0a13ff1e49e4c01aaf979168b1ce72bcd465197ff97c20dd9b016d1b1035b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chở hàng trong đô thị không chạy đúng tuyến, phạm vi, thời gian quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dbf44826ba34f18c5e937dadd994495db7b482498d9b2f6c692618befb79bf9f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên đường dành riêng cho xe buýt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc058d75daf2d78f5d54ef0d6d4c0f5b7475aec4cca0a14a14d1412cb0659722> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm quy định về nhận hàng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc0acfb483df940eb254dc9e26e41755ca2491895914b4a1dde67e7aebeb15c7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Phá dỡ biển quảng cáo, các bộ phận của biển quảng cáo làm ảnh hưởng đến kết cấu hạ tầng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc0e98053a5351073b419eaf2be052f301fe099db86d24f16adf36938afa4ab2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có tờ khai phương tiện vận tải đường bộ tạm nhập, tái xuất theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc2e8a72bd254760e6a46c1b5514aeccfb1eb4c7e4f24c18fed8a58e51dc54d6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Nằm trên mui xe, nóc xe, trong khoang chở hành lý"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc3bba1e207a129616d9c42435f138e1ae3645d713a05c753112a21dde09a03b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách theo hợp đồng mà ấn định hành trình, lịch trình cố định để phục vụ cho nhiều hành khách hoặc nhiều người thuê vận tải khác nhau"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc550c2f38f8c23416265181e7f3f348223371ebe0b5d7169c912f41a9d22be5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) không đúng số khung, số động cơ (số máy) của xe (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc8de5d500f3a19c75434898a6c1a03a59fb3f522389ce462c62faaa40fd58a7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe đạp, xe đạp máy buông cả hai tay"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc8f373827469247fa01f66184147ec106c868af7ba419d0a519163e43a26624> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không lập hồ sơ tài liệu liên quan đến công tác đào tạo theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dc97ffbed08749e72584f42c6ce121c86af8e1ff1a9763e230f89734faf530ac> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách không có dây đai an toàn tại các vị trí ghế ngồi, giường nằm theo quy định (trừ xe buýt nội tỉnh)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dca21de930c10ea8128d1b057b82524340dd98f4306ae6c81a9ff12588f7fb54> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe tạm thời hoặc phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dcbec8559f9699fc293a785b3e8581d5e608fc6bf5e228672b88b03950a14041> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải hành khách từ 08 chỗ trở lên, không kể chỗ của người lái xe, không lắp thiết bị ghi nhận hình ảnh khoang chở khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dccc8746f34c6ee7f98c802388689b54614ebaf70990d9c96804435151a9f223> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc truyền thông tin, dữ liệu từ thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dcd11fb942e1ec96fee21e5d06f30b9ba0c71c6d27c48b5610f0a48b37d70681> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thực hiện không đầy đủ, không đúng quy định về quản lý, áp dụng thông tin từ phần mềm quản lý bến xe khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dcf74dd565edb2a1edd6c45f12dee0a8e7c1c507f9161101a2a2393c6c1fb719> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng thiết bị không ghi dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dcfc7631efed3c5d45ada62aacfd7068885d7fa97542580dd0e5c9fdb0c78d57> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hàng hóa không có giấy vận tải bằng văn bản giấy theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd16365235f41e107c38bc8be149bf921d165355ec6f71c2a0d2d86fc326aa3f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cung ứng dịch vụ không có giấy phép đối với trường hợp phải có giấy phép hoặc có giấy phép nhưng không thực hiện đúng quy định ghi trong giấy phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd5473bd9d8f4fba6315bd1ca33a428f7867cba2c843bfa7959d565c3553f565> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sản xuất biển số trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd6526cbe8fa98f9da81630d31c2a27eef36dec83866fc3dd5568c2bc4e44713> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không mua bảo hiểm cho hành khách theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd70bec89634b82db639f2568079326b2ae484f5552f52c4ec0d8f0761addf26> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thực hiện hành vi quy định tại điểm đ khoản 2 Điều này trong trường hợp sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) không do cơ quan có thẩm quyền cấp mà không chứng minh được nguồn gốc xuất xứ của phương tiện (không có giấy tờ, chứng nhận nguồn gốc xe, chứng nhận quyền sở hữu hợp pháp)."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dd990d8dd9b2f693dcf15d02a497e359ed6e4d7b258605fd2ca2b57ba3266cfa> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có bộ phận quản lý an toàn theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ddd1924030c5832edae1d8f4ca39e2a1422f4a39731c9472dcf7cb212802e7f9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phù hiệu xe chở hành khách không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/de11832dd98a08d80f564dce5522e110bc04df639171cce9ce6ca1edf7cb315a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dựng rạp, lều quán, công trình khác trái phép trong khu vực đô thị tại hầm đường bộ, cầu vượt, hầm cho người đi bộ, gầm cầu vượt, trừ hành vi vi phạm quy định tại điểm a khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/de3c3159e40f79460088fa2ade650d0418428da5ed70c0d758a7f69aa74792fe> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gia công hàng hóa trên lòng đường, vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/de41dd2dd0671d19db89307c37118ca895c3b0354fafb78e9e0a811bc797891f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh khoang chở khách lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dea0456b06ac5344642c9ad2652bda3e060803e4bbf7e72e3acd8a47905ba3de> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có bộ phận quản lý an toàn nhưng bộ phận này không thực hiện đầy đủ các nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/deaf6036b77bbfd3210ded9728f445db8533c9d1af9814b058afb2e78b154f3e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng thiết bị, dụng cụ không đảm bảo theo quy định của pháp luật về đo lường để kiểm tra chất lượng xuất xưởng xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/decbfc5ff23a49fb65978ec8ecf1cab1e37e23372eab76a11cff0091f73507a4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không bổ sung kết cấu hạ tầng đường bộ bị ảnh hưởng do việc thực hiện đấu nối tạm thời"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/def2ba5ed2577af741a45b645ed79c4a807bad340e224a7a8bde9691178aad59> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách theo tuyến cố định, xe ô tô kinh doanh vận tải hành khách bằng xe buýt không có chỗ ưu tiên cho người khuyết tật, người cao tuổi và phụ nữ mang thai theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/defac11c96349d23c5caa6619929c498b52682c3682b9e4b3d8655c477ff5639> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người vượt quá quy định được phép chở của phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/defc886cc04b6d22e39f0a72b3196f15975cb2100dfb51de757d8aacfb6f395b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không ký kết hợp đồng cho thuê phương tiện tự lái với bên thuê để kinh doanh vận tải bằng xe ô tô, vận tải nội bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df4a61484149a8ed9236fc83e569d0daf37fe067d08c02131de7dce818061e25> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện công khai, niêm yết công khai tại trạm thu phí theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df77cd6e488a872edce3f31211cc254a720c8457e2dd9f399a98149ba640e671> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở vượt trên 50% đến 100% số người quy định được phép chở của phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df7d09ad41d60312eb4f28e8b53875ed76667457f168a4c0f256a2712abc858a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/df954016351c3415da698a76f9601b6050baa6c0bb25128367c6e937097aa8c6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hàng hóa có thiết bị để truy cập vào được phần mềm thể hiện nội dung của giấy vận tải nhưng không cung cấp cho lực lượng chức năng khi có yêu cầu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dfa272b219d3de35731ac08078f1768522b551c619c02aee88c09a9369b0f21c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lái xe, người áp tải vận chuyển hàng hóa nguy hiểm mà không được tập huấn về vận chuyển hàng hóa nguy hiểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dfa57fad11ae3ee1116043674d932c23ac6478a795b07a87dce1645aee22491d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện di dời công trình hạ tầng kỹ thuật sử dụng chung, công trình lắp đặt trong công trình kỹ thuật sử dụng chung khi có yêu cầu của người quản lý, sử dụng công trình đường bộ để đầu tư, xây dựng, nâng cấp, mở rộng và bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dfc081e2ce95076bb3d231c684c9ecd5550541dd1dd1cee0766541891d2960c2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô chở người từ 08 chỗ trở lên (không kể chỗ của người lái xe) kinh doanh vận tải hành khách có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dfe5b5f5f7d3e418af0921e08d5cf6db63fa13647a703936c3885631331c398e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe lưu trữ không đầy đủ hồ sơ theo quy định của 02 khóa đào tạo trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dfea138f1777d23f0f3da7ebdfcac3eea5c47ac985f1b33746b6c03134edd769> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định trong giấy phép lưu hành, trừ các hành vi vi phạm quy định tại khoản 2; điểm b, điểm c, điểm d khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dff21afdc493ec2ec35e209f6990ca8593ba1fd3b1e31535aee867b39f2c4241> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/dff253633800f9180da1e7e166e40db2be88cdd69e0bfaa834584a462a41e4fb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Mở cửa xe không bảo đảm an toàn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e01a761a55c95d921eda29e166802bbc8edb2b58ddc0020e1450a1f57f56c66b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xe được quyền ưu tiên sử dụng thiết bị phát tín hiệu ưu tiên không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e01d11028a8ffc1342baae5e6b0d76fc03f122cabc78a26ce5aecaa2e17b94b9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ (bao gồm khối lượng bản thân rơ moóc, sơ mi rơ moóc và khối lượng hàng chuyên chở) của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 30% đến 50%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e01d79308e1f6308c31ee1989963d5d1be2a87cb872b63526c70d23ec330abd1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe đi qua dải phân cách cố định ở giữa hai phần đường xe chạy, trừ các hành vi vi phạm quy định tại điểm e khoản 6, điểm d khoản 7, điểm đ khoản 9 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e033c6773b671eba4bf869e0549402c20de9e60a95a72aaae5b1afe658112e5f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ, để xe ở vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e036952b59a1da5f217c736af61267279fe3b93cfbcbb3e022e4fb9b52e1ea03> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có biển báo dấu hiệu nhận biết là xe chở trẻ em mầm non, học sinh theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e039b0def74876163523c50f87a1a80464bca7a471c48ec020c1deb8174bead3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tổ chức đua xe trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0599e499b627ebe8ad1251ca588c09cb6ff4683ed184b61925d819a0edd0c88> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở vượt trên 50% đến 100% số người quy định được phép chở của phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e05f3c11bba4d4ca02c3d8e03d42ae4d41324060277ee230c34394db99cd3114> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp điều hành phương tiện, lái xe để vận tải nhưng không có giấy phép kinh doanh vận tải theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e076b5ad7a26287bc3df70e50dd71c0d093cef9c9ceef9f5cabbd45d6c7c3b67> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về trọng tải, tải trọng, khổ giới hạn xe, vận chuyển hàng siêu trường, siêu trọng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e08a1d8327c88cdff71ac86fb5a4ab080cc67c2d4f8f6a0d87c1436a3cb6cf79> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở quá số người quy định được phép chở của phương tiện, trừ các hành vi vi phạm quy định tại khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0a28f86d75e62d791788844eabd0385da3b3181ed8b9e34be645d8507d06fc1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có kích thước bao ngoài vượt quá khổ giới hạn của đường bộ tham gia giao thông, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0c47ee6dc3533fbe64f420622bd82a8983e0f99e806f639c3d8c1905be34b69> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về chất ma túy hoặc chất kích thích khác mà pháp luật cấm sử dụng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0f78582d3da03a0ce23d8360ca3b92eec6ad51ac294c698dcada2691586dd32> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giáo viên dạy thực hành không mang theo giấy phép xe tập lái hoặc mang theo giấy phép xe tập lái đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e0ff0186548ff0b2e807c957e1ed32f0b4326411b6cdd9480fbe3380b1f9df44> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không dành lối thoát nước thích hợp từ công trình thuộc kết cấu hạ tầng đường bộ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e12d76b55757e5498afdb71950eeb84d0ec084a945d719db1f923753b83329f6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không công khai quy chế tuyển sinh, quản lý đào tạo và mức thu học phí theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e12f52018e65d979066838a13f186b12a69089aa23b60167bba74158f9464b13> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e14fb95aee5574fe83ea1e091bc0d5c5cd45e0b54d3722eb208869b65dc21ed7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có giấy phép lái xe nhưng không phù hợp với loại xe đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e1a00d4073bc78ef320fbabfe2c4061ecf5059f525d72d0ff7b3c52943a873c5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý làm sai lệch biển báo hiệu, đèn tín hiệu giao thông, rào chắn, cọc tiêu, cột cây số, vạch kẻ đường, tường bảo vệ, hàng rào hộ lan, mốc chỉ giới, cọc mốc giải phóng mặt bằng và các báo hiệu đường bộ khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e1ae0aa2c2970cf7f4b81219ec8471f37af4384f9d96b9ae6bbf897eb33c6b80> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đổ chất gây trơn trượt trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e1be5c9ae5744379c92db03c4e23cb01d65c8c7704f1d1beb1b940404466a7b0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy dưới tốc độ tối thiểu trên đoạn đường bộ có quy định tốc độ tối thiểu cho phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e1caf9d2abf33a865ff8dd2131dae65cb03269acf399c2c37e830a2caa398760> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe nơi có biển “Cấm đỗ xe” hoặc biển “Cấm dừng xe và đỗ xe”, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e1d72e3973866ae598267035dc6b6f313e42ef398f9b8e14df130daac867b116> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô (kể cả rơ moóc và sơ mi rơ moóc), xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cứu hộ giao thông đường bộ, xe cứu thương có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e210fc012727ae377bfbfbe2f1731543ffb3ed4a5bfd998cc2bdc00306443170> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây tai nạn giao thông không trợ giúp người bị nạn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e238f87cbeede6011f953b5ff784a2d2b11b9a7bef47c6619e7250292cef965e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng không có giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e242578fbae10842fc2d9f76efc1b58032d14db21cb5e13d9609fe69a2a29ff2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng thiết bị thay đổi biển số trên xe trái quy định (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e24264bd11e309c6dacce228cb070cb2bb0ef335fd41606c4558418ca1db3ed7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển phương tiện không có giấy phép liên vận, giấy phép vận tải đường bộ quốc tế theo quy định hoặc có nhưng đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e24f3a7a3e5fecaf0eb93ac61c6816835018309b32823979204bbb9be25346f4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giáo viên dạy thực hành để học viên không có phù hiệu “Học viên tập lái xe” lái xe tập lái hoặc có phù hiệu nhưng không đeo khi lái xe tập lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e29b276711b07fc8c6652c5138290bee1567ba8bef86818e1f80ce04cfb1153d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây tai nạn giao thông không đến trình báo ngay với cơ quan công an, Ủy ban nhân dân nơi gần nhất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e2acedba66faca72a8f4426fb5657c0389df2aff1cc957c2e3347c82f7471caa> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 100%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e2d517e9c19826e1beda838f3c7965653be39282accc5a809d66ec37240ccd79> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người trên xe ô tô không thắt dây đai an toàn (tại vị trí có trang bị dây đai an toàn) khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e30ea3e3e5059c150535d9d66badce3930d69a52928cbdcbdbeb528df9c52bcd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc miễn giảm giá vé đối với người cao tuổi, người khuyết tật và các đối tượng chính sách khác theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e32573f034e862ff5329c5cee2a62d9df7d2b0b6d8369b56eb75680bcbf88a6a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây tai nạn giao thông không trợ giúp người bị nạn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3378ed74eb3e67b338faf330c5d0f6e45548439ad6501180c8736772e7c8330> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định trong giấy phép lưu hành, trừ các hành vi vi phạm quy định tại khoản 2; điểm b, điểm c, điểm d khoản 3 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e33d97272d1fa1bf5328990392f0507bea107d93698ee3393e32fc86ca3d912d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e34b54f0c0409a1b74f771cc804dcf606f86e1795157a641cdd389b0271ad215> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp kính chắn gió, kính cửa của xe không phải là loại kính an toàn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3c3b6786cea9a529f591dd918a99f51e69e72ee83225f0f913d2f0e9177b18c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng nội dung thông tin đã niêm yết trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3d6678a1e5ef95ef79105255d4551247ea69374b8e0fcf5ffa4f2b81e3213ef> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không gửi biện pháp bảo đảm an toàn giao thông, an toàn công trình (biện pháp tổ chức giao thông) trước khi thi công trên đường bộ đang khai thác đến cơ quan quản lý đường bộ đối với trường hợp không phải cấp giấy phép thi công"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3f9c73b356bd88b74eb73512f444f093f2a57b0f00c18073da140fcb821b2df> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe sử dụng biện pháp kỹ thuật, trang thiết bị ngoại vi, các biện pháp khác để can thiệp vào quá trình hoạt động làm sai lệch dữ liệu của thiết bị giám sát thời gian học lý thuyết, thời gian, quãng đường học thực hành lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e3f9d4a475ad3e7e49d486f65902fbf321d664eb1ea8a5c77077a6c23752150c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trả hành khách tại nơi cấm dừng, cấm đỗ hoặc nơi đường cong tầm nhìn bị che khuất, trừ hành vi vi phạm quy định tại khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e40586e37f388f5045ffcc3c60411b5f3b183adbad931bd03c4f6b44223d817e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Quản lý công trình hạ tầng kỹ thuật sử dụng chung với đường bộ gây ảnh hưởng đến an toàn công trình đường bộ, an toàn giao thông đường bộ hoặc cản trở công tác vận hành, khai thác, bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e440d2b3d537aa8f6914a93c86e0dd5f6fabd5f8080b7cf975bdc9dc6331df73> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Phá hủy thẻ đầu cuối"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e44702373533a20a4717e0490615419a3a11e9abe8128b42ba4ff54c0eccd30a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lái xe, người quản lý trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được hướng dẫn về quy trình bảo đảm an toàn khi đưa đón trẻ em mầm non, học sinh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e44a8507f5f0a4775cb24bae4bdefb0da6a7e81ce89267cb2ce68865526a4c53> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
