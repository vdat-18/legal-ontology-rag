    skos:prefLabel "Không thực hiện việc cập nhật hồ sơ phương tiện cho xe cơ giới, xe máy chuyên dùng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/90a79169284dcd071c452c634543a0c13c60f823a183678db278622a69530437> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
