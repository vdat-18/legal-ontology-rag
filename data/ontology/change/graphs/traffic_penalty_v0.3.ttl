    skos:prefLabel "Không xây dựng công trình đường bộ để bồi hoàn, thay thế cho phần công trình bị ảnh hưởng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/56331c30eb6d42374e7105b28949cb48c71e178a689e1de587b2b130ffabf7ea> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng thiết bị không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/56478a3ce0a5642387118b21cb97a70d85dac47b2f306ad89b5a110a631a9ca9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
