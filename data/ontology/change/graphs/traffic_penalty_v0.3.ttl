    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 3 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/483f999f1270251aa88550d80ce1fc64a5aa9dff3b7d707db9b5ac8e68378583> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không xóa bỏ điểm đấu nối tạm thời khi hết thời hạn đấu nối tạm"@vi .

