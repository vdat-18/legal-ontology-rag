    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lôi kéo hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d14bb5317ae2ad555c7e83b06c2ae8bf7a64eabdd4dfed48baec44af25290bf8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
