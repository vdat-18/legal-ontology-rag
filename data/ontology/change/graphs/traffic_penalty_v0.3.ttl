    skos:prefLabel "Chuyển làn đường không có tín hiệu báo trước khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1acfb983733fe37c55fed32031423ec85697ad93983409f500b8a07dea0b4b93> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1aef1f0c7ccf9ef83cc8e23d7f1f9a273bcf09fc3745cc3f059682f65eef36a1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng còi liên tục"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1b1d41b48e61d540e7c6e3d4f36d8ea7b93861175870434676490350c7b4e397> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải có chất lượng không bảo đảm điều kiện của hình thức kinh doanh đã đăng ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1b431be503d9caeeba1661ea41159a3034016d458562136f778d339d5a19bceb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đón khách không có tên trong danh sách hành khách theo hợp đồng đã ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1b609364dc0272c1a6ee52f5524bb4493b8ec6474e2659a2938a43839d308aea> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đi bên phải theo chiều đi của mình"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1b7dc65c2fd9e7285a4dd8ad2dbd33541a428848f395f408681c5fdf97f7192b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng nội dung đã đăng ký, niêm yết về tiêu chuẩn chất lượng dịch vụ vận tải, dịch vụ hỗ trợ vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1bd93bb9311e9c4481b4714fe3c1bb027b11caf6715d321b6215539b870b4592> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1c226160b6eddc389e111540ad29e704de24be415911ded728492613a7c45f6c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có hệ thống lưu trữ nhưng không lưu trữ đầy đủ các khiếu nại của khách hàng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1c4add29b96e7d47932008f807b32ae21f2655ccfeff38090e14f125fe4f420d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi không đúng phần đường quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1c61e0e6f27d292e4beef9d8ad56350eba15bda3c32528c73de22ec4e756c03e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức kinh doanh vận tải, dịch vụ hỗ trợ vận tải có phần mềm không ghi nhận được đánh giá của khách hàng về chất lượng phục vụ của lái xe."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1c72b83d62e498d8fd1af80ae3d9f2ff561f777d22245ea0e3ac6fda6c1be638> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng nội dung đã đăng ký, niêm yết về giá cước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ca247a3d5cf10703d4386367c09e76fa072a4315959b2d93b065ab91db33b7e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển hướng không báo hiệu trước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1caa56696e331ed839cda6aad36be24c4c8948218a3c0f5d99411db0e15d3774> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công công trình trong phạm vi đất dành cho kết cấu hạ tầng đường bộ không có giấy phép thi công hoặc không có văn bản chấp thuận của cơ quan có thẩm quyền theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1cb3ba71db0b022761372eb03f0a6070a6cdbe36a029f665477d00485626ec7e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hành khách, xe vận tải nội bộ không lắp thiết bị giám sát hành trình của xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1cd564ff641e9a4211696ac75a9c4f4ae1c6f9799478bcd5edc67fb32b8f983e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 10% đến 50% (trừ xe xi téc chở chất lỏng), trên 20% đến 50% đối với xe xi téc chở chất lỏng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ce0edea8a7869e32a56279e5136e21647f23143361e7eb200cca337dbd1640f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d05c7948c5c96bfedcd53be7cd217279ed4d1a7103d24450d6d1d8e643c873a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không niêm yết các thông tin tại bến xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1d116f233ae0b3dfeb2a589cd3685c14ae74b13a45e2796dfdc32a691b3cacd5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đeo thẻ tên của lái xe theo đúng mẫu đơn vị kinh doanh vận tải đã quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1dca2fb241cbf3e4d9e3363ed27d138adfc98a20cd36cebb10e0b3922b5b2cd7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chạy quá tốc độ đuổi nhau trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1de8727102293c950d22e0a83bedf8fda83d9ae6405427c6b78b88464f088157> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dẫn dắt vật nuôi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e68141a3ea59775601384c0dbdd75f3ef83889ac739b4f21218cde05e795b41> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển làn đường không đúng nơi cho phép khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1e880a19088d75e8ea2ab935ae1c4f0f7ba5968b44b8b7cf39b723430ae6b288> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có biện pháp ngăn chặn phương tiện qua đoạn đường bị ngập nước sâu và lưu tốc dòng chảy mạnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ed47340f6ac4f30d38739ea2034cc78b91ed02f992f9d22806c4100c69e300a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f0ac1efcfd2561fa1a2186054e835e8d6dbbc61f2ec8ef37edf339280f042e8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe có thiết bị giám sát thời gian học lý thuyết, thời gian, quãng đường học thực hành lái xe của học viên nhưng không hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f1f6a7c0b0bd307abd230536218ccfd145ac8b7f3f02a91fc502e2dab43b666> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không hướng dẫn trẻ em mầm non, học sinh ngồi đúng vị trí quy định trong xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f6e8c373ddf1c0a49db5989d84e68f4d8ca0ddb3a2687f4fbd03e38d7319c32> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1f98d572c18e3934c9345831f50ea01debe130b4a5492eca7198bf553ebe5230> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không làm thủ tục thu hồi chứng nhận đăng ký xe; biển số xe; giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1fb1d5f8b7576dfe1a94a40a931f20beb7f8cd4f16ebe05885b4980d1984fccc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Phá hoại dữ liệu hệ thống thanh toán điện tử giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1fb1ec335f4bc700b64f100b58514e499e1b2f12a08e6061616223cdda50158b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1fbcaf253df6db9468bafda18ea7ba1b210699bfda0e01ab9230085d4306b64f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe tại nơi có biển “Cấm đỗ xe” hoặc biển “Cấm dừng xe và đỗ xe”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1fe9370e2ff4396790094d3667c607695ee0f66e60a3ab3ffad3cdd6d4ebb909> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc truyền dẫn thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh khoang chở khách lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1fe983511f50330ec4b2e59d67d209379394e36537de08255ffee86a7fb85554> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô cứu thương có lắp thiết bị giám sát hành trình nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ff20ec3d0baa2944f0f1f4582c9552c85bfb66f3b6b7fa872c5c8b7f610c06f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy có hợp đồng vận tải nhưng không đúng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/1ffb413337fee42010dff57b5d7fbd0c40d9ff177473f62e9aced979c4a08d77> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở đất đá, phế thải, hàng rời mà không có mui, bạt che đậy hoặc có mui, bạt che đậy nhưng vẫn để rơi vãi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/20000906adc6af3adece3cedf4f3326f0fcd9c6a70379c9376aacc6390baa127> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy đưa phương tiện có chứng nhận đăng ký xe tạm thời, phương tiện có phạm vi hoạt động hạn chế tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/200196880ad01c09feb8998ff1e3b9b6cbab3384dec25fec2da8d12175ec8d48> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đánh cắp dữ liệu hệ thống thanh toán điện tử giao thông đường bộ"@vi .

