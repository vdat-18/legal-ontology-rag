<https://w3id.org/legal-ontology-rag/data/concept/conduct/b5d897e5e676622ec3283984c62c2e032bbf71485a24e276a7698028518c4152> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy khai báo không đúng sự thật để được cấp lại biển số xe, chứng nhận đăng ký xe nhưng chưa đến mức bị truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b647b00b5e1f9005fcff6043c5d5418cb6e7e258099a2116da39cb25ce52a4a3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô cứu thương có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b647dc686268234f12a6abb446828f097d39660387df6e50deef54ce9629144f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe không sát theo lề đường, vỉa hè phía bên phải theo chiều đi hoặc bánh xe gần nhất cách lề đường, vỉa hè quá 0,25 mét"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6595c2094bfa83a8242b347853236f972a45cdad7df6d61b859813fe5f88fe4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô đầu kéo, xe vận tải nội bộ có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không ghi hoặc không lưu trữ được dữ liệu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b65ccbd0316ea17adc7c20ec4b2cb99542e924ee0dae37f91d000588e8c27dab> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b668451c8fc78d3d30ff57a04ce4741247047df65ca9c21b6be83fe64b200925> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc tháo dỡ biển quảng cáo, các bộ phận của biển quảng cáo khi có yêu cầu của cơ quan quản lý đường bộ, người quản lý, sử dụng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b66ec1f7a709532af13d982b2a6b5b866245b1c3089890c3c297b3b8bb8b9b01> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng thiết bị không ghi dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6c017d78dfb98d50bb3ffb3c2f7b4891c93687b315d9e9e6d51229dae2ca99d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có phù hiệu kiểm soát đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6c1760e1b944cd40e3bdff90f17d2b981a18fe6b7319fe8d203d9e02f0e146b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng còi liên tục"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6d16964a3faf32c69687cf7328c03564e781cb895aa45f3124cbc10e2421913> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đuổi nhau trên đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6e3c4959072f775e0c66d384aae756d0be245036de197f740de9d957ed1a5db> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6f8ff4d95cc30660fd04913224b4446a9a69d5f38b18633b2422e1e194939f4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công công trình trên đường bộ đang khai thác không đúng giấy phép thi công gây hư hỏng, hủy hoại công trình đường bộ đang khai thác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6f98a99b24761d7b08950a9c10168efbb7fc172a8c46c72f7a0a9767337f057> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm d khoản 6 Điều 20 hoặc điểm b khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b6fd89821c9f99977e5f369d30ef5ce43b605e183a16fbc86de4561675b883e2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xe không được quyền ưu tiên lắp đặt thiết bị phát tín hiệu của xe được quyền ưu tiên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7240bac6b57fecbbe9835078caed1e4b09bedd3e853937c25926cc8b9aee35e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý để vào công trình báo hiệu đường bộ nội dung không liên quan tới ý nghĩa, mục đích của báo hiệu đường bộ, làm sai lệch hoặc mất tác dụng của báo hiệu đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b738faacf22dd461697184845e84f1097a673a42574bc08715e93e39824d5fc0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ, để xe ở vỉa hè trái quy định của pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b73e3af4ed3118db096a7a04c8bc993bfd733bc31ebbd451ffc3eb69706f5959> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để xe ở lòng đường, vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b77302a73cdd6ab216dd1a7edf9d3f75ec0cccac56868da1d9988a7cf5b168b4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đặt biển cảnh báo “Chú ý xe đỗ” theo quy định trong trường hợp gặp sự cố kỹ thuật (hoặc bất khả kháng khác) buộc phải đỗ xe chiếm một phần đường xe chạy hoặc tại nơi không được phép đỗ xe, trừ hành vi vi phạm quy định tại điểm c khoản 7 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7951f151f0843fb949cd01ad1baf98a599360fcd5b429e51a836ee606ebab30> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý lấp mặt bằng trong phạm vi đất dành cho kết cấu hạ tầng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7de05e6c20e5d77c9eb970e299af0c34f73590046642a32db6686cd13e7d078> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp đặt thiết bị thay đổi biển số trên xe trái quy định (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b7f5df3003cf7dcaee717bf45abeedf460bd994d6923743d8dcd5de3c91587ed> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc cập nhật thông tin, dữ liệu từ thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b81d4d4de4f339fc3d9ea095122806a1f0329bddc5e40c2c13265fa5e567a2bc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lái xe, người áp tải vận chuyển hàng hóa nguy hiểm mà không được tập huấn về vận chuyển hàng hóa nguy hiểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b834428032cd7cf12dbc1d6039f17d7c0287de6d92b1b848b741285b3e25d02a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe đổ trái phép rác, đất, cát, đá, vật liệu, chất phế thải ra đường phố"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b83ab156e043c5643039dbe69dde54ab75f6c9c6a79178b8b404026665fcfb24> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người trên mui xe hoặc trong khoang chở hành lý của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b83cb5ee221928bd6d3db8af4472a54c8444a6061dd69a37750c2421b2dbb3ab> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b85a7eb7165a59becb0e1fa4317468d2ee05eccc1eaa66fe1971d9c731d98471> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc lưu trữ thông tin, dữ liệu từ thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b86a08f9da8f699a5a250a376f067699eeab021d078f02b4bc164956cb27fb4c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thành lập điểm giao dịch đón, trả khách, bốc dỡ hàng hóa trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b88a5f96f7d2c024c7ba214d9791a0f464d99f07b94590b6c0d2855e45e52d20> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công công trình trong phạm vi đất dành cho kết cấu hạ tầng đường bộ mà giấy phép thi công, văn bản chấp thuận đã hết thời hạn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8b7bd5f6647e503c2731ed90b05de23c8a35f9d6dd76cf4c62ce5b253b90e8c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thực hiện không đầy đủ, không đúng quy định về quản lý, áp dụng thông tin từ phần mềm quản lý bến xe khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8cfdbf995e9b304eaef20c948348c77fef2d02e0b9b6546755feb9977014ee3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b8db60b1139817e68e85b1728ab7b43dedb91210b9fcd9dbe0d7369e77d36e90> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người được chở trên xe đạp, xe đạp máy mang vác vật cồng kềnh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b906f9a0e69869d680343b04ea35da499a765f49cdc691ec13c93e642952b3a3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đầy đủ các nội dung trong quy trình vận hành, khai thác, bảo trì đường bộ đã được phê duyệt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b916af2cf3b2c965e925182e72cffe356efdc31c9a6fc6fe8be41ca69878c83b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không sửa chữa kịp thời theo quy định biển báo nguy hiểm, biển báo cấm, biển hiệu lệnh đã bị mất, bị hư hỏng mất tác dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b9a2d2423a1d6522a94c78281c4161be9d7255f1b1295a4adf1d6a56b6232cc0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không bồi hoàn kinh phí để xây dựng đoạn đường thay thế theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/b9b2cbe1acc862d96e3f2ea398ca92269a64f05cd9e6902cc3c76246767a96d5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển không đúng đối tượng theo quy định đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba0fcf162c3e5c0283ff6c13bd24f9aebb14502fc58c3d0a81b9525e726e07a5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện quá niên hạn sử dụng tham gia giao thông, trừ hành vi vi phạm quy định tại điểm i khoản 7 Điều 26 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba3b68676a3a6ae6ea08430520c8a5a5afacc38c17e95ee162bea2379c41b46d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng còi hơi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba86a06fe18ccabb3e830414ee4014f7c06a2c900bf84451f9b0564df1f3f40a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch thông tin, dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ba889358c5f84045651f71c853f6df9a59ce43d8d302094c31250aab553efb7d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không làm thủ tục đổi chứng nhận đăng ký xe, biển số xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bac65356c3760d8962f833808feac34ae8cd7371679fc2bf4f6de2c0e0b716c4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lái xe, nhân viên phục vụ trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được tập huấn, hướng dẫn về nghiệp vụ vận tải hành khách và an toàn giao thông theo quy định (đối với hình thức kinh doanh vận tải có quy định lái xe, nhân viên phục vụ trên xe phải được tập huấn, hướng dẫn nghiệp vụ), trừ các hành vi vi phạm quy định tại điểm c, điểm d khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bac7ca7ebf93f6ffb6587d19dbb4f6f7de642c95bcaff96aba41ebf3ef6345ef> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng rời, vật liệu xây dựng trên xe mà xe không có thành thùng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/badf29495a1ed419286ac5eac93daf32768fc3130370b2fbe5bfea0d18fff699> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm d khoản 9, điểm đ khoản 11 Điều này, hành vi bị cấm đi vào công trình thủy lợi và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bb1345b823a3b464c0d7725e6d77fcfc4fdc1f8e684a7d69eeb646f17b959178> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Quay đầu xe trên đường cao tốc, trừ các xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bb1906f3c33961f01b4e3dc07893b731db6f94bef6545ee8ce1f7cf5f0f52d0c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đặt chướng ngại vật, vật cản khác trái phép trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bb46a0a76343a68edb5fe1748483ed794e11c217c529b4d3c58d4be337b6a0f5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thanh toán tiền vé cho hành khách đã mua vé nhưng từ chối chuyến đi trước khi xe khởi hành theo quy định đối với tuyến cố định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bbcce10e02a64a1193645ff16da579d3f62da3d53b5bd176715cbf948626655e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô cứu hộ giao thông đường bộ chở xe được cứu hộ vượt quá khối lượng cho phép chuyên chở của xe cứu hộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bbd9eb92ff539d4e20511996502427bd140cdc7f131d6719f7357220dd7c1f5a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không niêm yết các thông tin tại bến xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bbf0de6089ddd5c7298591bf0e0b4367af7ca044a339d9904492a306f9975527> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe vận chuyển động vật sống không có kết cấu phù hợp với loại động vật chuyên chở theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bbf6e8a3a0d38e94489d88c2d41c96b0af2935f9eb377c1d246f69b47facb0a6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe đánh võng trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc1ac15ad327a129dd82332d77e6447cbd6eb654cf051eee21158dbf3cd55664> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc231ce07c7491c1a8971debd06c349256b76b8e12e5cd5fede21e23c7d366f1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không lưu trữ đầy đủ theo quy định các hồ sơ, tài liệu có liên quan trong quá trình quản lý, điều hành hoạt động vận tải của đơn vị"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bc82bc8075d9294ccca1cb85cdfd1fddeab68280ba6a5b0e5a1ef77cc09331a2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở quá số người quy định được phép chở của phương tiện, trừ các hành vi vi phạm quy định tại khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bca93e0b2758fc410906ce4623cbac8f94f663f8e3075550bc827d3ec125e680> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng không có giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bcc38e59069b0d2c2a8538c9dd3e3a996a2f23624ae19133c793f0c471f6454f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có biển báo dấu hiệu nhận biết là xe chở trẻ em mầm non, học sinh theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bcfb609d6f656ec5ed89272e1f48fe21b8fe996f5cd12c640a4b453bb059801b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để tổ chức, cá nhân không có giấy phép kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ quyết định giá cước để vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bd3851e3cedd4c50d88683401378c6f6fef3ff41ba3f07c83e96c0c311a710a0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe ngược với chiều lưu thông của làn đường, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bd8fa7cdd1b3af77db18e1b0127f05bc8607b54756c5d0ed27c3b57e0f783213> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chống đối người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bda68bdf5f53df59a5b36cd4830325d775ef427fdb678939792880d267c9aa02> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe rẽ trái tại nơi có biển báo hiệu có nội dung cấm rẽ trái đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bdb3d7e1b8fc5f06d088ffa188c246d483c633903684ab0b532262ff3625cb88> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đón hành khách trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bdd32d6aaf9fe1a308ef8e557a1d831945512af132f5a80b1d6d30447704c651> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý thay đổi nhãn hiệu, màu sơn của xe không đúng với chứng nhận đăng ký xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be06efb23bb6653a1f04fb113d0275271ced811615acdf9445c557ddaa8bd89f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be27b67422723416131aeb3e911b5f686fc9bf6e085867e82c3aa7c1c1d965c8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lùi xe ở đường một chiều, đường có biển “Cấm đi ngược chiều”, khu vực cấm dừng, trên phần đường dành cho người đi bộ qua đường, nơi đường bộ giao nhau, đường bộ giao nhau cùng mức với đường sắt, nơi tầm nhìn bị che khuất"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be3c7b5bd2cf194562db25955c71d0a70e120e1aa86dfcef24ac9b067730e617> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách không lắp đồng hồ tính tiền đối với loại xe đăng ký sử dụng đồng hồ tính tiền."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be55b6d4ccde5911cf3460b0dd436ec2b85f3215e4f11789d3d20f89ff45f397> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng hóa vượt phía trước, phía sau xe mà không có báo hiệu màu đỏ tại điểm đầu và điểm cuối cùng của hàng hóa khi xe hoạt động ban ngày; vận chuyển hàng hóa vượt phía trước, phía sau xe mà không có đèn hoặc báo hiệu khi xe hoạt động vào ban đêm hoặc khi trời tối"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be59a64bf87b713596710bb826a05f67cf46ebde23e56f913f87b10a37075570> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý mở cửa xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be6120f47a4eb213eff1f2d310ecb5de7742abe277726d0728294fcc8caf09ee> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng hóa trên xe gây cản trở tầm nhìn của người lái xe hoặc che khuất đèn, biển số xe (đối với loại xe có đèn, biển số xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/be87eb8a97c7942f3782b30b294ee6b5890bf9a5bf12ced2c11d139fb9e6f675> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe gắn biển số không đúng vị trí, không đúng quy cách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bef1c89ac446539eb2e2b0271d1d706ffc4bf74210567d71b9d2486741eabc86> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf04cf1f0a680f7e46b2b2e101cb75f36b910e3f3be9d88e6557291d1cda3e64> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng siêu trường, siêu trọng không có giấy phép lưu hành hoặc có giấy phép lưu hành nhưng đã hết giá trị sử dụng hoặc sử dụng giấy phép lưu hành không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf10d7757270e4077882dab6bdc08ebbaf6ba954b87526780b3e45abc34e179f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe, bao gồm cả hàng hóa xếp trên xe và người được chở trên xe, vượt quá tải trọng cho phép của đường bộ trên 20% đến 50%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf1596e9e071dc7ea89dfcaefadd3eafd792e19cdf356b1811e66d4d8849fc76> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe nơi có biển “Cấm dừng xe và đỗ xe”, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

