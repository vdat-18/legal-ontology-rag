    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Ngồi trên đường bộ gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/03e809d8303b03e310d7da4e625be5b2b2c7a5a431301993c9e6b1add5e8e5f4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe lắp phù hiệu, biểu trưng nhận diện tương tự của các cơ quan nhà nước, cơ quan ngoại giao, tổ chức quốc tế tại Việt Nam"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/04193ab591d0974eb5cc81c84c1fab547b41db41138ede2c72d61890b52b8ac2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp đặt trên xe thiết bị âm thanh, ánh sáng gây mất trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/04294c4e641d65cb399d01a450664e91280aeb6716e4215a205f0252af03825f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng mà trên xe không có hợp đồng vận tải, danh sách hành khách kèm theo, thiết bị để truy cập nội dung hợp đồng điện tử và danh sách hành khách theo quy định hoặc có các giấy tờ, thiết bị này nhưng không bảo đảm yêu cầu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/047e1f36f8727e458c633e34a502a8527b900ca3099f3796427f9b31bef1e06f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/049b092d04356315cdad5850facbe6eb5341344ecd82ea34c116723bf661f050> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải tự ý điều chỉnh giá cước vận tải đã niêm yết hoặc giá trị hợp đồng đã ký kết trên phần mềm."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/04af762284beb65ae76ace1b5f36fa5da98a0b3ee9064aa749482723d568cc06> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hành lý, hàng hóa vượt quá khổ giới hạn cho phép của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/04b3f74f7c7210845ead1cf5ee53ee6e910d10b6c93e80429a960ad47a20b3d2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh tiểu học, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh tiểu học không có dây đai an toàn phù hợp với lứa tuổi hoặc không có ghế ngồi phù hợp với lứa tuổi theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0515ba10d4d58d6b245aee7c3a4ef7914f7f723aed645b61a794ba9128cff259> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe), giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/052c35ce7d276784fb44ec90bef8d234d8679282962cb8f3e80dc85b17044cf7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe đi trên vỉa hè, trừ trường hợp điều khiển xe đi qua vỉa hè để vào nhà, cơ quan"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0544c1f213aafeac39ce44411a4f36acca6c6917a65886ea1b620e2d3f5c9438> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công trên đường bộ đang khai thác không thực hiện đầy đủ biện pháp tổ chức giao thông để xảy ra tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/054cad7da56f01542cc073270a98b297bc9e4f0f1968545d2007410db4dee699> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm thay đổi trái phép dữ liệu điện tử sử dụng trong thanh toán điện tử giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/055d19abd6a37a1199f0be00d62890fded1b172ee0f4e4269c7cde95881f4c4b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp điều hành phương tiện, lái xe để vận tải nhưng không có giấy phép kinh doanh vận tải theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0579c2b14abe9a336e6b6d50b0edeb1d6a2f692332ea17e1022ab842a139c068> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người được chở trên xe đạp, xe đạp máy đẩy xe khác, vật khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05b3f67773fcca9a12838e7f937d79604b84661fe53f21744fccb4963da5116c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy tốc độ thấp mà không đi bên phải phần đường xe chạy gây cản trở giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05b562d6562fd0bf183f7e43e4d3d2c08ceed173601b9d0f0aa1b575a5453dd8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 4 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05bdcbe0e9f6ab2d3c6816e0c8cd63427b6fa225bd526a1091e693a5cfef8d67> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức kinh doanh vận tải, dịch vụ hỗ trợ vận tải có phần mềm có ghi nhận đánh giá của khách hàng về chất lượng phục vụ của lái xe nhưng không gửi thông tin đến đơn vị kinh doanh vận tải theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/05d547ffb017914415938a0d4ce6daab90259945ab5794f4a5e5580fdf808826> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc di dời công trình khi cơ quan quản lý đường bộ có thẩm quyền, người quản lý, sử dụng đường bộ yêu cầu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/060f91701f55e399ee21259af6e187c7a29484939f40fd721d89c18ccc2c322c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không bồi hoàn kinh phí để xây dựng đoạn đường thay thế theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/061d7c178973bb9d44e35fae1fd6fe489f7b5aa5414a22a96bd700d6c1cfb4b2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tổ chức khám sức khỏe định kỳ cho lái xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/062a5c7c7131e87e011a962d19d95bf4f71dc137e618beb1010e182059056756> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chiếm dụng dải phân cách giữa của đường đôi làm nơi để vật liệu xây dựng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0656bb7a5f3482d6d7567d000b237ae64dec1482d7cfa00bffe99f36c0ea8775> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cản trở hệ thống thoát nước từ công trình thuộc kết cấu hạ tầng đường bộ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0670b780d627c78a4f35bb3270b34592b2a4530801621715af622fc5bdad202f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy chuyển hướng có tín hiệu báo hướng rẽ nhưng không sử dụng liên tục trong quá trình chuyển hướng, trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0693c78c00f1c3f4671a637f20eb9fed8d37e8df67f0fbcd9a8f4eab0b301334> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lùi xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/069830f852a44edd764bbbf38c7df3e864efe1680bdd2714309397d42852ae0e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng còi hơi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/072800575180641f9ebd2aada20bc1c421de1542647e1cfacbf33827e041a638> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc ký hợp đồng đào tạo với người học lái xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/074941d1d9f8e7b865449d445a4baa383513246d9ae8e712e876bc29b35f7d33> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy không làm thủ tục thu hồi chứng nhận đăng ký xe, biển số xe theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/075c27c26ff2291e8ddd14cc9e9ecf8e936a690b3995d8c72907254fa3719451> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng hóa nguy hiểm không thực hiện đúng quy định trong giấy phép vận chuyển hàng hóa nguy hiểm, trừ các hành vi vi phạm quy định tại điểm a khoản 6 Điều 20 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/076779243932fe4bfad992434672a5e96d19b58705f8765a5cdf0d6852446113> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thực hiện không đúng hình thức kinh doanh đã đăng ký trong giấy phép kinh doanh vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/0767ff92507d76ba722c1d4a9288eae9c05c0d31a14792debd7112d5706add32> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giao xe cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56, khoản 2 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/07e04137c3275bdbc41899edbc22e3dde4944fdc90dc76216d9f41556a8bce47> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/07fd430acc2840d64d96c5f9c2dcb9343af93916d0763a9544d5949cd92ed2d8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành hiệu lệnh của đèn tín hiệu giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/081bc06296c483f05935863ebc9e1f6fff770cf2211ef3066a3d7d99c1489651> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không bố trí người cảnh báo, hướng dẫn giao thông khi thi công công trình trên đường bộ đang khai thác theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/082de2e66002d9710c828cea0c2fe7e1e743d21fa5923b614108421dc71165fc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy đưa phương tiện không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/08310a7ffe33e96af073ed4bb1de41d898c361dd2bba030cffac5dd933032257> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy chở người ngồi trên xe kéo xe khác hoặc vật khác"@vi .

