    skos:prefLabel "Đặt máy tuốt lúa trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cc7120d10d2d4aef4724e4a8a377f696624bea5ad2cfd014b2751accbaad6bb7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tẩy xóa hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cca21538b65da968b23c2a1963f820306fe26469f8c2541a8486c231be9de1d0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccaeacbf1c23e8fde49dcf0c5231cc7b1a1c31710291f8593dd66a0af16e2b83> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giao phương tiện cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 4 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccaec84bd9c09a24406791aa44b473a93cd52883ab9a0d6eec1b294cad10a5ff> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bơm cát qua đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccbd5566347bd74361a68d9c9309d3db7efa7bddfa12d1daabee23222126873f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng mà trên xe không có hợp đồng vận tải, danh sách hành khách kèm theo, thiết bị để truy cập nội dung hợp đồng điện tử và danh sách hành khách theo quy định hoặc có các giấy tờ, thiết bị này nhưng không bảo đảm yêu cầu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccdcde780ca775f4aa44febb2032506f522ddcc5e187fde6fd158d94e712d698> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người trên thùng xe trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ccfabd4a428b1a36c6cada68a01418008ab80ab02c0252715f2b872dfb495fad> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tổ chức thực hiện các nội dung về công tác quản lý an toàn giao thông theo quy định, trừ hành vi vi phạm quy định tại điểm b khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cd0c7f1d4c723b9b3b4178f375f9818c895bf1880fbbee2c2e1bc6d25716d98a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe cấp chứng chỉ đào tạo cho học viên sai quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cd3aa2e94c0f337e4bf7bac699ab4731ea43bfbbe71a0a1e385df64dcf1aab8c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trung tâm sát hạch lái xe không lưu trữ hoặc lưu trữ không đầy đủ hồ sơ theo quy định của 02 kỳ sát hạch lái xe trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cd625cd301257ecf42179297286f8169b16bb10c82eb82cbeb8f2f21cb0a0699> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bến xe cho phương tiện xuất bến không đúng thời gian biểu đồ chạy xe đã được cơ quan quản lý tuyến công bố"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdacf21943899cb67848a39c52ded72ccecb4f488e4837d506e312073fcf4b1a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Ký kết hợp đồng cho thuê phương tiện để kinh doanh vận tải bằng xe ô tô, vận tải nội bộ mà không thể hiện nội dung không kèm người lái xe với bên thuê"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdb5106adc60ddc5f5a7b2c9ba21fa882bfb0427de5eff4309463b06ccc55464> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe), giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdbbeb3358b2cabb8be4219e332f07579d3f0c6a61787f90a2af03dadd2973a3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện giao thông thông minh không có giấy phép hoạt động hoặc giấy phép hoạt động hết hạn sử dụng hoặc hoạt động không đúng nội dung ghi trong giấy phép tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdc4bf4a8b6404b8ee4ab5338817942c0950460d9e714e664b993f0fd5a7c315> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải không cung cấp cho cơ quan quản lý danh sách các đơn vị kinh doanh vận tải, xe ô tô và lái xe của các đơn vị vận tải hợp tác với đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdca0ff63a986d588cc5d73abe2cda4e2d743bc835021478ea01e3bc055db1a0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng giấy phép lái xe đã bị trừ hết điểm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdd5aebabd6473c7f4070acd976c73094080591638743211049a082f5293ebe3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không giữ nguyên hiện trường, trừ hành vi vi phạm quy định tại điểm c khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdd791be0b4de1bbcf604ec9853e5fa3e836784ac972979316db605cfc75b355> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi ngược chiều trên đường có biển “Cấm đi ngược chiều”, trừ các hành vi vi phạm quy định tại điểm đ khoản 9 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdeb8dedccf2ff11cb993ed03ce8b4c400c4ba4a84e59603d6b820e3420762e1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không phát hiện kịp thời các hành vi lấn chiếm, sử dụng trái phép đất hành lang an toàn giao thông đường bộ, đất của đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/cdee898754ac36223506a3a09b608909056cbea6de34791cd2e0e2743c33adde> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe vận chuyển hàng hóa nguy hiểm mà không bóc (xóa) biểu trưng nguy hiểm trên phương tiện khi không tiếp tục vận chuyển loại hàng hóa đó"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ce0d12cbfc93c772dc2a099f20be4b09fb923b747f265029ae539a5b37821d2b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tháo bớt ghế, giường nằm trên xe ô tô trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ce2a266e1d8700a2d4ee4fe5de28bad670f7ce28eeddb2e3b17c37a481d87b3b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy trình quản lý, vận hành trạm thu phí theo quy định để xảy ra tai nạn giao thông đối với các phương tiện khi phương tiện tham gia giao thông qua trạm thu phí gây hậu quả từ mức nghiêm trọng trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ce357934b5ad8d6a7b14a57d8e9a216019ffd6aae1cc4fb9627959728e6f9f87> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tuân thủ quy định khi vào hoặc ra đường cao tốc"@vi .

