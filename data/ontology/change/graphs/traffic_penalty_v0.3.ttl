    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có bộ phận quản lý an toàn nhưng bộ phận này không thực hiện đầy đủ các nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c1c835500cf7c5a7ce4038794dd06b534b912ae2688ff2fe65bf3bb1294b7640> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người đang điều khiển xe hoặc chở người ngồi trên xe kéo xe khác, vật khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c1ce011ea84485d537c97176b5cbd6e6bf5275915f5113a8968d24a0308ebe7a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) có sử dụng cơ cấu khóa hãm nhưng công-ten-nơ vẫn bị xê dịch trong quá trình vận chuyển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c1dbc99c03c184bd0695ed5f17ca8c503459b2d85469501a60fc82b2a8b48d9c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Rời vị trí lái khi dừng xe nhưng không sử dụng phanh đỗ xe hoặc thực hiện biện pháp an toàn khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2121c79618a32f9bbb87ca73885f7ec3281dd7ac4d37080c3bc5e00e7a2df2e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm quy định về sử dụng thiết bị giám sát hành trình, thiết bị ghi nhận hình ảnh người lái xe trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c21346a643b237b44b86b3124bdeb45ed76b57faba8307e78bcde9d7f0b5fa9b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe được quyền ưu tiên sử dụng thiết bị phát tín hiệu ưu tiên khi có giấy phép của cơ quan có thẩm quyền cấp nhưng giấy phép không còn giá trị sử dụng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c221e4e37b60e2f72c58c167cb57cb76572a2165fc44524ae883bc0792edba4a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng không có tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2224c07f0001252123fc9c42e5ab3ca49997b36675e1f6b9b673e50bf52a49e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý làm hư hỏng biển báo hiệu, đèn tín hiệu giao thông, rào chắn, cọc tiêu, cột cây số, vạch kẻ đường, tường bảo vệ, hàng rào hộ lan, mốc chỉ giới, cọc mốc giải phóng mặt bằng và các báo hiệu đường bộ khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c22b8a32aa1dbb2765e88c4814dfe2989e678801d0cc51abd19526a54ee8c533> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xếp hàng lên xe ô tô"@vi .

