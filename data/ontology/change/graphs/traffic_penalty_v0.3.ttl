    skos:prefLabel "Chở trẻ em dưới 10 tuổi và chiều cao dưới 1,35 mét trên xe ô tô không sử dụng thiết bị an toàn phù hợp cho trẻ em theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/5672ad08a7bc406368350400d3ee370312fc018cc3e06a50d454781e890919ac> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy điều khiển xe gắn biển số không đúng quy cách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/567d5f6f933f636c4eb9aa2ba14b60955ae1335cd8ae7c98c35b0a5be6833296> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lưu thông trực tiếp xe bánh xích trên đường mà không thực hiện biện pháp bảo vệ đường theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/56aee026a41315bbadef2f684fcef438f5f71277bd6f5f7396eea05f781bb5c5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường rộng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/56d385a25a74680a612dd99757f186bceb5cc623fe231886587a79d873f5cc64> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
