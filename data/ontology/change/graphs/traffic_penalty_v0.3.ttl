<https://w3id.org/legal-ontology-rag/data/concept/conduct/76ae907f9e615192d899676d7ad3c4c74dcfb6015f853613b60c4f31cb7bb908> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi vào đường cao tốc không đúng quy định gây tai nạn giao thông"@vi .

