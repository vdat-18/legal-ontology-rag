<https://w3id.org/legal-ontology-rag/data/concept/conduct/48bd2d6d00cb292df8bc8a0835e242355169e9d78c4aa1c6ae68e577d57fd580> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Mang hóa chất độc hại, chất dễ cháy, nổ, hàng nguy hiểm hoặc hàng cấm lưu thông trên xe chở khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/48c657ecc42916545baa2c74a2ba033e39977e058cb96b93896dcacf95da6875> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/48fd253ac2be8be2a3dd882e12633d5822eb8c36ea8131953dd2a4e9714b85cd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lùi xe trên đường cao tốc, trừ các xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/48febe5780a54e15280694cb904d063de622701785e6001fd086c1e1010f1c64> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cố ý xóa dấu vết hiện trường vụ tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/490af5e6bddf2aef07e0f5fb9a9bd00ca7d27d0a7410378862ce90db43166594> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xe không được quyền ưu tiên lắp đặt thiết bị phát tín hiệu của xe được quyền ưu tiên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/490b5608e9e8980f77ebc3b7d354f8cf9b8cadc72e7eef771f98b8557febefb7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe tại vị trí: bên trái đường một chiều hoặc bên trái (theo hướng lưu thông) của đường đôi; trên đoạn đường cong hoặc gần đầu dốc nơi tầm nhìn bị che khuất; trên cầu (trừ trường hợp tổ chức giao thông cho phép), gầm cầu vượt (trừ những nơi cho phép dừng xe, đỗ xe), song song với một xe khác đang dừng, đỗ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/492c91ae94bfe8b649a79465fad1d5a69643959b49bb144656c9f1d3437a1c2c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trung tâm sát hạch lái xe không lắp đủ camera giám sát phòng sát hạch lý thuyết, mô phỏng các tình huống giao thông, sân sát hạch theo quy định hoặc có lắp camera giám sát nhưng không hoạt động theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4939f53d52f396e4f5d61eb69eb0332ddf91f798ba15b7bf8f26dbd130f53a27> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 56 của Luật Trật tự, an toàn giao thông đường bộ điều khiển xe tham gia giao thông (bao gồm cả trường hợp người điều khiển phương tiện có giấy phép lái xe nhưng đang trong thời gian bị tước quyền sử dụng)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/494c9f19a48ba7d385f92681226ec6a4867847447b23f72fbb9220c206bb312c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Mượn linh kiện, phụ kiện của xe ô tô khi kiểm định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/49552939f232c696a785431abc7d5ba01d03f2bef6f3421e063565604b35866b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm d khoản 6 Điều 20 hoặc điểm b khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4963c4bdc36759a1b474efa70dd2fa39988cf39e95bafa235449e0f709786bee> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gắn biển số không rõ chữ, số"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/49adccb5a89dc848d3928d956973fbb5d3fffbaf1f07f25c930bde4d8533c820> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe, kể cả rơ moóc và sơ mi rơ moóc, gắn biển số không đúng quy cách theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/49e9faa74eca09128447dd594a13b972b2b97082175bd0406ef270808990e2de> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đổ rác thải ra đường bộ không đúng nơi quy định, trừ hành vi vi phạm quy định tại điểm a khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4a07d0b18487becaa9fd9efcb2260d44be5f6a36053d6761942eebd1c5f98b71> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
