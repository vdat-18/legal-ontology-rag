    skos:prefLabel "Khi ra, vào vị trí dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf6d9a567c6b830ebeb7432e18da60bcddb9d63f498b5724e335910a2e7f4a4e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không khắc phục, điều chỉnh các lỗi, sai số phát hiện được thông qua quá trình đối soát"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/bf7044814f57f04699f7279a79a5b662ce348cf39c3e5acd586947b32656004e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dán lên chữ, số của biển số xe"@vi .

