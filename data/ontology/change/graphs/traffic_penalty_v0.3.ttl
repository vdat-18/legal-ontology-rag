<https://w3id.org/legal-ontology-rag/data/concept/conduct/3aa8e672e106818af2e0bffa3ac8522a71c16392fb7e167f81e4063369e369fd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Phá hủy thẻ đầu cuối"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3acc0152cb61c585ae83b65c5542c118d5dc0a538ce0e641221c7ad085136ee1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3ad46226e805c3f0ce15d5f5c58e8081296c49cd8823e3de0c7b9949f9bdda17> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe bánh xích tham gia giao thông không có giấy phép lưu hành hoặc có giấy phép lưu hành nhưng không còn giá trị sử dụng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3adaea7971efe5367b311b2381fe7fee5213e0083af957b243aa60c5d50d251e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện tháo dỡ công trình hạ tầng kỹ thuật sử dụng chung, công trình lắp đặt trong công trình kỹ thuật sử dụng chung khi có yêu cầu của người quản lý, sử dụng công trình đường bộ để đầu tư, xây dựng, nâng cấp, mở rộng và bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3afe2bb765d42656f14db4944e7b81a1b33a5eda2899aa4f94d805a6bee48620> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe nơi có biển “Cấm dừng xe và đỗ xe”"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3b0f3a42865375731dbe6aad0144aaa85164ef28e7c2de194d817401018d2b5f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phương tiện kinh doanh vận tải không lắp thiết bị giám sát hành trình của xe đối với hình thức kinh doanh vận tải có quy định phương tiện phải lắp thiết bị"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3b5117ef15517be80a4ae1d91a2920aa7186069c07c4dd69d9f89449aff143cb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển làn đường không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3bb757e77f3d8067dc2cf57c7669ba67479e6011ec011d69d9ffb8a4026a1f1d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3bb94fb316c03c8933440839d8019fb8ef68f95fc2a2864b62ef4e16ab47579c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy mà không có hợp đồng vận tải, danh sách hành khách theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3bb97e168fb7147cd801cd9c0a0a742daef57bde5a91917bc2483ef0dc6bcde5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chiếm dụng dải phân cách giữa của đường đôi làm nơi bày hàng hóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3bc08fa5ad3316e9a354ddbd8817e40a448137c23ef0542abc3b86e2053da751> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện nhiệm vụ đối soát số liệu thu phí giữa lưu lượng phương tiện thực tế lưu thông với lưu lượng phương tiện thực hiện thu phí của nhà cung cấp dịch vụ thanh toán tiền sử dụng đường bộ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3bca14d7ff4decc7df64d597026ceb1f12d58b221d5706bd7dee8bb33df3a680> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô kinh doanh vận tải hành khách tháo bớt ghế, giường nằm tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3bd934f63adb0e1f49481d52bb7026d4b3ebf9c27c1c28f7ad576bbbe116c3b6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng hồ sơ, tài liệu giả để thực hiện việc kiểm tra, chứng nhận, thử nghiệm nhưng chưa đến mức bị truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3c354bc454966d7c3d503d3a3268b2ce4231d5af124a1344bfef8cb5dabb6270> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm b khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3c4777770658911e9f8d259a38bf183a53e38091819231efa98ed5066c89f262> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3c483c37e2f9724a1b9452fb2858f207f8d5b34bbf4d5f06a86a9c165dbf0bc4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi ngược chiều trên đường có biển “Cấm đi ngược chiều” gây tai nạn giao thông, trừ các hành vi vi phạm quy định tại điểm b khoản 8, điểm đ khoản 9 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3c6b0a10a68ad36ecd1ca665d08dd67878f233cb5cfbfc22ebaf1311d9038c53> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thực hiện việc chứng nhận không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3c754c8116aec4855ccc7a7272badb523309d7a143d7a91f747cb2a218ca63b8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô chở người có giường nằm hai tầng để hoạt động trên các tuyến đường cấp V và cấp VI miền núi"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3c8cd94237aabf38c0de99ee9013855336e51462b88dccb0b1d1906541692823> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bến xe xác nhận không chính xác, đầy đủ các thông tin trong lệnh vận chuyển theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3cb1d5830fb342fae67837dd4cbc7ff8aa2ea57e1f5dc08db4929ff63931b4a6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe tại nơi đường bộ giao nhau hoặc trong phạm vi 05 mét tính từ mép đường giao nhau; điểm đón, trả khách; trước cổng hoặc trong phạm vi 05 mét hai bên cổng trụ sở cơ quan, tổ chức có bố trí đường cho xe ra, vào; nơi phần đường có bề rộng chỉ đủ cho một làn xe cơ giới; che khuất biển báo hiệu đường bộ, đèn tín hiệu giao thông; nơi mở dải phân cách giữa; cách xe ô tô đang đỗ ngược chiều dưới 20 mét trên đường phố hẹp, dưới 40 mét trên đường có một làn xe cơ giới trên một chiều đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3cb8ab054a512f3320e0009c5b0a90ad62df3eaa89cb0e86e0e33940fcdcd097> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bảo trì công trình hạ tầng kỹ thuật sử dụng chung với đường bộ gây ảnh hưởng đến an toàn công trình đường bộ, an toàn giao thông đường bộ hoặc cản trở công tác vận hành, khai thác, bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3cfd38d5fd970221db8a796cce8f241c322c39f293aec4c7c5b15a7f23031f28> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lòng đường, vỉa hè vào mục đích khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3d08ccfac4d51c91fa41636c789bf69529c0bb91446b89a8f5448345a231cccc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường rộng, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3d1bd2cb491796f8d4160f0a383fe2ae0cc9a11123cd88bbb7882cfdaf9838c4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô cứu thương không lắp thiết bị ghi nhận hình ảnh người lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3d4a7b006738f7539a38d2befef96aa543f9eb2fa62a8a35c6048bced87f5abe> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe máy chuyên dùng sử dụng giấy phép lái xe không còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3d5b609b9a6542764c25590eae1fb74ce91db2d2c49a0bda210ceb8c453a6018> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3d91a213350e949ceae8a16dcdf63ae804cd1f88d2c659717d731f6a1d03d195> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý mở nắp cống, nắp ga các công trình ngầm, hệ thống tuy nen trên đường bộ làm hư hỏng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3d9f697a397ead1dd5af723c04ea64a24627ec6d694e549d574aea43401a08a7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lưu trữ hồ sơ, tài liệu, dữ liệu chứng nhận không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3da210d6d7897401681393521d1fbc22b511ec075973b77911da6276cd93d50f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng còi trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3da7eeaedadf5d2c6f851a9a19dc99b82dab0470f6c2f1324bde4a01736e06d4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tiến hành các hoạt động ghi trong giấy phép, chứng chỉ hành nghề trong thời gian bị tước quyền sử dụng giấy phép, chứng chỉ hành nghề"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3dc072c5d4b9d9ad161d47e36ecc94e49b7cda6bee8fffd657a18e73ce00673d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lùi xe trên đường cao tốc không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3dd302b0744e617923a41de681e2affe87392be526e50778a2d3aea776d95d92> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc quản lý thông tin, dữ liệu từ thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3dfe09b95f0f9d75d1e9545a6c4286f82b0fe0ff5b8ebe01de9e085c9e938708> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe không đúng số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3e05296c8a1e824a8a2bac17592e3f7974d53f53ec6149a4be4a135277639afb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng hóa mà sắp xếp, chằng buộc hàng hóa không bảo đảm an toàn hoặc gây nguy hiểm cho người, phương tiện tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3e4a97e5904af3a266511d845f0071249cba296e35d178236cd352b6d7744254> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thuê linh kiện, phụ kiện của xe ô tô khi kiểm định"@vi .

