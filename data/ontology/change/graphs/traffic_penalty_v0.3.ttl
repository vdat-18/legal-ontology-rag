    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Rời vị trí lái khi dừng xe nhưng không sử dụng phanh đỗ xe hoặc thực hiện biện pháp an toàn khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f201bacbf560f3f4ca65eac81e1ee6d68b931a8833bfba728324eda9fc0e166> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp quyết định giá cước vận tải nhưng không có giấy phép kinh doanh vận tải theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f31896df915e4b72de6c849561eb6a2a7ad074bdb6741f7f8e46e5bbe5041e1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây tai nạn giao thông không dừng ngay phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f490c598ef24cd77fecfc9583eccf8021962651c382c34794571f1b5d00c5ae> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Phê duyệt quy trình thanh toán điện tử giao thông đường bộ không phù hợp với hình thức và phương thức thanh toán điện tử tại điểm thu"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f5b4a9fa35f3a8cb3029c78dc4cd7b9071fcd7f5d51b71911583e7175a4f87f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tát nước qua mặt đường giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2f72eef6139079c240deb745025791fb9a1a5449a7014e744aa4f4e7fdc1fec5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách không lắp đồng hồ tính tiền đối với loại xe đăng ký sử dụng đồng hồ tính tiền."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2fb1e50ebdc0b9f46301cc15e7fa669141ab5a84cf2e2ab0f6ecc8d0124816dd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc niêm yết thông tin trên xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2fc268c9c7585b882356c95e3246a80e77c8cf52d439ea7cf0be26f59655d27a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải hành khách lắp thêm ghế, giường nằm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2fc8ea364ac2f61a1ade0d91dd8a561cfbcf852feed08485aac96a88c5d6df92> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng có giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2fe9d0197d2b9886923bff1d199d72db76d5583082d12c1569a2839993adfc27> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý nhượng bán tài sản của trạm thu phí"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/2ffe3a98e442dc00addcae0d98317b4124a676d8d2aecfe4ba30ff045efe78bc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công trên đường bộ đang khai thác không đặt đèn cảnh báo giao thông và chiếu sáng ban đêm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3014482aed22d1893e96b5157976061df3caebbdca6e84b0c8ae1bf431e089a5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cố tình để các dấu hiệu, ký hiệu trái quy định trên sân sát hạch, xe sát hạch trong kỳ sát hạch"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3061a4e23f06439ed6197066208d3d4ba647b0477ab9eab524d063417a30c815> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe đi vào đường cao tốc, trừ phương tiện phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3072e908e30e8e51b9657b194fe546c67d96f5e7161f98b203de81cd5fc5c4d5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy điều khiển xe có bộ phận giảm thanh, giảm khói nhưng không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/30912faa86a07f8b05676df075460e968c26e93410adfe7ee82d4d94a8d91848> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trên đường dành riêng cho xe buýt"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3096c9c2fdb536a8ec5b21d40cc2d3280473b690de647748f73eec2ab2c1936f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trả khách tại trụ sở chính, trụ sở chi nhánh, văn phòng đại diện hoặc tại một địa điểm cố định khác do đơn vị kinh doanh vận tải thuê, hợp tác kinh doanh, trên các tuyến đường phố"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/309da335c9d39debe46afd13727ea69bc1fe90d4f5c0261dc6c27f10dcd2845d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bến xe không kê khai, công bố thông tin về giá dịch vụ xe ra, vào bến xe theo quy định của pháp luật về giá"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/30c697f2482e0c85036b0f15d66151b91401462bcf2f55a94bed7548fca0f0eb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm quy định về tải trọng, khổ giới hạn của phương tiện, của đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/30de23c6e2daa7e753e628c19ff03ab6dd0d8f63f24086ba2a00fb74e0cb6fd7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để tổ chức, cá nhân không có giấy phép kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ điều hành phương tiện và lái xe để vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/30e83744bdc64fcba4d6286cbd0e437746d0d529c24f35152615113875d684c4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kéo rơ moóc, sơ mi rơ moóc kéo thêm rơ moóc hoặc xe khác, vật khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/310a31b3cee6d5ac727e7f666f17a7b405e77105f41dab66cbccdf1163aee3a2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hành lý, hàng hóa vượt quá kích thước bao ngoài của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31167d75671b9be950aa6393244c75909077d21292eb7480108bf9c171eba355> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng trái phép lòng đường, vỉa hè để: họp chợ; kinh doanh dịch vụ ăn uống; bày, bán hàng hóa; sửa chữa phương tiện, máy móc, thiết bị; rửa xe; đặt, treo biển hiệu, biển quảng cáo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/311d9a2602e3e9b47dcc5d9c200ccde4307ef8e7e266e2b8ce8bc45348ea4ec0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định về dán, thu hồi phù hiệu cấp cho xe ô tô tham gia kinh doanh vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/3120ecb98a7cea0b18f2a618f379769469984a5a65c4c36cfc35755f968ff6ee> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm c khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/31323582d3e9d759ec75892c7b42196e603e87a22d7da0b5f84be536bd108b7f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trong hầm đường bộ không đúng nơi quy định"@vi .

