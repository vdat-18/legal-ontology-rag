    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có hệ thống hãm hoặc có nhưng không có tác dụng, không bảo đảm tiêu chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/96966309c3641dbfb551dbdde44ecd58b8a8ca644fd2be6c355a03d543b77482> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
