    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2997fef4b2d31e05430102bbbd1d568afdf541d4dca0a9b78ac6efc11bce59f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2a73d8ccc78e38a4e907eab151cf51430724da8b8b8ed8c8d1c8dce7acd3fe7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe lắp đặt còi vượt quá âm lượng theo quy định"@vi .

