<https://w3id.org/legal-ontology-rag/data/concept/conduct/4a12c06a89a069ec7912901fa922e8601fc35dac3fe66a860a9b5d9dc20a9afc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) mà không sử dụng cơ cấu khóa hãm công-ten-nơ với xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4a49bc2a90165eea256f71a08f78d1e9661d5226d833372433f1302211d2ee88> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở vượt trên 50% đến 100% số người quy định được phép chở của phương tiện"@vi .

