    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kéo rơ moóc không có biển báo hiệu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/91801ae33547486b6dc70f8ebf4fa6f7575f8f16209b0b7ef2b9dd1e956dbd68> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người trên nóc xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/918347d2e2fedacf87d81d6e3af9be9c78cbc28a2bb49e784384477ca957afca> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô (kể cả rơ moóc và sơ mi rơ moóc), xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cứu hộ giao thông đường bộ, xe cứu thương có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng không ghi được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9190c6766cb35251173805a66b60d489c3db970eafb606255d7c7e16f4b80e53> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe sử dụng còi vượt quá âm lượng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/91a1e7e68bdfbd89cacdb8e88dabb306be353910f0092f451ada0fefb9275350> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người trên mui xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/91aa67e9c83040919d7629b65950f78f5d7da0f60473cec0e4e59aa6b78a8803> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vẫn tiến hành các hoạt động ghi trong giấy phép trong thời gian bị tước quyền sử dụng giấy phép trong hoạt động đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/91aeaa4c88d1f585f1c78696cc1b703e8ac36ef282671f441db75daf7e916be3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có tờ khai phương tiện vận tải đường bộ tạm nhập, tái xuất theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/91b499f41d98fa8c273abf92704c177f6309a891882a53b5abfb5b7717ebdacb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý thay đổi tổng thành khung, tổng thành máy (động cơ), hệ thống phanh, hệ thống truyền động (truyền lực), hệ thống chuyển động của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/91c7f994a53efce33cac30c4d9a0c653b8a0b7f120d61c801fa05412f94f2a56> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có bộ phận giảm thanh, giảm khói không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/92067751433fbe664127ab4bfe3a74ea226c0b63255dffb6d112f31632d5bb61> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không lưu trữ đầy đủ theo quy định các hồ sơ, tài liệu có liên quan trong quá trình quản lý, điều hành hoạt động vận tải của đơn vị"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/921d67c221508c637d8f0d2af0e8bf84e2209195754528f99b250c2f1db2d34c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm quy định về lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/923245dd08d686cc43aca66a4799fb30d763ca7ff1ed5a58440f567b231e3a42> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm c khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/924ac81e36a7da1dc89df596ae6680b0a8421aaa36247051a3db5241886a29f8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng giá dịch vụ vận tải hành khách tuyến cố định đã niêm yết, kê khai."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/926d4fc6d9fdd9355ce20ebbc345e7080f5f9d26ede5a16ac6c367b7c79ef85a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe, giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/929591a9c1a247a05913563b94f5fcbb4fba057a89d28419b58c200f082a7c23> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây tai nạn giao thông không dừng ngay phương tiện"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/92a4a63f456fc2531bca3b8b148fb3cae1f93e8559981d5e4b51609628099d7f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không gắn biển số (đối với loại xe có quy định phải gắn biển số)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/92bea5ec9935c8cb253b5c7620e6104e10c259ba694734c842de0a724eea7044> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định trong giấy phép lưu hành, trừ các hành vi vi phạm quy định tại điểm a, điểm b khoản 3; điểm b, điểm c khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/92c172d1ae1145c8a1a10abcd7f7bb0043ea80b1cd4a678c3827a3748c069e91> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng thiết bị âm thanh, ánh sáng trên xe gây mất trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/92c80f77b82f954f311169bf02549b2eed8e4844a22e152b679930100fe75237> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để hàng hóa trong khoang chở hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/92edb08ff9db868b548c8d0271f7b507b117a036b2a104639f9a72cbf9798c1f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khi có điều kiện mà cố ý không cứu giúp người bị tai nạn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9378081953d917c8ef56f0e3898e25a9039a694bc827ba456014b1da148dc565> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 30% đến 50%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/93b200ae0903543d37dd4a75429b6da5691477a06df140d9a05322d61ab4c28f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/93d729388ee0c3034835396c59991b559914a9d399404d6910eefea6a00a554f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải không lắp thiết bị ghi nhận hình ảnh người lái xe theo quy định (đối với loại xe có quy định phải lắp thiết bị ghi nhận hình ảnh người lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/93ea08c915af49233faf3e2f753646f376b1c33c330304b370a428b1f0374ffa> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thu tiền vé nhưng không trao vé cho hành khách (vé giấy hoặc vé điện tử)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/943cb4d4938a7109e4310153f191a2dfb557d3b3399bdf37f486827bcd2cbbd9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy đi không đúng phần đường hoặc làn đường quy định, gồm làn cùng chiều hoặc làn ngược chiều"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/945b8dfe655e1dc7cfea20bbf1b476ba0c98e1ab1ff9beb8b2b970c74ff79d52> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chạy bằng một bánh đối với xe hai bánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/946183f1f1c1923863f7776bdb45b96a573ef633d0d1a64c9c88f975829b9763> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chở người bốn bánh có gắn động cơ kinh doanh vận tải, xe chở hàng bốn bánh có gắn động cơ kinh doanh vận tải không gắn phù hiệu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/947ce715881f9d16ca17a4f67a914722aad3fc9012f456d9ecceb4683b8436d2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đội “mũ bảo hiểm cho người đi mô tô, xe máy” không cài quai đúng quy cách khi tham gia giao thông trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/949523c4fc2a6287fe5796f8bb02ba3ef91d7c11c9fe289eaa6d74b91a0c5cb6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe máy chuyên dùng không có bằng (hoặc chứng chỉ) điều khiển xe máy chuyên dùng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9498d5d7ff60095cd04237970776b826516525d57a169451f20442f500473307> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xả thải hóa chất, chất thải gây mất an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/94b50c7064b326e9f65d8f717d83119178f8413bc7924154ade1499c947a8d17> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kéo rơ moóc không có biển báo hiệu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/94d067283a246b082fd5418e18ec8b2b932b1221780e3404acb3d0ffe45527d6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/9516029ce2eedbc222bcffa63f5dcf96bf7903c61f045a42255655b4c7b2d659> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không cấp lệnh vận chuyển, giấy vận tải cho lái xe đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/95a9f8f143fb43c9ed160c7a66196fb9ab8652cc13b1b3ae20099c6645a5c32b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô không có chứng nhận bảo hiểm bắt buộc trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/95bd2fe6896be2f15c4c6688977e53c124f90ffc91fda585bd37525a658a5570> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý thay đổi tính năng sử dụng của xe"@vi .

