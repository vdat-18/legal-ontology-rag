    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa phương tiện không gắn biển số (đối với loại xe có quy định phải gắn biển số) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4a6a5560b7481f66111c371e8faef85e2d80d2fe42f478706787a281dcd4200c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe ở lòng đường, vỉa hè trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4a7e1f3cc671653010ace9d7b6403219208fc822db2568e9ece76092959bd177> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy chuyển hướng không có tín hiệu báo hướng rẽ, trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4a9a4bee831f5b1ac5d09bada5ca03e2e9a7398a2b066b158a5aecbc336cf6e4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kinh doanh vận tải hành khách tháo bớt ghế, giường nằm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4ab10e1f2dd3d1b34a216e976be28c3a64983c96f68d596b1b7ce679d7bb3a90> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Nổ mìn làm ảnh hưởng đến an toàn công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4ab308e686a564c1ff5f6b4ba118c7bf3eee3ab4e16ec2e966527c6bf95946ae> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện các nhiệm vụ bảo đảm an toàn giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4ad8aa302f46a573b39b9e4533ac6c797eb39dcae5617645a78da5abe05278c8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy kinh doanh vận tải không mang theo chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4ad95b9c4d2a773ad61b6920adee3c9794bb7eb4e98a36da794683ec65a07d86> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trên đường dành riêng cho xe buýt, trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước, trên phần đường dành cho người đi bộ qua đường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4b0b290b586fbe277079c3c170f4a68d1d22d767f222679b1a5487697c204e99> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trên đường cao tốc không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4b275e7ece73c6a2dfe8e93ba0e7a48df9f4b4f73f5c2a8ecbb8a3efe00bd868> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô kinh doanh vận tải hành khách lắp thêm ghế, giường nằm tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4b7613ea4ca02a0beb779b4c638de203ae5417278b090596585bad90375ab35d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển hướng không có tín hiệu báo hướng rẽ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4b79a75560ac73bcb718b032efa680baa00c8deb09f6b38f0c055b1bdb0b616a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4b9f72a0612cdb6e99f44f47b885fcc2889b4564b56d2e09ca30ffc59dd871f5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không tổ chức thực hiện các nội dung về công tác quản lý an toàn giao thông theo quy định, trừ hành vi vi phạm quy định tại điểm b khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4bc6a31ae2c658d4c42f7249b52b08e1cd36f5f9c00da97ec0c418e6bd57c287> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm mất tác dụng của hệ thống thoát nước đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4bccb51f56d3fd359e554a7c1bb2c97c7058f5f1740ea7d27f6d234c50b1a9aa> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4be808919d9294f5b8cfff5e050231b440bc12d52f0f23f5320ca6b38488c8ee> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển phương tiện không gắn biển số tạm thời hoặc gắn biển số tạm thời không do cơ quan có thẩm quyền cấp (nếu có quy định phải gắn biển số tạm thời)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4bf138e8dd9af9f38cc83e2d714a26ac1608f7dcc905932a8961c5bcfda3dc3d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe không có đủ sân tập lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4c25dffd158d24a71fc91ac6fabcc22eb5f9a38543b8479645773fc2aaa21b8a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có ký hợp đồng đào tạo, thanh lý hợp đồng đào tạo nhưng không do người học lái xe trực tiếp ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4c3183998af50a7cc61d777574ced1b6170b33a81aca7ca45e9e21264c479d70> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng trái phép lòng đường, vỉa hè để: họp chợ; kinh doanh dịch vụ ăn uống; bày, bán hàng hóa; sửa chữa phương tiện, máy móc, thiết bị; rửa xe; đặt, treo biển hiệu, biển quảng cáo"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4c328f035650ae65438da3ff9ca058411237b8a4b4fbc795612f92c7ae935990> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành hiệu lệnh, chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm b, điểm d, điểm e khoản 2; điểm a, điểm c, điểm d, điểm h khoản 3; điểm a, điểm b, điểm c, điểm d khoản 4; điểm b, điểm d khoản 6; điểm a, điểm b, điểm c khoản 7; điểm a khoản 8; điểm b khoản 9; điểm a khoản 10 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4c4ae229b84e3ffcf98e1822f57a5481a5a58587aa80fe46e2210bbc7d78ab84> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển làn đường trên đường cao tốc không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4c69b337c44e0db21dd6e2600ade759d8e896e61001f9bcc376ea90bddc7541d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lái xe, nhân viên phục vụ trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được tập huấn, hướng dẫn về nghiệp vụ vận tải hành khách và an toàn giao thông theo quy định (đối với hình thức kinh doanh vận tải có quy định lái xe, nhân viên phục vụ trên xe phải được tập huấn, hướng dẫn nghiệp vụ), trừ các hành vi vi phạm quy định tại điểm c, điểm d khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4c8bef67c91c11106605a42cfc5e620b2f14635a0f1502b881d72eb5ef26ef27> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe vận chuyển hàng hóa nguy hiểm mà không bóc (xóa) biểu trưng nguy hiểm trên phương tiện khi không tiếp tục vận chuyển loại hàng hóa đó"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4c93d7d06e87d0cca8177378e1b5f1b0cc098a4dcbb76f9554019fb0f09b8e29> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô giao phương tiện cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4cd4af5857ee5f1c7df1aec3ace3d529cf207bb73b6d82735d8f4c1694378340> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe bố trí giáo viên không đủ tiêu chuẩn để giảng dạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4ced3d7a7c3e6bfb16946383b879849ce09938d40d58b57d720e4a4d896c5091> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Hoàn trả kết cấu hạ tầng đường bộ bị ảnh hưởng không đáp ứng theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4cef55fc04e9fe46aec165ca69a6b4f6c9b26ecde4037126cf35cc08e05c302c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để hành hung"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/4d7d7d0eefd2dfe2450ca1c5fc492e66e2f79863469bb9742b0d49305a548133> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để đe dọa"@vi .

