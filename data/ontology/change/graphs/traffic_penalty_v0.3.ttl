    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c3c722f7bcf0299f62465930cfa506eb9ef1f90dec9b438a94a14dec81076013> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chiếm dụng dải phân cách giữa của đường đôi làm nơi trông, giữ xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c4394e97f545f0fb455bd189236aa43ba386c04915d3adc572a516e8ac52c343> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có quy trình vận hành, khai thác, bảo trì đường bộ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c453a1678d80f20f209f792f347bcd46525b88f8baa258e06a286a0982c1def9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý lắp đặt vào công trình báo hiệu đường bộ nội dung không liên quan tới ý nghĩa, mục đích của báo hiệu đường bộ, làm sai lệch hoặc mất tác dụng của báo hiệu đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c47dea884ce7116f6adac8e9574eddb7b9e72a37ad903d05dae5f404e19d860e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe taxi chở hành khách không có thiết bị in hóa đơn (phiếu thu tiền) được kết nối với đồng hồ tính tiền theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c485afb21bbd2e82839d13f53bc5d3421f7e9933a3af14b877f04342169eb70f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không có báo hiệu bằng đèn khẩn cấp khi gặp sự cố kỹ thuật hoặc bất khả kháng khác buộc phải dừng xe, đỗ xe ở làn dừng xe khẩn cấp trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c4a60c500636cdf32151c26c85c8e49f2972fb2cc98869dd267d837b70753a06> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cơ giới, xe máy chuyên dùng có tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c4b6b81cb622f25eefd75b0c46f04c67d110c520dcbcdad68e5d60b3406b8b83> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để tổ chức, cá nhân không có giấy phép kinh doanh vận tải bằng xe ô tô, xe bốn bánh có gắn động cơ quyết định giá cước để vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c4d803f25c1b506b16b379e4c77158672dd428a120aff237dbc8b37f39b1ce62> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định trong giấy phép lưu hành, trừ các hành vi vi phạm quy định tại điểm a, điểm b khoản 3; điểm b, điểm c khoản 4 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c55038e7d2b1a43827182e992639283043df19617f8911b56d458025cc20ba6b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây tai nạn giao thông không giữ nguyên hiện trường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c57683dfbf5d1065a47cdec055900cfa640ed0ec580af3b7b20c24d5af50134b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô kinh doanh vận tải hành khách tháo bớt ghế, giường nằm tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c5778dc87cd6edf9b9e9edcfb7884a903daa018a33be4f06b6d723cfaa6a7556> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô cứu hộ giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c59c8b7db438beda2ec8cbf40279b67484e963cdd4b60bf5306313e83e7cf108> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không mặc đồng phục theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c5b3114cd0b8078054d39f7c3e5a72a10833265bf8ea96cbc0ed8ba73cb288b7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng thiết bị thay đổi biển số trên xe trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c5c74f87f67b7665343b81dd9afd5be0d2661bc9b948574e9c030a1783b025ab> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xếp hành lý, hàng hóa trên xe làm lệch xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c5e27b6e3a6468c5b31ddd86fa8f965ba59f51d952e09483612c5a0620653cc0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe vận tải nội bộ để kinh doanh vận tải hành khách, hàng hóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c65ee7677c90b05f24a1312580dcf07bbc25180244099b85fcce30d521520cbc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lái xe, nhân viên phục vụ trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được tập huấn, hướng dẫn về nghiệp vụ vận tải hành khách và an toàn giao thông theo quy định (đối với hình thức kinh doanh vận tải có quy định lái xe, nhân viên phục vụ trên xe phải được tập huấn, hướng dẫn nghiệp vụ), trừ các hành vi vi phạm quy định tại điểm c, điểm d khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c67f227dd0f5d7f3de710172663add11f8bc515cf3d62a76c96d6aa4d1b09e19> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c697512b1302441a1bb6c2bceea6ec8529fe633bf8b910ceb75e933fb61e99d9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để người đu bám ở cửa xe, bên ngoài thành xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c6a242aa20a30aaf6842b4db45d7c461ac731568e3cc32acda480c1a90af9863> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 10% đến 30%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c6a2f080049081afb5e97160ed41bf6906f20c4ddd468aa1ccbbeb637158035e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe ô tô kéo theo xe khác, vật khác (trừ trường hợp kéo theo một rơ moóc, sơ mi rơ moóc hoặc một xe ô tô, xe máy chuyên dùng khác khi xe này không tự chạy được)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c6cd0a6e1fe4090a3075d02d8d82c915db3b588a8223da62a58c7225fa9d72ca> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có báo hiệu theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7152be4c4a65112c6eac7cd1ca3c0fbf21105e8a03570172cdad81709594c9a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không bố trí người áp tải trên xe vận chuyển hàng hóa nguy hiểm đối với những trường hợp quy định phải có người áp tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c719da9e02062b52b0a7afdbacc58d6a0adffbd9fe4b3d81da008591f8d145db> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có giấy phép lái xe nhưng không phù hợp với loại xe đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c75df9bc736a550fdf68c6b8856b155cd6b4fd9b23e7fe576d43ce283e1cb564> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 7 Điều 20; điểm c khoản 6 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7685ecbf724d98589ea7023005d473efa699915405539d5d3aeeb90042e1ef7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c786c739fea079ed5eb85393b36bed0326e9646b993f1edf3d225d8d7c6dcfea> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c78ea2ad8ae1e5737190c82f4ba96870db61ecc131d9807eff502558d31e7efc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng chứng nhận đăng ký xe không đúng số khung, số động cơ (số máy) của xe (kể cả rơ moóc và sơ mi rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7cef98ccd663dff3ad22497bc881d9abcea72734eb706a927bdf6af404319b8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy chở người ngồi trên xe đẩy xe khác hoặc vật khác"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7e077a44f47e626a4c1f4a0e4d6a4e1650eebadc32e2eaeafce96f0859462f8> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng trên xe không chằng buộc hoặc có chằng buộc nhưng không bảo đảm an toàn, trừ hành vi vi phạm quy định tại khoản 10 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c7ecb70b942c2af2293a612b6f239fe6f36668a31cd643597c0a9163cfc3e0af> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô hai bánh có dung tích xi-lanh đến 125 cm3 hoặc có công suất động cơ điện đến 11 kW và các loại xe tương tự xe mô tô sử dụng giấy phép lái xe không hợp lệ (giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý giấy phép lái xe)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c81b830d6b09cffa63d7bcd6081c79364df0db60aa59d6360ae29802a035e42e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị giám sát hành trình lắp trên xe ô tô cứu hộ giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c8293686dcededdb750900c2e07bf52c6b85c76e0ced827d89ced2cb749ba969> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô (kể cả rơ moóc và sơ mi rơ moóc), xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cứu hộ giao thông đường bộ, xe cứu thương làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c84225b031f64ad167308b077ec5e90e48856845b1b493fc389d9264d61b5744> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên dốc không chèn bánh"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c84294748f4f222cb74ab1134cd0c042b8a1aeef2c7e9a0dbfb63c13acf1f1f5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm c khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c879be871a7c59bf277465baf596322b437817d18db436b435ad1c8e9bb5f451> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
