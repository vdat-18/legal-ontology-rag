    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không gửi nội dung tối thiểu của hợp đồng điện tử theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/626bac2f15d03c723a71d2e2a1d231c1869c19d7238bde451bcebec7aed5a676> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62abda87f2eb1356b9a8edc0d8714db3d362bd5371e58434d4fd1c7b5a5fd06d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có hoặc không gắn phù hiệu theo quy định, có phù hiệu nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62bd0c5dd1405180a210c899a082adddf1553249ecb312ee5f2bd877359faa83> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công công trình trên đường đô thị không thực hiện đúng thời gian theo giấy phép thi công hoặc văn bản chấp thuận"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62c534143910644bdb5a0f8b9691d5369499743562fe454c48e4be6cff9cf9e2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dùng chân điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/62e4fcf243035e6af47ed8f84198c09889ae7a2d78e427c9d3f2ede5e3c519af> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển hướng không bảo đảm khoảng cách an toàn với xe phía sau"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63709a862c3e37dd85e7cc33850848b360c91e2c51f7c23e26e4424f8f2e19d6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phù hiệu kiểm soát không do cơ quan có thẩm quyền cấp"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63bd921656cf069cc58877068110784b0be7a100f451e7db7e9fb318bd0c9148> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phần mềm sát hạch, thiết bị chấm điểm, xe sát hạch khi chưa được sự chấp thuận của cơ quan quản lý nhà nước có thẩm quyền"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63cd01c483600da01c004cf9e6c249fdb89001e43bc4b0d62b687433961a357b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lắp đặt biển quảng cáo trong phạm vi hành lang an toàn đường bộ mà không có văn bản chấp thuận theo quy định, trừ hành vi vi phạm quy định tại điểm d khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63f15756dbe7d1a709b9fa1c6eb698eebd36e166b0dad352940be54af79351ba> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Quay đầu xe không đúng quy định gây tai nạn giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/63f1e94cf8a06eae5817c27554d3c959294b55a6d6ad4c0f4e192c1920025e29> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công trên đường bộ đang khai thác có bố trí báo hiệu, rào chắn tạm thời tại nơi thi công nhưng không đầy đủ theo giấy phép thi công hoặc văn bản chấp thuận của cơ quan có thẩm quyền, trừ hành vi vi phạm quy định tại điểm c khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6415e12b9320ea835d94a636b2e29fcd6fb1cc91314b057b7ed0fc5a8dcad8c4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không đặt biển cảnh báo “Chú ý xe đỗ” theo quy định trong trường hợp gặp sự cố kỹ thuật (hoặc bất khả kháng khác) buộc phải đỗ xe chiếm một phần đường xe chạy hoặc tại nơi không được phép đỗ xe, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6457db900b7504e17e4e765712f86f05d2b3be3ec37569b43850441c210c3c46> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo giấy phép lái xe, trừ hành vi vi phạm quy định tại điểm c khoản 8 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/64b7246f882eb07f6d49f543e3c6d8f0df07430609d07aa0adf7a90e20644359> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe gắn biển số làm thay đổi chữ, số, màu sắc, hình dạng, kích thước của biển số xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/64c3ffd1336fc75bdf9927eb26ed50a619578793a8a48353c529601de00fe8d9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không mặc đồng phục của lái xe theo đúng mẫu đơn vị kinh doanh vận tải đã quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/64ca6ef167fd4f9d3b9ce81348b1856f074bc4a2de1adc3685f7b315673314e6> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô (kể cả rơ moóc và sơ mi rơ moóc), xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cứu hộ giao thông đường bộ, xe cứu thương không lắp thiết bị ghi nhận hình ảnh người lái xe theo quy định tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/64cd2b890cb041b66b8499d4e7c92029be91a2358eb27fde41ce769a27c2f291> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không cập nhật thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/64e05aaf424b1f7dd3cf3bcd7a1c7936eb3dda0efae3bfd7f643c1ad35ba1321> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/64fb060ce9c003045722cfd0049c9b978970062c1be39750f2edb6d2f65bbe8a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Ngồi phía sau vòng tay qua người ngồi trước để điều khiển xe, trừ trường hợp chở trẻ em dưới 06 tuổi ngồi phía trước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/650e47133e687528ac54f5598cf1a9dfad18ab594cc4eeae8f4dadf2399b21ff> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không bàn giao công trình, hồ sơ hoàn thành công trình, quy trình bảo trì theo quy định sau khi hoàn thành xây dựng công trình đường bộ để bồi hoàn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/652de883ad52733f30772047a75b363bc69dba914f47333bb1d5dadbb1a06b35> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có tổ chức thực hiện nhưng không đầy đủ các nội dung về công tác quản lý an toàn giao thông theo quy định, trừ hành vi vi phạm quy định tại điểm b khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65522d5e7919b5626d578a75603cb2e7b128719a8b0af4213b79e0328b3f111f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ đi vào đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65596c236339a408564cc3b68b9d1a3bd16e18ff32024f4ea789950bfbc8ca8d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng giá dịch vụ xe ra, vào bến xe đã kê khai, công bố."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65704fac0b4b89bf987479cea77e208f2aad97cd9e2bd26db05113d0c72a46ae> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không ký kết hợp đồng cho thuê phương tiện để tự lái với người thuê"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65a24a9579a4cd5bda87616e104fa5a1b25de97565844fec729bb61d51490934> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có phù hiệu kiểm soát theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65a32a9fcd917c4ab0039d999b731f3b15c97ff806b4b4cc65804533ef585359> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không xóa bỏ điểm đấu nối tạm thời khi hết thời hạn đấu nối tạm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65ed63d230efa4a0fd6be59591b686cd765ea49aa8148221bf84de4ee399f36c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải để trả hàng trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65f139097b92dc652ba82fbb688a666bb30280d710b879bde61bbe00621964a2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/65fccdf0a60e27318ffcc1ffe3e3f33d90c6ac71475831cc44c3eab9d228bb83> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 80 miligam/100 mililít máu hoặc vượt quá 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6602bce24177c410700cc9b227b5cf122d3c982745c5477c8af80417a1027931> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành hiệu lệnh, chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm được liệt kê tại các điểm, khoản khác của Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6644b1e9418f45687bf5ab10f6f538e8fe16a77bc58ff85c4b5662b2737e3ab4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tự ý đắp mặt bằng trong phạm vi đất dành cho kết cấu hạ tầng đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/665b3a5e5c0f9ed45aed507c890142a08fbac9c6f1a13a09781754b49c1f3bed> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở người không có tên trong danh sách hành khách"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/6688a8e128ecc9323fbe170234cf642c91996ef0447936ee9eb63784aa23176d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không sử dụng đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/669587e71ef9f8393ee1034e93bbff5836874a1e7a331b3a3b2574767329caef> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xây dựng biển quảng cáo trong phạm vi hành lang an toàn đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66a9c3eafdd0162685792fa9c844d81d780ff2fa3becfce8c55b205503cac61b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hiệu lực (hạn sử dụng) từ 01 tháng trở lên (kể cả rơ moóc)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/66b011ab753384a172ce0304ff4e6f11d6563a258e6244cacc7404314ef80632> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tái phạm hành vi quy định tại khoản 6 Điều này (trong trường hợp chở vượt trên 100% số người quy định được phép chở của phương tiện)"@vi .

