    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa xe ô tô đầu kéo, xe vận tải nội bộ không lắp thiết bị giám sát hành trình của xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7962458513738ee9d899912af626deee291431aa88778a4df64b2d0bffc0a97d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
