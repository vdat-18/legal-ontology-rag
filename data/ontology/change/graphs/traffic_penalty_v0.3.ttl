    skos:prefLabel "Đưa phương tiện có chứng nhận đăng ký xe nhưng không đúng với số khung, số động cơ (số máy) của xe tham gia giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/705734ea84ece4e1f6f48cbfe387036087673b7f7602f2c4401bfe3bccca25ae> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm d khoản 6 Điều 20 hoặc điểm b khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7089d3fb6bd9779acb3ef28fa4845ffc5136d28a0d92545e541166688dc1b181> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng nguy hiểm mà xe ô tô không lắp đèn hoặc tín hiệu cảnh báo theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/70960add4df716480a3d70c4f94b1851c6483763797b124b452e343ebcfdafef> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu nội dung cấm đi vào đối với loại phương tiện đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/709d57f9228b08c84c4588ba5104ae1383a23008d629972ee9511d7223b2749c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cơ sở đào tạo lái xe không lưu trữ hồ sơ theo quy định của 02 khóa đào tạo trở lên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/70dd5f1fd87fbd42f619706d4b5af9759bcc1000ba3a1def3011b5d56ed2c2b4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng thiết bị, dụng cụ không đảm bảo theo quy định của pháp luật về đo lường để kiểm tra chất lượng xuất xưởng xe cơ giới, xe máy chuyên dùng, phụ tùng xe cơ giới"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/70e361d4e4160ab0c4f307e89602c455a5b6692e6948f1077862734dfe79733d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng phù hiệu không do cơ quan có thẩm quyền cấp khi điều khiển xe chở người bốn bánh có gắn động cơ kinh doanh vận tải, xe chở hàng bốn bánh có gắn động cơ kinh doanh vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7100a0066fac69e886c2271062654b438c74f7cd6b7c5ae9684e3ea57acae010> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chở người bốn bánh có gắn động cơ kinh doanh vận tải, xe chở hàng bốn bánh có gắn động cơ kinh doanh vận tải có phù hiệu đã hết giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/71030b97fe173e81665aee10ba3b3ee977ba293dc1dd44e9e96e881a32d86b63> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Rú ga (nẹt pô) liên tục trong khu đông dân cư, khu vực cơ sở khám bệnh, chữa bệnh, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7110a1aa1b4ab76fc4cb39a09a6bc0272cc7f61ba9b906339a0c36d4196fb844> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe, kể cả rơ moóc và sơ mi rơ moóc, gắn biển số bị bẻ cong."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/712b633b9385ac1164677de81ee6cb41d138c85b9e8c426df6a389d3594d4a75> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe vận tải hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy đón khách không có tên trong danh sách hành khách theo hợp đồng đã ký"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/71304257bd3f842149dccdc4ee87daa18499fe30068c3fd6685872d2078bd5eb> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khai báo gian dối để trốn tránh trách nhiệm khi bị phát hiện vi phạm pháp luật về trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7133d4cca1674f55603f7f6aaf74ea5befaa1d5045605977abcaf468e995194f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giả mạo hồ sơ đăng ký xe nhưng chưa đến mức truy cứu trách nhiệm hình sự"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/714bccee36266c56fac3f82e3f2287f1d6b0674f4c81feddc1176ecc18275bd2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không cung cấp thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7168ead07b9100e8dc39c49259bba39aaaaaf53cae6a599ce9a3fd43e83c3d8c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 80 miligam/100 mililít máu hoặc vượt quá 0,4 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/718c7e7657b0a898fe10f504075c199cc4d08bef1f550780a64b226c53d13a64> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thực hiện báo cáo doanh thu không đúng thời gian theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7198b120d986ba2f214dc958fc1690e342e6d94ff1ee200b483eea30159628a0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe ở lòng đường trái quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/71a0ed1eb417c9547e8734e43f12d31ceab9dc60b8aabf0c82044e00719913de> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không cấp thẻ nhận dạng lái xe cho lái xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/71b2a7c2dce6d4f902f1482ac4b454665e4b31cb5d0c1307a776d116f4a63d25> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đe dọa người thi hành công vụ về bảo đảm trật tự, an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/71bbfd2ef65cbfb27b9ff04c6230a4655a77fdd519c155acf5b49973a75121d9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô giao phương tiện cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/71e6da42ce48f79c81e4a4cd6562a9623f01ad8440307ffd963783dce600e850> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Từ chối cung cấp dịch vụ kiểm định không đúng quy định của pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/71f01e44f6f592598779e5a9adb87fdfc42b8b2881bc7f8d596943b8d3b54c5d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề” khi chạy trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/727aba13379a70b570dcc5a1a2c2ee7fa4d3b535d85ddeda050de64c988b813b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy chuyển hướng không quan sát, trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/72feb76122cfa45156492929795f9172529a81bbfc7c2702080aa5d73b93c377> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện việc di dời công trình khi công trình ảnh hưởng đến an toàn giao thông đường bộ, an toàn công trình đường bộ mà không có biện pháp khắc phục"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/730f8890a20bffdc5d94d4d0045b8c192debb86bb3d110e93b6d2e7a57ab20b7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 7 Điều 20; điểm c khoản 6 Điều 21 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/733a393a0f238042deb49ac256805692ccbfcffcda9af954484038f0a67a44c7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khai thác công trình hạ tầng kỹ thuật sử dụng chung với đường bộ gây ảnh hưởng đến an toàn công trình đường bộ, an toàn giao thông đường bộ hoặc cản trở công tác vận hành, khai thác, bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/736c78cfabd1c49602e952c0749b6d72c4188d61acbd45505b163750460b3839> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng lái xe, nhân viên phục vụ trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được tập huấn, hướng dẫn về nghiệp vụ vận tải hành khách và an toàn giao thông theo quy định (đối với hình thức kinh doanh vận tải có quy định lái xe, nhân viên phục vụ trên xe phải được tập huấn, hướng dẫn nghiệp vụ), trừ các hành vi vi phạm quy định tại điểm c, điểm d khoản này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/73875f5198b37a4099df566146d408b341cd9289620d2f970ce79dcdc4d951e3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thi công trên đường bộ đang khai thác không đặt đèn cảnh báo giao thông và chiếu sáng ban đêm"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7387c9fae2f320446528e759285b16ed50d2e4527ae2e0fac8745e6cda1644e0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải hành khách theo hợp đồng mà thu tiền ngoài hợp đồng đã ký kết"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/73a0a1598468febc8f361748a56676fd43654fe8eeb8c518bab73e2b96ab63a0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có niêm yết thông tin trên xe nhưng không chính xác, không đầy đủ thông tin theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/73c7ab52630b7260dc991f69c9a66b6d9beb77097a3d484d8eb55f922ee385ec> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận chuyển hàng hóa là phương tiện vận tải, máy móc, thiết bị kỹ thuật, hàng dạng trụ không chằng buộc hoặc chằng buộc không theo quy định, trừ việc vận chuyển máy móc khổ lớn (quá khổ) trên phương tiện chuyên dùng và phải có giấy phép lưu hành trên đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/73d214bf813e41f01e144403e18db48056c56fc5b479bb3c1de24fdfa5d538cd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy chuyển hướng không bảo đảm khoảng cách an toàn với xe phía sau, trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/73e702644cbba8ae90ebba7611d59bd3ad3836e772f62f2c66f64119604148e4> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bày máy móc, thiết bị, vật tư trên lòng đường, vỉa hè"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/73e904e19736a49d387cd5efcda895cf1d9ae33940b202c9464542a69d8e02de> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô chở khách có giường nằm hai tầng để hoạt động trên các tuyến đường cấp V và cấp VI miền núi."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/74096c3a3cf87af866bdf129479481a9375af82bcf591074ead777b2eb05f851> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Ngăn chặn hệ thống thoát nước từ công trình thuộc kết cấu hạ tầng đường bộ theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/741ac0ef724eea99757e3db2697b6a58f844da27ce5c8f1ddb7c76e583a19c73> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có lắp thiết bị giám sát hành trình nhưng không có tác dụng trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7450faec19e8c1d29769dc46416f0bdd3c07958620ee41cee4814a05fb1a8a5f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải có lắp thiết bị ghi nhận hình ảnh người lái xe nhưng thiết bị không lưu trữ được dữ liệu trên xe trong quá trình xe tham gia giao thông theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/745aee6b429249d15dca4501cff62d88a15579fa705af36d856eee24c330ed76> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe niêm yết hành trình chạy xe không đúng với hành trình đã được cơ quan có thẩm quyền cấp phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7463848ab246d471e00e6a7cc0e1bbef9827b88d2406af88cae80254f442fede> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe kinh doanh vận tải hành khách theo tuyến cố định thu tiền vé cao hơn giá vé đã kê khai và niêm yết theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/746757e027bed092b1611a1cc0eaafc4cd814a8a090f8e7add585c388a2108c9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không ký kết hợp đồng cho thuê phương tiện tự lái với bên thuê để kinh doanh vận tải bằng xe ô tô, vận tải nội bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/746a755d1920d26dcc5c8acb4e7a60f078975337b83f5f8d5b5b546135157f80> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô hoặc các loại xe tương tự xe gắn máy vượt bên phải trong trường hợp không được phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/747b7345f484debe6f698e0ae6cc09e4bd340dcf208f34b4f5274d95ac066334> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe vận tải hành khách không có nhân viên phục vụ trên xe đối với những xe quy định phải có nhân viên phục vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/74998d417a3284f4f919d9c3b5280e57a9fa4b7478a91be9310e6f72e3957003> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đỗ xe trên dải phân cách cố định ở giữa hai phần đường xe chạy, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/74c95ff263583d32293d9b63b32efdf9828760d520dbdb3a96e7a5e07e9b0ae1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm hư hỏng thiết bị điều khiển, giám sát giao thông đường bộ, thiết bị thông minh hỗ trợ chỉ huy, điều khiển giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/74cff9c6b517f817b3f06d52001d5c955ae61f7a0032b1c308e987aceb192cf0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe mà tổng trọng lượng (khối lượng toàn bộ) của xe hoặc tải trọng trục xe (bao gồm cả hàng hóa xếp trên xe, người được chở trên xe) vượt quá tải trọng cho phép của đường bộ trên 50%, trừ trường hợp có giấy phép lưu hành còn giá trị sử dụng"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/74d13cdf1e6fe0b5f1ccf5deea8e20d97c848f3b7c92caf0c0a914072f41b170> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đua xe gắn máy, xe đạp máy, xe đạp trái phép trên đường giao thông"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/74d36ad40178d2facacb02f2980b7bec0b68e4ecaf0deb967743e4b146910c51> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy điều khiển xe gắn biển số làm thay đổi chữ, số, màu sắc của chữ, số, nền biển số xe, hình dạng, kích thước của biển số xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/74dabfdfae9e12c68fe031de622cea85573c027f441af57bc05944444a56a0da> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Cá nhân, tổ chức là chủ xe ô tô (kể cả rơ moóc và sơ mi rơ moóc), xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ, xe máy chuyên dùng và các loại xe tương tự xe ô tô đưa xe cứu hộ giao thông đường bộ không có dụng cụ, thiết bị chuyên dùng để cứu hộ, hỗ trợ cứu hộ theo quy định tham gia giao thông."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/751a71b58adf88413fa9d4ffac6dc69d3b15c155aa414ef2b0b08c065063a42e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/751db753fe36d38f81a81a758689a81f9966b0b53e7481916c8fcf3045a0634e> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vẫn tiến hành các hoạt động ghi trong giấy phép trong thời gian bị tước quyền sử dụng giấy phép trong hoạt động đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7541991f5015057657fc896ae729f2870dd73774071d380bcc9f337dceb825f0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a khoản 4 Điều 34 của Nghị định này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/755bd52aa3a9d60ddeba5bed7c1603a5c45f3f8bad5cde49771a49b1f55986c3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không niêm yết nội quy, giá dịch vụ, tên và số điện thoại cơ quan quản lý nhà nước có thẩm quyền tại bãi đỗ xe theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/756e0e1b5723184ad99136cd4264bd8995eb992c0cd43cc07a9048c2402c95f7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thu dọn ngay các biển báo hiệu, rào chắn, phương tiện, vật dụng thi công, các vật liệu tại phần đất của đường bộ, hành lang an toàn đường bộ theo nguyên trạng khi thi công xong"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/7591467398ee2bc6aa73d7279f6b82a4bd8151a36c9169ad7aa15e5102defdea> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không cấp lệnh vận chuyển, giấy vận tải cho lái xe đối với loại xe quy định phải cấp lệnh vận chuyển, giấy vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/759fe0de6939361a4fbf31c62ddd3356c074beb21e10d2898206048fa54cf21c> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đưa ra các yêu cầu trái quy định về trình tự, thủ tục đăng kiểm đối với cá nhân, tổ chức"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/75c755dd0b1258676bd2692a170e8f4f3f2f0fac4f8f92b44232c8c74df01847> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Tái phạm hành vi quy định tại khoản 5 Điều này (trong trường hợp chở vượt trên 100% số người quy định được phép chở của phương tiện)"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/75d2369d311c8f15f04c196e96f42926818fda5cdb85707ca52eed3ec8ad52c0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chở hàng vượt quá bề rộng thùng xe, kể cả bề rộng rơ moóc và sơ mi rơ moóc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/75da85b91964a20634a7664c57694b9424b22fbece9c03d4ad82bb99e319170a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm a, điểm b khoản 7 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/75dd0106f78e5fa4d6032f013c731b19ab6210f9822642ca08041f0c82152aec> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dừng xe trong hầm đường bộ không đúng nơi quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/760447f7e8df4a65210d3060c7a7576359ae0de010a9739a7f86b37dda72158f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải để trả khách trên đường cao tốc"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/761f28b881bfa13c7a72181a11cd2a1da1dfb5dc23f4480f28b3458800366adf> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đơn vị sản xuất, lắp ráp, nhập khẩu thiết bị giám sát hành trình của xe ô tô không có nhân sự cho từng vị trí công việc theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/762e24d8e3644413c4d18f2293967abbd1f8a01574f2eea4c5587002dbbbd331> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe chở hàng vượt trọng tải cho phép tham gia giao thông được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 100% đến 150%"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/76310c1be38f6b5647354b8d2730535886ea0a33058d525b5e7c38761b69c473> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Ném gạch, đất, đá, cát hoặc vật thể khác vào người, phương tiện đang tham gia giao thông trên đường bộ"@vi .

