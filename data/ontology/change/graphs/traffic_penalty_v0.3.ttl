<https://w3id.org/legal-ontology-rag/data/concept/conduct/55c1749ad78dd08c2e52b7e9a72e43ff72b2cde7914ad1f326e5fe31ff9e1b22> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe vận chuyển hành khách theo hợp đồng vận chuyển không đúng đối tượng theo quy định, áp dụng đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển trẻ em mầm non, học sinh, sinh viên, cán bộ, công chức, viên chức, công nhân"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/55ee5e6326563a4dd2fe773fc0123d421411289a4f07c651b4b5892e5c97f0e1> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
