    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chốt, đóng cố định cửa sau, cửa bên thùng xe khi xe đang chạy"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/c2d8a0ec643dd35303f784cc16609c5d400e8f3b67697790f53d370e0256d256> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô"@vi .

