<https://w3id.org/legal-ontology-rag/data/concept/conduct/f1b96f7c917d7bae857b40150f0d5049913881c91ffef9f7c150bf6fd1a16b0b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đi vào đường cao tốc, trừ người phục vụ việc quản lý, bảo trì đường cao tốc"@vi .

