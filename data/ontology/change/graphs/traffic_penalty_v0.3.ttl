    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô cứu thương"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/57256bd09988cbda012c5bddbc9f02ab5427f261fb652d03982ea9e1a2397fc5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
