<https://w3id.org/legal-ontology-rag/data/concept/conduct/8545bed8d195cf1b6555a701c36483b1efeccf6361ea6abe03a231196beac0fa> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Thực hiện các hành vi khác nhằm trốn tránh phát hiện xe chở quá tải, quá số người theo quy định của pháp luật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/85555bcc6b49ad75bc5d30b659eead8a97531a229d77d36f9162255605344ebe> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
