<https://w3id.org/legal-ontology-rag/data/concept/conduct/861399b2b8c3fbc785c36630e224634d6602495024d4d1b4f29454592fedfb80> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Gây tai nạn giao thông không giữ nguyên hiện trường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/863a03f684bf41cc5506d4379e588e85b8f218c16dc6d13b3a19e9f71604fae0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
