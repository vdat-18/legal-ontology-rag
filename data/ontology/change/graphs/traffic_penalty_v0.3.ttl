    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng nội dung đã đăng ký, niêm yết về giá cước"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae1595d2f37ff07c59d1053e10136e633c01c253838e7ed141dc3010b39b0ae5> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Có niêm yết thông tin trên xe nhưng không chính xác, không đầy đủ thông tin theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae2634cae6c0aba9725d733599dc0347e33d12176f18846c278a438d1e003d96> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô kinh doanh vận tải không mang theo chứng nhận bảo hiểm bắt buộc trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae73ba9746e228404a32396bb5cf484f0b7e5a804923025f0aa55ae24eb73142> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Làm sai lệch dữ liệu của thiết bị giám sát hành trình lắp trên xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae8334685c223d316273b72c7a8b07574ed7f02128fb6d5152ee5643203aa533> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Bố trí người trực tiếp điều hành hoạt động vận tải nhưng không đáp ứng đủ điều kiện theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae8dcc13092f0648a8a2b20ffaa3adf47f8d025f568ed840a85138403be763f9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe có hệ thống chuyển hướng không bảo đảm tiêu chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ae90355202d8fe129ac34a95d891217050d19995ece7d9ed5d7b537c30c0201b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
