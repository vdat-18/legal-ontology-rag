    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đặt, treo biển hiệu, bảng quảng cáo trên đất của đường bộ ở đoạn đường ngoài đô thị trừ việc đặt, treo biển hiệu, bảng quảng cáo tại lòng đường và trừ hành vi vi phạm quy định tại điểm a khoản 5 Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d42cb199e6a6ad6d6fe73d74fd4052fd1a122ab88aa9d47ba5bbc76d03886b3b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Nằm trên yên xe điều khiển xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d4392225ef48b6da2a94bedd46cb3ce519fde66e6153ef31151beab07a9f726d> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Giáo viên dạy thực hành chạy không đúng tuyến đường trong giấy phép xe tập lái"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d4490cf4a51a99608b01f5cab6ccf945a80b75a7bd4fe5df76e6bf58c7a94ef2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dựng cổng chào trái phép trong phạm vi đất dành cho kết cấu hạ tầng đường bộ gây ảnh hưởng đến an toàn giao thông đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d44cfea24db5fce16b4d893cc9ba98af5cabf8d20d6a19fbe8dcb1d2bcf024a0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người từ đủ 14 tuổi đến dưới 16 tuổi điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy hoặc điều khiển xe ô tô, xe chở người bốn bánh có gắn động cơ, xe chở hàng bốn bánh có gắn động cơ và các loại xe tương tự xe ô tô"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d45c149d20e5844fb81c367c6851a08ce9507cf95c1110fdd4aa55d3e9560bcd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chủ phương tiện là tổ chức không hợp tác với cơ quan chức năng và không giải trình để xác định được người đã điều khiển phương tiện thực hiện hành vi vi phạm, trừ trường hợp phương tiện bị chiếm đoạt, sử dụng trái phép"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d461fb74b1151753a320612adc026c540449a6bea4c326da4bfc4a06644e36d9> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không sử dụng hoặc sử dụng không đủ đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d478ecb5c610d11b1891b1f69b6ade33c19fba326c5da264762ba703af7c1ff0> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vận hành công trình hạ tầng kỹ thuật sử dụng chung với đường bộ gây ảnh hưởng đến an toàn công trình đường bộ, an toàn giao thông đường bộ hoặc cản trở công tác vận hành, khai thác, bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d48c321d2644fbda1978a264b998bbbceafd2ca0bf8a70d81047469abf205aa3> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Đào tạo thẩm tra viên an toàn giao thông đường bộ không đúng chương trình khung, kế hoạch đào tạo đã thông báo theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d4985b4338a1e6f4306638a155793f8d1825e1d7d476fbd3398692d9f86b84d2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Kiểm định cho xe cơ giới, xe máy chuyên dùng không đúng quy định, tiêu chuẩn, quy chuẩn kỹ thuật"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d54db735fb9bd51ea7e4c0f80a29562321c293b197e433e949d82a6cf6bd2ebc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Xe không được quyền ưu tiên sử dụng thiết bị phát tín hiệu của xe được quyền ưu tiên"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d54f7bfda5e33cb37e918db00b3c026990455367b573bf3e413a0357d2160ebc> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe trung chuyển chở hành khách không đúng quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d5535af94a04c7c28cf9df3390fd9c9aa787186cfb256589a4066e3150c29930> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Sử dụng xe ô tô kinh doanh vận tải chở trẻ em mầm non, học sinh, xe ô tô kinh doanh vận tải kết hợp với hoạt động đưa đón trẻ em mầm non, học sinh không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh hoặc không có thiết bị có chức năng cảnh báo, chống bỏ quên trẻ em trên xe hoặc không có thiết bị ghi nhận hình ảnh trẻ em mầm non, học sinh và thiết bị có chức năng cảnh báo, chống bỏ quên trẻ em trên xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d5647016f347771b1e0deb73d69f8500cd0c89bdf8dce593e738e8952073e348> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không giảm tốc độ (hoặc dừng lại) và nhường đường khi điều khiển xe đi từ đường không ưu tiên ra đường ưu tiên, từ đường nhánh ra đường chính"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d57b6584e6317979ae10a2d834a30d641ad97e4c3bef7e37cd5058e30a0662cd> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Dùng các thủ đoạn khác để trốn tránh việc phát hiện xe chở quá tải, quá khổ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d5834bfccde15007afb0132adbc1e1e6c9559b5575de9c21fc6f5439558db75f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm quy định về bảo vệ môi trường"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d5a0c52f7b14fe7693c5d834c6b6b49dcdf9b6c7db84f0c4b99ea03292f44437> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô hai bánh có dung tích xi-lanh đến 125 cm3 hoặc có công suất động cơ điện đến 11 kW và các loại xe tương tự xe mô tô không có giấy phép lái xe"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/d5a31fc510bae29250ad9a97cd5cafe10e55163c2f18ddf43d0fc7ce2e093bc7> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Để người mắc võng nằm trên xe khi xe đang chạy"@vi .

