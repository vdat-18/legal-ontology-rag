    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không truyền dẫn thông tin, dữ liệu thu thập từ thiết bị ghi nhận hình ảnh người lái xe lắp trên xe ô tô theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e99d1f6c3a604f4b230d390a88eb91e23ab1c8b9761ec27ce560196bcf0dbc6f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Vi phạm về chằng buộc vận chuyển hàng hóa"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e9a823fe59e05a2d94f240363e5e286f4e720e2dadf109d094344e845e91ef9f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Người điều khiển xe mô tô hai bánh có dung tích xi-lanh đến 125 cm3 hoặc có công suất động cơ điện đến 11 kW và các loại xe tương tự xe mô tô sử dụng giấy phép lái xe đã bị trừ hết điểm hoặc không do cơ quan có thẩm quyền cấp, bị tẩy xóa, không còn hiệu lực hoặc không phù hợp với loại xe đang điều khiển"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e9adbf26b9a5609a2a9108c54d43de0cf6bdcf92c1397a4ab9baf6718c2f3f89> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành yêu cầu kiểm tra về trọng tải, tải trọng, khổ giới hạn xe, vận chuyển hàng siêu trường, siêu trọng của người thi hành công vụ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e9d05461207895a4bbc68c9fcc2cc25e0af22f6d6a905d947b9525f1486d219a> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không chấp hành hiệu lệnh, chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm được liệt kê tại các điểm, khoản khác của Điều này"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/e9dd173db30e28db4571e8426b59d479d6bc403fadee4201bb6a96da4aca721b> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không sử dụng hoặc sử dụng không đủ đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn"@vi .

