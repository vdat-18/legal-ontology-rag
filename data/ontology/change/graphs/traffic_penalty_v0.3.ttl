    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Lợi dụng việc xảy ra tai nạn giao thông đường bộ để xúi giục"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ada37f1dcb6bc437d85a0c32191d71f7fa5ec4ca13b6b4b09e491fc46e9674f2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Điều khiển xe không có thiết bị giám sát hành trình theo quy định"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/adc82cefa6c1cdd87657760e9ecc3cebc218e38a5efe6f689cde5839d5a0c30f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không kê khai giá dịch vụ vận tải hành khách tuyến cố định bằng đường bộ theo quy định."@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ade770af7e276156456255082b8cf71f6cee7ccffd6549f77ce83b47a126e477> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Không thực hiện đúng quy định về dán, thu hồi phù hiệu cấp cho xe ô tô tham gia kinh doanh vận tải"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/ade85b768add8d1d790d70cb8e7bcdb8ba41058bc183224004a45196182a72e2> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Khai thác công trình hạ tầng kỹ thuật sử dụng chung với đường bộ gây ảnh hưởng đến an toàn công trình đường bộ, an toàn giao thông đường bộ hoặc cản trở công tác vận hành, khai thác, bảo trì công trình đường bộ"@vi .

<https://w3id.org/legal-ontology-rag/data/concept/conduct/adf55e1a2bbee1bee2401be619375120241a70d4da62715a98e0ce56132b5f5f> a <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#RegulatedConduct> ;
    skos:inScheme <https://w3id.org/legal-ontology-rag/ontology/occurrence-context#conductScheme> ;
    skos:prefLabel "Chuyển hướng không đúng quy định gây tai nạn giao thông"@vi .

