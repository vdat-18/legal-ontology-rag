# LLM accessed through an OpenAI-compatible API
LLM_BASE_URL=<OPENAI_COMPATIBLE_BASE_URL>
LLM_API_KEY=<LLM_API_KEY>
LLM_MODEL=<MODEL_ID>
LLM_TIMEOUT_SECONDS=60

# Chunking uses the tokenizer and input limit from the selected versioned profile
EMBEDDING_PROFILE=qwen3_0_6b
CHUNK_MAX_TOKENS=512
CHUNK_SPLIT_OVERLAP_TOKENS=64

# Ground-truth synthesis thresholds (docs/groundtruth_synthesis_pipeline.md)
GROUNDTRUTH_CHUNK_QUALITY_THRESHOLD=0.6
GROUNDTRUTH_SPAN_MATCH_THRESHOLD=0.85
GROUNDTRUTH_BUNDLE_OVERLAP_THRESHOLD=0.5
GROUNDTRUTH_DEDUP_COSINE_THRESHOLD=0.9
GROUNDTRUTH_MAX_QUALITY_RETRIES=2
GROUNDTRUTH_MAX_SIMULATOR_TURNS=8

# Milvus vector store (docker compose up -d etcd minio milvus), shared across RAG pipeline
# versions; each version keeps its data in its own Milvus database (see NaiveRagSettings)
MILVUS_URI=http://localhost:19530
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Naive RAG baseline (B0); reuses LLM_*, EMBEDDING_PROFILE, and MILVUS_URI above
NAIVE_RAG_TOP_K=10
