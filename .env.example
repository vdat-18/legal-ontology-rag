# LLM accessed through an OpenAI-compatible API
LLM_BASE_URL=<OPENAI_COMPATIBLE_BASE_URL>
LLM_API_KEY=<LLM_API_KEY>
LLM_MODEL=<MODEL_ID>
LLM_TIMEOUT_SECONDS=60
# Optional: extra keys to run multiple Graphiti indexing shards in parallel.
# LLM_API_KEY_2=<ANOTHER_LLM_API_KEY>

# Chunking uses the tokenizer and input limit from the selected versioned profile.
EMBEDDING_PROFILE=qwen3_0_6b
CHUNK_MAX_TOKENS=512
CHUNK_SPLIT_OVERLAP_TOKENS=64
EMBEDDING_LOCAL_FILES_ONLY=false

# Shared Milvus standalone and its MinIO object store.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:<MILVUS_ROOT_PASSWORD>
MILVUS_DATABASE=legal_rag
MILVUS_ROOT_PASSWORD=<MILVUS_ROOT_PASSWORD>
MINIO_ROOT_USER=<MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>

# Naive RAG owns this collection inside the shared Milvus database.
NAIVE_RAG_MILVUS_COLLECTION_NAME=naive_rag_chunks

# Corrective RAG owns this collection inside the shared Milvus database.
CRAG_MILVUS_COLLECTION_NAME=legal_chunks
MILVUS_INDEX_BATCH_SIZE=32

# Shared Neo4j graph database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=<NEO4J_USER>
NEO4J_PASSWORD=<NEO4J_PASSWORD>

# Optional Compose host bindings and UI ports default to localhost-only values.
# INFRA_HOST_BIND=127.0.0.1
# ATTU_PORT=3000
# MINIO_CONSOLE_PORT=9001

# Corrective RAG action trigger and refinement.
CRAG_EVALUATOR_UPPER_THRESHOLD=0.70
CRAG_EVALUATOR_LOWER_THRESHOLD=0.35
CRAG_REFINEMENT_MAX_STRIPS_PER_CHUNK=8
CRAG_REFINEMENT_STRIP_MAX_CHARS=900
CRAG_REFINEMENT_TOP_INTERNAL_STRIPS=6
CRAG_REFINEMENT_TOP_EXTERNAL_STRIPS=5
CRAG_REFINEMENT_DECOMPOSE_MODE=excerption

# Optional free web-search branch for CRAG INCORRECT/AMBIGUOUS actions.
CRAG_WEB_SEARCH_ENABLED=false
CRAG_WEB_SEARCH_URL=https://duckduckgo.com/html/
CRAG_WEB_SEARCH_MAX_RESULTS=3
CRAG_WEB_SEARCH_TIMEOUT_SECONDS=10
CRAG_WEB_SEARCH_ALLOWED_DOMAINS=chinhphu.vn,vanban.chinhphu.vn,moj.gov.vn
