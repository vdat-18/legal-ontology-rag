# LLM accessed through 9Router's OpenAI-compatible API
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=<FULL_9ROUTER_KEY>
LLM_MODEL=gemini/gemini-3.6-flash
LLM_TIMEOUT_SECONDS=60

# Bounded image-caption generation
IMAGE_CAPTION_MAX_CONCURRENCY=4
IMAGE_CAPTION_MAX_OUTPUT_TOKENS=2048
IMAGE_CAPTION_MAX_CONTEXT_CHARACTERS=4000
IMAGE_CAPTION_TEMPERATURE=0
