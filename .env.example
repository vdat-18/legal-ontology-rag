# Copy to .env and fill in. Never commit real secrets.

# --- Neo4j (Graphiti backend) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- LLM (extraction) ---
ANTHROPIC_API_KEY=

# --- Models (optional overrides) ---
GRAPHITI_LLM_MODEL=claude-sonnet-4-5
GRAPHITI_SMALL_LLM_MODEL=claude-haiku-4-5-latest

# --- Embedder: 'openai' (needs OPENAI_API_KEY) or 'bge' (local BGE-M3) ---
GRAPHITI_EMBEDDER=openai
OPENAI_API_KEY=

# --- Data / graph partition (optional overrides) ---
# CORPUS_ZIP=data/raw/road_traffic_legal_documents.zip
# PENALTY_CONFIG=data/config/penalty_corpus.json
GRAPHITI_GROUP_ID=traffic_penalty_vn

# --- Ragas ground-truth generation (optional overrides) ---
# Uses OPENAI_API_KEY when the selected Ragas provider is OpenAI.
# GROUNDTRUTH_CONFIG=data/config/groundtruth_corpus_v1.json
# RAGAS_LLM_PROVIDER=openai
# RAGAS_LLM_MODEL=
# RAGAS_EMBEDDING_PROVIDER=openai
# RAGAS_EMBEDDING_MODEL=
# RAGAS_CANDIDATES_OUTPUT=data/evaluation/candidates.jsonl
