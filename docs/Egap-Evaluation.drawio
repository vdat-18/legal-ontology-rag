        <mxCell id="F4IfnMR2Abhsz6hBbRpP-40" parent="1" style="text;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#000000;fillColor=#d5e8d4;" value="&lt;table data-line=&quot;137&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;border-collapse: collapse; margin-bottom: 0.7em; position: relative; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;thead data-line=&quot;137&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;position: relative;&quot;&gt;&lt;tr data-line=&quot;137&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;position: relative;&quot;&gt;&lt;th style=&quot;text-align: left; border-bottom-width: 1px; border-bottom-style: solid; border-color: rgba(255, 255, 255, 0.69); padding: 5px 10px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Persona&lt;/span&gt;&lt;/th&gt;&lt;th style=&quot;text-align: left; border-bottom-width: 1px; border-bottom-style: solid; border-color: rgba(255, 255, 255, 0.69); padding: 5px 10px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Age&lt;/span&gt;&lt;/th&gt;&lt;th style=&quot;text-align: left; border-bottom-width: 1px; border-bottom-style: solid; border-color: rgba(255, 255, 255, 0.69); padding: 5px 10px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Tech&lt;/span&gt;&lt;/th&gt;&lt;th style=&quot;text-align: left; border-bottom-width: 1px; border-bottom-style: solid; border-color: rgba(255, 255, 255, 0.69); padding: 5px 10px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Communication Style&lt;/span&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-line=&quot;139&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;position: relative;&quot;&gt;&lt;tr data-line=&quot;139&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;position: relative;&quot;&gt;&lt;td style=&quot;padding: 5px 10px; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;strong style=&quot;color: rgb(0, 0, 0);&quot;&gt;Young Tech-Savvy&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;25-35&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;High&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Concise, precise numbers, impatient&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr data-line=&quot;140&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;position: relative;&quot;&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;strong style=&quot;color: rgb(0, 0, 0);&quot;&gt;Elderly Traditional&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;65+&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Low&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Polite, slow, approximate numbers, Isan dialect&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr data-line=&quot;141&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;position: relative;&quot;&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;strong style=&quot;color: rgb(0, 0, 0);&quot;&gt;Business-Oriented&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;45-55&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Medium&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Transactional, demands exact figures&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr data-line=&quot;142&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;position: relative;&quot;&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;strong style=&quot;color: rgb(0, 0, 0);&quot;&gt;Casual Chatty&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;35-50&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Medium&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Verbose, friendly, often off-topic&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr data-line=&quot;143&quot; class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;position: relative;&quot;&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;strong style=&quot;color: rgb(0, 0, 0);&quot;&gt;Hesitant Uncertain&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;45-60&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Low&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding: 5px 10px; border-top-width: 1px; border-top-style: solid; border-color: rgba(255, 255, 255, 0.18);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Apologetic, vague, needs reassurance&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="180" width="640" x="-850" y="490" as="geometry" />
        </mxCell>
        <mxCell id="pGc6Ir82Nq3YNr14OTjz-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;strokeWidth=2;" value="" vertex="1">
